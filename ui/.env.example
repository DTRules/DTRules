# DTRules UI Environment Configuration
# Copy this file to .env.local and update the values for your system

# Backend API URL (default: http://localhost:8080/api)
VITE_API_URL=http://localhost:8080/api

# Path to CHIP sample project for quick start
# Update this to the absolute path on your system
# Example: /home/user/DTRules/sampleprojects/CHIP/xml
VITE_CHIP_PROJECT_PATH=
