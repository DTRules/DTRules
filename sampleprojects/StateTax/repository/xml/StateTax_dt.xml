<action_number>1</action_number>
<action_comment>Sum all income sources</action_comment>
<action_requirement></action_requirement>
<action_description>Perform Calculate_Gross_Income</action_description>
<action_postfix>
Calculate_Gross_Income
</action_postfix>
<action_column column_value="X" column_number="2"></action_column>
<action_column column_value="X" column_number="3"></action_column></action_details>
<action_details>
<action_number>2</action_number>
<action_comment>Initialize AGI to gross income</action_comment>
<action_requirement></action_requirement>
<action_description>set taxpayer.agi = taxpayer.grossIncome</action_description>
<action_postfix>
taxpayer.grossIncome cvi /taxpayer.agi xdef
</action_postfix>
<action_column column_value="X" column_number="2"></action_column>
<action_column column_value="X" column_number="3"></action_column></action_details>
<action_details>
<action_number>3</action_number>
<action_comment>Subtract above-the-line adjustments</action_comment>
<action_requirement></action_requirement>
<action_description>Perform Apply_Adjustments</action_description>
<action_postfix>
Apply_Adjustments
</action_postfix>
<action_column column_value="X" column_number="2"></action_column>
<action_column column_value="X" column_number="3"></action_column></action_details>
<action_details>
<action_number>4</action_number>
<action_comment>Set deduction and exemptions from state_config</action_comment>
<action_requirement></action_requirement>
<action_description>Perform Determine_Filing_Details</action_description>
<action_postfix>
Determine_Filing_Details
</action_postfix>
<action_column column_value="X" column_number="2"></action_column>
<action_column column_value="X" column_number="3"></action_column></action_details>
<action_details>
<action_number>5</action_number>
<action_comment>Compute taxable income</action_comment>
<action_requirement></action_requirement>
<action_description>Perform Calculate_Taxable_Income</action_description>
<action_postfix>
Calculate_Taxable_Income
</action_postfix>
<action_column column_value="X" column_number="2"></action_column>
<action_column column_value="X" column_number="3"></action_column></action_details>
<action_details>
<action_number>6</action_number>
<action_comment>Apply flat tax rate</action_comment>
<action_requirement></action_requirement>
<action_description>Perform Apply_Flat_Tax</action_description>
<action_postfix>
Apply_Flat_Tax
</action_postfix>
<action_column column_value="X" column_number="2"></action_column></action_details>
<action_details>
<action_number>7</action_number>
<action_comment>Select brackets for filing status and apply progressive rates</action_comment>
<action_requirement></action_requirement>
<action_description>Perform Select_And_Apply_Brackets</action_description>
<action_postfix>
Select_And_Apply_Brackets
</action_postfix>
<action_column column_value="X" column_number="3"></action_column></action_details>
<action_details>
<action_number>8</action_number>
<action_comment>Build result entity</action_comment>
<action_requirement></action_requirement>
<action_description>Perform Evaluate_Results</action_description>
<action_postfix>
Evaluate_Results
</action_postfix>
<action_column column_value="X" column_number="1"></action_column>
<action_column column_value="X" column_number="2"></action_column>
<action_column column_value="X" column_number="3"></action_column>
<action_column column_value="X" column_number="4"></action_column></action_details></actions>
<policy_statements>
<policy_statement column="1">
<policy_description>No income tax for this state</policy_description>
<policy_statement_postfix>&quot;State &quot; state_config.state_code cvs strconcat &quot; has no income tax, tax owed is $0&quot; strconcat</policy_statement_postfix></policy_statement>
<policy_statement column="2">
<policy_description>Computing flat-rate tax</policy_description>
<policy_statement_postfix>&quot;Computing flat-rate tax for &quot; state_config.state_name cvs strconcat</policy_statement_postfix></policy_statement>
<policy_statement column="3">
<policy_description>Computing progressive-bracket tax</policy_description>
<policy_statement_postfix>&quot;Computing progressive-bracket tax for &quot; state_config.state_name cvs strconcat</policy_statement_postfix></policy_statement>
<policy_statement column="4">
<policy_description>Unknown tax type</policy_description>
<policy_statement_postfix>&quot;Unknown tax type: &quot; state_config.tax_type cvs strconcat</policy_statement_postfix></policy_statement></policy_statements></decision_table>
<decision_table>
<table_name>Calculate_Gross_Income</table_name>
<xls_file>StateTax_dt.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Iterates over all income sources and sums them into taxpayer.grossIncome</COMMENTS>
<POLICY_REFERENCE></POLICY_REFERENCE></attribute_fields>
<contexts>
<context_details>
<context_number>1</context_number>
<context_comment>Iterate over all income entries</context_comment>
<context_description>for all incomes</context_description>
<context_postfix>
dup incomes forall pop
</context_postfix></context_details></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Include all income types</condition_comment>
<condition_requirement></condition_requirement>
<condition_description>true</condition_description>
<condition_postfix>
true
</condition_postfix>
<condition_column column_value="Y" column_number="1"></condition_column></condition_details></conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Add income to gross total</action_comment>
<action_requirement></action_requirement>
<action_description>add income.amount to taxpayer.grossIncome</action_description>
<action_postfix>
income.amount taxpayer.grossIncome + /taxpayer.grossIncome xdef
</action_postfix>
<action_column column_value="X" column_number="1"></action_column></action_details></actions>
<policy_statements>
<policy_statement column="1">
<policy_description>Adding income to gross income</policy_description>
<policy_statement_postfix>&quot;Adding &quot; income.type cvs strconcat &quot; income of $&quot; strconcat income.amount cvs strconcat &quot; to gross income&quot; strconcat</policy_statement_postfix></policy_statement></policy_statements></decision_table>
<decision_table>
<table_name>Apply_Adjustments</table_name>
<xls_file>StateTax_dt.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Subtracts above-the-line adjustments from AGI</COMMENTS>
<POLICY_REFERENCE></POLICY_REFERENCE></attribute_fields>
<contexts>
<context_details>
<context_number>1</context_number>
<context_comment>Iterate over all adjustments</context_comment>
<context_description>for all adjustments</context_description>
<context_postfix>
dup adjustments forall pop
</context_postfix></context_details></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Apply all adjustments</condition_comment>
<condition_requirement></condition_requirement>
<condition_description>true</condition_description>
<condition_postfix>
true
</condition_postfix>
<condition_column column_value="Y" column_number="1"></condition_column></condition_details></conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Subtract adjustment from AGI</action_comment>
<action_requirement></action_requirement>
<action_description>subtract adjustment.amount from taxpayer.agi</action_description>
<action_postfix>
taxpayer.agi adjustment.amount - /taxpayer.agi xdef
</action_postfix>
<action_column column_value="X" column_number="1"></action_column></action_details></actions>
<policy_statements>
<policy_statement column="1">
<policy_description>Subtracting adjustment from AGI</policy_description>
<policy_statement_postfix>&quot;Subtracting &quot; adjustment.type cvs strconcat &quot; adjustment of $&quot; strconcat adjustment.amount cvs strconcat &quot; from AGI&quot; strconcat</policy_statement_postfix></policy_statement></policy_statements></decision_table>
<decision_table>
<table_name>Determine_Filing_Details</table_name>
<xls_file>StateTax_dt.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Sets standard deduction and exemptions from state_config based on filing status</COMMENTS>
<POLICY_REFERENCE></POLICY_REFERENCE></attribute_fields>
<contexts></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Single filer</condition_comment>
<condition_requirement></condition_requirement>
<condition_description>taxpayer.filing_status == SINGLE</condition_description>
<condition_postfix>
taxpayer.filing_status "SINGLE" streq
</condition_postfix>
<condition_column column_value="Y" column_number="1"></condition_column></condition_details>
<condition_details>
<condition_number>2</condition_number>
<condition_comment>Married Filing Jointly</condition_comment>
<condition_requirement></condition_requirement>
<condition_description>taxpayer.filing_status == MFJ</condition_description>
<condition_postfix>
taxpayer.filing_status "MFJ" streq
</condition_postfix>
<condition_column column_value="Y" column_number="2"></condition_column></condition_details>
<condition_details>
<condition_number>3</condition_number>
<condition_comment>Head of Household</condition_comment>
<condition_requirement></condition_requirement>
<condition_description>taxpayer.filing_status == HOH</condition_description>
<condition_postfix>
taxpayer.filing_status "HOH" streq
</condition_postfix>
<condition_column column_value="Y" column_number="3"></condition_column></condition_details>
<condition_details>
<condition_number>4</condition_number>
<condition_comment>Default to Single</condition_comment>
<condition_requirement></condition_requirement>
<condition_description>true</condition_description>
<condition_postfix>
true
</condition_postfix>
<condition_column column_value="Y" column_number="4"></condition_column></condition_details></conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Deduction for Single</action_comment>
<action_requirement></action_requirement>
<action_description>set deduction from state_config.standard_deduction_single</action_description>
<action_postfix>
state_config.standard_deduction_single cvi /taxpayer.deduction xdef
</action_postfix>
<action_column column_value="X" column_number="1"></action_column>
<action_column column_value="X" column_number="4"></action_column></action_details>
<action_details>
<action_number>2</action_number>
<action_comment>Deduction for MFJ</action_comment>
<action_requirement></action_requirement>
<action_description>set deduction from state_config.standard_deduction_mfj</action_description>
<action_postfix>
state_config.standard_deduction_mfj cvi /taxpayer.deduction xdef
</action_postfix>
<action_column column_value="X" column_number="2"></action_column></action_details>
<action_details>
<action_number>3</action_number>
<action_comment>Deduction for HOH</action_comment>
<action_requirement></action_requirement>
<action_description>set deduction from state_config.standard_deduction_hoh</action_description>
<action_postfix>
state_config.standard_deduction_hoh cvi /taxpayer.deduction xdef
</action_postfix>
<action_column column_value="X" column_number="3"></action_column></action_details>
<action_details>
<action_number>4</action_number>
<action_comment>Exemptions: self only</action_comment>
<action_requirement></action_requirement>
<action_description>set exemptions = num_dependents + 1</action_description>
<action_postfix>
taxpayer.num_dependents 1 + /taxpayer.exemptions xdef
</action_postfix>
<action_column column_value="X" column_number="1"></action_column>
<action_column column_value="X" column_number="3"></action_column>
<action_column column_value="X" column_number="4"></action_column></action_details>
<action_details>
<action_number>5</action_number>
<action_comment>Exemptions: self + spouse</action_comment>
<action_requirement></action_requirement>
<action_description>set exemptions = num_dependents + 2</action_description>
<action_postfix>
taxpayer.num_dependents 2 + /taxpayer.exemptions xdef
</action_postfix>
<action_column column_value="X" column_number="2"></action_column></action_details></actions>
<policy_statements>
<policy_statement column="1">
<policy_description>Filing as Single</policy_description>
<policy_statement_postfix>&quot;Filing as Single: deduction $&quot; state_config.standard_deduction_single cvs strconcat &quot;, exemption $&quot; strconcat state_config.exemption_amount cvs strconcat</policy_statement_postfix></policy_statement>
<policy_statement column="2">
<policy_description>Filing as MFJ</policy_description>
<policy_statement_postfix>&quot;Filing as MFJ: deduction $&quot; state_config.standard_deduction_mfj cvs strconcat &quot;, exemption $&quot; strconcat state_config.exemption_amount cvs strconcat</policy_statement_postfix></policy_statement>
<policy_statement column="3">
<policy_description>Filing as HOH</policy_description>
<policy_statement_postfix>&quot;Filing as HOH: deduction $&quot; state_config.standard_deduction_hoh cvs strconcat &quot;, exemption $&quot; strconcat state_config.exemption_amount cvs strconcat</policy_statement_postfix></policy_statement>
<policy_statement column="4">
<policy_description>Unknown filing status, defaulting to Single</policy_description>
<policy_statement_postfix>&quot;Unknown filing status, defaulting to Single&quot; </policy_statement_postfix></policy_statement></policy_statements></decision_table>
<decision_table>
<table_name>Calculate_Taxable_Income</table_name>
<xls_file>StateTax_dt.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Computes taxable income = AGI - deduction - (exemptions * exemption_amount). Floors at zero.</COMMENTS>
<POLICY_REFERENCE></POLICY_REFERENCE></attribute_fields>
<contexts></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Check if taxable income is positive</condition_comment>
<condition_requirement></condition_requirement>
<condition_description>AGI - deduction - (exemptions * exemption_amount) &gt; 0</condition_description>
<condition_postfix>
taxpayer.agi taxpayer.deduction - taxpayer.exemptions state_config.exemption_amount * - 0 &gt;
</condition_postfix>
<condition_column column_value="Y" column_number="1"></condition_column>
<condition_column column_value="N" column_number="2"></condition_column></condition_details></conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Compute positive taxable income</action_comment>
<action_requirement></action_requirement>
<action_description>taxableIncome = AGI - deduction - (exemptions * exemption_amount)</action_description>
<action_postfix>
taxpayer.agi taxpayer.deduction - taxpayer.exemptions state_config.exemption_amount * - /taxpayer.taxableIncome xdef
</action_postfix>
<action_column column_value="X" column_number="1"></action_column></action_details>
<action_details>
<action_number>2</action_number>
<action_comment>Floor at zero</action_comment>
<action_requirement></action_requirement>
<action_description>set taxableIncome = 0</action_description>
<action_postfix>
0 /taxpayer.taxableIncome xdef
</action_postfix>
<action_column column_value="X" column_number="2"></action_column></action_details></actions>
<policy_statements>
<policy_statement column="1">
<policy_description>Taxable income computed</policy_description>
<policy_statement_postfix>&quot;Taxable income computed as AGI minus deductions and exemptions&quot; </policy_statement_postfix></policy_statement>
<policy_statement column="2">
<policy_description>Deductions exceed AGI</policy_description>
<policy_statement_postfix>&quot;Deductions and exemptions exceed AGI, taxable income set to $0&quot; </policy_statement_postfix></policy_statement></policy_statements></decision_table>
<decision_table>
<table_name>Apply_Flat_Tax</table_name>
<xls_file>StateTax_dt.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Applies a flat tax rate to taxable income. Rate comes from state_config.flat_rate_bps.</COMMENTS>
<POLICY_REFERENCE></POLICY_REFERENCE></attribute_fields>
<contexts></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Always apply</condition_comment>
<condition_requirement></condition_requirement>
<condition_description>perform when called</condition_description>
<condition_postfix>
perform when called
</condition_postfix>
<condition_column column_value="*" column_number="1"></condition_column></condition_details></conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Compute flat tax: taxableIncome * flat_rate_bps / 10000</action_comment>
<action_requirement></action_requirement>
<action_description>taxOwed = taxableIncome * flat_rate / 10000</action_description>
<action_postfix>
taxpayer.taxableIncome state_config.flat_rate_bps * 10000 / /taxpayer.taxOwed xdef
</action_postfix>
<action_column column_value="X" column_number="1"></action_column></action_details></actions>
<policy_statements></policy_statements></decision_table>
<decision_table>
<table_name>Select_And_Apply_Brackets</table_name>
<xls_file>StateTax_dt.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Selects the correct bracket array based on filing status and calls Apply_Bracket_Iteration</COMMENTS>
<POLICY_REFERENCE></POLICY_REFERENCE></attribute_fields>
<contexts></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>No taxable income</condition_comment>
<condition_requirement></condition_requirement>
<condition_description>taxpayer.taxableIncome &lt;= 0</condition_description>
<condition_postfix>
taxpayer.taxableIncome 0 &lt;=
</condition_postfix>
<condition_column column_value="Y" column_number="1"></condition_column></condition_details>
<condition_details>
<condition_number>2</condition_number>
<condition_comment>Single filer</condition_comment>
<condition_requirement></condition_requirement>
<condition_description>taxpayer.filing_status == SINGLE</condition_description>
<condition_postfix>
taxpayer.filing_status "SINGLE" streq
</condition_postfix>
<condition_column column_value="Y" column_number="2"></condition_column></condition_details>
<condition_details>
<condition_number>3</condition_number>
<condition_comment>Married Filing Jointly</condition_comment>
<condition_requirement></condition_requirement>
<condition_description>taxpayer.filing_status == MFJ</condition_description>
<condition_postfix>
taxpayer.filing_status "MFJ" streq
</condition_postfix>
<condition_column column_value="Y" column_number="3"></condition_column></condition_details>
<condition_details>
<condition_number>4</condition_number>
<condition_comment>HOH or default</condition_comment>
<condition_requirement></condition_requirement>
<condition_description>true</condition_description>
<condition_postfix>
true
</condition_postfix>
<condition_column column_value="Y" column_number="4"></condition_column></condition_details></conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>No tax on zero income</action_comment>
<action_requirement></action_requirement>
<action_description>set taxOwed = 0</action_description>
<action_postfix>
0 /taxpayer.taxOwed xdef
</action_postfix>
<action_column column_value="X" column_number="1"></action_column></action_details>
<action_details>
<action_number>2</action_number>
<action_comment>Use single brackets</action_comment>
<action_requirement></action_requirement>
<action_description>set active_brackets = brackets_single, reset guard, apply</action_description>
<action_postfix>
state_config.brackets_single /taxpayer.active_brackets xdef false cvb /taxpayer.bracket_applied xdef Apply_Bracket_Iteration
</action_postfix>
<action_column column_value="X" column_number="2"></action_column></action_details>
<action_details>
<action_number>3</action_number>
<action_comment>Use MFJ brackets</action_comment>
<action_requirement></action_requirement>
<action_description>set active_brackets = brackets_mfj, reset guard, apply</action_description>
<action_postfix>
state_config.brackets_mfj /taxpayer.active_brackets xdef false cvb /taxpayer.bracket_applied xdef Apply_Bracket_Iteration
</action_postfix>
<action_column column_value="X" column_number="3"></action_column></action_details>
<action_details>
<action_number>4</action_number>
<action_comment>Use HOH brackets (default)</action_comment>
<action_requirement></action_requirement>
<action_description>set active_brackets = brackets_hoh, reset guard, apply</action_description>
<action_postfix>
state_config.brackets_hoh /taxpayer.active_brackets xdef false cvb /taxpayer.bracket_applied xdef Apply_Bracket_Iteration
</action_postfix>
<action_column column_value="X" column_number="4"></action_column></action_details></actions>
<policy_statements></policy_statements></decision_table>
<decision_table>
<table_name>Apply_Bracket_Iteration</table_name>
<xls_file>StateTax_dt.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Iterates through tax brackets and applies the matching one. Uses bracket_applied guard to stop after first match. Brackets must be ordered lowest to highest.</COMMENTS>
<POLICY_REFERENCE></POLICY_REFERENCE></attribute_fields>
<contexts>
<context_details>
<context_number>1</context_number>
<context_comment>Iterate over active bracket array</context_comment>
<context_description>for all active_brackets</context_description>
<context_postfix>
dup active_brackets forall pop
</context_postfix></context_details></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Guard: only apply one bracket</condition_comment>
<condition_requirement></condition_requirement>
<condition_description>taxpayer.bracket_applied == false</condition_description>
<condition_postfix>
taxpayer.bracket_applied false beq
</condition_postfix>
<condition_column column_value="Y" column_number="1"></condition_column></condition_details>
<condition_details>
<condition_number>2</condition_number>
<condition_comment>Income falls within this bracket</condition_comment>
<condition_requirement></condition_requirement>
<condition_description>taxpayer.taxableIncome &lt;= bracket.ceiling</condition_description>
<condition_postfix>
taxpayer.taxableIncome bracket.ceiling &lt;=
</condition_postfix>
<condition_column column_value="Y" column_number="1"></condition_column></condition_details></conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Compute tax: base_tax + (taxableIncome - floor) * rate_bps / 10000</action_comment>
<action_requirement></action_requirement>
<action_description>taxOwed = base_tax + marginal tax for this bracket</action_description>
<action_postfix>
bracket.base_tax taxpayer.taxableIncome bracket.floor - bracket.rate_bps * 10000 / + /taxpayer.taxOwed xdef
