</action_details>
<action_details>
<action_number>5</action_number>
<action_comment>Compute taxable income</action_comment>
<action_dsl>Perform Calculate_Taxable_Income</action_dsl>
<action_postfix>
/Calculate_Taxable_Income performtable
</action_postfix>
<columns>-XX-</columns>
</action_details>
<action_details>
<action_number>6</action_number>
<action_comment>Apply flat tax rate</action_comment>
<action_dsl>Perform Apply_Flat_Tax</action_dsl>
<action_postfix>
/Apply_Flat_Tax performtable
</action_postfix>
<columns>-X--</columns>
</action_details>
<action_details>
<action_number>7</action_number>
<action_comment>Select brackets for filing status and apply progressive rates; Perform Select_And_Apply_Brackets</action_comment>
<action_dsl>perform Select_And_Apply_Brackets</action_dsl>
<action_postfix>
/Select_And_Apply_Brackets performtable
</action_postfix>
<columns>--X-</columns>
</action_details>
<action_details>
<action_number>8</action_number>
<action_comment>Build result entity</action_comment>
<action_dsl>Perform Evaluate_Results</action_dsl>
<action_postfix>
/Evaluate_Results performtable
</action_postfix>
<columns>XXXX</columns>
</action_details>
</actions>
<policy_statements>
<policy_statement column="1">
<policy_description>State {state_config.state_code} has no income tax, tax owed is $0</policy_description>
<policy_statement_postfix>"State " state_config.state_code cvs strconcat " has no income tax, tax owed is $0" strconcat</policy_statement_postfix>
</policy_statement>
<policy_statement column="2">
<policy_description>Computing flat-rate tax for {state_config.state_name}</policy_description>
<policy_statement_postfix>"Computing flat-rate tax for " state_config.state_name cvs strconcat "" strconcat</policy_statement_postfix>
</policy_statement>
<policy_statement column="3">
<policy_description>Computing progressive-bracket tax for {state_config.state_name}</policy_description>
<policy_statement_postfix>"Computing progressive-bracket tax for " state_config.state_name cvs strconcat "" strconcat</policy_statement_postfix>
</policy_statement>
<policy_statement column="4">
<policy_description>Unknown tax type: {state_config.tax_type}</policy_description>
<policy_statement_postfix>"Unknown tax type: " state_config.tax_type cvs strconcat "" strconcat</policy_statement_postfix>
</policy_statement>
</policy_statements>
</decision_table>

