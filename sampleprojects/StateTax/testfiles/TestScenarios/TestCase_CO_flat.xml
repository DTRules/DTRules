<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test Case: Colorado - Flat Tax (4.4%, federal standard deduction)
  State: CO, tax_type: flat, flat_rate_bps: 440
  std_ded: 15000/30000/22500, exemption: 0
  Taxpayer: $90,000 wages, SINGLE, 0 dependents
  Computation:
    totalIncome    = 90000
    stdDeduction   = 15000
    exemptions     = (1 + 0) * 0 = 0
    taxableIncome  = 90000 - 15000 - 0 = 75000
    tax = 75000 * 440 / 10000 = 33000000 / 10000 = 3300 (integer division)
  Expected: taxOwed = 3300
-->
<job>
  <tax_year>2025</tax_year>
  <state>CO</state>
  <state_config>
    <state_code>CO</state_code>
    <state_name>Colorado</state_name>
    <tax_type>flat</tax_type>
    <flat_rate_bps>440</flat_rate_bps>
    <standard_deduction_single>15000</standard_deduction_single>
    <standard_deduction_mfj>30000</standard_deduction_mfj>
    <standard_deduction_hoh>22500</standard_deduction_hoh>
    <exemption_amount>0</exemption_amount>
    <brackets_single></brackets_single>
    <brackets_mfj></brackets_mfj>
    <brackets_hoh></brackets_hoh>
  </state_config>
  <taxpayer>
    <taxpayer_ID>CO01</taxpayer_ID>
    <filing_status>SINGLE</filing_status>
    <num_dependents>0</num_dependents>
    <incomes>
      <income><type>WA</type><amount>90000</amount></income>
    </incomes>
    <adjustments></adjustments>
  </taxpayer>
</job>
