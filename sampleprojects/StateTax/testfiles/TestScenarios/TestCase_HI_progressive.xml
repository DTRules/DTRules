<!--
  Test Case: Hawaii - Progressive Tax (12 brackets, high rate)
  State: HI, tax_type: progressive
  std_ded: 4400/8800/6424, exemption: 1144
  Taxpayer: $95,000 wages, SINGLE, 0 dependents
  Computation:
    totalIncome    = 95000
    stdDeduction   = 4400
    exemptions     = (1 + 0) * 1144 = 1144
    taxableIncome  = 95000 - 4400 - 1144 = 89456

  Bracket base_tax computation (integer arithmetic):
    B1:  [0, 9600]          rate=140  base=0     width=9600  tax=9600*140/10000=134
    B2:  [9600, 14400]      rate=320  base=134   width=4800  tax=4800*320/10000=153
    B3:  [14400, 19200]     rate=550  base=287   width=4800  tax=4800*550/10000=264
    B4:  [19200, 24000]     rate=640  base=551   width=4800  tax=4800*640/10000=307
    B5:  [24000, 36000]     rate=680  base=858   width=12000 tax=12000*680/10000=816
    B6:  [36000, 48000]     rate=720  base=1674  width=12000 tax=12000*720/10000=864
    B7:  [48000, 125000]    rate=760  base=2538  width=77000 tax=77000*760/10000=5852
    B8:  [125000, 175000]   rate=790  base=8390  width=50000 tax=50000*790/10000=3950
    B9:  [175000, 225000]   rate=825  base=12340 width=50000 tax=50000*825/10000=4125
    B10: [225000, 275000]   rate=900  base=16465 width=50000 tax=50000*900/10000=4500
    B11: [275000, 325000]   rate=1000 base=20965 width=50000 tax=50000*1000/10000=5000
    B12: [325000, 999999999] rate=1100 base=25965

  taxableIncome=89456 falls in B7 [48000, 125000, 760, 2538]:
    tax = 2538 + (89456 - 48000) * 760 / 10000
        = 2538 + 41456 * 760 / 10000
        = 2538 + 31506560 / 10000
        = 2538 + 3150
        = 5688
  Expected: taxOwed = 5688
-->
