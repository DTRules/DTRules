<!--
  Test Case: Georgia - Flat Tax (5.19%)
  State: GA, tax_type: flat, flat_rate_bps: 519
  std_ded: 12000/24000/12000, exemption: 0
  Taxpayer: $80,000 wages, SINGLE, 0 dependents
