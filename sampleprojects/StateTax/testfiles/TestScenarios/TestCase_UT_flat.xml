<!-- Utah - Flat tax 4.55%
     Single, $91,000 wages, 0 dependents
     Taxable = 91000 - 0 - 0 = 91000
     Tax = 91000 * 455 / 10000 = 4140  (integer arithmetic: 91000*455=41405000, /10000=4140)
     Expected: taxOwed = $4,140
     Note: UT uses a credit not deduction; modeled with 0.
-->
<job>
  <tax_year>2025</tax_year>
  <state>UT</state>
  <state_config>
    <state_code>UT</state_code>
    <state_name>Utah</state_name>
    <tax_type>flat</tax_type>
    <flat_rate_bps>455</flat_rate_bps>
    <standard_deduction_single>0</standard_deduction_single>
    <standard_deduction_mfj>0</standard_deduction_mfj>
    <standard_deduction_hoh>0</standard_deduction_hoh>
    <exemption_amount>0</exemption_amount>
    <brackets_single></brackets_single>
    <brackets_mfj></brackets_mfj>
    <brackets_hoh></brackets_hoh>
  </state_config>
  <taxpayer>
    <taxpayer_ID>UT01</taxpayer_ID>
    <filing_status>SINGLE</filing_status>
    <num_dependents>0</num_dependents>
    <incomes>
      <income><type>WA</type><amount>91000</amount></income>
    </incomes>
    <adjustments></adjustments>
  </taxpayer>
</job>
