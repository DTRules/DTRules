<!-- TABLE 3010: Select_Medication -->
<decision_table el_compiled="true">
<source>
<relative_path>service1_medication.xlsx</relative_path>
<file_name>service1_medication.xlsx</file_name>
<sheet_number>2</sheet_number>
</source>
<table_name>Select_Medication</table_name>
<xls_file>service1_medication.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS></COMMENTS>
<TABLE_NUMBER>3010</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Penicillin allergy overrides age (beta-lactam cross-reactivity)</condition_comment>
<condition_dsl>patient.penicillin_allergic is true</condition_dsl>
<condition_postfix>
patient.penicillin_allergic true beq
</condition_postfix>
<condition_column column_number="1" column_value="Y" />
<condition_column column_number="2" column_value="N" />
<condition_column column_number="3" column_value="N" />
</condition_details>
<condition_details>
<condition_number>2</condition_number>
<condition_comment>Adult (&gt;= 18)</condition_comment>
<condition_dsl>patient.age &gt;= constants.adult_age</condition_dsl>
<condition_postfix>
patient.age constants.adult_age &gt;=
</condition_postfix>
<condition_column column_number="2" column_value="Y" />
<condition_column column_number="3" column_value="N" />
</condition_details>
</conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Fluoroquinolone for penicillin-allergic patients</action_comment>
<action_dsl>set result.recommended_drug = "Levofloxacin"</action_dsl>
<action_postfix>
"Levofloxacin" cvs /result.recommended_drug xdef
</action_postfix>
<action_column column_number="1" column_value="X" />
</action_details>
<action_details>
<action_number>2</action_number>
<action_comment>Adult first-line</action_comment>
<action_dsl>set result.recommended_drug = "Amoxicillin"</action_dsl>
<action_postfix>
"Amoxicillin" cvs /result.recommended_drug xdef
</action_postfix>
<action_column column_number="2" column_value="X" />
</action_details>
<action_details>
<action_number>3</action_number>
<action_comment>Pediatric first-line</action_comment>
<action_dsl>set result.recommended_drug = "Cefuroxime"</action_dsl>
<action_postfix>
"Cefuroxime" cvs /result.recommended_drug xdef
</action_postfix>
<action_column column_number="3" column_value="X" />
</action_details>
</actions>
<policy_statements></policy_statements>
</decision_table>

<!-- TABLE 3020: Determine_Dose -->
<decision_table el_compiled="true">
<source>
<relative_path>service1_medication.xlsx</relative_path>
<file_name>service1_medication.xlsx</file_name>
<sheet_number>3</sheet_number>
</source>
<table_name>Determine_Dose</table_name>
<xls_file>service1_medication.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS></COMMENTS>
<TABLE_NUMBER>3020</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Renal impairment: PCr &gt; 1.4 and CCr &lt; 50</condition_comment>
<condition_dsl>patient.pcr &gt; constants.renal_pcr_threshold and result.ccr &lt; constants.renal_ccr_threshold</condition_dsl>
<condition_postfix>
patient.pcr constants.renal_pcr_threshold f&gt; { pop result.ccr constants.renal_ccr_threshold f&lt; } over if
</condition_postfix>
<condition_column column_number="1" column_value="Y" />
<condition_column column_number="2" column_value="N" />
<condition_column column_number="3" column_value="N" />
</condition_details>
<condition_details>
<condition_number>2</condition_number>
<condition_comment>Standard-dose age band (15..60)</condition_comment>
<condition_dsl>patient.age &gt;= constants.dose_low_age and patient.age &lt;= constants.dose_high_age</condition_dsl>
<condition_postfix>
patient.age constants.dose_low_age &gt;= { pop patient.age constants.dose_high_age &lt;= } over if
</condition_postfix>
<condition_column column_number="2" column_value="Y" />
<condition_column column_number="3" column_value="N" />
</condition_details>
</conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Renal-reduced dose</action_comment>
<action_dsl>set result.dose_mg = constants.reduced_dose</action_dsl>
<action_postfix>
constants.reduced_dose cvi /result.dose_mg xdef
</action_postfix>
<action_column column_number="1" column_value="X" />
</action_details>
<action_details>
<action_number>2</action_number>
<action_comment>Standard dose for 15..60</action_comment>
<action_dsl>set result.dose_mg = constants.standard_dose</action_dsl>
<action_postfix>
constants.standard_dose cvi /result.dose_mg xdef
</action_postfix>
<action_column column_number="2" column_value="X" />
</action_details>
<action_details>
<action_number>3</action_number>
<action_comment>Reduced dose for &lt;15 or &gt;60</action_comment>
<action_dsl>set result.dose_mg = constants.reduced_dose</action_dsl>
<action_postfix>
constants.reduced_dose cvi /result.dose_mg xdef
</action_postfix>
<action_column column_number="3" column_value="X" />
</action_details>
<action_details>
<action_number>4</action_number>
<action_comment>Flag the renal adjustment</action_comment>
<action_dsl>set result.renal_adjustment = true</action_dsl>
<action_postfix>
true cvb /result.renal_adjustment xdef
</action_postfix>
<action_column column_number="1" column_value="X" />
</action_details>
<action_details>
<action_number>5</action_number>
<action_comment>Dosing interval (hours)</action_comment>
<action_dsl>set result.frequency_hours = constants.dosing_interval_hours</action_dsl>
<action_postfix>
constants.dosing_interval_hours cvi /result.frequency_hours xdef
</action_postfix>
<action_column column_number="1" column_value="X" />
<action_column column_number="2" column_value="X" />
<action_column column_number="3" column_value="X" />
</action_details>
<action_details>
<action_number>6</action_number>
<action_comment>Therapy duration (days)</action_comment>
<action_dsl>set result.duration_days = constants.therapy_duration_days</action_dsl>
<action_postfix>
constants.therapy_duration_days cvi /result.duration_days xdef
</action_postfix>
<action_column column_number="1" column_value="X" />
<action_column column_number="2" column_value="X" />
<action_column column_number="3" column_value="X" />
</action_details>
</actions>
