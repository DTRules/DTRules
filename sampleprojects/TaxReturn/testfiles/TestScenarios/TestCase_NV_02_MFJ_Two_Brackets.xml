   <!-- NV Test Case 2: Married Filing Jointly in Two Brackets -->
   <id>NV-02</id>
   <tax_year>2025</tax_year>
   <filing_status>married_filing_jointly</filing_status>
   <state>NV</state>
   <city>Reno</city>
   <has_state_income_tax>true</has_state_income_tax>

   <!-- Expected values for validation -->
   <!-- Federal AGI: $180,000 -->
   <!-- NV AGI: $180,000 -->
   <!-- NV Standard Deduction: $15,000 (MFJ) -->
   <!-- NV Taxable Income: $165,000 -->
   <!-- Bracket 1: $100,000 × 2.5% = $2,500 -->
   <!-- Bracket 2: $65,000 × 4.0% = $2,600 -->
   <!-- Total NV Tax: $5,100 (spans two brackets, under $240,000 threshold) -->
   <expected_agi>180000</expected_agi>
   <expected_nv_agi>180000</expected_nv_agi>
   <expected_nv_taxable_income>165000</expected_nv_taxable_income>
   <expected_nv_tax>5100</expected_nv_tax>

   <!-- Taxpayers -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Michael Chen</name>
         <ssn>222-33-5555</ssn>
         <date_of_birth>8/12/1985</date_of_birth>
         <occupation>Software Engineer</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>110000</w2_wages>
         <w2_withholding>20000</w2_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
      <taxpayer id="2">
         <id>2</id>
         <name>Lisa Chen</name>
         <ssn>222-33-6666</ssn>
         <date_of_birth>4/25/1987</date_of_birth>
         <occupation>Marketing Manager</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>false</is_primary>
         <w2_wages>70000</w2_wages>
         <w2_withholding>12000</w2_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- Incomes -->
   <incomes>
      <income id="1">
         <id>1</id>
