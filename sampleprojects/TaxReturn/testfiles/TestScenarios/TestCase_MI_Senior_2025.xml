   <!-- Michigan Senior Taxpayer with Retirement Income Test Case -->
   <id>103</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>MI</state>
   <city>Grand Rapids</city>

   <!-- Test Case 3: MFJ, seniors age 67+ with retirement income -->
   <!-- Income: $30,000 W-2 wages + $50,000 retirement = $80,000 -->
   <!-- Federal AGI: $80,000 -->
   <!-- MI Personal Exemptions: $5,800 * 2 = $11,600 -->
   <!-- MI Standard Deduction (age 67+): $40,000 -->
   <!-- MI Retirement Subtraction: $40,000 (limited) -->
   <!-- MI Taxable Income: $80,000 - $11,600 - $40,000 - $40,000 = $0 (but we subtract retirement from income first) -->
   <!-- Actually: $80,000 - $40,000 retirement subtraction - $40,000 std deduction - $11,600 exemptions -->
   <!-- MI Taxable Income: max(0, $80,000 - $40,000 - $40,000 - $11,600) = $0 -->
   <!-- MI Tax: $0 * 0.0425 = $0 -->
   <expected_agi>80000</expected_agi>
   <expected_mi_state_tax>0</expected_mi_state_tax>

   <!-- Taxpayers - Both over 67 -->
