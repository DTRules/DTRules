   <!-- MO Standard Deduction: $31,500 (MFJ) -->
   <!-- MO Taxable Income: $43,500 -->
   <!-- MO Tax Calculation (cumulative through all 8 brackets):
        - Bracket 1 (0% on $0-$1,313): $0
        - Bracket 2 (2% on $1,314-$2,626): $1,313 × 2% = $26.26
        - Bracket 3 (2.5% on $2,627-$3,939): $1,313 × 2.5% = $32.83
        - Bracket 4 (3% on $3,940-$5,252): $1,313 × 3% = $39.39
        - Bracket 5 (3.5% on $5,253-$6,565): $1,313 × 3.5% = $45.96
        - Bracket 6 (4% on $6,566-$7,878): $1,313 × 4% = $52.52
        - Bracket 7 (4.5% on $7,879-$9,191): $1,313 × 4.5% = $59.09
        - Bracket 8 (4.7% on $9,192-$43,500): $34,309 × 4.7% = $1,612.52
        Total: $1,868.57
   -->
   <expected_agi>75000</expected_agi>
   <expected_mo_agi>75000</expected_mo_agi>
   <expected_mo_taxable_income>43500</expected_mo_taxable_income>
   <expected_mo_tax>1868.57</expected_mo_tax>

