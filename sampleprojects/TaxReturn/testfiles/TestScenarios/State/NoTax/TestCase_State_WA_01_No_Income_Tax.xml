   <!--
   =====================================================================
   WASHINGTON (WA) - NO STATE INCOME TAX TEST CASE
   =====================================================================

   Washington has NO state income tax on any type of income:
   - W-2 wages: NOT TAXED
   - Stock compensation (RSUs): NOT TAXED
   - Capital gains: NOT TAXED (except 7% capital gains tax on high-earners)
   - All other income types: NOT TAXED

   Washington is one of 9 states with no personal income tax.

   Special Note - Capital Gains Tax:
   Washington enacted a 7% capital gains tax in 2022, but it applies
   only to long-term capital gains exceeding $250,000 per year.
   This is NOT a general income tax.

   This test case validates tech worker with high W-2 and RSUs:
   - High W-2 base salary ($180,000) is NOT taxed
   - RSU income ($50,000) is NOT taxed
   - State tax = $0 for stock compensation

   Income breakdown:
   - W-2 base salary: $180,000
   - RSU vesting (reported on W-2): $50,000
   - Total W-2 wages: $230,000

   Expected Results:
   - Federal AGI: $230,000
   - Federal Taxable: ~$215,000 (after standard deduction)
   - Federal Tax: ~$48,500 (approximate)
   - WA State Tax: $0 (no income tax)

   Note: RSUs are taxed as ordinary income federally when they vest,
   but Washington has no income tax on compensation income.
   =====================================================================
   -->

   <id>WA-NoTax-01</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>WA</state>
   <city>Seattle</city>

   <!-- Expected Values for Validation -->
   <!-- Itemizing beats the $15,750 single standard deduction: $23,000 charitable
         + $28,000 mortgage interest (balance $600,000, under the $750,000
         acquisition-debt limit) + $9,500 SALT, which is property tax alone
         because Washington levies no income tax. 230,000 - 60,500 = 169,500.
         Previously assumed the standard deduction (#1161). -->
   <expected_agi>230000</expected_agi>
   <expected_taxable_income>169500</expected_taxable_income>
   <expected_federal_tax>48500</expected_federal_tax>
   <expected_state_tax>0</expected_state_tax>
   <expected_total_tax>33797</expected_total_tax>

   <!-- Tech Worker - Washington Resident -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Emily Chen</name>
         <ssn>999-00-1111</ssn>
         <date_of_birth>10/30/1988</date_of_birth>
         <occupation>Software Engineer</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>230000</w2_wages>
         <w2_stock_comp>50000</w2_stock_comp>
         <w2_withholding>55000</w2_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents>
   </dependents>

   <!-- Property (primary residence in Seattle) -->
   <properties>
      <property id="1">
         <id>1</id>
         <type>primary_residence</type>
         <address>456 Pine Avenue, Seattle, WA 98101</address>
         <purchase_date>6/1/2021</purchase_date>
         <purchase_price>750000</purchase_price>
         <current_fmv>925000</current_fmv>
         <mortgage_balance>600000</mortgage_balance>
         <mortgage_origination_date>6/1/2021</mortgage_origination_date>
         <mortgage_interest>28000</mortgage_interest>
         <property_taxes>9500</property_taxes>
         <rental_income>0</rental_income>
         <rental_expenses>0</rental_expenses>
         <depreciation>0</depreciation>
      </property>
   </properties>

   <!-- No vehicles -->
   <vehicles>
   </vehicles>

   <!-- Deductions (for itemizing) -->
   <deductions>
      <deduction id="1">
         <id>1</id>
         <category>charity</category>
         <description>Tech for Good foundation</description>
         <amount>18000</amount>
      </deduction>
      <deduction id="2">
         <id>2</id>
         <category>charity</category>
         <description>Local food bank</description>
         <amount>5000</amount>
      </deduction>
   </deductions>
