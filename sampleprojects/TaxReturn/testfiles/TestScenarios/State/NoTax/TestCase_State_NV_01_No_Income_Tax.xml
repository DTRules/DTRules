   <!--
   =====================================================================
   NEVADA (NV) - NO STATE INCOME TAX TEST CASE
   =====================================================================

   Nevada has NO state income tax on any type of income:
   - W-2 wages: NOT TAXED
   - Tips (common in hospitality/casino industry): NOT TAXED
   - Self-employment income: NOT TAXED
   - All other income types: NOT TAXED

   Nevada is one of 9 states with no personal income tax.
   The state relies heavily on gaming/casino taxes and sales tax.

   This test case validates:
   - W-2 wages ($42,000) are NOT taxed
   - Tip income ($18,000) is NOT taxed
   - State tax = $0 for casino employee with substantial tips

   Income breakdown:
   - W-2 base wages: $42,000
   - Tips (reported): $18,000
   - Total W-2 income: $60,000

   Expected Results:
   - Federal AGI: $60,000
   - Federal Taxable: ~$45,000 (after standard deduction)
   - Federal Tax: ~$5,000 (approximate)
   - NV State Tax: $0 (no income tax)

   Note: Tips are fully taxable for federal purposes but not for Nevada
   state tax (because Nevada has no income tax on any income).
   =====================================================================
   -->

   <id>NV-NoTax-01</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>NV</state>
   <city>Las Vegas</city>

   <!-- Expected Values for Validation -->
   <expected_agi>60000</expected_agi>
   <expected_taxable_income>45000</expected_taxable_income>
   <expected_federal_tax>5000</expected_federal_tax>
   <expected_state_tax>0</expected_state_tax>
   <expected_total_tax>5000</expected_total_tax>

   <!-- Casino Employee - Nevada Resident -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Maria Rodriguez</name>
         <ssn>333-44-5555</ssn>
         <date_of_birth>11/5/1992</date_of_birth>
         <occupation>Casino Dealer</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>60000</w2_wages>
         <w2_tips>18000</w2_tips>
         <w2_withholding>6000</w2_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents>
   </dependents>

   <!-- No properties -->
   <properties>
   </properties>

   <!-- No vehicles -->
   <vehicles>
   </vehicles>

   <!-- No deductions -->
   <deductions>
   </deductions>
</job>
