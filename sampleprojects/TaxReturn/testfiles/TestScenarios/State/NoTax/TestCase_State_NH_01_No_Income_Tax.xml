   <!--
   =====================================================================
   NEW HAMPSHIRE (NH) - NO WAGE INCOME TAX TEST CASE
   =====================================================================

   New Hampshire has NO tax on wages or self-employment income:
   - W-2 wages: NOT TAXED
   - Self-employment income: NOT TAXED
   - Capital gains: NOT TAXED

   HOWEVER, New Hampshire DOES tax interest and dividends:
   - Interest &amp; Dividends Tax: 3% in 2025 (being phased out)
   - Phase-out schedule:
     * 2023 and earlier: 5%
     * 2024: 4%
     * 2025: 3%
     * 2026+: 0% (full repeal)

   This test case validates W-2 income is NOT taxed:
   - W-2 wages ($85,000) are NOT taxed
   - No investment income in this test
   - State tax = $0 for wage earners

   Income breakdown:
   - W-2 wages only: $85,000
   - No interest or dividends

   Expected Results:
   - Federal AGI: $85,000
   - Federal Taxable: ~$70,000 (after standard deduction)
   - Federal Tax: ~$11,500 (approximate)
   - NH State Tax: $0 (no tax on wages)

   Note: See TestCase_NH_02_Dividends_Taxed for testing the 3% tax
   on interest and dividend income.
   =====================================================================
   -->

   <id>NH-NoTax-01</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>NH</state>
   <city>Manchester</city>

   <!-- Expected Values for Validation -->
   <expected_agi>85000</expected_agi>
   <expected_taxable_income>69250</expected_taxable_income>
   <expected_federal_tax>11500</expected_federal_tax>
   <expected_state_tax>0</expected_state_tax>
   <expected_total_tax>10149</expected_total_tax>

   <!-- Single Filer - New Hampshire Resident -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>David Wilson</name>
         <ssn>444-55-6666</ssn>
         <date_of_birth>2/14/1985</date_of_birth>
         <occupation>Software Developer</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>85000</w2_wages>
         <w2_withholding>12000</w2_withholding>
         <interest_income>0</interest_income>
         <dividend_income>0</dividend_income>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents>
   </dependents>

   <!-- No properties -->
   <properties>
