   <!-- Oregon military retirement test case (OR-MIL-02). -->
   <!-- Oregon has no military retirement subtraction for 2025; Schedule OR-ASC code 307 subtracts only -->
   <!-- the share of a federal pension earned before October 1, 1991 (ORS 316.680(1)(e); 2025 -->
   <!-- Publication OR-17 p. 73). The service dates the former heading assumed (1985 to 2005) are not -->
   <!-- inputs of the scenario, so no subtraction can be worked; see SPEC 2.9. -->

   <id>OR-MIL-02</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>OR</state>
   <city>Eugene</city>

   <!-- Expected values for validation (2025), worked from the inputs and the 2025 forms,
        never from what the rules print (#1330). expected_total_tax is the federal tax (Form 1040 line 24); the state's own tax is
        checked separately through expected_state_tax, and expected_refund is
        withholding less the federal tax. -->
   <!-- Federal (2025 Form 1040): line 1a wages $30,000 + line 5b military retired pay $50,000 (taxable: IRC 61(a)(10); Pub. 525,
        Military retirement pay) = AGI $80,000.
        Standard deduction $15,750 (Single, 2025, OBBBA).
        Taxable income $64,250.
        Tax (2025 Single brackets): 1,192.50 + 12% x 36,550 + 22% x 15,775 = 5,578.50 + 3,470.50 = $9,049.00.
        Withholding $14,000 less tax $9,049.00 = refund $4,951.00. -->
   <!-- Oregon (2025 Form OR-40): line 7 federal AGI $80,000; line 10 federal tax subtraction = lesser
        of $9,049 and the $8,500 cap = $8,500; line 13 subtractions $0; line 15 $71,500; line 17
        standard deduction $2,835 (Single, 2025); line 19 taxable income $68,665; line 20 tax (rate
        chart S): 4,065 + 8.75% x 18,665 = $5,698.19, whole dollars $5,698; line 25 exemption credit
        $256; line 27 retirement income credit $0 (under 62). Line 29 Oregon tax $5,442.
        OR_Tax is a #1200 placeholder and computes $7,648.25; the state check fails until #1200
        rebuilds Oregon. -->
   <!-- expected_state_tax was an approximate $4,600 after a 30% exemption from assumed service dates (#1330). -->
   <expected_agi>80000</expected_agi>
   <expected_taxable_income>64250</expected_taxable_income>
   <expected_total_tax>9049</expected_total_tax>
   <expected_state_tax>5442</expected_state_tax>
   <expected_refund>4951</expected_refund>

   <!-- Retired Military Taxpayer (Served 1985-2005, mixed service) -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Linda</name>
         <last_name>Williams</last_name>
         <ssn>333-44-5566</ssn>
         <date_of_birth>4/22/1965</date_of_birth>
         <occupation>Military Retiree - Office Manager</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>30000</w2_wages>
         <w2_withholding>14000</w2_withholding>
         <military_retirement_pay>50000</military_retirement_pay>
         <is_senior>false</is_senior>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions -->
   <deductions></deductions>
</job>
