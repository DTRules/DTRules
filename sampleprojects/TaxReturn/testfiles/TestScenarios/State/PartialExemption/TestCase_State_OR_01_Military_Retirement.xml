   <!-- Oregon Military Retirement Test Case -->
   <!-- Test Case OR-Military-01: Service before Oct 1, 1991 (fully exempt) -->
   <!-- OR provides full exemption for military service before Oct 1, 1991 -->
   <!-- This taxpayer served 1971-1991 (all service before cutoff date) -->

   <id>OR-MIL-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>OR</state>
   <city>Portland</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $40,000 military retirement + $35,000 W2 = $75,000 -->
   <!-- AGI: $75,000 -->
   <!-- Federal Standard Deduction: $15,000 (Single) -->
   <!-- Federal Taxable Income: $60,000 -->
   <!-- Federal Tax: ~$7,900 -->
   <!-- OR: Progressive tax (4.75% to 9.9%) -->
   <!-- OR Standard Deduction: $2,745 (single) -->
   <!-- OR Personal Exemption: $239 -->
   <!-- OR Military Retirement Exemption: $40,000 (100% - all service before 1991) -->
   <!-- OR Taxable Income: $35,000 - $2,745 - $239 = $32,016 -->
   <!-- OR Tax (progressive brackets): ~$2,400 -->
   <!-- Total Tax: $10,300 -->
   <!-- Withholding: $11,000 -->
   <!-- Refund: $700 -->
   <expected_agi>75000</expected_agi>
   <expected_taxable_income>60000</expected_taxable_income>
   <expected_total_tax>10300</expected_total_tax>
   <expected_state_tax>2400</expected_state_tax>
   <expected_refund>700</expected_refund>

