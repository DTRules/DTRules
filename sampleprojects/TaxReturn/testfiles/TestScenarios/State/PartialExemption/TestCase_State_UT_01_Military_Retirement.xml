   <!-- Utah military retirement test case (UT-MIL-01). -->
   <!-- Utah gives no exemption for military retirement pay; the relief is the military retirement -->
   <!-- credit, TC-40A Part 3 code AJ, a nonrefundable 4.5% of the pay included in AGI (Utah Code -->
   <!-- 59-10-1043; 2025 TC-40 instructions p. 21-22), which combines with the taxpayer tax credit -->
   <!-- (TC-40 lines 11 to 20: 6% of the federal deduction plus $2,111 per dependent, less 1.3% of -->
   <!-- taxable income over $18,213 single). The former heading's $10,000 exemption with AGI caps is -->
   <!-- not Utah law. -->

   <id>UT-MIL-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>UT</state>
   <city>Salt Lake City</city>

   <!-- Expected values for validation (2025), worked from the inputs and the 2025 forms,
        never from what the rules print (#1330). expected_total_tax is the federal tax (Form 1040 line 24); the state's own tax is
        checked separately through expected_state_tax, and expected_refund is
        withholding less the federal tax. -->
   <!-- Federal (2025 Form 1040): line 1a wages $25,000 + line 5b military retired pay $20,000 (taxable: IRC 61(a)(10); Pub. 525,
        Military retirement pay) = AGI $45,000.
        Standard deduction $15,750 (Single, 2025, OBBBA).
        Taxable income $29,250.
        Tax (2025 Single brackets): 1,192.50 + 12% x 17,325 = $3,271.50.
        Withholding $5,500 less tax $3,271.50 = refund $2,228.50. -->
   <!-- Utah (2025 Form TC-40): line 9 Utah taxable income $45,000 (federal AGI; the standard
        deduction is not subtracted); line 10 tax 4.5% = $2,025.00; line 16 6% x (0 + $15,750) =
        $945.00; line 19 phase-out 1.3% x ($45,000 - $18,213) = $348.23; line 20 taxpayer tax credit
        $596.77; line 22 $1,428.23; TC-40A Part 3 code AJ military retirement credit 4.5% x $20,000 =
        $900.00; line 25 tax after nonrefundable credits $528.23 (the form rounds to $528). Utah tax $528.23. -->
   <!-- expected_state_tax was $1,593: 4.55% (the 2024 rate) of AGI less a $10,000 exemption, with neither
        Utah credit (#1330). -->
   <expected_agi>45000</expected_agi>
   <expected_taxable_income>29250</expected_taxable_income>
   <expected_total_tax>3271.5</expected_total_tax>
   <expected_state_tax>528.23</expected_state_tax>
   <expected_refund>2228.5</expected_refund>

   <!-- Retired Military Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Karen</name>
         <last_name>Taylor</last_name>
         <ssn>444-55-6677</ssn>
         <date_of_birth>9/10/1970</date_of_birth>
         <occupation>Military Retiree - Part Time Sales</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>25000</w2_wages>
         <w2_withholding>5500</w2_withholding>
         <military_retirement_pay>20000</military_retirement_pay>
         <is_senior>false</is_senior>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions -->
   <deductions></deductions>
</job>
