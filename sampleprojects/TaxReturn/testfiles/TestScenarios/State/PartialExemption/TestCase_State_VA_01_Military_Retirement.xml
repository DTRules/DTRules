   <!-- Virginia military retirement test case (VA-MIL-01). -->
   <!-- Military Benefits Subtraction, Schedule ADJ code 60: up to $40,000 of military retirement income -->
   <!-- per individual for taxable year 2025 and after, any age (the age-55 test applied only to 2022 -->
   <!-- to 2024) (Va. Code 58.1-322.02(18); 2025 Form 760 instructions p. 20). -->

   <id>VA-MIL-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>VA</state>
   <city>Richmond</city>

   <!-- Expected values for validation (2025), worked from the inputs and the 2025 forms,
        never from what the rules print (#1330). expected_total_tax is the federal tax (Form 1040 line 24); the state's own tax is
        checked separately through expected_state_tax, and expected_refund is
        withholding less the federal tax. -->
   <!-- Federal (2025 Form 1040): line 1a wages $48,000 + line 5b military retired pay $36,000 (taxable: IRC 61(a)(10); Pub. 525,
        Military retirement pay) = AGI $84,000.
        Standard deduction $15,750 (Single, 2025, OBBBA).
        Taxable income $68,250.
        Tax (2025 Single brackets): 1,192.50 + 12% x 36,550 + 22% x 19,775 = 5,578.50 + 4,350.50 = $9,929.00.
        Withholding $14,500 less tax $9,929.00 = refund $4,571.00. -->
   <!-- Virginia (2025 Form 760): line 1 federal AGI $84,000; Schedule ADJ code 60 = lesser of $36,000
        and $40,000 = $36,000 (line 7, line 8); line 9 VAGI $48,000; line 11 standard deduction $8,750
        (Single, 2025); line 12 exemption $930 x 1; line 15 taxable income $38,320; line 16 tax (rate
        schedule): 720 + 5.75% x 21,320 = $1,945.90, whole dollars $1,946 (the tax table's row $38,287
        to $38,322 prints $1,945). Line 23 low-income credit $0 (VAGI over $15,650). Virginia tax $1,946.
        VA_Tax is a #1200 placeholder (5.75% of VAGI less $8,500) and computes $2,271.25; the state
        check fails until #1200 rebuilds Virginia. -->
   <!-- expected_state_tax was an approximate $4,000 after a $10,000 subtraction, the 2023 figure (#1330). -->
   <expected_agi>84000</expected_agi>
   <expected_taxable_income>68250</expected_taxable_income>
   <expected_total_tax>9929</expected_total_tax>
   <expected_state_tax>1946</expected_state_tax>
   <expected_refund>4571</expected_refund>

   <!-- Retired Military Taxpayer (Age 62) -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Mark</name>
         <last_name>Lewis</last_name>
         <ssn>777-88-9900</ssn>
         <date_of_birth>6/28/1963</date_of_birth>
         <occupation>Military Retiree - Government Contractor</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>48000</w2_wages>
         <w2_withholding>14500</w2_withholding>
         <military_retirement_pay>36000</military_retirement_pay>
         <is_senior>false</is_senior>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions -->
   <deductions></deductions>
</job>
