   <!-- Vermont Military Retirement Test Case -->
   <!-- Test Case VT-Military-01: Military retirement with income-based exclusion -->
   <!-- VT provides income-based exclusion for military retirement -->
   <!-- Specific rules vary based on AGI thresholds -->

   <id>VT-MIL-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>VT</state>
   <city>Burlington</city>

