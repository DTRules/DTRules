   <!-- Maryland Military Retirement Test Case -->
   <!-- Test Case MD-Military-02: Military retiree age 60 ($20,000 exemption at age 55+) -->
   <!-- MD provides age-based military retirement exemptions: -->
   <!-- Under age 55: First $12,500 exempt -->
   <!-- Age 55+: First $20,000 exempt -->
   <!-- This test uses age 60 (born 1965) = $20,000 exemption -->

   <id>MD-MIL-02</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>MD</state>
   <city>Annapolis</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $35,000 military retirement + $45,000 W2 = $80,000 -->
   <!-- AGI: $80,000 -->
   <!-- Federal Standard Deduction: $15,000 (Single) -->
   <!-- Federal Taxable Income: $65,000 -->
   <!-- Federal Tax: ~$8,700 -->
   <!-- MD: Progressive tax (up to 5.75%) -->
   <!-- MD Military Retirement Exemption: $20,000 (age 55+) -->
   <!-- MD Taxable Retirement: $35,000 - $20,000 = $15,000 -->
   <!-- MD Taxable Income: $15,000 + $45,000 = $60,000 -->
   <!-- MD Tax (progressive brackets): ~$3,400 -->
   <!-- Total Tax: $12,100 -->
   <!-- Withholding: $13,000 -->
   <!-- Refund: $900 -->
   <expected_agi>80000</expected_agi>
   <expected_taxable_income>65000</expected_taxable_income>
   <expected_total_tax>12100</expected_total_tax>
   <expected_state_tax>3400</expected_state_tax>
   <expected_refund>900</expected_refund>

   <!-- Retired Military Taxpayer (Age 60) -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>David</name>
         <last_name>Garcia</last_name>
         <ssn>999-00-1111</ssn>
         <date_of_birth>7/22/1965</date_of_birth>
         <occupation>Military Retiree - Defense Contractor</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>45000</w2_wages>
         <w2_withholding>13000</w2_withholding>
         <military_retirement_pay>35000</military_retirement_pay>
         <is_senior>false</is_senior>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions -->
   <deductions></deductions>
</job>
