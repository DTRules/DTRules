   <!-- Utah Military Retirement Test Case -->
   <!-- Test Case UT-Military-02: Military retirement with AGI $55,000 single (partial exemption - phased out) -->
   <!-- UT provides income-based retirement credit: -->
   <!-- Single: AGI up to $47,500 = $10,000 exemption -->
   <!-- Single: AGI $47,500-$67,500 = phased out (linear) -->
   <!-- Single: AGI over $67,500 = no exemption -->
   <!-- This test uses AGI $55,000 (in phaseout range) -->
   <!-- Phaseout calculation: ($55,000 - $47,500) / ($67,500 - $47,500) = $7,500 / $20,000 = 37.5% phased out -->
   <!-- Exemption: $10,000 * (1 - 0.375) = $6,250 -->

   <id>UT-MIL-02</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>UT</state>
   <city>Provo</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $28,000 military retirement + $27,000 W2 = $55,000 -->
   <!-- AGI: $55,000 (in phaseout range) -->
   <!-- Federal Standard Deduction: $15,000 (Single) -->
   <!-- Federal Taxable Income: $40,000 -->
   <!-- Federal Tax: ~$4,650 -->
   <!-- UT: Flat 4.55% tax rate (2025) -->
   <!-- UT Military Retirement Exemption: $6,250 (partial - phased out) -->
   <!-- UT Taxable Retirement: $28,000 - $6,250 = $21,750 -->
   <!-- UT Taxable Income: $21,750 + $27,000 = $48,750 -->
   <!-- UT Tax: $48,750 * 0.0455 = $2,218 -->
   <!-- Total Tax: $6,868 -->
   <!-- Withholding: $7,500 -->
   <!-- Refund: $632 -->
   <expected_agi>55000</expected_agi>
   <expected_taxable_income>40000</expected_taxable_income>
   <expected_total_tax>6868</expected_total_tax>
   <expected_state_tax>2218</expected_state_tax>
   <expected_refund>632</expected_refund>

   <!-- Retired Military Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Steven</name>
         <last_name>Harris</last_name>
         <ssn>555-66-7788</ssn>
         <date_of_birth>11/3/1968</date_of_birth>
         <occupation>Military Retiree - Warehouse Supervisor</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>27000</w2_wages>
         <w2_withholding>7500</w2_withholding>
         <military_retirement_pay>28000</military_retirement_pay>
         <is_senior>false</is_senior>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions -->
   <deductions></deductions>
