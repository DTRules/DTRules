   <!-- Colorado military retirement test case (CO-MIL-01). -->
   <!-- DR 0104 starts from federal taxable income (line 1). A retired servicemember 54 or younger -->
   <!-- subtracts up to $15,000 of military retirement benefits (DR 0104AD line 7; C.R.S. 39-22-104(4)(y)); -->
   <!-- at 55 to 64 the pension and annuity subtraction applies instead, up to $20,000, and at 65 or -->
   <!-- older up to $24,000 (DR 0104AD line 4; C.R.S. 39-22-104(4)(f); 2025 104 Book p. 19). -->

   <id>CO-MIL-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>CO</state>
   <city>Colorado Springs</city>

   <!-- Expected values for validation (2025), worked from the inputs and the 2025 forms,
        never from what the rules print (#1330). expected_total_tax is the federal tax (Form 1040 line 24); the state's own tax is
        checked separately through expected_state_tax, and expected_refund is
        withholding less the federal tax. -->
   <!-- Federal (2025 Form 1040): line 1a wages $25,000 + line 5b military retired pay $38,000 (taxable: IRC 61(a)(10); Pub. 525,
        Military retirement pay) = AGI $63,000.
        Standard deduction $15,750 (Single, 2025, OBBBA).
        Taxable income $47,250.
        Tax (2025 Single brackets): 1,192.50 + 12% x 35,325 = $5,431.50.
        Withholding $8,500 less tax $5,431.50 = refund $3,068.50. -->
   <!-- Colorado (2025 Form DR 0104): line 1 federal taxable income $47,250; DR 0104AD line 4 pension
        and annuity subtraction at age 62 (born 3/15/1963) = lesser of $20,000 and $38,000 = $20,000
        (line 7's $15,000 is for taxpayers under 55); line 12 Colorado taxable income $27,250; line 13
        tax 4.4% (2025 104 Book tax table row $27,200 to $27,300: $1,199) = $1,199.00. The TABOR state
        sales tax refund ($25, line 38) is a refundable payment, not part of the tax. Colorado tax $1,199. -->
   <!-- expected_state_tax was $1,892, 4.4% of federal AGI less the subtraction: Colorado taxes federal
        taxable income, so the $15,750 standard deduction was left out (#1330). -->
   <expected_agi>63000</expected_agi>
   <expected_taxable_income>47250</expected_taxable_income>
   <expected_total_tax>5431.5</expected_total_tax>
   <expected_state_tax>1199</expected_state_tax>
   <expected_refund>3068.5</expected_refund>

   <!-- Retired Military Taxpayer (Age 62) -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Robert</name>
         <last_name>Thompson</last_name>
         <ssn>222-33-4444</ssn>
         <date_of_birth>3/15/1963</date_of_birth>
         <occupation>Military Retiree - Security Guard</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>25000</w2_wages>
         <w2_withholding>8500</w2_withholding>
         <military_retirement_pay>38000</military_retirement_pay>
         <is_senior>false</is_senior>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions -->
   <deductions></deductions>
</job>
