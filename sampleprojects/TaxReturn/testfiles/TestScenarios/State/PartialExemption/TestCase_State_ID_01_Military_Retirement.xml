   <!-- Idaho military retirement test case (ID-MIL-01). -->
   <!-- Idaho has no unconditional military retirement exemption. Retired pay is a qualifying benefit -->
   <!-- for the retirement benefits deduction, Form 39R Part B line 8, when the retiree is 62 or older, -->
   <!-- disabled, or under 62 and employed with enough income to have to file a federal return -->
   <!-- (Idaho Code 63-3022A(1)(b); 2025 Form 39R instructions p. 31). The deduction is capped at -->
   <!-- $48,216 single ($72,324 joint) less Social Security received. The 2025 rate is 5.3% (HB 40). -->

   <id>ID-MIL-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>ID</state>
   <city>Boise</city>

   <!-- Expected values for validation (2025), worked from the inputs and the 2025 forms,
        never from what the rules print (#1330). expected_total_tax is the federal tax (Form 1040 line 24); the state's own tax is
        checked separately through expected_state_tax, and expected_refund is
        withholding less the federal tax. -->
   <!-- Federal (2025 Form 1040): line 1a wages $38,000 + line 5b military retired pay $32,000 (taxable: IRC 61(a)(10); Pub. 525,
        Military retirement pay) = AGI $70,000.
        Standard deduction $15,750 (Single, 2025, OBBBA).
        Taxable income $54,250.
        Tax (2025 Single brackets): 1,192.50 + 12% x 36,550 + 22% x 5,775 = 5,578.50 + 1,270.50 = $6,849.00.
        Withholding $11,000 less tax $6,849.00 = refund $4,151.00. -->
   <!-- Idaho (2025 Form 40): line 7 federal AGI $70,000; Form 39R Part B line 8: qualifies under 62
        because employed (wages $38,000); 8a cap $48,216; 8e qualifying benefits $32,000; 8f $32,000
        to line 24 and Form 40 line 10; line 11 Idaho AGI $38,000; line 16 standard deduction $15,750
        (Idaho conforms to the OBBBA figure, HB 559); line 19 taxable income $22,250; line 20
        worksheet: ($22,250 - $4,811 zero bracket) x 5.3% = $924.27, rounded on the form to $924.
        The $155 grocery credit is refundable (line 43) and the $10 permanent building fund tax is a
        separate tax, so neither is in the income tax figure. Idaho tax $924. -->
   <!-- expected_state_tax was a guess of $3,600 ("assume partial deduction") at 5.8% (#1330). -->
   <expected_agi>70000</expected_agi>
   <expected_taxable_income>54250</expected_taxable_income>
   <expected_total_tax>6849</expected_total_tax>
   <expected_state_tax>924</expected_state_tax>
   <expected_refund>4151</expected_refund>

   <!-- Retired Military Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Jennifer</name>
         <last_name>Wilson</last_name>
         <ssn>666-77-8888</ssn>
         <date_of_birth>9/8/1967</date_of_birth>
         <occupation>Military Retiree - Teacher</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>38000</w2_wages>
         <w2_withholding>11000</w2_withholding>
         <military_retirement_pay>32000</military_retirement_pay>
         <is_senior>false</is_senior>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions -->
   <deductions></deductions>
</job>
