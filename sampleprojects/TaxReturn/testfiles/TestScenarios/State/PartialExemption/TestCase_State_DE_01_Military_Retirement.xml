   <!-- Delaware Military Retirement Test Case -->
   <!-- Test Case DE-Military-01: Military retirement with $12,500 exclusion under age 60 -->
   <!-- DE provides: -->
   <!-- Under age 60: $12,500 exclusion -->
   <!-- Age 60+: $12,500 + additional $2,000 = $14,500 total -->
   <!-- This test uses age 57 (born 1968) = $12,500 exemption -->

   <id>DE-MIL-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>DE</state>
   <city>Dover</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $28,000 military retirement + $40,000 W2 = $68,000 -->
   <!-- AGI: $68,000 -->
   <!-- Federal Standard Deduction: $15,000 (Single) -->
   <!-- Federal Taxable Income: $53,000 -->
   <!-- Federal Tax: ~$6,400 -->
   <!-- DE: Progressive tax (up to 6.6%) -->
   <!-- DE Military Retirement Exclusion: $12,500 (under age 60) -->
   <!-- DE Taxable Retirement: $28,000 - $12,500 = $15,500 -->
   <!-- DE Taxable Income: $15,500 + $40,000 = $55,500 -->
   <!-- DE Tax (progressive brackets): ~$3,400 -->
   <!-- Total Tax: $9,800 -->
   <!-- Withholding: $10,500 -->
   <!-- Refund: $700 -->
   <expected_agi>68000</expected_agi>
   <expected_taxable_income>53000</expected_taxable_income>
   <expected_total_tax>9800</expected_total_tax>
   <expected_state_tax>3400</expected_state_tax>
   <expected_refund>700</expected_refund>

   <!-- Retired Military Taxpayer (Age 57) -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Patricia</name>
         <last_name>Davis</last_name>
         <ssn>333-44-5555</ssn>
         <date_of_birth>6/20/1968</date_of_birth>
         <occupation>Military Retiree - Administrator</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>40000</w2_wages>
         <w2_withholding>10500</w2_withholding>
         <military_retirement_pay>28000</military_retirement_pay>
         <is_senior>false</is_senior>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions -->
   <deductions></deductions>
</job>
