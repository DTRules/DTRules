   <!-- New Mexico Military Retirement Test Case -->
   <!-- Test Case NM-Military-01: Military retirement ($30,000 exemption) -->
   <!-- NM provides flat $30,000 exemption for military retirement (2025) -->

   <id>NM-MIL-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>NM</state>
   <city>Albuquerque</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $48,000 military retirement + $40,000 W2 = $88,000 -->
   <!-- AGI: $88,000 -->
   <!-- Federal Standard Deduction: $15,000 (Single) -->
   <!-- Federal Taxable Income: $73,000 -->
   <!-- Federal Tax: ~$10,200 -->
   <!-- NM: Progressive tax (up to 5.9%) -->
   <!-- NM Military Retirement Exemption: $30,000 -->
   <!-- NM Taxable Retirement: $48,000 - $30,000 = $18,000 -->
   <!-- NM Taxable Income: $18,000 + $40,000 = $58,000 -->
   <!-- NM Tax (progressive brackets): ~$3,200 -->
   <!-- Total Tax: $13,400 -->
   <!-- Withholding: $14,500 -->
   <!-- Refund: $1,100 -->
   <expected_agi>88000</expected_agi>
   <expected_taxable_income>73000</expected_taxable_income>
   <expected_total_tax>13400</expected_total_tax>
   <expected_state_tax>3200</expected_state_tax>
   <expected_refund>1100</expected_refund>

