   <!-- New York Military Retirement Full Exemption Test Case -->
   <!-- Test Case NY-Military-01: Military retiree with full exemption -->
   <!-- NY provides 100% exemption for military retirement pay -->
   <!-- NY has progressive tax rates (4% - 10.9%) -->
   <!-- This test verifies that military retirement is fully excluded from NY taxable income -->

   <id>NY-MIL-FULL-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>NY</state>
   <city>Albany</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $50,000 military retirement (100% exempt in NY) + $40,000 private pension (taxable) = $90,000 AGI -->
   <!-- Federal AGI: $90,000 -->
   <!-- Federal Standard Deduction: $15,000 (Single) -->
   <!-- Federal Taxable Income: $75,000 -->
   <!-- Federal Tax: $11,925 @ 10% = $1,192.50 + $63,075 @ 12% = $7,569.00 = $8,761.50 -->
   <!--
   NY Calculation:
   - NY AGI starts with Federal AGI: $90,000
   - NY Military Retirement Exclusion: $50,000 (100% exempt)
   - NY Adjusted AGI: $90,000 - $50,000 = $40,000
   - NY Standard Deduction: $8,000 (Single, 2025)
   - NY Taxable Income: $40,000 - $8,000 = $32,000
   - NY Tax (progressive brackets, approximate for $32,000): ~$1,400
   - Total Tax: $8,761.50 + $1,400 = $10,161.50
   - Withholding: $12,000
   - Refund: $1,838.50
   -->
   <expected_agi>90000</expected_agi>
   <expected_taxable_income>75000</expected_taxable_income>
   <expected_total_tax>10161.50</expected_total_tax>
   <expected_state_tax>1400</expected_state_tax>
   <expected_refund>1838.50</expected_refund>

   <!-- Retired Military Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>James</name>
         <last_name>Martinez</last_name>
         <ssn>111-22-3333</ssn>
         <date_of_birth>6/12/1975</date_of_birth>
         <occupation>Military Retiree - Retired after 22 years</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>0</w2_wages>
         <w2_withholding>12000</w2_withholding>
         <military_retirement_pay>50000</military_retirement_pay>
         <pension_income>40000</pension_income>
         <is_senior>false</is_senior>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions -->
   <deductions></deductions>

   <!--
   MSRRA Compliance Notes:
   - Military Servicemembers Civil Relief Act (SCRA) and Military Spouses Residency Relief Act (MSRRA)
     protect service members from dual state taxation
   - NY honors these federal protections
   - Military retirement pay earned through federal service is 100% exempt in NY

   SCRA Compliance:
   - Service members stationed in NY but domiciled elsewhere can exclude military pay from NY taxation
   - This test case shows NY resident receiving full exemption on military retirement

   Test Coverage:
   - This test validates that $50,000 military retirement pay is fully excluded from NY state AGI
   - Only the $40,000 private pension is subject to NY income tax
   - NY provides this exemption regardless of age or years of service
   - Representative of high-tax state with full military retirement exemption
   -->
</job>
