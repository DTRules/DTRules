   <!-- Ohio military retirement test case (OH-MIL-FULL-01). -->
   <!-- Uniformed services retirement income included in federal AGI is deducted in full on the -->
   <!-- Ohio Schedule of Adjustments line 34 (R.C. 5747.01(A)(23); 2025 IT 1040 booklet p. 24). -->

   <id>OH-MIL-FULL-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>OH</state>
   <city>Columbus</city>

   <!-- Expected values for validation (2025), worked from the inputs and the 2025 forms,
        never from what the rules print (#1330). expected_total_tax is the federal tax (Form 1040 line 24); the state's own tax is
        checked separately through expected_state_tax, and expected_refund is
        withholding less the federal tax. -->
   <!-- Federal (2025 Form 1040): line 1a wages $15,000 + line 5b military retired pay $48,000 (taxable: IRC 61(a)(10); Pub. 525,
        Military retirement pay) = AGI $63,000.
        Standard deduction $15,750 (Single, 2025, OBBBA).
        Taxable income $47,250.
        Tax (2025 Single brackets): 1,192.50 + 12% x 35,325 = $5,431.50.
        Withholding $6,500 less tax $5,431.50 = refund $1,068.50. -->
   <!-- Ohio (2025 Form IT 1040): line 1 federal AGI $63,000; Schedule of Adjustments line 34
        uniformed services retirement income $48,000 (line 2b); line 3 Ohio AGI $15,000; line 4
        personal exemption $2,400 (MAGI $40,000 or less); line 7 taxable nonbusiness income $12,600;
        line 8a tax $0 (the first $26,050 is taxed at 0%; R.C. 5747.02). The $20 exemption credit
        (Schedule of Credits line 9) is limited to the $0 tax. Ohio tax $0.
        OH_Tax is a #1200 placeholder (3.5% of Ohio AGI) and computes $525; the state check fails
        until #1200 rebuilds Ohio. -->
   <!-- expected_state_tax $0 was right; the federal figures used the pre-OBBBA $15,000 standard
        deduction (#1330). -->
   <expected_agi>63000</expected_agi>
   <expected_taxable_income>47250</expected_taxable_income>
   <expected_total_tax>5431.5</expected_total_tax>
   <expected_state_tax>0</expected_state_tax>
   <expected_refund>1068.5</expected_refund>

   <!-- Retired Military Taxpayer with part-time work -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Michael</name>
         <last_name>Anderson</last_name>
         <ssn>444-55-6666</ssn>
         <date_of_birth>11/5/1980</date_of_birth>
         <occupation>Military Retiree - Part-time Security</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>15000</w2_wages>
         <w2_withholding>6500</w2_withholding>
         <military_retirement_pay>48000</military_retirement_pay>
         <is_senior>false</is_senior>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions -->
   <deductions></deductions>

   <!--
   MSRRA Compliance Notes:
   - Military Servicemembers Civil Relief Act (SCRA) and Military Spouses Residency Relief Act (MSRRA)
     protect service members from dual state taxation
   - OH honors these federal protections
   - Military retirement pay earned through federal service is 100% exempt in OH

   SCRA Compliance:
   - Service members stationed in OH but domiciled elsewhere can exclude military pay from OH taxation
   - This test case shows OH resident receiving full exemption on military retirement

   Test Coverage:
   - This test validates that $48,000 military retirement pay is fully excluded from OH state AGI
   - Only the $15,000 part-time wages are subject to OH income tax
   - After military retirement exclusion ($48,000) and personal exemption ($2,400),
     the taxable income of $12,600 falls below OH's $26,050 zero-tax threshold
   - Result: $0 OH state tax owed
   - OH provides this exemption regardless of age or years of service
   - Representative of progressive-rate state with full military retirement exemption
   - Tests combination of tax-exempt military retirement and modest employment income
   - Demonstrates how OH's exemption threshold benefits low-to-moderate income military retirees
   - OH may also have local income taxes (not modeled in this test)
   -->
</job>
