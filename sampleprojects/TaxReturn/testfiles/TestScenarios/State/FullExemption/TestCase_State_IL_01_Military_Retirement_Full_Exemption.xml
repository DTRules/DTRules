   <!-- Illinois Military Retirement Full Exemption Test Case -->
   <!-- Test Case IL-Military-01: Military retiree with full exemption -->
   <!-- IL provides 100% exemption for military retirement pay -->
   <!-- IL has flat 4.95% state income tax rate -->
   <!-- This test verifies that military retirement is fully excluded from IL taxable income -->

   <id>IL-MIL-FULL-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>IL</state>
   <city>Springfield</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $45,000 military retirement (100% exempt in IL) + $30,000 W2 wages (taxable) = $75,000 AGI -->
   <!-- Federal AGI: $75,000 -->
   <!-- Federal Standard Deduction: $15,000 (Single) -->
   <!-- Federal Taxable Income: $60,000 -->
   <!-- Federal Tax: $11,925 @ 10% = $1,192.50 + $48,075 @ 12% = $5,769.00 = $6,961.50 -->
   <!--
   IL Calculation:
   - IL AGI starts with Federal AGI: $75,000
   - IL Military Retirement Exclusion: $45,000 (100% exempt)
   - IL Adjusted AGI: $75,000 - $45,000 = $30,000
   - IL does not have state standard deduction (uses federal AGI with modifications)
   - IL Taxable Income: $30,000
   - IL Tax: $30,000 * 0.0495 = $1,485
   - Total Tax: $6,961.50 + $1,485 = $8,446.50
   - Withholding: $9,500
   - Refund: $1,053.50
   -->
   <expected_agi>75000</expected_agi>
   <expected_taxable_income>60000</expected_taxable_income>
   <expected_total_tax>8446.50</expected_total_tax>
   <expected_state_tax>1485</expected_state_tax>
   <expected_refund>1053.50</expected_refund>

   <!-- Retired Military Taxpayer working part-time -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Sarah</name>
         <last_name>Johnson</last_name>
         <ssn>222-33-4444</ssn>
         <date_of_birth>8/25/1978</date_of_birth>
         <occupation>Military Retiree - Part-time IT Consultant</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>30000</w2_wages>
         <w2_withholding>9500</w2_withholding>
         <military_retirement_pay>45000</military_retirement_pay>
         <is_senior>false</is_senior>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions -->
   <deductions></deductions>

   <!--
   MSRRA Compliance Notes:
   - Military Servicemembers Civil Relief Act (SCRA) and Military Spouses Residency Relief Act (MSRRA)
     protect service members from dual state taxation
   - IL honors these federal protections
   - Military retirement pay earned through federal service is 100% exempt in IL

   SCRA Compliance:
   - Service members stationed in IL but domiciled elsewhere can exclude military pay from IL taxation
   - This test case shows IL resident receiving full exemption on military retirement

   Test Coverage:
   - This test validates that $45,000 military retirement pay is fully excluded from IL state AGI
   - Only the $30,000 W-2 wages are subject to IL income tax at the 4.95% flat rate
   - IL provides this exemption regardless of age or years of service
   - Representative of flat-rate state with full military retirement exemption
   - Tests combination of tax-exempt military retirement and taxable employment income
   -->
</job>
