   <!-- Illinois military retirement test case (IL-MIL-FULL-01). -->
   <!-- Illinois subtracts federally taxed retirement income, including military retired pay, in full -->
   <!-- on IL-1040 line 5 (2025 IL-1040 instructions; Publication 120; 35 ILCS 5/203(a)(2)(F)). -->

   <id>IL-MIL-FULL-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>IL</state>
   <city>Springfield</city>

   <!-- Expected values for validation (2025), worked from the inputs and the 2025 forms,
        never from what the rules print (#1330). expected_total_tax is the federal tax (Form 1040 line 24); the state's own tax is
        checked separately through expected_state_tax, and expected_refund is
        withholding less the federal tax. -->
   <!-- Federal (2025 Form 1040): line 1a wages $30,000 + line 5b military retired pay $45,000 (taxable: IRC 61(a)(10); Pub. 525,
        Military retirement pay) = AGI $75,000.
        Standard deduction $15,750 (Single, 2025, OBBBA).
        Taxable income $59,250.
        Tax (2025 Single brackets): 1,192.50 + 12% x 36,550 + 22% x 10,775 = 5,578.50 + 2,370.50 = $7,949.00.
        Withholding $9,500 less tax $7,949.00 = refund $1,551.00. -->
   <!-- Illinois (2025 Form IL-1040): line 1 federal AGI $75,000; line 5 subtraction of retirement
        income (military retired pay) $45,000; line 9 base income $30,000; line 10 exemption
        $2,850 x 1; line 11 net income $27,150; line 12 tax 4.95% = $1,343.925, rounded to whole
        dollars on the form: $1,344. No automatic credits. -->
   <!-- expected_state_tax was $1,485, 4.95% of $30,000 with the $2,850 exemption left out; the federal
        figures used the pre-OBBBA $15,000 standard deduction and added the state tax into
        expected_total_tax (#1330). -->
   <expected_agi>75000</expected_agi>
   <expected_taxable_income>59250</expected_taxable_income>
   <expected_total_tax>7949</expected_total_tax>
   <expected_state_tax>1344</expected_state_tax>
   <expected_refund>1551</expected_refund>

   <!-- Retired Military Taxpayer working part-time -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Sarah</name>
         <last_name>Johnson</last_name>
         <ssn>222-33-4444</ssn>
         <date_of_birth>8/25/1978</date_of_birth>
         <occupation>Military Retiree - Part-time IT Consultant</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>30000</w2_wages>
         <w2_withholding>9500</w2_withholding>
         <military_retirement_pay>45000</military_retirement_pay>
         <is_senior>false</is_senior>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions -->
   <deductions></deductions>

   <!--
   MSRRA Compliance Notes:
   - Military Servicemembers Civil Relief Act (SCRA) and Military Spouses Residency Relief Act (MSRRA)
     protect service members from dual state taxation
   - IL honors these federal protections
   - Military retirement pay earned through federal service is 100% exempt in IL

   SCRA Compliance:
   - Service members stationed in IL but domiciled elsewhere can exclude military pay from IL taxation
   - This test case shows IL resident receiving full exemption on military retirement

   Test Coverage:
   - This test validates that $45,000 military retirement pay is fully excluded from IL state AGI
   - Only the $30,000 W-2 wages are subject to IL income tax at the 4.95% flat rate
   - IL provides this exemption regardless of age or years of service
   - Representative of flat-rate state with full military retirement exemption
   - Tests combination of tax-exempt military retirement and taxable employment income
   -->
</job>
