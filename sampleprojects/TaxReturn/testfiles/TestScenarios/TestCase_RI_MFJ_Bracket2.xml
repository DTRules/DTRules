   <!-- Rhode Island Tax Test Case 2: MFJ filers, Bracket 2 ($79,900-$181,650) -->
   <id>RI002</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>RI</state>
   <city>Warwick</city>

   <!-- Expected values:
        Federal AGI: $140,000
        RI AGI: $140,000
        RI Personal Exemption: $5,100
        RI Standard Deduction (MFJ): $21,800
        RI Taxable Income: $140,000 - $5,100 - $21,800 = $113,100
        RI Tax:
          Bracket 1: $79,900 × 3.75% = $2,996.25
          Bracket 2: ($113,100 - $79,900) × 4.75% = $33,200 × 4.75% = $1,577
          Total: $4,573.25
   -->
   <expected_agi>140000</expected_agi>
   <expected_taxable_income>113100</expected_taxable_income>

