   <!-- OR-02: Married Filing Jointly (Oregon Progressive Tax) -->
   <!-- Test Case: MFJ filers with income in bracket 3 -->

   <!-- Tax Return Configuration -->
   <id>1002</id>
   <tax_year>2025</tax_year>
   <filing_status>Married_Filing_Jointly</filing_status>
   <state>OR</state>
   <city>Eugene</city>

   <!-- Oregon Tax Calculation:
        Federal AGI: $150,000
        OR Standard Deduction (MFJ): $5,670
        OR Taxable Income: $144,330

        Bracket 1: $8,800 × 4.75% = $418.00
        Bracket 2: ($22,200 - $8,800) = $13,400 × 6.75% = $904.50
        Bracket 3: ($144,330 - $22,200) = $122,130 × 8.75% = $10,686.38
        Total Tax Before Credits: $12,008.88
        Personal Exemption Credits: 2 × $256 = $512
        Oregon Tax After Credits: $11,496.88
   -->

