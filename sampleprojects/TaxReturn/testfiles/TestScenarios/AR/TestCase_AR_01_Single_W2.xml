   <!-- Expected values, worked from each form's own rules -->
   <!-- Sources: AR1000F/AR1000NR 2025 instructions (standard deduction, line 27;
        personal tax credits, line 7); AR DFA 2025 Indexed Tax Brackets and
        2025 Regular Income Tax Table (tax at the midpoint of the $100 band,
        rounded to the dollar). -->
   <!-- Federal: AGI $52,000; taxable $52,000 - $15,750 = $36,250 -->
   <!-- Arkansas: net taxable income $52,000 - $2,470 = $49,530.
        Band $49,500-$49,600, midpoint $49,550: x 3.9% = $1,932.45 - $419.96
        = $1,512.49 -> $1,512 (table row 49,500-49,600: $1,512).
        Personal tax credits: 1 x $29 = $29. Tax: $1,512 - $29 = $1,483 -->
   <expected_agi>52000</expected_agi>
   <expected_taxable_income>36250</expected_taxable_income>
   <expected_state_tax>1483</expected_state_tax>

