   <!-- AR Test Case 03: head of household, $99,000 of wages, one child, in the $94,701-$97,800 adjustment phase-in -->
   <id>AR-03</id>
   <tax_year>2025</tax_year>
   <filing_status>HOH</filing_status>
   <state>AR</state>
   <city>Little Rock</city>
   <has_state_income_tax>true</has_state_income_tax>

   <!-- Expected values, worked from each form's own rules -->
   <!-- Sources: AR1000F/AR1000NR 2025 instructions (standard deduction, line 27;
        personal tax credits, line 7); AR DFA 2025 Indexed Tax Brackets and
        2025 Regular Income Tax Table (tax at the midpoint of the $100 band,
        rounded to the dollar). -->
   <!-- Federal: AGI $99,000; taxable $99,000 - $23,625 = $75,375 -->
   <!-- Arkansas: net taxable income $99,000 - $2,470 = $96,530.
        Band $96,501-$96,600, midpoint $96,551; this band's minus adjustment
        is $219.30 ($399.30 at $94,701, $10.00 less per $100 band).
        $96,551 x 3.9% = $3,765.49 - $219.30 = $3,546.19 -> $3,546 (table row
        96,501-96,601: $3,546).
        Personal tax credits: taxpayer + Head of Household box + 1 dependent
        = 3 x $29 = $87. Tax: $3,546 - $87 = $3,459 -->
   <expected_agi>99000</expected_agi>
   <expected_taxable_income>75375</expected_taxable_income>
   <expected_state_tax>3459</expected_state_tax>

