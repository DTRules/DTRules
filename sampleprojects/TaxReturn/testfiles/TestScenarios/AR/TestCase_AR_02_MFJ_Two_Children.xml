   <!-- Expected values, worked from each form's own rules -->
   <!-- Sources: AR1000F/AR1000NR 2025 instructions (standard deduction, line 27;
        personal tax credits, line 7); AR DFA 2025 Indexed Tax Brackets and
        2025 Regular Income Tax Table (tax at the midpoint of the $100 band,
        rounded to the dollar). -->
   <!-- Federal: AGI $98,000; taxable $98,000 - $31,500 = $66,500 -->
   <!-- Arkansas: net taxable income $98,000 - $4,940 = $93,060.
        Band $93,001-$93,100 (from $75,000 the bands run 01-00), midpoint
        $93,051: x 3.9% = $3,628.99 - $419.96 = $3,209.03 -> $3,209 (table
        row 93,001-93,101: $3,209).
        Personal tax credits: 2 taxpayers + 2 dependents = 4 x $29 = $116.
        Tax: $3,209 - $116 = $3,093 -->
   <expected_agi>98000</expected_agi>
   <expected_taxable_income>66500</expected_taxable_income>
   <expected_state_tax>3093</expected_state_tax>

