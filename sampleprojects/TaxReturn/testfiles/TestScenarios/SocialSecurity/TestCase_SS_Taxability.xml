   <!-- Tests the up-to-85% Social Security taxability calculation per
        IRC §86 and Publication 915. Single retiree with modest pension
        income plus Social Security benefits; combined provisional income
        crosses the upper threshold ($34,000 Single), so up to 85% of
        SS becomes taxable.

          W-2 / pension income           = $30,000
          Social Security benefits       = $24,000
          1/2 SS benefits for provisional = $12,000
          Provisional income             = $30,000 + $12,000 = $42,000
          Single thresholds: $25k (50%), $34k (85%)
          Provisional > $34,000 → up to 85% taxable
          Taxable SS ≈ min(85% × $24,000, 85% × ($42k - $34k) + 50% ×
                            min(SS, $9k)) ≈ ~$15,300 (per worksheet)
        Test asserts non-zero AGI / taxable_social_security; precise
        worksheet result depends on the rules' implementation. -->

   <id>1</id>
   <tax_year>2025</tax_year>
   <filing_status>SINGLE</filing_status>
   <state>FL</state>
   <city>Miami</city>

   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Elena Rodriguez</name>
