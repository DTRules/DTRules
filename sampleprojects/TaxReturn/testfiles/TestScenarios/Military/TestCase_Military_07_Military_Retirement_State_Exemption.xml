         <description>Social Security benefits (Form SSA-1099)</description>
      </income>
      <income id="3">
         <id>3</id>
         <taxpayer_id>2</taxpayer_id>
         <type>w2_wages</type>
         <gross_amount>30000</gross_amount>
         <withholding>3200</withholding>
      </income>
   </incomes>

