   <!--
      Test Case: Early Distribution from Retirement Account (IRA)

      IRC Section 72(t) - Early Distribution Penalty

      Rules Tested:
      - Distributions before age 59½ subject to 10% early withdrawal penalty
      - Exceptions to penalty (IRC §72(t)(2)):
      -   Death, disability, medical expenses > 7.5% AGI
      -   Health insurance premiums (unemployed), first home ($10k lifetime)
      -   Higher education expenses, substantially equal periodic payments
      -   IRS levy, qualified reservist distributions
      - Distribution is ordinary income regardless of penalty
      - Form 1099-R shows distribution and taxable amount
      - Form 5329 calculates penalty (unless exception applies)

      Test Scenario:
      - Taxpayer age 52 (under 59½)
      - Traditional IRA early distribution: $40,000
      - Distribution reason: Disability (permanently disabled)
      - Form 1099-R received, code 3 (disability exception)
      - Taxable amount: $40,000 (fully taxable - traditional IRA)
      - 10% penalty: WAIVED due to disability exception
      - Medical certification of disability required

      Expected Results:
      - Distribution included in gross income: $40,000
      - No 10% early distribution penalty (disability exception)
      - Tax on distribution at ordinary income rates
      - Form 5329 filed showing exception code
   -->

   <!-- Tax Return Configuration -->
   <id>SPECIAL_10</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>CO</state>
   <city>Denver</city>

   <!-- Expected values for validation -->
   <!-- Income: $55,000 W-2 + $40,000 IRA distribution -->
   <!-- AGI: $95,000 -->
   <!-- Standard Deduction: $30,000 -->
   <!-- Taxable Income: $95,000 - $30,000 = $65,000 -->
   <!-- Tax: $7,372 (2025 MFJ rates) -->
   <!-- NO early distribution penalty (disability exception) -->
   <!-- Withholding: $5,500 W-2 + $8,000 IRA = $13,500 -->
   <!-- Refund: $6,128 -->
   <expected_agi>95000</expected_agi>
   <expected_taxable_income>65000</expected_taxable_income>
   <expected_total_tax>7372</expected_total_tax>
   <expected_refund>6128</expected_refund>

   <!-- Taxpayers -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Thomas Mitchell</name>
         <ssn>012-34-5678</ssn>
         <date_of_birth>6/10/1973</date_of_birth>
         <age>52</age>
