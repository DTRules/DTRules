         <disability_certification>Permanent and total disability per IRC 72(m)(7)</disability_certification>
         <w2_wages>55000</w2_wages>
         <w2_withholding>5500</w2_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>

      <taxpayer id="2">
         <id>2</id>
         <name>Jennifer Mitchell</name>
         <ssn>123-45-6789</ssn>
         <date_of_birth>8/15/1975</date_of_birth>
         <age>50</age>
         <occupation>Retail Manager (part-time)</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>false</is_primary>
         <w2_wages>0</w2_wages>
         <w2_withholding>0</w2_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

