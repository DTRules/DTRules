   <!-- Taxable Income: $95,000 - $32,300 = $62,700 -->
   <!-- Tax: $7,132 (2025 MFJ rates) -->
   <!-- Withholding: $9,500 -->
   <!-- Refund: $2,368 -->
   <expected_agi>95000</expected_agi>
   <expected_taxable_income>62700</expected_taxable_income>
   <expected_total_tax>7132</expected_total_tax>
   <expected_refund>2368</expected_refund>

