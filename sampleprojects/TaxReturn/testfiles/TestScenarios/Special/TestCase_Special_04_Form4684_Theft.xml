   <!--
      Test Case: Form 4684 - Casualty and Theft Losses (Theft Loss)

      IRC Section 165(e) and (h) - Theft Loss Deduction

      Rules Tested:
      - Post-TCJA: Theft losses only deductible if related to federally declared disaster
      - Must establish theft occurred (police report required)
      - Loss = Lesser of (adjusted basis OR FMV before theft) - reimbursement
      - $100 floor per theft event (IRC §165(h)(1))
      - 10% AGI limitation (IRC §165(h)(2)(A))
      - Loss deducted in year theft discovered (if different from occurrence)

      Test Scenario:
      - Jewelry stolen during burglary during federally declared emergency
      - Jewelry: inherited diamond necklace
      - Adjusted basis (FMV at inheritance): $12,000
      - FMV at time of theft: $15,000
      - Insurance reimbursement: $8,000
      - Police report filed
      - Loss = Lesser($12,000 basis, $15,000 FMV) - $8,000 = $4,000
      - Apply $100 floor: $4,000 - $100 = $3,900
      - AGI: $110,000, so 10% AGI = $11,000
      - Since $3,900 &lt; $11,000, no deductible loss after 10% AGI floor

      Expected Results:
      - Form 4684 filed
      - Theft loss after $100 floor: $3,900
      - Deductible loss after 10% AGI floor: $0 (eliminated by AGI limitation)
      - Must be connected to federally declared disaster (civil unrest, etc.)
   -->

   <!-- Tax Return Configuration -->
   <id>SPECIAL_04</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>CA</state>
   <city>Los Angeles</city>

   <!-- Expected values for validation -->
   <!-- Income: $110,000 W-2 -->
   <!-- AGI: $110,000 -->
   <!-- Standard Deduction: $30,000 -->
   <!-- Itemized: $14,200 mortgage int + $10,000 SALT + $0 theft (eliminated) = $24,200 -->
   <!-- Choose standard ($30,000) over itemized ($24,200) -->
   <!-- Taxable Income: $110,000 - $30,000 = $80,000 -->
   <!-- Tax: $9,264 (2025 MFJ rates) -->
   <!-- Withholding: $11,000 -->
   <!-- Refund: $1,736 -->
   <expected_agi>110000</expected_agi>
   <expected_taxable_income>80000</expected_taxable_income>
   <expected_total_tax>9264</expected_total_tax>
   <expected_refund>1736</expected_refund>

   <!-- Taxpayers -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Susan Anderson</name>
         <ssn>456-78-9012</ssn>
         <date_of_birth>7/15/1978</date_of_birth>
         <occupation>Marketing Director</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>110000</w2_wages>
         <w2_withholding>11000</w2_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>

      <taxpayer id="2">
         <id>2</id>
         <name>James Anderson</name>
         <ssn>567-89-0123</ssn>
         <date_of_birth>9/8/1976</date_of_birth>
         <occupation>Architect (unemployed during year)</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>false</is_primary>
         <w2_wages>0</w2_wages>
         <w2_withholding>0</w2_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents>
   </dependents>

   <!-- Primary Residence -->
   <properties>
      <property id="1">
         <id>1</id>
         <type>primary_residence</type>
         <address>234 Wilshire Boulevard, Los Angeles, CA 90024</address>
         <purchase_date>6/1/2020</purchase_date>
         <purchase_price>720000</purchase_price>
         <current_fmv>850000</current_fmv>
         <mortgage_balance>650000</mortgage_balance>
         <mortgage_origination_date>6/1/2020</mortgage_origination_date>
         <mortgage_interest>14200</mortgage_interest>
         <property_taxes>11500</property_taxes>
         <rental_income>0</rental_income>
         <rental_expenses>0</rental_expenses>
         <depreciation>0</depreciation>
      </property>
   </properties>

   <!-- No vehicles -->
   <vehicles>
   </vehicles>

   <!-- Theft Losses -->
   <casualty_losses>
      <!-- Jewelry theft during civil unrest (federally declared disaster area) -->
      <casualty id="1">
         <id>1</id>
         <event_type>theft</event_type>
         <description>Jewelry stolen during burglary - diamond necklace inherited from grandmother</description>
         <event_date>3/22/2025</event_date>
         <discovery_date>3/22/2025</discovery_date>
         <property_id>0</property_id>
         <property_description>Diamond necklace (personal property)</property_description>
         <is_federally_declared_disaster>true</is_federally_declared_disaster>
         <disaster_declaration_number>FEMA-4601-EM-CA</disaster_declaration_number>
         <disaster_context>Civil unrest and looting during state of emergency</disaster_context>
         <police_report_filed>true</police_report_filed>
         <police_report_number>LA-2025-045678</police_report_number>
         <police_department>Los Angeles Police Department</police_department>
         <!-- Inherited property - basis is FMV at date of inheritance -->
         <property_adjusted_basis>12000</property_adjusted_basis>
         <fmv_at_inheritance>12000</fmv_at_inheritance>
         <inheritance_date>1/15/2023</inheritance_date>
         <fmv_before_theft>15000</fmv_before_theft>
         <!-- Loss = Lesser(basis $12k, FMV before theft $15k) - insurance $8k = $12k - $8k = $4,000 -->
         <insurance_reimbursement>8000</insurance_reimbursement>
         <insurance_reimbursement_expected>0</insurance_reimbursement_expected>
         <loss_before_limits>4000</loss_before_limits>
         <!-- Apply $100 floor per casualty/theft -->
         <floor_100_applied>100</floor_100_applied>
         <loss_after_100_floor>3900</loss_after_100_floor>
         <!-- 10% AGI limitation: $110,000 * 0.10 = $11,000 -->
         <agi_for_calculation>110000</agi_for_calculation>
         <ten_percent_agi>11000</ten_percent_agi>
         <!-- Deductible: $3,900 - $11,000 = $0 (eliminated by 10% AGI floor) -->
         <deductible_casualty_loss>0</deductible_casualty_loss>
      </casualty>
   </casualty_losses>

   <!-- No other deductions -->
   <deductions>
   </deductions>
</job>
