         <property_address>1234 Oak Street, Chicago, IL 60601</property_address>
         <building_identification_number>IL-2020-001234</building_identification_number>
         <!-- Investment timeline -->
         <placed_in_service_date>6/1/2020</placed_in_service_date>
         <first_credit_year>2020</first_credit_year>
         <disposition_date>10/15/2025</disposition_date>
         <years_held>5</years_held>
         <compliance_period_years>15</compliance_period_years>
         <!-- Credit history -->
         <annual_credit_amount>10000</annual_credit_amount>
         <credits_claimed_2020>10000</credits_claimed_2020>
         <credits_claimed_2021>10000</credits_claimed_2021>
         <credits_claimed_2022>10000</credits_claimed_2022>
         <credits_claimed_2023>10000</credits_claimed_2023>
         <credits_claimed_2024>10000</credits_claimed_2024>
         <total_credits_claimed>50000</total_credits_claimed>
         <!-- Recapture calculation (Form 8611) -->
         <years_held_at_disposition>5</years_held_at_disposition>
         <required_compliance_years>15</required_compliance_years>
         <!-- Credits earned = (Years held / Compliance years) × Total credits -->
         <credits_earned_to_date>16667</credits_earned_to_date>
         <!-- Accelerated portion = Credits claimed - Credits earned -->
         <accelerated_portion>33333</accelerated_portion>
         <!-- Interest on accelerated portion -->
         <interest_rate>0.05</interest_rate>
         <average_years_outstanding>3</average_years_outstanding>
         <interest_amount>5000</interest_amount>
         <!-- Total recapture -->
         <total_recapture_amount>38333</total_recapture_amount>
         <!-- Reason for recapture -->
         <recapture_reason>disposition</recapture_reason>
         <disposition_type>sale</disposition_type>
         <noncompliance_event>false</noncompliance_event>
      </recapture>
   </lihtc_recapture>

