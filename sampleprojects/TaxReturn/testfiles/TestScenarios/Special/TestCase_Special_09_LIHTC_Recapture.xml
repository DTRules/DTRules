   <!--
      Test Case: Low-Income Housing Tax Credit (LIHTC) Recapture

      IRC Section 42 - Low-Income Housing Credit

      Rules Tested:
      - LIHTC provides credit over 10-year period for qualifying low-income housing
      - 15-year compliance period required to avoid recapture
      - Recapture triggered by: disposition, change in use, noncompliance
      - Recapture = Accelerated portion + Interest
      - Accelerated portion = (Credits claimed - Credits earned to date)
      - Interest calculated from year credit was claimed
      - Form 8611 - Recapture of Low-Income Housing Credit

      Test Scenario:
      - Taxpayer invested in LIHTC property in 2020
      - Credits received: $10,000/year for years 2020-2024 (5 years)
      - Total credits claimed: $50,000
      - Property sold in 2025 (year 6 of 15-year compliance period)
      - Recapture calculation:
      -   Credits earned at sale: 5/15 × $50,000 = $16,667
      -   Credits claimed: $50,000
      -   Accelerated portion: $50,000 - $16,667 = $33,333
      -   Interest (simplified): $33,333 × 5% avg × 3 years avg = $5,000
      -   Total recapture: $33,333 + $5,000 = $38,333

      Expected Results:
      - Form 8611 required
      - Recapture tax: $38,333 (added to total tax liability)
      - Significant increase in tax due
      - No LIHTC credit in 2025 (property disposed)
   -->

   <!-- Tax Return Configuration -->
   <id>SPECIAL_09</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>IL</state>
   <city>Chicago</city>

   <!-- Expected values for validation -->
   <!-- Income: $250,000 W-2 -->
   <!-- AGI: $250,000 -->
   <!-- Standard Deduction: $30,000 -->
   <!-- Taxable Income: $250,000 - $30,000 = $220,000 -->
   <!-- Tax: $41,532 (2025 MFJ rates) -->
   <!-- LIHTC Recapture: $38,333 -->
   <!-- Total Tax: $41,532 + $38,333 = $79,865 -->
   <!-- Withholding: $50,000 -->
   <!-- Owed: $29,865 -->
   <expected_agi>250000</expected_agi>
   <expected_taxable_income>218500</expected_taxable_income>
   <expected_total_tax>38134</expected_total_tax>
   <expected_refund>0</expected_refund>

   <!-- Taxpayers -->
   <taxpayers>
