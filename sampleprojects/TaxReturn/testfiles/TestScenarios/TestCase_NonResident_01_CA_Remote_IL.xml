   <!-- Non-Resident Test Case 1: CA Resident Working Remotely for IL Employer -->
   <!-- Scenario: California resident works remotely from home for Illinois-based employer -->
   <!-- Expected: IL should tax only IL-source income (none, as work performed in CA) -->
   <!-- CA would tax all income (not implemented yet), but this tests IL non-resident logic -->
   <id>NonRes-01</id>
   <tax_year>2025</tax_year>
   <filing_status>single</filing_status>
   <state>CA</state>
   <city>San Francisco</city>
   <has_state_income_tax>true</has_state_income_tax>

   <!-- Expected values for validation -->
   <!-- Federal AGI: $85,000 W-2 wages -->
   <!-- IL source income: $0 (work performed in CA, not IL) -->
   <!-- IL AGI: $0 -->
   <!-- IL Tax: $0 -->
   <expected_agi>85000</expected_agi>
   <expected_il_state_source_income>0</expected_il_state_source_income>
   <expected_il_agi>0</expected_il_agi>
   <expected_il_tax>0</expected_il_tax>

