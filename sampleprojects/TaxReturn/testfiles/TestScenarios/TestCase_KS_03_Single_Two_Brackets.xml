   <!-- KS Test Case 3: Single High Earner Using Both Brackets -->
   <id>KS-03</id>
   <tax_year>2025</tax_year>
   <filing_status>single</filing_status>
   <state>KS</state>
   <city>Kansas City</city>
   <has_state_income_tax>true</has_state_income_tax>

   <!-- Expected values for validation -->
   <!-- Federal AGI: $75,000 -->
   <!-- KS AGI: $75,000 -->
   <!-- KS Standard Deduction: $9,765 (Single) -->
   <!-- KS Personal Exemption: $9,160 (Single) -->
   <!-- KS Taxable Income: $75,000 - $9,765 - $9,160 = $56,075 -->
   <!-- KS Tax: -->
   <!--   Bracket 1 (5.20% on $0-$23,000): $23,000 × 5.20% = $1,196.00 -->
   <!--   Bracket 2 (5.58% on $23,000-$56,075): $33,075 × 5.58% = $1,845.59 -->
   <!--   Total: $1,196.00 + $1,845.59 = $3,041.59 -->
   <expected_agi>75000</expected_agi>
   <expected_ks_agi>75000</expected_ks_agi>
   <expected_ks_taxable_income>56075</expected_ks_taxable_income>
   <expected_ks_bracket_1_tax>1196.00</expected_ks_bracket_1_tax>
   <expected_ks_bracket_2_tax>1845.59</expected_ks_bracket_2_tax>
   <expected_ks_tax>3041.59</expected_ks_tax>

