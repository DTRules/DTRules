   <!-- Multi-State Test Case 2: CA to TX Move (Part-Year Resident) -->
   <!-- Married couple, one spouse worked in CA from Jan 1 to Sept 30 (273 days) -->
   <!-- Both moved to TX on Oct 1. TX has no state income tax. -->
