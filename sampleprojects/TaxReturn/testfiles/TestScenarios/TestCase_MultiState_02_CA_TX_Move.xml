   <filing_status>mfj</filing_status>
   <state>TX</state>
   <city>Austin</city>
   <has_state_income_tax>false</has_state_income_tax>

   <!-- Expected values for validation -->
   <!-- Total Annual Income: $145,000 -->
   <!-- CA Period: Jan 1 - Sept 30 (273 days) = 74.8% of year -->
   <!-- CA Allocated Income: $145,000 × 74.8% = $108,460 -->
   <!-- TX has no state income tax, so no TX tax -->
