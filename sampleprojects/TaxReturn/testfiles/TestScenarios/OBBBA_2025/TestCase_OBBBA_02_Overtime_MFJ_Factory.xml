   <!-- Test Case: MFJ factory worker with significant overtime income -->
   <!-- Tests the "No Tax on Overtime" provision from OBBBA 2025 -->
   <!-- Max deduction: $25,000 for MFJ, Phase-out starts at $300,000 MAGI -->

   <id>2</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>OH</state>
   <city>Cleveland</city>

   <!-- Expected values for validation -->
   <!-- Primary W-2: $55,000 base + $18,000 overtime -->
   <!-- Spouse W-2: $42,000 -->
   <!-- Total Income: $55,000 + $18,000 + $42,000 = $115,000 -->
   <!-- Overtime Deduction: $18,000 (under $25k cap for MFJ) -->
   <!-- AGI: $115,000 - $18,000 = $97,000 -->
   <!-- Standard Deduction (MFJ): $30,000 -->
   <!-- Taxable Income: $97,000 - $30,000 = $67,000 -->
   <!-- Tax: 10%(23,200) + 12%(43,800) = $7,576 -->
   <!-- CTC: $2,000 (Tommy age 10) -->
   <!-- Total Tax: $7,576 - $2,000 = $5,576 -->
   <expected_agi>97000</expected_agi>
   <expected_taxable_income>65500</expected_taxable_income>
   <expected_total_tax>5183</expected_total_tax>
   <expected_refund>0</expected_refund>

