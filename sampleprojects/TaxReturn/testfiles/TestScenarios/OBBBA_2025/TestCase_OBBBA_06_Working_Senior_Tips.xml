   <id>6</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>AZ</state>
   <city>Phoenix</city>

   <!-- Expected values for validation -->
   <!-- Part-time W-2: $18,000 -->
   <!-- Tip Income: $12,000 -->
   <!-- Social Security: $22,000 -->
   <!-- Total Income: $52,000 -->
   <!-- Tips Deduction: $12,000 (under cap) -->
   <!-- Senior OBBBA Deduction: $6,000 -->
   <!-- Total OBBBA Deductions: $18,000 -->
   <!-- AGI: $52,000 - $18,000 = $34,000 -->
   <!-- Standard Deduction for Single 65+: $15,000 + $2,000 = $17,000 -->
   <!-- Taxable Income: $34,000 - $17,000 = $17,000 -->
   <!-- Tax: 10% of $11,600 = $1,160 + 12% of $5,400 = $648 = $1,808 -->
