   <!-- Test Case: Tips deduction with partial phase-out at $160k AGI -->
   <!-- Tests partial reduction of tips deduction -->
   <!-- Phase-out begins at $150,000 MAGI for Single filers -->
   <!-- This server is $10k into the phase-out range -->

   <id>7</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>NV</state>
   <city>Las Vegas</city>

   <!-- Expected values for validation -->
   <!-- Base W-2: $70,000 -->
   <!-- Tip Income: $90,000 -->
   <!-- Total Income: $160,000 ($10k into phase-out zone) -->
   <!-- Tips Deduction: $25,000 max, but reduced by phase-out -->
   <!-- Phase-out calculation: $10,000 over threshold -->
   <!-- Assume linear phase-out over $50k range: 20% reduction -->
   <!-- Tips Deduction: $25,000 * 80% = $20,000 -->
   <!-- AGI: $160,000 - $20,000 = $140,000 -->
   <!-- Standard Deduction: $15,000 -->
   <!-- Taxable Income: $140,000 - $15,000 = $125,000 -->
   <!-- Tax: 10%(11,600)+12%(35,550)+22%(53,375)+24%(24,475) = $22,347 -->
   <expected_agi>140000</expected_agi>
   <expected_taxable_income>125000</expected_taxable_income>
   <expected_total_tax>22347</expected_total_tax>
   <expected_refund>0</expected_refund>

   <taxpayer>
      <id>1</id>
      <name>Marcus Williams</name>
      <ssn>777-88-9999</ssn>
      <date_of_birth>1989-11-05</date_of_birth>
      <occupation>Casino Dealer</occupation>
      <is_self_employed>false</is_self_employed>
      <is_primary>true</is_primary>
      <w2_wages>70000</w2_wages>
      <w2_withholding>16000</w2_withholding>
      <tip_income>90000</tip_income>
      <overtime_income>0</overtime_income>
      <social_security_income>0</social_security_income>
      <is_senior>false</is_senior>
   </taxpayer>
</job>
