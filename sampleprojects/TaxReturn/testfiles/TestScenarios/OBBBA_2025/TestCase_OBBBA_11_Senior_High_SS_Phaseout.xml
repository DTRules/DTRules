   <!-- Test Case: MFJ senior couple with high SS benefits causing phaseout -->
   <!-- Tests Senior Additional Deduction phase-out -->
   <!-- Additional $6,000 deduction per senior, Phase-out at $150,000 MAGI for MFJ -->
   <!-- This couple has $165k income, $15k into phase-out zone -->

   <id>11</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>AZ</state>
   <city>Phoenix</city>

   <!-- Expected values for validation -->
   <!-- Social Security: $58,000 (both seniors - high earners) -->
   <!-- Pension Income: $45,000 -->
   <!-- Investment Income: $62,000 -->
   <!-- Total Income: $165,000 ($15k into phase-out zone) -->
   <!-- Senior OBBBA Deduction: $12,000 max ($6k x 2 seniors) -->
   <!-- Phase-out calculation: $15,000 over $150k threshold -->
   <!-- Assume linear phase-out over $50k range: 30% reduction -->
   <!-- Senior Deduction: $12,000 * 70% = $8,400 -->
   <!-- AGI: $165,000 - $8,400 = $156,600 -->
   <!-- Standard Deduction (MFJ): $30,000 + $3,200 (2 x $1,600 for 65+) = $33,200 -->
   <!-- Taxable Income: $156,600 - $33,200 = $123,400 -->
   <!-- Tax: 10%(23,200)+12%(71,100)+22%(29,100) = $21,930 -->
   <expected_agi>156600</expected_agi>
   <expected_taxable_income>123400</expected_taxable_income>
   <expected_total_tax>21930</expected_total_tax>
   <expected_refund>0</expected_refund>

