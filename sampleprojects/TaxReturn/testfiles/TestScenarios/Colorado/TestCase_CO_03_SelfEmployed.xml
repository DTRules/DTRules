   <!-- CO-03: Colorado Single Self-Employed -->
   <!-- Tax Return Configuration -->
   <id>103</id>
   <tax_year>2025</tax_year>
   <filing_status>SINGLE</filing_status>
   <state>CO</state>
   <city>Colorado Springs</city>

   <!-- Expected values for validation -->
   <!-- Federal: SE gross $100,000 - expenses $30,000 = $70,000 net -->
   <!-- SE Tax: ~$9,891, deduction ~$4,946 -->
   <!-- Federal AGI: $70,000 - $4,946 = $65,054 -->
   <!-- QBI deduction: $14,000 (20% of $70,000) -->
   <!-- Federal Taxable: $65,054 - $15,000 - $14,000 = $36,054 -->
   <!-- Colorado: Federal taxable $36,054 * 4.40% = $1,586 -->
   <expected_agi>65054</expected_agi>
   <expected_taxable_income>36054</expected_taxable_income>

   <!-- Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Robert Freelance</name>
         <ssn>456-78-9012</ssn>
         <date_of_birth>7/10/1985</date_of_birth>
         <occupation>Freelance Consultant</occupation>
         <is_self_employed>true</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>0</w2_wages>
         <w2_withholding>0</w2_withholding>
         <se_gross_income>100000</se_gross_income>
         <se_expenses>30000</se_expenses>
         <estimated_payments>8000</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents>
   </dependents>
</job>
