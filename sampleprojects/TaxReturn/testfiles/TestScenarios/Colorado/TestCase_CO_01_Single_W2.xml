   <!-- CO-01: Colorado Single Filer with W-2 Income -->
   <!-- Tax Return Configuration -->
   <id>101</id>
   <tax_year>2025</tax_year>
   <filing_status>SINGLE</filing_status>
   <state>CO</state>
   <city>Denver</city>

   <!-- Expected values for validation -->
   <!-- Federal: W-2 $75,000, Standard deduction $15,000 -->
   <!-- Federal AGI: $75,000 -->
   <!-- Federal Taxable Income: $60,000 -->
   <!-- Federal Tax (approximate): $8,990 -->
   <!-- Colorado: Starts with federal taxable $60,000, 4.40% = $2,640 -->
   <expected_agi>75000</expected_agi>
   <expected_taxable_income>60000</expected_taxable_income>

   <!-- Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Jane Smith</name>
         <ssn>123-45-6789</ssn>
         <date_of_birth>3/15/1990</date_of_birth>
         <occupation>Software Engineer</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>75000</w2_wages>
         <w2_withholding>12000</w2_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents>
   </dependents>
</job>
