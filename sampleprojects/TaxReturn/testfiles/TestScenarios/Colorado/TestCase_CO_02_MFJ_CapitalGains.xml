   <state>CO</state>
   <city>Boulder</city>

   <!-- Expected values for validation -->
   <!-- Federal: W-2 $120,000 + LTCG $50,000 = $170,000 AGI -->
   <!-- Federal Taxable Income: $170,000 - $30,000 = $140,000 -->
   <!-- Colorado: Federal taxable $140,000 - 39% of $50,000 LTCG = $140,000 - $19,500 = $120,500 -->
   <!-- Colorado Tax: $120,500 * 4.40% = $5,302 -->
   <expected_agi>170000</expected_agi>
   <expected_taxable_income>140000</expected_taxable_income>

   <!-- Taxpayers -->
