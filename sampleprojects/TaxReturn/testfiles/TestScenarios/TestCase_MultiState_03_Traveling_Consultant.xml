   <!-- Multi-State Test Case 3: Traveling Consultant Working in Multiple States -->
   <!-- Self-employed consultant worked in NH, IL, and MT throughout the year -->
   <!-- NH: Jan-Apr (120 days), IL: May-Aug (123 days), MT: Sept-Dec (122 days) -->
   <id>MS-03</id>
   <tax_year>2025</tax_year>
   <filing_status>single</filing_status>
   <state>NH</state>
   <city>Portsmouth</city>
   <has_state_income_tax>true</has_state_income_tax>

   <!-- Expected values for validation -->
   <!-- Total Annual SE Net Profit: $120,000 -->
   <!-- NH Period: 120 days = 32.9% → $39,480 -->
   <!-- IL Period: 123 days = 33.7% → $40,440 -->
   <!-- MT Period: 122 days = 33.4% → $40,080 -->
   <expected_agi>120000</expected_agi>
   <expected_nh_allocated_income>39480</expected_nh_allocated_income>
   <expected_il_allocated_income>40440</expected_il_allocated_income>
   <expected_mt_allocated_income>40080</expected_mt_allocated_income>

   <!-- State Periods -->
   <state_periods>
      <state_period id="1">
         <id>1</id>
         <state_code>NH</state_code>
         <start_date>1/1/2025</start_date>
         <end_date>4/30/2025</end_date>
         <resident_status>nonresident</resident_status>
      </state_period>
      <state_period id="2">
         <id>2</id>
         <state_code>IL</state_code>
         <start_date>5/1/2025</start_date>
         <end_date>8/31/2025</end_date>
         <resident_status>nonresident</resident_status>
      </state_period>
      <state_period id="3">
         <id>3</id>
         <state_code>MT</state_code>
         <start_date>9/1/2025</start_date>
         <end_date>12/31/2025</end_date>
         <resident_status>nonresident</resident_status>
      </state_period>
   </state_periods>

   <!-- Taxpayers -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Alex Rodriguez</name>
         <ssn>666-77-8888</ssn>
         <date_of_birth>11/8/1983</date_of_birth>
         <occupation>Management Consultant</occupation>
         <is_self_employed>true</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>0</w2_wages>
         <w2_withholding>0</w2_withholding>
         <se_gross_income>150000</se_gross_income>
         <se_expenses>30000</se_expenses>
         <estimated_payments>25000</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- Incomes -->
   <incomes>
      <income id="1">
         <id>1</id>
         <taxpayer_id>1</taxpayer_id>
         <type>1099-nec</type>
         <source>Client Projects NH</source>
         <gross_amount>39480</gross_amount>
         <withholding>0</withholding>
         <state_code>NH</state_code>
         <state_period_id>1</state_period_id>
         <is_earned>true</is_earned>
      </income>
      <income id="2">
         <id>2</id>
         <taxpayer_id>1</taxpayer_id>
         <type>1099-nec</type>
         <source>Client Projects IL</source>
         <gross_amount>40440</gross_amount>
         <withholding>0</withholding>
         <state_code>IL</state_code>
         <state_period_id>2</state_period_id>
         <is_earned>true</is_earned>
      </income>
      <income id="3">
         <id>3</id>
         <taxpayer_id>1</taxpayer_id>
         <type>1099-nec</type>
         <source>Client Projects MT</source>
         <gross_amount>40080</gross_amount>
         <withholding>0</withholding>
         <state_code>MT</state_code>
         <state_period_id>3</state_period_id>
         <is_earned>true</is_earned>
      </income>
   </incomes>

   <!-- Dependents -->
   <dependents></dependents>

   <!-- Properties -->
   <properties></properties>

   <!-- Vehicles -->
   <vehicles>
      <vehicle id="1">
         <id>1</id>
         <year>2023</year>
         <make>Tesla</make>
         <model>Model 3</model>
         <business_miles>24000</business_miles>
         <total_miles>26000</total_miles>
         <is_actual_expenses>false</is_actual_expenses>
      </vehicle>
   </vehicles>

   <!-- Deductions -->
   <deductions></deductions>
</job>
