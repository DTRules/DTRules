   <!-- OH Test Case 2: Married Filing Jointly with Two Brackets -->
   <id>OH-02</id>
   <tax_year>2025</tax_year>
   <filing_status>married_filing_jointly</filing_status>
   <state>OH</state>
   <city>Cleveland</city>
   <has_state_income_tax>true</has_state_income_tax>

   <!-- Expected values for validation -->
   <!-- Federal AGI: $55,000 -->
   <!-- OH AGI: $55,000 -->
   <!-- OH Exemption: $2,100 per person ($40,000 < AGI ≤ $80,000) -->
   <!-- Total Exemptions: 2 × $2,100 = $4,200 -->
   <!-- OH Taxable Income: $55,000 - $4,200 = $50,800 -->
   <!-- OH Tax: -->
   <!--   Bracket 1 (0% on $0-$26,050): $0 -->
   <!--   Bracket 2 (2.75% on $26,051-$50,800): $24,750 × 0.0275 = $680.625 -->
   <!--   Total: $680.625 -->
   <expected_agi>55000</expected_agi>
   <expected_oh_agi>55000</expected_oh_agi>
   <expected_oh_taxable_income>50800</expected_oh_taxable_income>
   <expected_oh_tax>680.625</expected_oh_tax>

   <!-- Taxpayers -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Bob Williams</name>
         <ssn>222-33-4444</ssn>
         <date_of_birth>8/10/1988</date_of_birth>
         <occupation>Accountant</occupation>
         <is_self_employed>false</is_self_employed>
