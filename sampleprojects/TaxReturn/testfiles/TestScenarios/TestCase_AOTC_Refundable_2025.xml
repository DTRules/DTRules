   <!-- Expected values for validation -->
   <!-- Test: AOTC Refundable/Nonrefundable Split (40%/60%) -->
   <!-- Income: $30,000 W2 wages -->
   <!-- AGI: $30,000 -->
   <!-- Deduction: $15,000 standard -->
   <!-- Taxable: $15,000 -->
   <!-- Tax before credits: ~$1,500 (10% bracket) -->
   <!-- AOTC: $2,500 total ($4,000 expenses * 100% first $2k + 25% next $2k) -->
   <!--   - Nonrefundable: $1,500 (60% of $2,500, but limited by tax liability) -->
   <!--   - Refundable: $1,000 (40% of $2,500, capped at $1,000) -->
   <!-- Withholding: $3,000 -->
   <!-- Net: $0 tax - $1,500 nonrefundable AOTC = $0, then + $1,000 refundable + $3,000 withholding = $4,000 refund -->
