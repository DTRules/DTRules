<!-- Test Case: Schedule SE - Self-Employment Tax (Non-Farm) -->
<!-- Scenario: Freelance graphic designer with net business income below SS wage base -->
<!-- Net SE Income: $95,000 -->
<!-- Expected: SE tax $13,428 (15.3% of $92.35% of $95k = $87,733) -->
<!-- SE deduction: $6,714 (50% of SE tax) -->
