<!-- Test Case: Form 8960 - NIIT on Capital Gains -->
<!-- Scenario: Single filer with long-term capital gains, AGI over $200k -->
<!-- LTCG: $85,000, MAGI: $265,000 -->
<!-- Expected: 3.8% NIIT on lesser of NII ($85k) or excess MAGI ($65k) = $2,470 -->
<job>
    <id>AdditionalTaxes_07</id>
    <tax_year>2025</tax_year>
    <filing_status>Single</filing_status>
    <state>WA</state>

