    <!-- W-2: $175,000 + Interest: $5,000 + LTCG: $85,000 = $265,000 AGI -->
    <!-- Deduction: $15,000 standard -->
    <!-- Taxable: $250,000 -->
    <!-- Income tax: ~$48,697 (with qualified cap gains at 15%) -->
    <!-- NIIT: $2,470 (3.8% on $65,000 excess MAGI over $200k) -->
    <!-- Total tax: $51,167 -->
    <expected_agi>265000</expected_agi>
    <expected_taxable_income>249250</expected_taxable_income>
    <expected_total_tax>47487</expected_total_tax>

    <taxpayers>
        <taxpayer>
            <id>1</id>
