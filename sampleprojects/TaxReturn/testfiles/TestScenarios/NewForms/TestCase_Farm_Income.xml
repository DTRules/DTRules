   <!-- Expected values for validation -->
   <!-- Farm Gross Income: $200,000 + $15,000 + $5,000 = $220,000 -->
   <!-- Farm Expenses: $25,000 + $20,000 + $15,000 + $10,000 + $8,000 + $12,000 + $5,000 + $5,000 = $100,000 -->
   <!-- Net Farm Profit: $220,000 - $100,000 = $120,000 -->
   <!-- Farm SE Tax: $120,000 x 0.9235 x 0.153 = $16,951 -->
   <!-- SE Tax Deduction: $8,476 -->
   <!-- Gross Income: $120,000 -->
   <!-- AGI: $120,000 - $8,476 = $111,524 -->
   <!-- Standard Deduction: $30,000 -->
   <!-- QBI: $120,000 x 0.20 = $24,000 -->
   <!-- Taxable: $111,524 - $30,000 - $24,000 = $57,524 -->
   <expected_agi>111524</expected_agi>
   <expected_taxable_income>57524</expected_taxable_income>

