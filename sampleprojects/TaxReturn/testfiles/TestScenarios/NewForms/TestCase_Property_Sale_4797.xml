   <!-- Test Case: Form 4797 Business Property Sale -->
   <!-- Sale of business equipment with Section 1245 depreciation recapture -->

   <id>4797-01</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>FL</state>
   <city>Miami</city>

   <!-- Expected values for validation -->
   <!-- W-2 Wages: $75,000 -->
   <!-- Equipment Sale: -->
   <!--   Sales Price: $40,000 -->
   <!--   Cost Basis: $50,000 -->
   <!--   Depreciation Taken: $30,000 -->
   <!--   Adjusted Basis: $50,000 - $30,000 = $20,000 -->
   <!--   Total Gain: $40,000 - $20,000 = $20,000 -->
   <!--   Section 1245 Recapture (ordinary): min($30,000, $20,000) = $20,000 -->
   <!--   Section 1231 Gain: $0 -->
   <!-- Gross Income: $75,000 + $20,000 (recapture) = $95,000 -->
   <!-- AGI: $95,000 -->
   <!-- Standard Deduction: $15,000 -->
   <!-- Taxable: $95,000 - $15,000 = $80,000 -->
   <expected_agi>95000</expected_agi>
   <expected_taxable_income>80000</expected_taxable_income>

   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Carlos</name>
         <ssn>901-01-1121</ssn>
         <date_of_birth>9/5/1970</date_of_birth>
         <occupation>Contractor</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>75000</w2_wages>
         <w2_withholding>10000</w2_withholding>
      </taxpayer>
   </taxpayers>

   <dependents></dependents>
   <properties></properties>
   <vehicles></vehicles>
   <deductions></deductions>

   <!-- Form 4797 Property Sale -->
   <property_sales>
      <property_sale id="1">
         <id>1</id>
