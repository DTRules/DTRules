   <!-- Maine State Tax Test Case - Senior with Pension and Social Security -->
   <id>103</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>ME</state>
   <city>Augusta</city>

   <!-- Expected values for validation -->
   <!-- Maine test case: Single senior, W-2 $30,000 + Pension $50,000 + SS $25,000 -->
   <!-- Federal AGI: $30,000 + $50,000 + $21,250 (85% of SS taxable) = $101,250 -->
   <!-- Maine AGI: $101,250 - $25,000 (SS exempt) - $48,216 (max pension deduction) = $28,034 -->
   <!-- ME Standard Deduction: $15,000 -->
   <!-- ME Personal Exemption: $5,150 (1 person) -->
   <!-- ME Taxable Income: $28,034 - $15,000 - $5,150 = $7,884 -->
   <!-- ME Tax: $7,884 × 5.8% = $457.27 (all in first bracket) -->
   <expected_agi>101250</expected_agi>

