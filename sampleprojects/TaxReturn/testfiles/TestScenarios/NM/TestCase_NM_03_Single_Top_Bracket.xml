   <!-- NM Test Case 03: single, $250,000 of wages, in the 5.9% bracket -->
   <id>NM-03</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>NM</state>
   <city>Albuquerque</city>
   <has_state_income_tax>true</has_state_income_tax>

   <!-- Expected values, worked from the state's own form -->
   <!-- Sources: New Mexico 2025 PIT-1 instructions: line 12 federal standard deduction, line 13 deduction for certain dependents, line 14 low- and middle-income exemption worksheet, line 17 taxable income; 2025 Tax Rate Table (PIT-TRT), bands 'more than X but not over X+100', and the page T-7 schedule over $100,000. -->
   <!-- Federal: AGI $250,000; taxable $250,000 - $15,750 = $234,250 -->
   <!-- New Mexico: line 17 $250,000 - $15,750 = $234,250 (over $36,667,
        so no line 14 exemption). Over $100,000, page T-7 schedule, Single
        over $210,000: $9,746 + 5.9% x ($234,250 - $210,000) = $9,746 +
        $1,430.75 = $11,176.75 -> $11,177 -->
   <expected_agi>250000</expected_agi>
   <expected_taxable_income>234250</expected_taxable_income>
   <expected_state_tax>11177</expected_state_tax>

