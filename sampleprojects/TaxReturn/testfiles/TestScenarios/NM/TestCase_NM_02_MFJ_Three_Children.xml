   <has_state_income_tax>true</has_state_income_tax>

   <!-- Expected values, worked from the state's own form -->
   <!-- Sources: New Mexico 2025 PIT-1 instructions: line 12 federal standard deduction, line 13 deduction for certain dependents, line 14 low- and middle-income exemption worksheet, line 17 taxable income; 2025 Tax Rate Table (PIT-TRT), bands 'more than X but not over X+100', and the page T-7 schedule over $100,000. -->
   <!-- Federal: AGI $52,000; taxable $52,000 - $31,500 = $20,500 -->
   <!-- New Mexico: line 12 $31,500. Line 13: (3 dependents - 1) x $4,000 =
        $8,000. Line 14: $2,500 - 10% x ($52,000 - $30,000) = $300, x 5
        exemptions = $1,500. Line 17: $52,000 - $31,500 - $8,000 - $1,500 =
        $11,000. Table row more than $10,900 not over $11,000, Married
        Filing Jointly: $214 (1.5% x 8,000 + 3.2% x 2,950 at the $10,950
        midpoint = $214.40) -->
   <expected_agi>52000</expected_agi>
   <expected_taxable_income>20500</expected_taxable_income>
   <expected_state_tax>214</expected_state_tax>

