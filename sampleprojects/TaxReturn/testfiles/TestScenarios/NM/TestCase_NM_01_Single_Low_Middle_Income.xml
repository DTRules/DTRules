   <!-- NM Test Case 01: single, $34,000 of wages, inside the low- and middle-income exemption -->
   <id>NM-01</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>NM</state>
   <city>Albuquerque</city>
   <has_state_income_tax>true</has_state_income_tax>

   <!-- Expected values, worked from the state's own form -->
   <!-- Sources: New Mexico 2025 PIT-1 instructions: line 12 federal standard deduction, line 13 deduction for certain dependents, line 14 low- and middle-income exemption worksheet, line 17 taxable income; 2025 Tax Rate Table (PIT-TRT), bands 'more than X but not over X+100', and the page T-7 schedule over $100,000. -->
   <!-- Federal: AGI $34,000; taxable $34,000 - $15,750 = $18,250 -->
   <!-- New Mexico: line 12 $15,750. Line 14: $2,500 - 15% x ($34,000 -
        $20,000) = $400, x 1 exemption = $400. Line 17: $34,000 - $15,750 -
        $400 = $17,850. Table row more than $17,800 not over $17,900,
        Single: $493 (1.5% x 5,500 + 3.2% x 11,000 + 4.3% x 1,350 at the
        $17,850 midpoint = $492.55) -->
   <expected_agi>34000</expected_agi>
   <expected_taxable_income>18250</expected_taxable_income>
   <expected_state_tax>493</expected_state_tax>

   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Lucia Montoya</name>
         <ssn>701-11-2301</ssn>
         <date_of_birth>2/14/1994</date_of_birth>
         <occupation>Retail Manager</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>34000</w2_wages>
         <w2_withholding>2900</w2_withholding>
      </taxpayer>
   </taxpayers>

