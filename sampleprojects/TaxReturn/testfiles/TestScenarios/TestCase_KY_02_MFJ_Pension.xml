   <!-- KY Test Case 2: Married Filing Jointly With Pension Income -->
   <id>KY-02</id>
   <tax_year>2025</tax_year>
   <filing_status>married_filing_jointly</filing_status>
   <state>KY</state>
   <city>Lexington</city>
   <has_state_income_tax>true</has_state_income_tax>

   <!-- Expected values for validation -->
   <!-- Federal AGI: $80,000 ($45,000 W-2 + $35,000 pension) -->
   <!-- KY Pension Exclusion: $31,110 (max exclusion) -->
   <!-- KY AGI after exclusion: $48,890 -->
   <!-- KY Standard Deduction: $3,270 -->
   <!-- KY Taxable Income: $45,620 -->
   <!-- KY Tax: $45,620 × 4.0% = $1,824.80 -->
   <expected_agi>80000</expected_agi>
   <expected_ky_agi>48890</expected_ky_agi>
   <expected_ky_taxable_income>45620</expected_ky_taxable_income>
   <expected_ky_tax>1824.80</expected_ky_tax>

