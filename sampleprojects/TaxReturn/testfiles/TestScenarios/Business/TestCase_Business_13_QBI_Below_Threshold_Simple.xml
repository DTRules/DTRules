        </taxpayer>
    </taxpayers>

    <!-- Schedule K-1 from Partnership - QBI Below Threshold -->
    <!-- IRC 199A: QBI deduction for pass-through business income -->
    <!-- Below threshold ($197,300 single): Simple 20% calculation -->
    <!-- No W-2 wage limitation, no SSTB restriction -->
    <k1_incomes>
        <k1_income id="1">
            <id>1</id>
            <source_type>partnership</source_type>
