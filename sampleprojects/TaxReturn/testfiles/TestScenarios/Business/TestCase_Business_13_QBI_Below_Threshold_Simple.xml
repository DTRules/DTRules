<!-- Business Test 13: QBI Deduction - Below Threshold (Form 8995 Simple) -->
<!-- Triggers: Form 8995, Schedule K-1, Form 1040 Line 13 -->
<!-- Tests: 20% QBI deduction for taxpayer below income threshold -->
<job>
    <id>BUS13-QBI-BELOW-THRESHOLD</id>
    <tax_year>2025</tax_year>
    <filing_status>SINGLE</filing_status>
    <state>TX</state>

    <!-- Expected values -->
    <!-- Income: $65,000 W2 + $82,000 K-1 QBI = $147,000 -->
    <!-- AGI: $147,000 -->
    <!-- Standard Deduction: $15,000 -->
    <!-- Taxable before QBI: $132,000 -->
    <!-- QBI Deduction: Lesser of: -->
    <!--   1) 20% of QBI = $82,000 * 0.20 = $16,400 -->
    <!--   2) 20% of taxable income = $132,000 * 0.20 = $26,400 -->
    <!-- QBI Deduction: $16,400 (lesser amount) -->
    <!-- Taxable: $115,600 ($132k - $16,400) -->
    <!-- AGI $147k < $197,300 threshold: No W-2 wage limitation -->
    <expected_agi>147000</expected_agi>
    <expected_taxable_income>115600</expected_taxable_income>

    <taxpayers>
        <taxpayer id="1">
            <id>1</id>
            <name>Brian Jackson</name>
            <ssn>400-23-0001</ssn>
            <date_of_birth>7/12/1985</date_of_birth>
            <is_primary>true</is_primary>
            <occupation>Software Developer + Partner in Dev Shop LLC</occupation>
            <w2_wages>65000</w2_wages>
