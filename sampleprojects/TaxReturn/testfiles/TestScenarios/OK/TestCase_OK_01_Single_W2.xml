   <!-- OK Test Case 01: single, $45,000 of wages -->
   <id>OK-01</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>OK</state>
   <city>Oklahoma City</city>
   <has_state_income_tax>true</has_state_income_tax>

   <!-- Expected values, worked from the state's own form -->
   <!-- Sources: Oklahoma 2025 Form 511 packet: line 10 standard deduction, line 11 $1,000 per exemption, line 13 taxable income, line 14 Income Tax Table (bands 'at least X but less than X+50') and the $100,000-or-more computation on page 38. -->
   <!-- Federal: AGI $45,000; taxable $45,000 - $15,750 = $29,250 -->
   <!-- Oklahoma: line 10 $6,350; line 11 1 exemption x $1,000 = $1,000;
        line 13 $45,000 - $7,350 = $37,650. Table row at least $37,650 but
        less than $37,700, single: $1,601 (bracket tax at the $37,675
        midpoint: $153.50 + 4.75% x $30,475 = $1,601.06) -->
   <expected_agi>45000</expected_agi>
   <expected_taxable_income>29250</expected_taxable_income>
   <expected_state_tax>1601</expected_state_tax>

