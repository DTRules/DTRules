   <!-- OK Test Case 03: head of household, $120,000 of wages, one child, taxable income over $100,000 -->
   <id>OK-03</id>
   <tax_year>2025</tax_year>
   <filing_status>HOH</filing_status>
   <state>OK</state>
   <city>Oklahoma City</city>
   <has_state_income_tax>true</has_state_income_tax>

   <!-- Expected values, worked from the state's own form -->
   <!-- Sources: Oklahoma 2025 Form 511 packet: line 10 standard deduction, line 11 $1,000 per exemption, line 13 taxable income, line 14 Income Tax Table (bands 'at least X but less than X+50') and the $100,000-or-more computation on page 38. -->
   <!-- Federal: AGI $120,000; taxable $120,000 - $23,625 = $96,375 -->
   <!-- Oklahoma: line 10 $9,350; line 11 2 exemptions x $1,000 = $2,000;
        line 13 $120,000 - $11,350 = $108,650. $100,000 or more, married
        filing joint / head of household computation: $4,373 plus 0.0475 x
        ($108,650 - $100,000) = $4,373 + $410.88 = $4,783.88 -> $4,784 -->
   <expected_agi>120000</expected_agi>
   <expected_taxable_income>96375</expected_taxable_income>
   <expected_state_tax>4784</expected_state_tax>

