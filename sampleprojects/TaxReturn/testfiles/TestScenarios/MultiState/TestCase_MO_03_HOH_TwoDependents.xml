   <!-- Missouri Test Case 03: Head of Household with two dependents -->
   <!-- Tests MO HOH standard deduction and progressive tax brackets -->

   <id>MO-03</id>
   <tax_year>2025</tax_year>
   <filing_status>HOH</filing_status>
   <state>MO</state>
   <city>Springfield</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $62,000 W-2 -->
   <!-- Federal: AGI $62,000; standard deduction $23,625 (HOH; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $62,000 - $23,625 = $38,375; tax $4,265 (2025 HOH schedule, Rev. Proc. 2024-40) -->
   <!-- Child tax credit 2 x $2,200 = $4,400 (2025, IRC 24(h)); tax after credit $0 -->
   <!-- Missouri (2025 Form MO-1040 and 2025 Tax Chart, dor.mo.gov): line 11 federal tax is
        Form 1040 line 22 (after nonrefundable credits), $0; line 12 percentage for
        Missouri AGI $62,000 is 15%; line 13 federal income tax deduction $0 (cap $5,000/$10,000);
        line 14 standard deduction $23,625; line 15 head of household exemption $1,400 -->
   <!-- Line 29 taxable income $36,975; chart: $256 + 4.7% of the excess over $9,191 = $1,562 -->
   <!-- expected_state_tax was $1682, not derived from the state's 2025 form (#1317). -->
   <expected_agi>62000</expected_agi>
   <expected_taxable_income>38375</expected_taxable_income>
      <!-- expected_federal_tax is read by nothing and is left as it was; the 2025 figure is in the derivation above (#1317). -->
   <expected_federal_tax>0</expected_federal_tax>
   <expected_state_tax>1562</expected_state_tax>
   <expected_total_tax>0</expected_total_tax>

   <!-- Head of Household Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
