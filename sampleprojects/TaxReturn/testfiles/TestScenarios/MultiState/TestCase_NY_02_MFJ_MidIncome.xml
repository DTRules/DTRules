   <!-- New York Test Case 02: MFJ with dual W-2 income -->
   <!-- Tests NY progressive tax through brackets 1-5 (4%, 4.5%, 5.25%, 5.5%, 6%) -->

   <id>NY-02</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>NY</state>
   <city>New York City</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $150,000 + $100,000 W-2 = $250,000 -->
   <!-- Federal: AGI $250,000; standard deduction $31,500 (MFJ; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $250,000 - $31,500 = $218,500; tax $38,134 (2025 MFJ schedule, Rev. Proc. 2024-40) -->
   <!-- New York (2025 Form IT-201): standard deduction $16,050 MFJ (IT-201-I page 10); NY taxable
        income $250,000 - $16,050 = $233,950. NYAGI is over $107,650, so IT-201-I tax computation worksheet 2
        applies: line 3 rate-schedule tax $8,553 + 6.00% of ($233,950 - $161,550) = $12,897; line 4 recapture base
        $333; line 5 incremental benefit $807; line 6 NYAGI over $161,550 = $88,450, line 7 the lesser of that
        or $50,000 = $50,000, line 8 = 1.0000, line 9 = $807; line 10 tax $14,037 -->
   <!-- expected_state_tax was $12897, not derived from the state's 2025 form (#1317). -->
   <expected_agi>250000</expected_agi>
   <expected_taxable_income>218500</expected_taxable_income>
   <expected_state_tax>14037</expected_state_tax>

