   <!-- Virginia Test Case 02: Married Filing Jointly with moderate income -->
   <!-- Tests Virginia progressive tax - exercising all 4 brackets -->

   <id>VA-02</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>VA</state>
   <city>Norfolk</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $65,000 + $45,000 W-2 = $110,000 -->
   <!-- Federal: AGI $110,000; standard deduction $31,500 (MFJ; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $110,000 - $31,500 = $78,500; tax $8,943 (2025 MFJ schedule, Rev. Proc. 2024-40) -->
   <!-- Virginia (2025 Form 760 instructions and 2025 Tax Rate Schedule, tax.virginia.gov):
        standard deduction $17,500 (2025); personal exemptions 2 x $930 = $1,860; Virginia taxable income
        $110,000 - $17,500 - $1,860 = $90,640; rate schedule $720 + 5.75% of ($90,640 - $17,000) = $4,954.30, rounded $4,954 -->
   <!-- Spouse tax adjustment (Form 760 line 17, worksheet page 11): each spouse's separate
        VAGI less exemption ($64,070, $44,070) exceeds $17,000 and taxable income exceeds $34,000, so the
        adjustment is the $259 maximum; tax after adjustment $4,695 -->
   <!-- expected_state_tax was $5061.25, not derived from the state's 2025 form (#1317). -->
   <expected_agi>110000</expected_agi>
   <expected_taxable_income>78500</expected_taxable_income>
   <expected_federal_tax>8943</expected_federal_tax>
   <expected_state_tax>4695</expected_state_tax>
   <expected_total_tax>8943</expected_total_tax>

