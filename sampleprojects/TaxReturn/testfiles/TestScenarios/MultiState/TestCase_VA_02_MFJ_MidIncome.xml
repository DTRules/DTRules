   <!-- Virginia Test Case 02: Married Filing Jointly with moderate income -->
   <!-- Tests Virginia progressive tax - exercising all 4 brackets -->

   <id>VA-02</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>VA</state>
   <city>Norfolk</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $65,000 W2 (primary) + $45,000 W2 (spouse) = $110,000 -->
   <!-- Federal AGI: $110,000 (no adjustments) -->
   <!-- Federal Standard Deduction: $30,000 (MFJ per Rev. Proc. 2024-40) -->
   <!-- Federal Taxable: $80,000 -->
   <!-- Federal Tax: $9,168 (10% on $23,850 + 12% on $56,150) -->
   <!-- VA AGI: $110,000 -->
   <!-- VA Standard Deduction: $17,500 (MFJ) -->
   <!-- VA Taxable Income: $92,500 -->
   <!-- VA Tax Calculation (progressive): -->
   <!--   Bracket 1 (2% on first $3,000): $60 -->
   <!--   Bracket 2 (3% on $3,001-$5,000): $60 -->
   <!--   Bracket 3 (5% on $5,001-$17,000): $600 -->
   <!--   Bracket 4 (5.75% on $17,001-$92,500): $4,341.25 -->
   <!--   Total VA Tax: $5,061.25 -->
   <expected_agi>110000</expected_agi>
   <expected_taxable_income>80000</expected_taxable_income>
   <expected_federal_tax>9168</expected_federal_tax>
   <expected_state_tax>5061.25</expected_state_tax>
   <expected_total_tax>14229.25</expected_total_tax>

