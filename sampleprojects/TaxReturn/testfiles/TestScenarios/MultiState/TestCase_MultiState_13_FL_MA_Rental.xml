   <!-- FL resident with a rental property in MA. Florida has no income tax; Massachusetts
        taxes the rent as a non-resident and prorates the personal exemption by the share
        of this taxpayer's income that is from Massachusetts (#1201).

        Federal (2025): AGI = 90,000 wages + 30,000 rent = $120,000;
        taxable income = 120,000 - 15,750 single standard deduction = $104,250.

        Massachusetts, worked from the 2025 Form 1-NR/PY and its instructions
        (mass.gov/doc/2025-form-1-nrpy-instructions/download):
          line 12/14a  Massachusetts 5.0% income (the rent)             $30,000
          line 14e     non-Massachusetts source income (the wages)      $90,000
          line 14f     total income                                     $120,000
          line 14g     deduction and exemption ratio: 30,000 / 120,000  = 0.2500 (4 decimal places)
          line 4a/22a  personal exemption, single                       $4,400
          line 22      nonresidents: 22a x 14g = 4,400 x 0.2500         = $1,100
          line 23      5.0% income after exemptions: 30,000 - 1,100     = $28,900
          line 26      tax on 5.0% income: 28,900 x 0.05                = $1,445.00
        Rent rather than wages so that the line 15 FICA deduction (up to $2,000 of
        Social Security tax on Massachusetts wages), which MA_Tax does not model,
        does not enter the figure. -->
   <id>MS-13-FL-MA-RENTAL</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>FL</state>

   <expected_agi>120000</expected_agi>
   <expected_taxable_income>104250</expected_taxable_income>
   <expected_ma_nonresident_tax>1445.00</expected_ma_nonresident_tax>

   <state_periods>
      <state_period id="1">
         <id>1</id>
         <state_code>FL</state_code>
         <start_date>1/1/2025</start_date>
         <end_date>12/31/2025</end_date>
         <resident_status>full_year</resident_status>
      </state_period>
      <state_period id="2">
         <id>2</id>
         <state_code>MA</state_code>
         <start_date>1/1/2025</start_date>
         <end_date>12/31/2025</end_date>
         <resident_status>nonresident</resident_status>
      </state_period>
   </state_periods>

   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Test Taxpayer</name>
         <date_of_birth>3/14/1985</date_of_birth>
         <is_primary>true</is_primary>
         <w2_wages>90000</w2_wages>
      </taxpayer>
   </taxpayers>

   <incomes>
      <income id="1">
         <id>1</id>
         <taxpayer_id>1</taxpayer_id>
         <type>w2_wages</type>
         <source>Employer in FL</source>
         <gross_amount>90000</gross_amount>
         <state_code>FL</state_code>
      </income>
      <income id="2">
         <id>2</id>
         <taxpayer_id>1</taxpayer_id>
         <type>rental</type>
         <source>Rental property in MA</source>
         <gross_amount>30000</gross_amount>
         <state_code>MA</state_code>
      </income>
   </incomes>

   <dependents></dependents>
   <properties></properties>
   <vehicles></vehicles>
   <deductions></deductions>
</job>
