         <gross_amount>85000</gross_amount>
         <withholding>14000</withholding>
         <state_code>NJ</state_code>
         <state_period_id>2</state_period_id>
         <work_location>Jersey City</work_location>
         <days_worked>240</days_worked>
      </income>
   </incomes>

