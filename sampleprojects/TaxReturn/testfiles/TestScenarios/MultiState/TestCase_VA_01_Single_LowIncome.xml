   <!-- Virginia Test Case 01: Single filer with low income -->
   <!-- Tests Virginia progressive tax - primarily in lower brackets -->

   <id>VA-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>VA</state>
   <city>Richmond</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $20,000 W2 -->
   <!-- Federal AGI: $20,000 (no adjustments) -->
   <!-- Federal Standard Deduction: $15,000 (Single per Rev. Proc. 2024-40) -->
   <!-- Federal Taxable: $5,000 -->
   <!-- Federal Tax: $500 (10% on $5,000) -->
   <!-- VA AGI: $20,000 -->
   <!-- VA Standard Deduction: $8,750 -->
   <!-- VA Taxable Income: $11,250 -->
   <!-- VA Tax Calculation (progressive): -->
   <!--   Bracket 1 (2% on first $3,000): $60 -->
   <!--   Bracket 2 (3% on $3,001-$5,000): $60 -->
   <!--   Bracket 3 (5% on $5,001-$11,250): $312.50 -->
   <!--   Total VA Tax: $432.50 -->
   <expected_agi>20000</expected_agi>
   <expected_taxable_income>5000</expected_taxable_income>
   <expected_federal_tax>500</expected_federal_tax>
   <expected_state_tax>432.50</expected_state_tax>
   <expected_total_tax>932.50</expected_total_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Emily Carter</name>
         <ssn>333-44-5555</ssn>
         <date_of_birth>3/15/1995</date_of_birth>
         <occupation>Retail Worker</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>20000</w2_wages>
         <w2_withholding>800</w2_withholding>
         <state_withholding>500</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions (standard is better) -->
   <deductions></deductions>
</job>
