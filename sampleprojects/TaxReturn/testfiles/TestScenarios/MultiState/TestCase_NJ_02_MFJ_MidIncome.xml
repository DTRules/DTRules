   <!-- New Jersey Test Case 02: Married filing jointly with mid income -->
   <!-- Tests NJ progressive tax brackets for MFJ (2.45%, 3.5%, 5.525%) -->

   <id>NJ-02</id>
   <tax_year>2025</tax_year>
   <filing_status>M</filing_status>
   <state>NJ</state>
   <city>Trenton</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $100,000 W2 combined -->
   <!-- Federal AGI: $100,000 -->
   <!-- Federal Standard Deduction: $30,000 (MFJ) -->
   <!-- Federal Taxable: $70,000 -->
   <!-- Federal Tax: $7,859 (10% on $23,850 + 12% on $46,150) -->
   <!-- NJ uses AGI minus 2x personal exemption: $100,000 - $2,000 = $98,000 -->
   <!-- NJ Tax MFJ brackets: -->
   <!--   $280 (1.4% on $20,000) -->
   <!--   + $525 (1.75% on $30,000) -->
   <!--   + $490 (2.45% on $20,000) -->
   <!--   + $350 (3.5% on $10,000) -->
   <!--   + $995 (5.525% on $18,000) -->
   <!--   = $2,640 -->
   <expected_agi>100000</expected_agi>
   <expected_taxable_income>70000</expected_taxable_income>
   <expected_federal_tax>7859</expected_federal_tax>
   <expected_state_tax>2640</expected_state_tax>
   <expected_total_tax>10499</expected_total_tax>

