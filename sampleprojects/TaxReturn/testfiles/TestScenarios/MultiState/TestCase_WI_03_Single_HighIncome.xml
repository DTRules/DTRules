   <!-- Wisconsin Test Case 03: Single filer with high income -->
   <!-- Tests all 4 Wisconsin progressive tax brackets including top 7.65% rate -->

   <id>WI-03</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>WI</state>
   <city>Green Bay</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $400,000 W-2 -->
   <!-- Federal: AGI $400,000; standard deduction $15,750 (Single; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $400,000 - $15,750 = $384,250; tax $104,034.75 (2025 Single schedule, Rev. Proc. 2024-40) -->
   <!-- Additional Medicare tax (Form 8959): 0.9% of wages over $200,000 = $1,800; total $105,834.75 -->
   <!-- Wisconsin (2025 Form 1 instructions, revenue.wi.gov/TaxForms2025/2025-Form1-Inst.pdf):
        line 8 standard deduction $0 (the single deduction is fully phased out above the table); line 10 exemptions 1 x $700 = $700;
        line 11 taxable income $400,000 - $0 - $700 = $399,300 -->
   <!-- Line 12 tax from the Tax Computation Worksheet (taxable income $100,000 or more), Section A,
        $323,290 or over: $399,300 x 7.65% - $8,183.76 = $22,362.69 -->
   <!-- expected_state_tax was $21325, not derived from the state's 2025 form (#1317). -->
   <expected_agi>400000</expected_agi>
   <expected_taxable_income>384250</expected_taxable_income>
      <!-- expected_federal_tax is read by nothing and is left as it was; the 2025 figure is in the derivation above (#1317). -->
   <expected_federal_tax>110851</expected_federal_tax>
   <expected_state_tax>22363</expected_state_tax>
   <expected_total_tax>105834.75</expected_total_tax>

   <!-- Single High-Income Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Robert Williams</name>
         <ssn>666-77-8888</ssn>
         <date_of_birth>11/22/1978</date_of_birth>
         <occupation>Physician</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>400000</w2_wages>
         <w2_withholding>120000</w2_withholding>
         <state_withholding>22000</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions (standard is better) -->
   <deductions></deductions>
