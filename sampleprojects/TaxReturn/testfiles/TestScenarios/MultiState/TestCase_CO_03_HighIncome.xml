   <!-- Colorado Test Case 03: High income single filer -->
   <!-- Tests Colorado flat 4.4% tax on higher income -->

   <id>CO-03</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>CO</state>
   <city>Colorado Springs</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $250,000 W-2 -->
   <!-- Federal: AGI $250,000; standard deduction $15,750 (Single; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $250,000 - $15,750 = $234,250; tax $52,023 (2025 Single schedule, Rev. Proc. 2024-40) -->
   <!-- Additional Medicare tax (Form 8959): 0.9% of wages over $200,000 = $450; total $52,473 -->
   <!-- Colorado (2025 DR 0104): line 1 is federal taxable income, Form 1040 line 15,
        $234,250; no additions or subtractions; tax at the 4.4% rate (2025 DR 0104EZ
        instructions: 'The income tax rate is currently 4.4%') = $10,307 -->
   <!-- expected_state_tax was $10340, not derived from the state's 2025 form (#1317). -->
   <expected_agi>250000</expected_agi>
   <expected_taxable_income>234250</expected_taxable_income>
      <!-- expected_federal_tax is read by nothing and is left as it was; the 2025 figure is in the derivation above (#1317). -->
   <expected_federal_tax>50673</expected_federal_tax>
   <expected_state_tax>10307</expected_state_tax>
   <expected_total_tax>52473</expected_total_tax>

   <!-- Single High-Income Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>David Martinez</name>
         <ssn>555-66-7777</ssn>
         <date_of_birth>2/28/1980</date_of_birth>
         <occupation>Physician</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>250000</w2_wages>
         <w2_withholding>60000</w2_withholding>
         <state_withholding>11000</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions (standard is better) -->
   <deductions></deductions>
</job>
