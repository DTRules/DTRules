   <!-- Ohio Test Case 01: Single filer with low income (under exemption threshold) -->
   <!-- Tests Ohio 0% bracket and low-income personal exemption -->

   <id>OH-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>OH</state>
   <city>Columbus</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $20,000 W-2 -->
   <!-- Federal: AGI $20,000; standard deduction $15,750 (Single; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $20,000 - $15,750 = $4,250; tax $425 (2025 Single schedule, Rev. Proc. 2024-40) -->
   <!-- Ohio (2025 IT 1040 booklet, tax.ohio.gov): exemption $2,400 per exemption at MAGI $20,000,
        1 exemption = $2,400; Ohio taxable income $20,000 - $2,400 = $17,600; 2025 brackets (IT 1040 line 8a;
        R.C. 5747.02): $17,600 is not over $26,050, so the tax is $0 (0% bracket) -->
   <!-- expected_state_tax, $0, agrees with the state's 2025 form (#1317). -->
   <expected_agi>20000</expected_agi>
   <expected_taxable_income>4250</expected_taxable_income>
      <!-- expected_federal_tax is read by nothing and is left as it was; the 2025 figure is in the derivation above (#1317). -->
   <expected_federal_tax>500</expected_federal_tax>
   <expected_state_tax>0</expected_state_tax>
   <expected_total_tax>425</expected_total_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>David Miller</name>
         <ssn>333-44-5555</ssn>
         <date_of_birth>6/15/1995</date_of_birth>
         <occupation>Retail Worker</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>20000</w2_wages>
         <w2_withholding>2500</w2_withholding>
         <state_withholding>0</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions (standard is better) -->
   <deductions></deductions>
</job>
