   <!-- Ohio Test Case 01: Single filer with low income (under exemption threshold) -->
   <!-- Tests Ohio 0% bracket and low-income personal exemption -->

   <id>OH-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>OH</state>
   <city>Columbus</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $20,000 W2 -->
   <!-- Federal AGI: $20,000 (no adjustments) -->
   <!-- Federal Standard Deduction: $15,000 (Single per Rev. Proc. 2024-40) -->
   <!-- Federal Taxable: $5,000 -->
   <!-- Federal Tax: $500 (10% on $5,000) -->
   <!-- OH Personal Exemption: $2,350 (AGI &lt;= $40,000) -->
   <!-- OH Taxable: $20,000 - $2,350 = $17,650 -->
   <!-- OH Tax: $0 (taxable income $17,650 is below $26,050 threshold, 0% bracket) -->
   <!-- Withholding: $2,500 federal + $0 state -->
   <!-- Federal Refund: $2,000 -->
   <!-- State Refund: $0 -->
   <expected_agi>20000</expected_agi>
   <expected_taxable_income>5000</expected_taxable_income>
   <expected_federal_tax>500</expected_federal_tax>
   <expected_state_tax>0</expected_state_tax>
   <expected_total_tax>500</expected_total_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>David Miller</name>
         <ssn>333-44-5555</ssn>
         <date_of_birth>6/15/1995</date_of_birth>
         <occupation>Retail Worker</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>20000</w2_wages>
         <w2_withholding>2500</w2_withholding>
         <state_withholding>0</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions (standard is better) -->
   <deductions></deductions>
</job>
