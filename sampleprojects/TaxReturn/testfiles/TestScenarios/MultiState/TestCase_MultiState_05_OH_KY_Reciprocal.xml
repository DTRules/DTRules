   <!-- Multi-State Test Case 5: OH-KY Reciprocal Agreement -->
   <!-- Live in OH, work in KY - reciprocal agreement applies -->
   <!-- Tests: Reciprocal agreement, no KY tax, only OH tax on wages -->
   <!-- OH and KY have reciprocal agreement - KY does not tax OH residents -->
   <id>MS-05-OH-KY</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>OH</state>
   <city>Cincinnati</city>

