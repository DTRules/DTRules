   <!-- Utah Test Case 02: Married filing jointly with two incomes -->
   <!-- Tests Utah flat 4.5% tax with Taxpayer Tax Credit for joint filers -->

   <id>UT-02</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>UT</state>
   <city>Provo</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $80,000 + $65,000 = $145,000 W2 -->
   <!-- Federal AGI: $145,000 -->
   <!-- Federal Standard Deduction: $30,000 (MFJ) -->
   <!-- Federal Taxable: $115,000 -->
   <!-- UT Taxable: $115,000 -->
   <!-- UT Base Tax: $5,175 (4.5% of $115,000) -->
   <!-- UT Taxpayer Credit: $1,890 (6% of $31,500 standard deduction) -->
   <!-- UT Final Tax: $3,285 ($5,175 - $1,890) -->
   <!-- Withholding: $22,000 federal + $4,000 state -->
   <expected_agi>145000</expected_agi>
   <expected_taxable_income>113500</expected_taxable_income>
   <expected_state_tax>3285</expected_state_tax>

   <!-- Married Taxpayers -->
