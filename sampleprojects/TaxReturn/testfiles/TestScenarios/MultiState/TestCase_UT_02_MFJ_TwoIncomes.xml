   <!-- Utah Test Case 02: Married filing jointly with two incomes -->
   <!-- Tests Utah flat 4.5% tax with Taxpayer Tax Credit for joint filers -->

   <id>UT-02</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>UT</state>
   <city>Provo</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $80,000 + $65,000 W-2 = $145,000 -->
   <!-- Federal: AGI $145,000; standard deduction $31,500 (MFJ; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $145,000 - $31,500 = $113,500; tax $14,798 (2025 MFJ schedule, Rev. Proc. 2024-40) -->
   <!-- Utah (2025 TC-40, files.tax.utah.gov/tax/forms/current/tc-40.pdf): line 9 Utah taxable
        income $145,000 (no additions or subtractions); line 10 tax 4.5% = $6,525; taxpayer tax credit:
        line 11 0 dependents x $2,111 = $0, line 12 federal standard deduction $31,500, line 13 $31,500,
        line 16 6% = $1,890, line 17 $36,426, line 18 $108,574, line 19 1.3% = $1,411.46, line 20 credit $478.54;
        line 22 Utah income tax $6,525 - $478.54 = $6,046 -->
   <!-- expected_state_tax was $3285, not derived from the state's 2025 form (#1317). -->
   <expected_agi>145000</expected_agi>
   <expected_taxable_income>113500</expected_taxable_income>
   <expected_state_tax>6046</expected_state_tax>

   <!-- Married Taxpayers -->
   <taxpayers>
