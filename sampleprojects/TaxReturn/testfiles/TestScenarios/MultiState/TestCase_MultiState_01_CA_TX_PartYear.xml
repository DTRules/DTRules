   <!-- Multi-State Test Case 1: CA to TX Move (Part-Year Resident) -->
   <!-- High-tax state (CA) to no-tax state (TX) mid-year move -->
   <!-- Tests: Part-year resident allocation, CA tax on CA portion only -->
   <!-- Move Date: June 30, 2025 (181 days in CA, 184 days in TX) -->
   <id>MS-01-CA-TX</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>TX</state>
   <city>Austin</city>

   <!-- Expected values for validation -->
   <!-- Total W-2 Income: $180,000 -->
   <!-- CA Period: Jan 1 - June 30 (181 days) = 49.6% of year -->
   <!-- CA Allocated Income: $180,000 × 49.6% = $89,280 -->
   <!-- TX has no state income tax -->
   <!-- CA Tax (part-year resident): Based on $89,280 CA-source income -->
