   <!-- Minnesota Test Case 03: Single filer with high income (Bracket 4) -->
   <!-- Tests MN progressive brackets: 5.35% + 6.80% + 7.85% + 9.85% -->

   <id>MN-03</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>MN</state>
   <city>Rochester</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $250,000 W-2 -->
   <!-- Federal: AGI $250,000; standard deduction $15,750 (Single; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $250,000 - $15,750 = $234,250; tax $52,023 (2025 Single schedule, Rev. Proc. 2024-40) -->
   <!-- Additional Medicare tax (Form 8959): 0.9% of wages over $200,000 = $450; total $52,473 -->
   <!-- Minnesota (2025 Form M1; 2025 brackets and standard deduction from the
        Department of Revenue, revenue.state.mn.us/mndor-pp/20636): standard deduction
        single $14,950; taxable $250,000 - $14,950 = $235,050; $32,570 x 5.35% = $1,742.49; $74,420 x 6.80% = $5,060.56; $91,640 x 7.85% = $7,193.74; $36,420 x 9.85% = $3,587.37;
        tax $17,584.17. The M1 tax table (used under $100,000) is computed at the midpoint of
        each $100 band, which is this figure here. -->
   <!-- expected_state_tax was $17583, not derived from the state's 2025 form (#1317). -->
   <expected_agi>250000</expected_agi>
   <expected_taxable_income>234250</expected_taxable_income>
   <expected_state_tax>17584</expected_state_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Jennifer Williams</name>
         <ssn>555-66-7777</ssn>
         <date_of_birth>11/8/1982</date_of_birth>
         <occupation>Physician</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>250000</w2_wages>
         <w2_withholding>50000</w2_withholding>
         <state_withholding>18000</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

