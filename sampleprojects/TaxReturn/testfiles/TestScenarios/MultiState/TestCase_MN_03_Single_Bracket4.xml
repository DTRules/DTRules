   <!-- Minnesota Test Case 03: Single filer with high income (Bracket 4) -->
   <!-- Tests MN progressive brackets: 5.35% + 6.80% + 7.85% + 9.85% -->

   <id>MN-03</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>MN</state>
   <city>Rochester</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $250,000 W2 -->
   <!-- Federal AGI: $250,000 (no adjustments) -->
   <!-- Federal Standard Deduction: $15,000 (Single per Rev. Proc. 2024-40) -->
   <!-- Federal Taxable: $235,000 -->
   <!-- MN AGI: $250,000 -->
   <!-- MN Standard Deduction: $14,950 -->
   <!-- MN Taxable: $235,050 -->
   <!-- MN Tax Calculation: -->
   <!--   Bracket 1: $32,570 * 5.35% = $1,742.50 -->
   <!--   Bracket 2: ($106,990 - $32,570) * 6.80% = $5,060.56 -->
   <!--   Bracket 3: ($198,630 - $106,990) * 7.85% = $7,193.74 -->
   <!--   Bracket 4: ($235,050 - $198,630) * 9.85% = $3,586.37 -->
   <!--   Total: $17,583.17 -->
   <expected_agi>250000</expected_agi>
   <expected_taxable_income>235000</expected_taxable_income>
   <expected_state_tax>17583</expected_state_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Jennifer Williams</name>
         <ssn>555-66-7777</ssn>
         <date_of_birth>11/8/1982</date_of_birth>
         <occupation>Physician</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>250000</w2_wages>
         <w2_withholding>50000</w2_withholding>
         <state_withholding>18000</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

