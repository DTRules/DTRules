   <!-- Minnesota Test Case 01: Single filer with low income (Bracket 1) -->
   <!-- Tests MN 5.35% tax on first bracket -->

   <id>MN-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>MN</state>
   <city>Minneapolis</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $40,000 W-2 -->
   <!-- Federal: AGI $40,000; standard deduction $15,750 (Single; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $40,000 - $15,750 = $24,250; tax $2,671.50 (2025 Single schedule, Rev. Proc. 2024-40) -->
   <!-- Minnesota (2025 Form M1; 2025 brackets and standard deduction from the
        Department of Revenue, revenue.state.mn.us/mndor-pp/20636): standard deduction
        single $14,950; taxable $40,000 - $14,950 = $25,050; $25,050 x 5.35% = $1,340.17;
        tax $1,340.17. The M1 tax table (used under $100,000) is computed at the midpoint of
        each $100 band, which is this figure here. -->
   <!-- expected_state_tax, $1340, agrees with the state's 2025 form (#1317). -->
   <expected_agi>40000</expected_agi>
   <expected_taxable_income>24250</expected_taxable_income>
   <expected_state_tax>1340</expected_state_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Emily Anderson</name>
         <ssn>333-44-5555</ssn>
         <date_of_birth>3/15/1990</date_of_birth>
         <occupation>Librarian</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>40000</w2_wages>
         <w2_withholding>4000</w2_withholding>
         <state_withholding>1500</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions (standard is better) -->
   <deductions></deductions>
</job>
