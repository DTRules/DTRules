   <!-- Minnesota Test Case 01: Single filer with low income (Bracket 1) -->
   <!-- Tests MN 5.35% tax on first bracket -->

   <id>MN-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>MN</state>
   <city>Minneapolis</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $40,000 W2 -->
   <!-- Federal AGI: $40,000 (no adjustments) -->
   <!-- Federal Standard Deduction: $15,000 (Single per Rev. Proc. 2024-40) -->
   <!-- Federal Taxable: $25,000 -->
   <!-- MN AGI: $40,000 -->
   <!-- MN Standard Deduction: $14,950 -->
   <!-- MN Taxable: $25,050 -->
   <!-- MN Tax: $1,340.18 (5.35% of $25,050 - all in bracket 1) -->
   <expected_agi>40000</expected_agi>
   <expected_taxable_income>24250</expected_taxable_income>
   <expected_state_tax>1340</expected_state_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Emily Anderson</name>
         <ssn>333-44-5555</ssn>
         <date_of_birth>3/15/1990</date_of_birth>
         <occupation>Librarian</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>40000</w2_wages>
         <w2_withholding>4000</w2_withholding>
         <state_withholding>1500</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions (standard is better) -->
   <deductions></deductions>
</job>
