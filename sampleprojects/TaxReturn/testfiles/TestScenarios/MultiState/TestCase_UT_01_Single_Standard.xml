   <!-- Utah Test Case 01: Single filer with moderate income -->
   <!-- Tests Utah flat 4.5% tax with Taxpayer Tax Credit -->

   <id>UT-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>UT</state>
   <city>Salt Lake City</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $60,000 W-2 -->
   <!-- Federal: AGI $60,000; standard deduction $15,750 (Single; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $60,000 - $15,750 = $44,250; tax $5,071.50 (2025 Single schedule, Rev. Proc. 2024-40) -->
   <!-- Utah (2025 TC-40, files.tax.utah.gov/tax/forms/current/tc-40.pdf): line 9 Utah taxable
        income $60,000 (no additions or subtractions); line 10 tax 4.5% = $2,700; taxpayer tax credit:
        line 11 0 dependents x $2,111 = $0, line 12 federal standard deduction $15,750, line 13 $15,750,
        line 16 6% = $945, line 17 $18,213, line 18 $41,787, line 19 1.3% = $543.23, line 20 credit $401.77;
        line 22 Utah income tax $2,700 - $401.77 = $2,298 -->
   <!-- expected_state_tax was $1080, not derived from the state's 2025 form (#1317). -->
   <expected_agi>60000</expected_agi>
   <expected_taxable_income>44250</expected_taxable_income>
   <expected_state_tax>2298</expected_state_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Emily Parker</name>
         <ssn>333-44-5555</ssn>
         <date_of_birth>3/15/1990</date_of_birth>
         <occupation>Software Developer</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>60000</w2_wages>
         <w2_withholding>9000</w2_withholding>
         <state_withholding>1200</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions -->
   <deductions></deductions>
</job>
