   <!-- Missouri Test Case 02: Married Filing Jointly with mid-level income -->
   <!-- Tests MO standard deduction for MFJ and all 8 progressive brackets -->

   <id>MO-02</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>MO</state>
   <city>St. Louis</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $75,000 + $55,000 = $130,000 -->
   <!-- Federal AGI: $130,000 (no adjustments) -->
   <!-- Federal Standard Deduction: $30,000 (MFJ per Rev. Proc. 2024-40) -->
   <!-- Federal Taxable: $100,000 -->
   <!-- Federal Tax: 10% × $23,200 + 12% × $70,650 + 22% × $6,150 = $2,320 + $8,478 + $1,353 = $12,151 -->
   <!-- MO Standard Deduction: $30,000 (MFJ) -->
   <!-- MO Taxable: $130,000 - $30,000 = $100,000 -->
   <!-- MO Tax calculation (all income in top bracket): -->
   <!--   Bracket 1: $1,313 × 0% = $0 -->
   <!--   Bracket 2: $1,313 × 2% = $26.26 -->
   <!--   Bracket 3: $1,313 × 2.5% = $32.83 -->
   <!--   Bracket 4: $1,313 × 3% = $39.39 -->
   <!--   Bracket 5: $1,313 × 3.5% = $45.96 -->
   <!--   Bracket 6: $1,313 × 4% = $52.52 -->
   <!--   Bracket 7: $1,313 × 4.6% = $60.40 -->
   <!--   Bracket 8: ($100,000 - $9,191) = $90,809 × 4.7% = $4,268.02 -->
   <!--   Total MO Tax: $4,525.38 -->
   <!-- Withholding: $15,000 federal + $4,500 state -->
   <expected_agi>130000</expected_agi>
   <expected_taxable_income>98500</expected_taxable_income>
   <expected_federal_tax>12151</expected_federal_tax>
   <expected_state_tax>4525</expected_state_tax>
   <expected_total_tax>10498</expected_total_tax>

