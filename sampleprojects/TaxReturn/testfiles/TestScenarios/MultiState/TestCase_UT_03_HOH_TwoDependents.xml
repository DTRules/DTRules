   <!-- Utah Test Case 03: Head of household with two dependents -->
   <!-- Tests Utah flat 4.5% tax with Taxpayer Tax Credit including personal exemptions -->

   <id>UT-03</id>
   <tax_year>2025</tax_year>
   <filing_status>HOH</filing_status>
   <state>UT</state>
   <city>Ogden</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $95,000 W-2 -->
   <!-- Federal: AGI $95,000; standard deduction $23,625 (HOH; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $95,000 - $23,625 = $71,375; tax $8,877.50 (2025 HOH schedule, Rev. Proc. 2024-40) -->
   <!-- Child tax credit 2 x $2,200 = $4,400 (2025, IRC 24(h)); tax after credit $4,477.50 -->
   <!-- Utah (2025 TC-40, files.tax.utah.gov/tax/forms/current/tc-40.pdf): line 9 Utah taxable
        income $95,000 (no additions or subtractions); line 10 tax 4.5% = $4,275; taxpayer tax credit:
        line 11 2 dependents x $2,111 = $4,222, line 12 federal standard deduction $23,625, line 13 $27,847,
        line 16 6% = $1,670.82, line 17 $27,320, line 18 $67,680, line 19 1.3% = $879.84, line 20 credit $790.98;
        line 22 Utah income tax $4,275 - $790.98 = $3,484 -->
   <!-- expected_state_tax was $1659, not derived from the state's 2025 form (#1317). -->
   <expected_agi>95000</expected_agi>
   <expected_taxable_income>71375</expected_taxable_income>
   <expected_state_tax>3484</expected_state_tax>

