   <!-- Utah Test Case 03: Head of household with two dependents -->
   <!-- Tests Utah flat 4.5% tax with Taxpayer Tax Credit including personal exemptions -->

   <id>UT-03</id>
   <tax_year>2025</tax_year>
   <filing_status>HOH</filing_status>
   <state>UT</state>
   <city>Ogden</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $95,000 W2 -->
   <!-- Federal AGI: $95,000 -->
   <!-- Federal Standard Deduction: $22,500 (HOH) -->
   <!-- Federal Taxable: $72,500 -->
   <!-- UT Taxable: $72,500 -->
   <!-- UT Base Tax: $3,262.50 (4.5% of $72,500) -->
   <!-- UT Taxpayer Credit: 6% of (std_deduction + 2 * personal_exemption) -->
   <!--   = 6% of ($22,500 + 2 * $2,111) = 6% of $26,722 = $1,603.32 -->
   <!-- UT Final Tax: $1,659.18 ($3,262.50 - $1,603.32) -->
   <!-- Withholding: $15,000 federal + $2,000 state -->
   <expected_agi>95000</expected_agi>
   <expected_taxable_income>72500</expected_taxable_income>
   <expected_state_tax>1659</expected_state_tax>

   <!-- Head of Household Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Jennifer Martinez</name>
         <ssn>555-66-7777</ssn>
         <date_of_birth>5/12/1982</date_of_birth>
         <occupation>Marketing Manager</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>95000</w2_wages>
         <w2_withholding>15000</w2_withholding>
         <state_withholding>2000</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- Two qualifying dependents -->
   <dependents>
      <dependent id="1">
         <id>1</id>
         <name>Alex Martinez</name>
         <ssn>666-77-8888</ssn>
         <date_of_birth>3/15/2015</date_of_birth>
         <relationship>Child</relationship>
         <is_qualifying_child>true</is_qualifying_child>
         <is_qualifying_relative>false</is_qualifying_relative>
         <months_lived_with_taxpayer>12</months_lived_with_taxpayer>
      </dependent>
      <dependent id="2">
         <id>2</id>
         <name>Taylor Martinez</name>
         <ssn>666-77-9999</ssn>
         <date_of_birth>8/22/2017</date_of_birth>
         <relationship>Child</relationship>
         <is_qualifying_child>true</is_qualifying_child>
         <is_qualifying_relative>false</is_qualifying_relative>
         <months_lived_with_taxpayer>12</months_lived_with_taxpayer>
      </dependent>
   </dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions -->
   <deductions></deductions>
