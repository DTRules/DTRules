   <!-- Wisconsin Test Case 02: Married filing jointly with mid-level income -->
   <!-- Tests Wisconsin progressive tax brackets 1, 2, and 3 (MFJ) -->

   <id>WI-02</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>WI</state>
   <city>Milwaukee</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $80,000 W2 combined -->
   <!-- Federal AGI: $80,000 (no adjustments) -->
   <!-- Federal Standard Deduction: $30,000 (MFJ per Rev. Proc. 2024-40) -->
   <!-- Federal Taxable: $50,000 -->
   <!-- Federal Tax: $5,150 (10% on $23,850 + 12% on $26,150) -->
   <!-- WI Standard Deduction: $26,510 -->
   <!-- WI Taxable: $80,000 - $26,510 = $53,490 -->
   <!-- WI Tax Bracket 1: $19,090 × 3.5% = $668.15 -->
   <!-- WI Tax Bracket 2: ($38,190 - $19,090) × 4.4% = $840.40 -->
   <!-- WI Tax Bracket 3: ($53,490 - $38,190) × 5.3% = $810.90 -->
   <!-- WI Tax Total: $2,319.45 -->
   <!-- Withholding: $12,000 federal + $2,500 state -->
   <expected_agi>80000</expected_agi>
   <expected_taxable_income>48500</expected_taxable_income>
   <expected_federal_tax>5150</expected_federal_tax>
   <expected_state_tax>2319</expected_state_tax>
   <expected_total_tax>5343</expected_total_tax>

