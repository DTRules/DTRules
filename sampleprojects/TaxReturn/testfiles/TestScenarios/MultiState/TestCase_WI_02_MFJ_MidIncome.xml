   <!-- Wisconsin Test Case 02: Married filing jointly with mid-level income -->
   <!-- Tests Wisconsin progressive tax brackets 1, 2, and 3 (MFJ) -->

   <id>WI-02</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>WI</state>
   <city>Milwaukee</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $50,000 + $30,000 W-2 = $80,000 -->
   <!-- Federal: AGI $80,000; standard deduction $31,500 (MFJ; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $80,000 - $31,500 = $48,500; tax $5,343 (2025 MFJ schedule, Rev. Proc. 2024-40) -->
   <!-- Wisconsin (2025 Form 1 instructions, revenue.wi.gov/TaxForms2025/2025-Form1-Inst.pdf):
        line 8 standard deduction $14,818 (Standard Deduction Table row $80,000 to $80,500, married filing jointly); line 10 exemptions 2 x $700 = $1,400;
        line 11 taxable income $80,000 - $14,818 - $1,400 = $63,782 -->
   <!-- Line 12 tax from the 2025 Tax Table, row $63,700 to $63,800, married filing jointly column: $2,629 (the 2025 rates are 3.5%,
        4.4% from $19,580 and 5.3% from $67,300; 2025 Wis. Act 15 widened the 4.4% bracket) -->
   <!-- Line 18 married couple credit (Schedule 2): 3% of the smaller qualified earned income
        $30,000, capped at $16,000, = $480 (max $480); tax after credit $2,149 -->
   <!-- expected_state_tax was $2319, not derived from the state's 2025 form (#1317). -->
   <expected_agi>80000</expected_agi>
   <expected_taxable_income>48500</expected_taxable_income>
   <expected_federal_tax>5343</expected_federal_tax>
   <expected_state_tax>2149</expected_state_tax>
   <expected_total_tax>5343</expected_total_tax>

