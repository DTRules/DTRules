   <!-- Michigan Test Case 01: Single filer with W-2 income, no dependents -->
   <!-- Tests Michigan flat 4.25% tax with $5,800 personal exemption -->

   <id>MI-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>MI</state>
   <city>Detroit</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $60,000 W2 -->
   <!-- Federal AGI: $60,000 (no adjustments) -->
   <!-- Federal Standard Deduction: $15,000 (Single per Rev. Proc. 2024-40) -->
   <!-- Federal Taxable: $45,000 -->
   <!-- Federal Tax: $5,703 (10% on $11,925 + 12% on $33,075) -->
   <!-- MI Personal Exemption: $5,800 -->
   <!-- MI Taxable Income: $54,200 ($60,000 AGI - $5,800 exemption) -->
   <!-- MI Tax: $2,304 (4.25% of $54,200) -->
   <expected_agi>60000</expected_agi>
   <expected_taxable_income>44250</expected_taxable_income>
   <expected_federal_tax>5703</expected_federal_tax>
   <expected_state_tax>2304</expected_state_tax>
   <expected_total_tax>5071.5</expected_total_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Alex Martinez</name>
         <ssn>333-44-5555</ssn>
         <date_of_birth>7/15/1990</date_of_birth>
         <occupation>Software Engineer</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>60000</w2_wages>
         <w2_withholding>9000</w2_withholding>
         <state_withholding>2500</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions (standard is better) -->
   <deductions></deductions>
</job>
