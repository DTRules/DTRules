   <!-- Colorado Test Case 02: Married filing jointly with two W-2 incomes -->
   <!-- Tests Colorado flat 4.4% tax on federal taxable income -->

   <id>CO-02</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>CO</state>
   <city>Boulder</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $90,000 + $60,000 W-2 = $150,000 -->
   <!-- Federal: AGI $150,000; standard deduction $31,500 (MFJ; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $150,000 - $31,500 = $118,500; tax $15,898 (2025 MFJ schedule, Rev. Proc. 2024-40) -->
   <!-- Colorado (2025 DR 0104): line 1 is federal taxable income, Form 1040 line 15,
        $118,500; no additions or subtractions; tax at the 4.4% rate (2025 DR 0104EZ
        instructions: 'The income tax rate is currently 4.4%') = $5,214 -->
   <!-- expected_state_tax was $5280, not derived from the state's 2025 form (#1317). -->
   <expected_agi>150000</expected_agi>
   <expected_taxable_income>118500</expected_taxable_income>
      <!-- expected_federal_tax is read by nothing and is left as it was; the 2025 figure is in the derivation above (#1317). -->
   <expected_federal_tax>18229</expected_federal_tax>
   <expected_state_tax>5214</expected_state_tax>
   <expected_total_tax>15898</expected_total_tax>

   <!-- Married Couple -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Michael Chen</name>
         <ssn>333-44-5555</ssn>
         <date_of_birth>8/12/1985</date_of_birth>
         <occupation>Software Engineer</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>90000</w2_wages>
         <w2_withholding>15000</w2_withholding>
         <state_withholding>4000</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
      <taxpayer id="2">
         <id>2</id>
         <name>Lisa Chen</name>
         <ssn>444-55-6666</ssn>
         <date_of_birth>11/3/1987</date_of_birth>
         <occupation>Nurse</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>false</is_primary>
         <w2_wages>60000</w2_wages>
         <w2_withholding>8000</w2_withholding>
         <state_withholding>2500</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

