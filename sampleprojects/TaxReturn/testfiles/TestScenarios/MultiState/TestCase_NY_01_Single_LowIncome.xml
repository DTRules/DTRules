   <!-- New York Test Case 01: Single filer with W-2 income -->
   <!-- Tests NY progressive tax through brackets 1-4 (4%, 4.5%, 5.25%, 5.5%) -->

   <id>NY-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>NY</state>
   <city>Albany</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $50,000 W-2 -->
   <!-- Federal: AGI $50,000; standard deduction $15,750 (Single; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $50,000 - $15,750 = $34,250; tax $3,871.50 (2025 Single schedule, Rev. Proc. 2024-40) -->
   <!-- New York (2025 Form IT-201): standard deduction $8,000 Single (IT-201-I page 10);
        NY taxable income $50,000 - $8,000 = $42,000. NYAGI is not over $107,650 and taxable income is
        under $65,000, so the 2025 NYS tax table applies: row at least $42,000 but less than $42,050,
        Single column, $2,147 (rate schedule at the band's midpoint: $600 + 5.5% of the excess over $13,900) -->
   <!-- expected_state_tax was $2145, not derived from the state's 2025 form (#1317). -->
   <expected_agi>50000</expected_agi>
   <expected_taxable_income>34250</expected_taxable_income>
   <expected_state_tax>2147</expected_state_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Emily Chen</name>
         <ssn>333-44-5555</ssn>
         <date_of_birth>3/15/1990</date_of_birth>
         <occupation>Nurse</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>50000</w2_wages>
         <w2_withholding>7000</w2_withholding>
         <state_withholding>2500</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions (standard is better) -->
   <deductions></deductions>
</job>
