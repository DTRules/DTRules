   <!-- Michigan Test Case 02: Married filing jointly with 2 dependents -->
   <!-- Tests Michigan exemptions: $11,600 (2 x $5,800) + $11,600 (2 dependents) = $23,200 total -->

   <id>MI-02</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>MI</state>
   <city>Ann Arbor</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $95,000 W2 (taxpayer) + $45,000 W2 (spouse) = $140,000 -->
   <!-- Federal AGI: $140,000 (no adjustments) -->
   <!-- Federal Standard Deduction: $30,000 (MFJ per Rev. Proc. 2024-40) -->
   <!-- Federal Taxable: $110,000 -->
   <!-- Federal Tax: $15,043 (10% on $23,850 + 12% on $73,700 + 22% on $12,450) -->
   <!-- MI Personal Exemptions: $11,600 (taxpayer + spouse) + $11,600 (2 dependents) = $23,200 -->
   <!-- MI Taxable Income: $116,800 ($140,000 AGI - $23,200 exemptions) -->
   <!-- MI Tax: $4,964 (4.25% of $116,800) -->
   <expected_agi>140000</expected_agi>
   <expected_taxable_income>110000</expected_taxable_income>
   <expected_federal_tax>15043</expected_federal_tax>
   <expected_state_tax>4964</expected_state_tax>
   <expected_total_tax>20007</expected_total_tax>

