   <!-- New York Test Case 03: Single filer with very high income -->
   <!-- Tests NY progressive tax through bracket 7 (9.65%) -->

   <id>NY-03</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>NY</state>
   <city>Manhattan</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $2,000,000 W-2 -->
   <!-- Federal: AGI $2,000,000; standard deduction $15,750 (Single; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $2,000,000 - $15,750 = $1,984,250; tax $691,192.75 (2025 Single schedule, Rev. Proc. 2024-40) -->
   <!-- Additional Medicare tax (Form 8959): 0.9% of wages over $200,000 = $16,200; total $707,392.75 -->
   <!-- New York (2025 Form IT-201): standard deduction $8,000 Single (IT-201-I page 10); NY taxable
        income $2,000,000 - $8,000 = $1,992,000. NYAGI is over $107,650, so IT-201-I tax computation worksheet 9
        applies: line 3 rate-schedule tax $71,413 + 9.65% of ($1,992,000 - $1,077,550) = $159,657.42; line 4 recapture base
        $2,399; line 5 incremental benefit $30,172; line 6 NYAGI over $1,077,550 = $922,450, line 7 the lesser of that
        or $50,000 = $50,000, line 8 = 1.0000, line 9 = $30,172; line 10 tax $192,228 -->
   <!-- expected_state_tax was $159657, not derived from the state's 2025 form (#1317). -->
   <expected_agi>2000000</expected_agi>
   <expected_taxable_income>1984250</expected_taxable_income>
   <expected_state_tax>192228</expected_state_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Alexandra Thompson</name>
         <ssn>555-66-7777</ssn>
         <date_of_birth>11/5/1978</date_of_birth>
         <occupation>Investment Banker</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>2000000</w2_wages>
         <w2_withholding>450000</w2_withholding>
         <state_withholding>170000</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

