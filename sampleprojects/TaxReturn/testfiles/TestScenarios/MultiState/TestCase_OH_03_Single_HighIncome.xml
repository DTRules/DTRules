   <!-- Ohio Test Case 03: Single filer with high income (over $100,000) -->
   <!-- Tests Ohio 3.125% bracket and high-income personal exemption -->

   <id>OH-03</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>OH</state>
   <city>Cincinnati</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $150,000 W-2 -->
   <!-- Federal: AGI $150,000; standard deduction $15,750 (Single; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $150,000 - $15,750 = $134,250; tax $25,067 (2025 Single schedule, Rev. Proc. 2024-40) -->
   <!-- Ohio (2025 IT 1040 booklet, tax.ohio.gov): exemption $1,900 per exemption at MAGI $150,000,
        1 exemption = $1,900; Ohio taxable income $150,000 - $1,900 = $148,100; 2025 brackets (IT 1040 line 8a;
        R.C. 5747.02): $2,394.32 + 3.125% of ($148,100 - $100,000) = $3,897.45 -->
   <!-- Ohio's printed 2025 figures are inconsistent: $2,394.32 is $360.69 (the 2024 bracket base) + 2.75% x
        $73,950; the 2025 booklet's own $342.00 would give $2,375.63. The $2,394.32 printed in the 2025 IT 1040
        booklet and R.C. 5747.02 is used as published; the inconsistency is Ohio's. -->
   <!-- expected_state_tax was $3538, not derived from the state's 2025 form (#1317). -->
   <expected_agi>150000</expected_agi>
   <expected_taxable_income>134250</expected_taxable_income>
   <expected_federal_tax>25067</expected_federal_tax>
   <expected_state_tax>3897</expected_state_tax>
   <expected_total_tax>25067</expected_total_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Michael Anderson</name>
         <ssn>666-77-8888</ssn>
         <date_of_birth>4/8/1980</date_of_birth>
         <occupation>Software Engineer</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>150000</w2_wages>
         <w2_withholding>30000</w2_withholding>
         <state_withholding>4000</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

