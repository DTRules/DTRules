   <!-- Ohio Test Case 02: Married filing jointly with mid-level income -->
   <!-- Tests Ohio 2.75% bracket and mid-income personal exemption -->

   <id>OH-02</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>OH</state>
   <city>Cleveland</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $85,000 combined W2 -->
   <!-- Federal AGI: $85,000 (no adjustments) -->
   <!-- Federal Standard Deduction: $30,000 (MFJ per Rev. Proc. 2024-40) -->
   <!-- Federal Taxable: $55,000 -->
   <!-- Federal Tax: ~$5,827 (10% on $23,850 + 12% on $31,150) -->
   <!-- OH Personal Exemption: $1,850 x 2 = $3,700 (AGI > $80,000) -->
   <!-- OH Taxable: $85,000 - $3,700 = $81,300 -->
   <!-- OH Tax: ($81,300 - $26,050) x 2.75% = $55,250 x 0.0275 = $1,519.38 -->
   <!-- Withholding: $10,000 federal + $2,000 state -->
   <!-- Federal Refund: ~$4,173 -->
   <!-- State Refund: $480.62 -->
   <expected_agi>85000</expected_agi>
   <expected_taxable_income>55000</expected_taxable_income>
   <expected_federal_tax>5827</expected_federal_tax>
   <expected_state_tax>1519</expected_state_tax>
   <expected_total_tax>7346</expected_total_tax>

