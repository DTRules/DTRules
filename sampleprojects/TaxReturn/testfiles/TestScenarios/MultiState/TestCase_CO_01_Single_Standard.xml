   <!-- Colorado Test Case 01: Single filer with W-2 income -->
   <!-- Tests Colorado flat 4.4% tax on federal taxable income -->

   <id>CO-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>CO</state>
   <city>Denver</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $75,000 W-2 -->
   <!-- Federal: AGI $75,000; standard deduction $15,750 (Single; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $75,000 - $15,750 = $59,250; tax $7,949 (2025 Single schedule, Rev. Proc. 2024-40) -->
   <!-- Colorado (2025 DR 0104): line 1 is federal taxable income, Form 1040 line 15,
        $59,250; no additions or subtractions; tax at the 4.4% rate (2025 DR 0104EZ
        instructions: 'The income tax rate is currently 4.4%') = $2,607 -->
   <!-- expected_state_tax was $2640, not derived from the state's 2025 form (#1317). -->
   <expected_agi>75000</expected_agi>
   <expected_taxable_income>59250</expected_taxable_income>
   <expected_federal_tax>7949</expected_federal_tax>
   <expected_state_tax>2607</expected_state_tax>
   <expected_total_tax>7949</expected_total_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Sarah Johnson</name>
         <ssn>222-33-4444</ssn>
         <date_of_birth>5/20/1988</date_of_birth>
         <occupation>Teacher</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>75000</w2_wages>
         <w2_withholding>12000</w2_withholding>
         <state_withholding>3000</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions (standard is better) -->
   <deductions></deductions>
</job>
