   <!-- Colorado Test Case 01: Single filer with W-2 income -->
   <!-- Tests Colorado flat 4.4% tax on federal taxable income -->

   <id>CO-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>CO</state>
   <city>Denver</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $75,000 W2 -->
   <!-- Federal AGI: $75,000 (no adjustments) -->
   <!-- Federal Standard Deduction: $15,000 (Single per Rev. Proc. 2024-40) -->
   <!-- Federal Taxable: $60,000 -->
   <!-- Federal Tax: $8,329 (10% on $11,925 + 12% on $36,550 + 22% on $11,525) -->
   <!-- CO uses federal taxable income: $60,000 -->
   <!-- CO Tax: $2,640 (4.4% of $60,000) -->
   <!-- Withholding: $12,000 federal + $3,000 state -->
   <!-- Federal Refund: $3,671 -->
   <!-- State Refund: $360 -->
   <expected_agi>75000</expected_agi>
   <expected_taxable_income>60000</expected_taxable_income>
   <expected_federal_tax>8329</expected_federal_tax>
   <expected_state_tax>2640</expected_state_tax>
   <expected_total_tax>10969</expected_total_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Sarah Johnson</name>
         <ssn>222-33-4444</ssn>
         <date_of_birth>5/20/1988</date_of_birth>
         <occupation>Teacher</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>75000</w2_wages>
         <w2_withholding>12000</w2_withholding>
         <state_withholding>3000</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions (standard is better) -->
   <deductions></deductions>
</job>
