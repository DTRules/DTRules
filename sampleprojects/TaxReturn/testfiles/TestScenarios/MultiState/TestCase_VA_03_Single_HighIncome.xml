   <!-- Virginia Test Case 03: Single filer with high income -->
   <!-- Tests Virginia progressive tax - heavily in top bracket -->

   <id>VA-03</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>VA</state>
   <city>Alexandria</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $150,000 W2 -->
   <!-- Federal AGI: $150,000 (no adjustments) -->
   <!-- Federal Standard Deduction: $15,000 (Single per Rev. Proc. 2024-40) -->
   <!-- Federal Taxable: $135,000 -->
   <!-- Federal Tax: $25,879 (22% bracket) -->
   <!-- VA AGI: $150,000 -->
   <!-- VA Standard Deduction: $8,750 (Single) -->
   <!-- VA Taxable Income: $141,250 -->
   <!-- VA Tax Calculation (progressive): -->
   <!--   Bracket 1 (2% on first $3,000): $60 -->
   <!--   Bracket 2 (3% on $3,001-$5,000): $60 -->
   <!--   Bracket 3 (5% on $5,001-$17,000): $600 -->
   <!--   Bracket 4 (5.75% on $17,001-$141,250): $7,144.38 -->
   <!--   Total VA Tax: $7,864.38 -->
   <expected_agi>150000</expected_agi>
   <expected_taxable_income>134250</expected_taxable_income>
   <expected_federal_tax>25879</expected_federal_tax>
   <expected_state_tax>7864.38</expected_state_tax>
   <expected_total_tax>25067</expected_total_tax>

