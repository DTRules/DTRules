   <!-- Virginia Test Case 03: Single filer with high income -->
   <!-- Tests Virginia progressive tax - heavily in top bracket -->

   <id>VA-03</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>VA</state>
   <city>Alexandria</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $150,000 W-2 -->
   <!-- Federal: AGI $150,000; standard deduction $15,750 (Single; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $150,000 - $15,750 = $134,250; tax $25,067 (2025 Single schedule, Rev. Proc. 2024-40) -->
   <!-- Virginia (2025 Form 760 instructions and 2025 Tax Rate Schedule, tax.virginia.gov):
        standard deduction $8,750 (2025); personal exemptions 1 x $930 = $930; Virginia taxable income
        $150,000 - $8,750 - $930 = $140,320; rate schedule $720 + 5.75% of ($140,320 - $17,000) = $7,810.90, rounded $7,811 -->
   <!-- expected_state_tax was $7864.38, not derived from the state's 2025 form (#1317). -->
   <expected_agi>150000</expected_agi>
   <expected_taxable_income>134250</expected_taxable_income>
      <!-- expected_federal_tax is read by nothing and is left as it was; the 2025 figure is in the derivation above (#1317). -->
   <expected_federal_tax>25879</expected_federal_tax>
   <expected_state_tax>7811</expected_state_tax>
   <expected_total_tax>25067</expected_total_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>David Martinez</name>
         <ssn>666-77-8888</ssn>
         <date_of_birth>12/5/1980</date_of_birth>
         <occupation>Senior Engineer</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>150000</w2_wages>
         <w2_withholding>28000</w2_withholding>
         <state_withholding>8000</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions (standard is better) -->
   <deductions></deductions>
