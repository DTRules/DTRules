   <!-- IL resident working in WI. Wisconsin exempts Illinois residents' wages (Pub 121, form W-220), so WI taxes none of it and Illinois taxes all of it. -->
   <id>MS-09-IL-WI</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>IL</state>

   <expected_agi>72000</expected_agi>
   <expected_reciprocity_state>WI</expected_reciprocity_state>
   <expected_nonresident_source_income>0</expected_nonresident_source_income>

   <state_periods>
      <state_period id="1">
         <id>1</id>
         <state_code>IL</state_code>
         <start_date>1/1/2025</start_date>
         <end_date>12/31/2025</end_date>
         <resident_status>full_year</resident_status>
      </state_period>
      <state_period id="2">
         <id>2</id>
         <state_code>WI</state_code>
         <start_date>1/1/2025</start_date>
         <end_date>12/31/2025</end_date>
         <resident_status>nonresident</resident_status>
      </state_period>
   </state_periods>

   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Test Taxpayer</name>
         <date_of_birth>3/14/1985</date_of_birth>
         <is_primary>true</is_primary>
         <w2_wages>72000</w2_wages>
      </taxpayer>
   </taxpayers>

   <incomes>
      <income id="1">
         <id>1</id>
         <taxpayer_id>1</taxpayer_id>
         <type>w2_wages</type>
         <source>Employer in WI</source>
         <gross_amount>72000</gross_amount>
         <state_code>WI</state_code>
      </income>
   </incomes>

   <dependents></dependents>
   <properties></properties>
   <vehicles></vehicles>
   <deductions></deductions>
</job>
