   <!-- Wisconsin Test Case 01: Single filer with low W-2 income -->
   <!-- Tests Wisconsin progressive tax brackets 1 and 2 -->

   <id>WI-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>WI</state>
   <city>Madison</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $30,000 W2 -->
   <!-- Federal AGI: $30,000 (no adjustments) -->
   <!-- Federal Standard Deduction: $15,000 (Single per Rev. Proc. 2024-40) -->
   <!-- Federal Taxable: $15,000 -->
   <!-- Federal Tax: $1,597 (10% on $11,925 + 12% on $3,075) -->
   <!-- WI Standard Deduction: $14,260 -->
   <!-- WI Taxable: $30,000 - $14,260 = $15,740 -->
   <!-- WI Tax Bracket 1: $14,679 × 3.5% = $513.77 -->
   <!-- WI Tax Bracket 2: ($15,740 - $14,679) × 4.4% = $46.68 -->
   <!-- WI Tax Total: $560.45 -->
   <!-- Withholding: $4,500 federal + $600 state -->
   <expected_agi>30000</expected_agi>
   <expected_taxable_income>15000</expected_taxable_income>
   <expected_federal_tax>1597</expected_federal_tax>
   <expected_state_tax>560</expected_state_tax>
   <expected_total_tax>2157</expected_total_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Emily Chen</name>
         <ssn>333-44-5555</ssn>
         <date_of_birth>3/15/1992</date_of_birth>
         <occupation>Librarian</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>30000</w2_wages>
         <w2_withholding>4500</w2_withholding>
         <state_withholding>600</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions (standard is better) -->
   <deductions></deductions>
</job>
