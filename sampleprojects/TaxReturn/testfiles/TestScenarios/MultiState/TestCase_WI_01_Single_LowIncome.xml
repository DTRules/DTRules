   <!-- Wisconsin Test Case 01: Single filer with low W-2 income -->
   <!-- Tests Wisconsin progressive tax brackets 1 and 2 -->

   <id>WI-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>WI</state>
   <city>Madison</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $30,000 W-2 -->
   <!-- Federal: AGI $30,000; standard deduction $15,750 (Single; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $30,000 - $15,750 = $14,250; tax $1,471.50 (2025 Single schedule, Rev. Proc. 2024-40) -->
   <!-- Wisconsin (2025 Form 1 instructions, revenue.wi.gov/TaxForms2025/2025-Form1-Inst.pdf):
        line 8 standard deduction $12,276 (Standard Deduction Table row $30,000 to $30,500, single); line 10 exemptions 1 x $700 = $700;
        line 11 taxable income $30,000 - $12,276 - $700 = $17,024 -->
   <!-- Line 12 tax from the 2025 Tax Table, row $17,000 to $17,100, single column: $618 (the 2025 rates are 3.5%,
        4.4% from $14,680 and 5.3% from $50,480; 2025 Wis. Act 15 widened the 4.4% bracket) -->
   <!-- expected_state_tax was $560, not derived from the state's 2025 form (#1317). -->
   <expected_agi>30000</expected_agi>
   <expected_taxable_income>14250</expected_taxable_income>
      <!-- expected_federal_tax is read by nothing and is left as it was; the 2025 figure is in the derivation above (#1317). -->
   <expected_federal_tax>1597</expected_federal_tax>
   <expected_state_tax>618</expected_state_tax>
   <expected_total_tax>1471.5</expected_total_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Emily Chen</name>
         <ssn>333-44-5555</ssn>
         <date_of_birth>3/15/1992</date_of_birth>
         <occupation>Librarian</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>30000</w2_wages>
         <w2_withholding>4500</w2_withholding>
         <state_withholding>600</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions (standard is better) -->
   <deductions></deductions>
</job>
