   <!-- Missouri Test Case 01: Single filer with low income -->
   <!-- Tests Missouri progressive brackets 1-3 -->

   <id>MO-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>MO</state>
   <city>Kansas City</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $25,000 W-2 -->
   <!-- Federal: AGI $25,000; standard deduction $15,750 (Single; 2025 after OBBBA, P.L. 119-21 sec. 70102; IRS IR-2025-103); taxable income
        $25,000 - $15,750 = $9,250; tax $925 (2025 Single schedule, Rev. Proc. 2024-40) -->
   <!-- Missouri (2025 Form MO-1040 and 2025 Tax Chart, dor.mo.gov): line 11 federal tax is
        Form 1040 line 22 (after nonrefundable credits), $925; line 12 percentage for
        Missouri AGI $25,000 is 35%; line 13 federal income tax deduction $324 (cap $5,000/$10,000);
        line 14 standard deduction $15,750 -->
   <!-- Line 29 taxable income $8,926; chart: $197 + 4.5% of the excess over $7,878 = $244 -->
   <!-- expected_state_tax was $295, not derived from the state's 2025 form (#1317). -->
   <expected_agi>25000</expected_agi>
   <expected_taxable_income>9250</expected_taxable_income>
   <expected_federal_tax>925</expected_federal_tax>
   <expected_state_tax>244</expected_state_tax>
   <expected_total_tax>925</expected_total_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Sarah Johnson</name>
         <ssn>444-55-6666</ssn>
         <date_of_birth>8/22/1992</date_of_birth>
         <occupation>Office Administrator</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>25000</w2_wages>
         <w2_withholding>3000</w2_withholding>
         <state_withholding>300</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

