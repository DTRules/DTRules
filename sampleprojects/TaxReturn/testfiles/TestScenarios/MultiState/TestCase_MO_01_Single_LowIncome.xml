   <!-- Missouri Test Case 01: Single filer with low income -->
   <!-- Tests Missouri progressive brackets 1-3 -->

   <id>MO-01</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>MO</state>
   <city>Kansas City</city>

   <!-- Expected values for validation (2025) -->
   <!-- Income: $25,000 W2 -->
   <!-- Federal AGI: $25,000 (no adjustments) -->
   <!-- Federal Standard Deduction: $15,000 (Single per Rev. Proc. 2024-40) -->
   <!-- Federal Taxable: $10,000 -->
   <!-- Federal Tax: $1,000 (10% on $10,000) -->
   <!-- MO Standard Deduction: $15,000 (Single) -->
   <!-- MO Taxable: $25,000 - $15,000 = $10,000 -->
   <!-- MO Tax calculation: -->
   <!--   Bracket 1: $1,313 × 0% = $0 -->
   <!--   Bracket 2: ($2,626 - $1,313) = $1,313 × 2% = $26.26 -->
   <!--   Bracket 3: ($3,939 - $2,626) = $1,313 × 2.5% = $32.83 -->
   <!--   Bracket 4: ($5,252 - $3,939) = $1,313 × 3% = $39.39 -->
   <!--   Bracket 5: ($6,565 - $5,252) = $1,313 × 3.5% = $45.96 -->
   <!--   Bracket 6: ($7,878 - $6,565) = $1,313 × 4% = $52.52 -->
   <!--   Bracket 7: ($9,191 - $7,878) = $1,313 × 4.6% = $60.40 -->
   <!--   Bracket 8: ($10,000 - $9,191) = $809 × 4.7% = $38.02 -->
   <!--   Total MO Tax: $295.38 -->
   <!-- Withholding: $3,000 federal + $300 state -->
   <!-- Federal Refund: $2,000 -->
   <!-- State Refund: $4.62 -->
   <expected_agi>25000</expected_agi>
   <expected_taxable_income>10000</expected_taxable_income>
   <expected_federal_tax>1000</expected_federal_tax>
   <expected_state_tax>295</expected_state_tax>
   <expected_total_tax>1295</expected_total_tax>

   <!-- Single Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Sarah Johnson</name>
         <ssn>444-55-6666</ssn>
         <date_of_birth>8/22/1992</date_of_birth>
         <occupation>Office Administrator</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>25000</w2_wages>
         <w2_withholding>3000</w2_withholding>
         <state_withholding>300</state_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- No vehicles -->
   <vehicles></vehicles>

   <!-- No itemized deductions (standard is better) -->
   <deductions></deductions>
