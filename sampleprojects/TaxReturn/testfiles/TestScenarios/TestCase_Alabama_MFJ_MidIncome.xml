   <!-- Alabama State Tax Test Case: Married Filing Jointly, Mid Income -->
   <!-- Tests Alabama Brackets 1-3 for MFJ (2%, 4%, 5% rates) -->
   <id>102</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>AL</state>
   <city>Montgomery</city>

   <!-- Expected values for validation -->
   <!-- AGI: $50,000 W-2 (spouse1) + $35,000 W-2 (spouse2) = $85,000 -->
   <!-- AL Taxable Income: $85,000 - $11,500 (std deduction) - $3,000 (exemption) = $70,500 -->
   <!-- AL Tax Calculation (MFJ brackets):
        Bracket 1 (2%): $1,000 × 0.02 = $20
        Bracket 2 (4%): ($6,000 - $1,000) × 0.04 = $5,000 × 0.04 = $200
        Bracket 3 (5%): ($70,500 - $6,000) × 0.05 = $64,500 × 0.05 = $3,225
        Total AL Tax: $20 + $200 + $3,225 = $3,445
   -->
   <expected_agi>85000</expected_agi>
   <expected_al_taxable_income>70500</expected_al_taxable_income>
