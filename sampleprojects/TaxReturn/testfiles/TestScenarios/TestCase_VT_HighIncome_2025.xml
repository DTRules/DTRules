   <!-- Vermont High Income Single Taxpayer Test Case -->
   <id>203</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>VT</state>
   <city>Stowe</city>

   <!-- Test Case 3: Single filer with high income -->
   <!-- Income: $250,000 W-2 wages -->
   <!-- Federal AGI: $250,000 -->
   <!-- VT Standard Deduction: $7,100 -->
   <!-- VT Personal Exemption: $5,000 -->
   <!-- VT Taxable Income: $250,000 - $7,100 - $5,000 = $237,900 -->
   <!-- VT Tax Calculation: -->
   <!--   First $45,400 @ 3.35% = $1,520.90 -->
   <!--   Next $64,650 ($110,050 - $45,400) @ 6.60% = $4,266.90 -->
   <!--   Next $119,400 ($229,450 - $110,050) @ 7.60% = $9,074.40 -->
   <!--   Remaining $8,450 ($237,900 - $229,450) @ 8.75% = $739.38 -->
   <!--   Total VT Tax = $15,601.58 -->
   <expected_agi>250000</expected_agi>
   <expected_vt_state_tax>15601.58</expected_vt_state_tax>

   <!-- Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Michael Chen</name>
         <ssn>777-88-9999</ssn>
         <date_of_birth>8/5/1975</date_of_birth>
         <age>50</age>
         <occupation>Executive</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>250000</w2_wages>
         <w2_withholding>50000</w2_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

