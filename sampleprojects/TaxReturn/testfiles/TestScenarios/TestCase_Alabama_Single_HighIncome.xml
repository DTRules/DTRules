   <!-- Alabama State Tax Test Case: Single Filer, High Income with SE -->
   <!-- Tests Alabama Brackets 1-3 for Single with self-employment income -->
   <id>103</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>AL</state>
   <city>Huntsville</city>

   <!-- Expected values for validation -->
   <!-- SE Gross: $120,000 -->
   <!-- SE Expenses (vehicle): 24,000 miles × $0.70 = $16,800 -->
   <!-- SE Net: $120,000 - $16,800 = $103,200 -->
   <!-- SE Tax: $103,200 × 0.9235 × 0.153 = $14,579 -->
   <!-- SE Tax Deduction: $14,579 × 0.50 = $7,290 -->
   <!-- AGI: $103,200 - $7,290 = $95,910 -->
   <!-- AL Taxable Income: $95,910 - $4,500 (std deduction) - $1,500 (exemption) = $89,910 -->
   <!-- AL Tax Calculation (Single brackets):
        Bracket 1 (2%): $500 × 0.02 = $10
        Bracket 2 (4%): ($3,000 - $500) × 0.04 = $2,500 × 0.04 = $100
        Bracket 3 (5%): ($89,910 - $3,000) × 0.05 = $86,910 × 0.05 = $4,345.50
        Total AL Tax: $10 + $100 + $4,345.50 = $4,455.50 (rounded to $4,456)
   -->
   <expected_agi>95910</expected_agi>
   <expected_al_taxable_income>89910</expected_al_taxable_income>
   <expected_al_state_tax>4456</expected_al_state_tax>

   <!-- Taxpayers -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>David Chen</name>
         <ssn>666-77-8888</ssn>
         <date_of_birth>11/8/1980</date_of_birth>
         <occupation>Software Consultant</occupation>
         <is_self_employed>true</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>0</w2_wages>
         <w2_withholding>0</w2_withholding>
         <se_gross_income>120000</se_gross_income>
         <estimated_payments>15000</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No properties -->
   <properties></properties>

   <!-- Vehicles (business vehicle) -->
   <vehicles>
      <vehicle id="1">
         <id>1</id>
         <taxpayer_id>1</taxpayer_id>
         <description>2021 Honda Accord</description>
         <purchase_date>3/1/2021</purchase_date>
         <purchase_price>28000</purchase_price>
         <total_miles>30000</total_miles>
         <business_miles>24000</business_miles>
         <method>standard_mileage</method>
         <actual_expenses>0</actual_expenses>
         <vehicle_depreciation>0</vehicle_depreciation>
      </vehicle>
   </vehicles>

   <!-- No deductions -->
   <deductions></deductions>
</job>
