   <!-- Test Case 2: SC Middle Income Taxpayer (Bracket 2 - 3% tax) -->
   <!-- Scenario: Single filer in South Carolina with middle income -->
   <!-- AGI: $32,000 -->
   <!-- SC Taxable Income: $32,000 - $15,000 (SC std deduction) = $17,000 -->
   <!-- SC Tax: ($17,000 - $3,560) * 3% = $13,440 * 0.03 = $403.20 -->

   <id>1002</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>SC</state>
   <city>Columbia</city>
   <has_state_income_tax>true</has_state_income_tax>

   <!-- Expected values for validation -->
   <!-- AGI: $32,000 -->
   <!-- Federal Taxable: $32,000 - $15,000 (federal std) = $17,000 -->
   <!-- Federal Tax: $11,925 * 10% + ($17,000 - $11,925) * 12% = $1,192.50 + $609 = $1,801.50 -->
   <!-- SC Taxable: $32,000 - $15,000 (SC std) = $17,000 -->
   <!-- SC Tax: ($17,000 - $3,560) * 3% = $403.20 -->
   <!-- Total Tax: $1,801.50 + $403.20 = $2,204.70 -->
   <expected_agi>32000</expected_agi>
   <expected_taxable_income>17000</expected_taxable_income>
   <expected_total_tax>2205</expected_total_tax>

   <!-- Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>John Davis</name>
         <ssn>222-33-4444</ssn>
         <date_of_birth>3/15/1988</date_of_birth>
         <occupation>Teacher</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>32000</w2_wages>
         <w2_withholding>2500</w2_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No deductions -->
   <deductions></deductions>

   <!-- No properties -->
   <properties></properties>

   <!-- No self-employment -->
   <se_income></se_income>

   <!-- No rental properties -->
   <rental_properties></rental_properties>

   <!-- No other income -->
   <other_income></other_income>
</job>
