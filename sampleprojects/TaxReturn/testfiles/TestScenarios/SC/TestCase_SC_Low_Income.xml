   <!-- Test Case 1: SC Low Income Taxpayer (Bracket 1 - 0% tax) -->
   <!-- Scenario: Single filer in South Carolina with low income -->
   <!-- AGI: $18,000 -->
   <!-- SC Taxable Income: $18,000 - $15,000 (SC std deduction) = $3,000 -->
   <!-- SC Tax: $0 (under $3,560, bracket 1 at 0%) -->

   <id>1001</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>SC</state>
   <city>Charleston</city>
   <has_state_income_tax>true</has_state_income_tax>

   <!-- Expected values for validation -->
   <!-- AGI: $18,000 -->
   <!-- Federal Taxable: $18,000 - $15,000 (federal std) = $3,000 -->
   <!-- Federal Tax: $3,000 * 10% = $300 -->
   <!-- SC Taxable: $18,000 - $15,000 (SC std) = $3,000 -->
   <!-- SC Tax: $0 (under $3,560 threshold) -->
   <!-- Total Tax: $300 (federal) + $0 (SC) = $300 -->
   <expected_agi>18000</expected_agi>
   <expected_taxable_income>3000</expected_taxable_income>
   <expected_total_tax>300</expected_total_tax>

   <!-- Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Jane Smith</name>
         <ssn>111-22-3333</ssn>
         <date_of_birth>6/1/1995</date_of_birth>
         <occupation>Retail Worker</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>18000</w2_wages>
         <w2_withholding>500</w2_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents></dependents>

   <!-- No deductions -->
   <deductions></deductions>

   <!-- No properties -->
   <properties></properties>

   <!-- No self-employment -->
   <se_income></se_income>

   <!-- No rental properties -->
   <rental_properties></rental_properties>

   <!-- No other income -->
   <other_income></other_income>
</job>
