   <!-- Michigan Married Filing Jointly Test Case -->
   <id>102</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>MI</state>
   <city>Ann Arbor</city>

   <!-- Test Case 2: MFJ, dual income with itemized deductions -->
   <!-- Income: $80,000 + $50,000 = $130,000 W-2 wages -->
   <!-- Federal AGI: $130,000 -->
   <!-- MI Personal Exemptions: $5,800 * 2 = $11,600 -->
   <!-- MI Itemized Deductions: $15,000 (MI follows federal itemization) -->
   <!-- MI Taxable Income: $130,000 - $11,600 - $15,000 = $103,400 -->
   <!-- MI Tax: $103,400 * 0.0425 = $4,394.50 -->
   <expected_agi>130000</expected_agi>
   <expected_mi_state_tax>4394.50</expected_mi_state_tax>

