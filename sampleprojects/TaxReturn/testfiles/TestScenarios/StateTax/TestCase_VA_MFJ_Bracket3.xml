   <!-- Virginia State Tax Test Case - Married Filing Jointly, Bracket 3 -->
   <!-- Test that MFJ filers with dependents spanning multiple brackets are taxed correctly -->
   <id>2</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>VA</state>
   <city>Virginia Beach</city>

   <!-- Expected values for validation -->
   <!-- AGI: $55,000 ($28,000 + $27,000) -->
   <!-- Standard deduction: $17,500 (MFJ) -->
   <!-- Personal exemptions: 4 persons × $930 = $3,720 -->
   <!-- VA Taxable income: $55,000 - $17,500 - $3,720 = $33,780 -->
   <!-- Tax calculation (VA brackets):
        - Bracket 1 ($0-$3,000 @ 2%): $3,000 × 0.02 = $60.00
        - Bracket 2 ($3,000-$5,000 @ 3%): ($5,000 - $3,000) × 0.03 = $60.00
        - Bracket 3 ($5,000-$17,000 @ 5%): ($17,000 - $5,000) × 0.05 = $600.00
        - Bracket 4 (>$17,000 @ 5.75%): ($33,780 - $17,000) × 0.0575 = $964.85
        - Total: $60.00 + $60.00 + $600.00 + $964.85 = $1,684.85
   -->
   <expected_agi>55000</expected_agi>
   <expected_taxable_income>33780</expected_taxable_income>
   <expected_va_state_tax>1684.85</expected_va_state_tax>

