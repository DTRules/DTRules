   <!-- Connecticut State Tax Test Case 1: Single Filer, Low Income -->
   <!-- Tests CT tax bracket 1 (2% rate) -->
   <id>1</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>CT</state>
   <city>Hartford</city>

   <!-- Expected values for validation -->
   <!-- Income: $45,000 W-2 -->
   <!-- AGI: $45,000 -->
   <!-- CT AGI: $45,000 -->
   <!-- CT Personal Credit: $15,000 -->
   <!-- CT Taxable Income: $45,000 - $15,000 = $30,000 -->
   <!-- CT Tax: (10000 * 0.02) + (20000 * 0.045) = $200 + $900 = $1,100 (bracket 2) -->
   <expected_agi>45000</expected_agi>
   <expected_ct_agi>45000</expected_ct_agi>
   <expected_ct_taxable_income>30000</expected_ct_taxable_income>
   <expected_ct_tax>1100</expected_ct_tax>

