   <state>CT</state>
   <city>Stamford</city>

   <!-- Expected values for validation -->
   <!-- Income: $150,000 W-2 total -->
   <!-- AGI: $150,000 -->
   <!-- CT AGI: $150,000 -->
   <!-- CT Personal Credit: $24,000 -->
   <!-- CT Taxable Income: $150,000 - $24,000 = $126,000 -->
   <!-- CT Tax calculation (bracket 3):
        Bracket 1: 20000 * 0.02 = $400
        Bracket 2: (100000-20000) * 0.045 = 80000 * 0.045 = $3,600
        Bracket 3: (126000-100000) * 0.055 = 26000 * 0.055 = $1,430
        Total: $400 + $3,600 + $1,430 = $5,430
   -->
   <expected_agi>150000</expected_agi>
   <expected_ct_agi>150000</expected_ct_agi>
   <expected_ct_taxable_income>126000</expected_ct_taxable_income>
   <expected_ct_tax>5430</expected_ct_tax>

