   <!-- Connecticut State Tax Test Case 3: Single Filer, High Income -->
   <!-- Tests CT tax bracket 7 (6.99% marginal rate) -->
   <id>3</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>CT</state>
   <city>Greenwich</city>

   <!-- Expected values for validation -->
   <!-- Income: $600,000 W-2 -->
   <!-- AGI: $600,000 -->
   <!-- CT AGI: $600,000 -->
   <!-- CT Personal Credit: $15,000 -->
   <!-- CT Taxable Income: $600,000 - $15,000 = $585,000 -->
   <!-- CT Tax calculation (bracket 7):
        Bracket 1: 10000 * 0.02 = $200
        Bracket 2: (50000-10000) * 0.045 = 40000 * 0.045 = $1,800
        Bracket 3: (100000-50000) * 0.055 = 50000 * 0.055 = $2,750
        Bracket 4: (200000-100000) * 0.06 = 100000 * 0.06 = $6,000
        Bracket 5: (250000-200000) * 0.065 = 50000 * 0.065 = $3,250
        Bracket 6: (500000-250000) * 0.069 = 250000 * 0.069 = $17,250
        Bracket 7: (585000-500000) * 0.0699 = 85000 * 0.0699 = $5,941.50
        Total: $200 + $1,800 + $2,750 + $6,000 + $3,250 + $17,250 + $5,942 = $37,192
   -->
   <expected_agi>600000</expected_agi>
   <expected_ct_agi>600000</expected_ct_agi>
   <expected_ct_taxable_income>585000</expected_ct_taxable_income>
   <expected_ct_tax>37192</expected_ct_tax>

   <!-- Taxpayer -->
   <taxpayers>
