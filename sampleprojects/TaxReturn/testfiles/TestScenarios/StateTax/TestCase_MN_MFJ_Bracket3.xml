   <!-- Minnesota State Tax Test Case - Married Filing Jointly, Bracket 3 -->
   <!-- Test that MFJ filers with dependents spanning multiple brackets are taxed correctly -->
   <id>2</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>MN</state>
   <city>St. Paul</city>

   <!-- Expected values for validation -->
   <!-- AGI: $220,000 ($95,000 + $125,000) -->
   <!-- Standard deduction: $29,900 (MFJ) -->
   <!-- Dependent exemptions: 2 × $5,200 = $10,400 -->
   <!-- Taxable income: $220,000 - $29,900 - $10,400 = $179,700 -->
   <!-- Tax calculation (MFJ brackets):
        - Bracket 1 ($0-$47,620 @ 5.35%): $47,620 × 0.0535 = $2,547.67
        - Bracket 2 ($47,620-$189,180 @ 6.80%): ($179,700 - $47,620) × 0.0680 = $8,981.44
        - Total: $2,547.67 + $8,981.44 = $11,529.11
   -->
   <expected_agi>220000</expected_agi>
   <expected_taxable_income>179700</expected_taxable_income>
   <expected_mn_state_tax>11529.11</expected_mn_state_tax>

