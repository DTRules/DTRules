   <!-- Virginia State Tax Test Case - Head of Household, Bracket 4 -->
   <!-- Test that HOH filer at the top tax rate (5.75%) is taxed correctly -->
   <id>3</id>
   <tax_year>2025</tax_year>
   <filing_status>HOH</filing_status>
   <state>VA</state>
   <city>Alexandria</city>

   <!-- Expected values for validation -->
   <!-- AGI: $85,000 -->
   <!-- Standard deduction: $8,750 (HOH uses Single deduction in VA) -->
   <!-- Personal exemptions: 2 persons × $930 = $1,860 -->
   <!-- VA Taxable income: $85,000 - $8,750 - $1,860 = $74,390 -->
   <!-- Tax calculation (VA brackets):
        - Bracket 1 ($0-$3,000 @ 2%): $3,000 × 0.02 = $60.00
        - Bracket 2 ($3,000-$5,000 @ 3%): ($5,000 - $3,000) × 0.03 = $60.00
        - Bracket 3 ($5,000-$17,000 @ 5%): ($17,000 - $5,000) × 0.05 = $600.00
        - Bracket 4 (>$17,000 @ 5.75%): ($74,390 - $17,000) × 0.0575 = $3,299.93
        - Total: $60.00 + $60.00 + $600.00 + $3,299.93 = $4,019.93
   -->
   <expected_agi>85000</expected_agi>
   <expected_taxable_income>74390</expected_taxable_income>
   <expected_va_state_tax>4019.93</expected_va_state_tax>

   <!-- Taxpayers -->
   <taxpayers>
      <!-- Single parent, head of household -->
      <taxpayer id="1">
         <id>1</id>
         <name>Jennifer Walker</name>
         <ssn>666-77-8888</ssn>
         <date_of_birth>1/15/1982</date_of_birth>
         <occupation>IT Manager</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>85000</w2_wages>
         <w2_withholding>12000</w2_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- Dependents -->
   <dependents>
      <!-- Qualifying child for HOH status -->
      <dependent id="1">
         <id>1</id>
         <name>Olivia Walker</name>
         <ssn>777-88-9999</ssn>
         <date_of_birth>6/20/2012</date_of_birth>
