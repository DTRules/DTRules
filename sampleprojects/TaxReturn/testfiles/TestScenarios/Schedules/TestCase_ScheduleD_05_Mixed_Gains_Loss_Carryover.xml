<?xml version="1.0" encoding="UTF-8"?>
<!-- Test Case: Schedule D - Mixed ST/LT Gains -->
<!-- Scenario: Taxpayer with both ST and LT gains. A prior-year capital loss carryover
     used to be supplied here as an <adjustment> element no mapping read, so it never
     loaded; the sample has no carryover field or rule, and the expectations below are
     the arithmetic of the inputs that do load (#1194) -->
<!-- STCG: $10,000, LTCG: $30,000 -->
<!-- Expected: net gain $40,000, $30,000 of it at the 15% long-term rate -->
<job>
    <id>10015</id>
    <tax_year>2025</tax_year>
    <filing_status>MFJ</filing_status>
    <state>TX</state>

    <!-- Expected results -->
    <!-- AGI: $130,000 W-2 + $40,000 gains = $170,000 -->
    <!-- Deduction: $31,500 standard (MFJ, 2025) -->
    <!-- Taxable: $138,500 -->
    <!-- Tax: $13,698 ordinary on $108,500 (2025 MFJ brackets: 2,385 + 8,772 + 2,541) + $4,500 LTCG (15% on $30k) = $18,198 -->
    <expected_agi>170000</expected_agi>
    <expected_taxable_income>138500</expected_taxable_income>
    <expected_total_tax>18198</expected_total_tax>

    <taxpayers>
        <taxpayer>
            <id>1</id>
            <name>Steven Davis</name>
            <ssn>456-78-9012</ssn>
            <date_of_birth>03/25/1975</date_of_birth>
            <occupation>Portfolio Manager</occupation>
            <is_self_employed>false</is_self_employed>
            <is_primary>true</is_primary>
            <w2_wages>85000</w2_wages>
            <w2_withholding>15000</w2_withholding>
        </taxpayer>
        <taxpayer>
            <id>2</id>
            <name>Laura Davis</name>
            <ssn>567-89-0123</ssn>
            <date_of_birth>05/18/1977</date_of_birth>
            <occupation>Marketing VP</occupation>
            <is_self_employed>false</is_self_employed>
            <is_primary>false</is_primary>
            <w2_wages>45000</w2_wages>
            <w2_withholding>7000</w2_withholding>
        </taxpayer>
    </taxpayers>

    <incomes>
        <!-- Short-term capital gain -->
        <income>
            <id>1</id>
            <taxpayer_id>1</taxpayer_id>
            <type>capital_gain</type>
            <source>Stock trading - short-term</source>
            <gross_amount>10000</gross_amount>
            <tax_withheld>0</tax_withheld>
            <is_earned>false</is_earned>
            <holding_period>short_term</holding_period>
        </income>

        <!-- Long-term capital gain -->
        <income>
            <id>2</id>
            <taxpayer_id>1</taxpayer_id>
            <type>capital_gain</type>
            <source>Stock sale - long-term holdings</source>
            <gross_amount>30000</gross_amount>
            <tax_withheld>0</tax_withheld>
            <is_earned>false</is_earned>
            <holding_period>long_term</holding_period>
        </income>
    </incomes>


    <dependents></dependents>
    <properties></properties>
    <vehicles></vehicles>
    <deductions></deductions>
    <expenses></expenses>
</job>
