<?xml version="1.0" encoding="UTF-8"?>
<!-- Test Case: Schedule A - Medical Expenses Exceeding 7.5% AGI Threshold -->
<!-- Scenario: Single filer with significant medical expenses -->
<!-- Medical expenses: $15,000, AGI: $60,000, Threshold: $4,500 (7.5%), Deductible: $10,500 -->
<!-- Expected: Itemized deductions exceed standard deduction -->
<job>
    <id>10001</id>
    <tax_year>2025</tax_year>
    <filing_status>Single</filing_status>
    <state>TX</state>

    <!-- Expected results -->
    <!-- AGI: $60,000 -->
    <!-- Itemized: Medical $10,500 + SALT $10,000 + Charity $3,000 = $23,500 -->
    <!-- Standard: $15,000 (single) -->
    <!-- Taxable: $60,000 - $23,500 = $36,500 -->
    <!-- Tax: ~$4,188 -->
    <expected_agi>60000</expected_agi>
    <expected_taxable_income>36500</expected_taxable_income>
    <expected_total_tax>4188</expected_total_tax>

    <taxpayers>
        <taxpayer>
            <id>1</id>
            <name>Jennifer Martinez</name>
            <ssn>111-22-3333</ssn>
            <date_of_birth>03/12/1970</date_of_birth>
            <occupation>Nurse</occupation>
            <is_self_employed>false</is_self_employed>
            <is_primary>true</is_primary>
            <w2_wages>60000</w2_wages>
            <w2_withholding>7000</w2_withholding>
        </taxpayer>
    </taxpayers>

    <deductions>
        <!-- Medical expenses -->
        <deduction>
            <id>1</id>
            <category>medical</category>
            <description>Surgery and hospital stay</description>
            <amount>12000</amount>
        </deduction>
        <deduction>
            <id>2</id>
            <category>medical</category>
            <description>Prescription medications</description>
            <amount>2000</amount>
        </deduction>
        <deduction>
            <id>3</id>
            <category>medical</category>
            <description>Medical transportation</description>
            <amount>1000</amount>
        </deduction>

        <!-- State and local taxes (SALT) -->
        <deduction>
            <id>4</id>
            <category>state_tax</category>
            <description>State income tax paid</description>
            <amount>3500</amount>
        </deduction>
        <deduction>
            <id>5</id>
            <category>property_tax</category>
            <description>Property tax</description>
            <amount>6500</amount>
        </deduction>

        <!-- Charitable contributions -->
        <deduction>
            <id>6</id>
            <category>charity</category>
            <description>Church donations</description>
            <amount>3000</amount>
        </deduction>
    </deductions>

    <dependents></dependents>
    <properties></properties>
    <vehicles></vehicles>
    <incomes></incomes>
</job>
