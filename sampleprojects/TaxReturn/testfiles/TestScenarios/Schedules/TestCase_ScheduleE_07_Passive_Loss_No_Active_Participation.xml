<!-- Test Case: Schedule E - Rental loss without active participation -->
<!-- Scenario: Moderate income, but the taxpayer does not actively participate in the rental -->
<!-- Rental income: $10,000, Expenses: $16,000, Loss: ($6,000) -->
<!-- Expected: the $25,000 special allowance does not apply; with no passive income the whole loss is suspended (IRS Pub 925) -->
<job>
    <id>10022</id>
    <tax_year>2025</tax_year>
    <filing_status>MFJ</filing_status>
    <state>TX</state>

    <!-- Expected results -->
    <!-- Schedule E expenses, from this file's own fields: mortgage interest
         7,000 + property taxes 3,000 + insurance 1,000 + repairs 1,000 +
         management 1,000 + utilities 0 + advertising 0 + depreciation 3,000
         = 16,000. Net: 10,000 - 16,000 = (6,000) -->
    <!-- Form 8582: the loss is not from active-participation rental real
         estate, so Part II's special allowance does not reach it. There is
         no passive income to absorb it: $0 allowed, $6,000 suspended -->
    <!-- AGI: $70,000 W-2 (loss not deducted) -->
    <!-- Deduction: $31,500 standard (MFJ, 2025) -->
    <!-- Taxable: $70,000 - $31,500 = $38,500 -->
    <!-- Tax: $4,143 (2025 MFJ brackets: 2,385 + 12% of 14,650) -->
