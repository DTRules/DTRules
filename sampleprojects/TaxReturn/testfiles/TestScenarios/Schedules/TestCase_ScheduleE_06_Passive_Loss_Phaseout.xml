    <!-- Schedule E expenses, from this file's own fields: mortgage interest
         14,000 + property taxes 5,000 + insurance 1,500 + repairs 2,500 +
         management 1,000 + utilities 0 + advertising 0 + depreciation 6,000
         = 30,000. Net: 12,000 - 30,000 = (18,000) -->
    <!-- Form 8582: modified AGI $120,000 (wages; the passive loss is not
         subtracted). Special allowance $25,000 - 50% x ($120,000 - $100,000)
         = $15,000. Allowed: smaller of the $18,000 loss and $15,000 =
         $15,000; $3,000 suspended and carried forward -->
    <!-- AGI: $120,000 - $15,000 = $105,000 -->
    <!-- Deduction: $31,500 standard (MFJ, 2025) -->
    <!-- Taxable: $105,000 - $31,500 = $73,500 -->
    <!-- Tax: $8,343 (2025 MFJ brackets: 2,385 + 12% of 49,650) -->
