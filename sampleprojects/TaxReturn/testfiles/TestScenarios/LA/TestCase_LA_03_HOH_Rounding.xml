   <!-- LA Test Case 03: head of household, $41,350 of wages, one child; the tax rounds half up -->
   <id>LA-03</id>
   <tax_year>2025</tax_year>
   <filing_status>HOH</filing_status>
   <state>LA</state>
   <city>Baton Rouge</city>
   <has_state_income_tax>true</has_state_income_tax>

   <!-- Expected values, worked from the state's own form -->
   <!-- Sources: Louisiana IT-540 2025 instructions (Act 11 of the 2024 Third Extraordinary Session): line 8 standard deduction, line 10 taxable income, line 11 = line 10 x .03 rounded to the nearest dollar. -->
   <!-- Federal: AGI $41,350; taxable $41,350 - $23,625 = $17,725 -->
   <!-- Louisiana: line 7 $41,350 - line 8 $25,000 = line 10 $16,350;
        line 11 $16,350 x .03 = $490.50, rounded to the nearest dollar = $491 -->
   <expected_agi>41350</expected_agi>
   <expected_taxable_income>17725</expected_taxable_income>
   <expected_state_tax>491</expected_state_tax>

