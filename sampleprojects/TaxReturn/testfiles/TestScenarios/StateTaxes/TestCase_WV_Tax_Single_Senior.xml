   <!-- Test Case: West Virginia State Tax - Single Filer, Senior, High Income -->
   <!-- Tests WV progressive tax bracket 5 with senior additional exemption -->

   <id>WV-03</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>WV</state>
   <city>Huntington</city>

   <!-- Expected values for validation -->
   <!-- W-2 Wages: $95,000 -->
   <!-- Federal AGI: $95,000 -->
   <!-- WV Personal Exemptions: 1 person + 1 senior (65+) = 2 × $2,000 = $4,000 -->
   <!-- WV Taxable Income: $95,000 - $4,000 = $91,000 -->
   <!-- WV Tax Calculation (all brackets):
        Bracket 1: $10,000 × 2.22% = $222.00
        Bracket 2: $15,000 × 2.96% = $444.00
        Bracket 3: $15,000 × 3.33% = $499.50
        Bracket 4: $20,000 × 4.44% = $888.00
        Bracket 5: $31,000 × 4.82% = $1,494.20
        Total WV Tax: $222 + $444 + $499.50 + $888 + $1,494.20 = $3,547.70
   -->
   <expected_agi>95000</expected_agi>
   <expected_taxable_income>79250</expected_taxable_income>

