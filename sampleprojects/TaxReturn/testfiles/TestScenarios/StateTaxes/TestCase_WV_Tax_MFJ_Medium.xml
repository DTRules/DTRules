   <!-- Test Case: West Virginia State Tax - Married Filing Jointly, Medium Income -->
   <!-- Tests WV progressive tax with dependents, brackets 3-4 -->

   <id>WV-02</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>WV</state>
   <city>Morgantown</city>

   <!-- Expected values for validation -->
   <!-- Combined W-2 Wages: $80,000 -->
   <!-- Federal AGI: $80,000 -->
   <!-- WV Personal Exemptions: 2 taxpayers + 2 dependents = 4 × $2,000 = $8,000 -->
   <!-- WV Taxable Income: $80,000 - $8,000 = $72,000 -->
   <!-- WV Tax Calculation:
        Bracket 1: $10,000 × 2.22% = $222.00
        Bracket 2: $15,000 × 2.96% = $444.00
        Bracket 3: $15,000 × 3.33% = $499.50
        Bracket 4: $20,000 × 4.44% = $888.00
        Bracket 5: $12,000 × 4.82% = $578.40
        Total WV Tax: $222 + $444 + $499.50 + $888 + $578.40 = $2,631.90
   -->
   <expected_agi>80000</expected_agi>
   <expected_taxable_income>51600</expected_taxable_income>

