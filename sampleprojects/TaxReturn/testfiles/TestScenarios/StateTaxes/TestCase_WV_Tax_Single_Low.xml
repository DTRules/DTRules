   <!-- Test Case: West Virginia State Tax - Single Filer, Low Income -->
   <!-- Tests WV progressive tax brackets 1-2 (2.22% and 2.96%) -->

   <id>WV-01</id>
   <tax_year>2025</tax_year>
   <filing_status>Single</filing_status>
   <state>WV</state>
   <city>Charleston</city>

   <!-- Expected values for validation -->
   <!-- W-2 Wages: $35,000 -->
   <!-- Federal AGI: $35,000 -->
   <!-- WV Personal Exemption: 1 person × $2,000 = $2,000 -->
   <!-- WV Taxable Income: $35,000 - $2,000 = $33,000 -->
   <!-- WV Tax Calculation:
        Bracket 1: $10,000 × 2.22% = $222.00
        Bracket 2: $15,000 × 2.96% = $444.00 ($10K-$25K)
        Bracket 3: $8,000 × 3.33% = $266.40 ($25K-$33K)
        Total WV Tax: $222.00 + $444.00 + $266.40 = $932.40
   -->
   <expected_agi>35000</expected_agi>
   <expected_taxable_income>19250</expected_taxable_income>

   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Robert Smith</name>
         <ssn>123-45-6789</ssn>
         <date_of_birth>5/15/1990</date_of_birth>
         <age>35</age>
         <occupation>Teacher</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>35000</w2_wages>
         <w2_withholding>3500</w2_withholding>
      </taxpayer>
   </taxpayers>

   <dependents></dependents>
   <properties></properties>
   <vehicles></vehicles>
   <deductions></deductions>
   <income_sources></income_sources>
</job>
