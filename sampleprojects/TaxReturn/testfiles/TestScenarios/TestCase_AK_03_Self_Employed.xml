   <!-- AK Test Case 3: Self-Employed with Business Income -->
   <id>AK-03</id>
   <tax_year>2025</tax_year>
   <filing_status>single</filing_status>
   <state>AK</state>
   <city>Juneau</city>
   <has_state_income_tax>false</has_state_income_tax>

   <!-- Expected values for validation -->
   <!-- Federal AGI: $95,000 (SE income after expenses) -->
   <!-- AK AGI: $95,000 -->
   <!-- AK Taxable Income: $0 (no state income tax) -->
   <!-- AK Tax: $0 (Alaska has no state income tax) -->
   <expected_agi>95000</expected_agi>
   <expected_ak_agi>95000</expected_ak_agi>
   <expected_ak_taxable_income>0</expected_ak_taxable_income>
   <expected_ak_tax>0</expected_ak_tax>

   <!-- Taxpayers -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Robert Wilson</name>
         <ssn>555-66-7777</ssn>
         <date_of_birth>2/28/1980</date_of_birth>
         <occupation>Fishing Guide</occupation>
         <is_self_employed>true</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>0</w2_wages>
         <w2_withholding>0</w2_withholding>
         <se_gross_income>120000</se_gross_income>
         <se_expenses>25000</se_expenses>
         <estimated_payments>15000</estimated_payments>
      </taxpayer>
   </taxpayers>

   <!-- Incomes -->
   <incomes>
      <income id="1">
         <id>1</id>
         <taxpayer_id>1</taxpayer_id>
         <type>self_employment</type>
         <gross_amount>120000</gross_amount>
         <expenses>25000</expenses>
      </income>
   </incomes>

   <!-- Dependents -->
   <dependents></dependents>

   <!-- Properties -->
   <properties></properties>

   <!-- Vehicles -->
   <vehicles></vehicles>

   <!-- Deductions -->
   <deductions></deductions>
</job>
