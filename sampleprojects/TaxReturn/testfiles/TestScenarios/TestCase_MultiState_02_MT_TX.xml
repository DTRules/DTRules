   <!-- Multi-State Test Case 2: MT → TX Move (Part-Year Resident) -->
   <!-- Scenario: Taxpayer lived in MT Jan 1 - Aug 31 (243 days), moved to TX Sep 1 - Dec 31 (122 days) -->
   <!-- MT has progressive income tax, TX has no income tax -->
   <id>MultiState-02-MT-TX</id>
   <tax_year>2025</tax_year>
   <filing_status>married_filing_jointly</filing_status>
   <state>MT</state>
   <city>Billings</city>
   <has_state_income_tax>true</has_state_income_tax>

   <!-- Expected values for validation -->
   <!-- Total Federal AGI: $120,000 -->
   <!-- MT Period: 243 days / 365 = 66.58% -->
   <!-- MT Allocated Income: $120,000 × 66.58% = $79,896 -->
   <!-- MT AGI: $79,896 -->
   <!-- MT Standard Deduction MFJ: $10,600 -->
   <!-- MT Taxable Income: $69,296 -->
   <!-- MT Tax: Bracket 1: $23,600 × 4.7% = $1,109.20 -->
   <!--        Bracket 2: ($69,296 - $23,600) × 5.9% = $2,696.06 -->
   <!--        Total: $3,805.26 -->
   <!-- TX has no state income tax, so no TX tax -->
   <expected_agi>120000</expected_agi>
   <expected_mt_agi>79896</expected_mt_agi>
   <expected_mt_taxable_income>69296</expected_mt_taxable_income>
   <expected_mt_tax>3805.26</expected_mt_tax>

   <!-- Taxpayers -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>Robert Martinez</name>
