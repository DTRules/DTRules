   <!-- Foreign Test Case 3: Form 2555 - FEIE with Physical Presence Test (Exactly 330 Days) -->
   <!-- Tests: Process_Foreign_Earned_Income -->
   <!-- Scenario: US citizen meeting exact minimum physical presence test -->
   <!-- 330 full days in 12-month period, qualifies for FEIE -->
   <id>FOREIGN-03</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>CA</state>
   <city>San Diego</city>

   <!-- Expected values for validation -->
   <!-- Foreign earned income: $110,000 -->
   <!-- Days outside US: 330 (meets exact 330-day physical presence test) -->
   <!-- FEIE max exclusion (2025): $126,500 -->
   <!-- FEIE exclusion: $110,000 (full amount, under limit) -->
   <!-- Spouse US income: $45,000 -->
   <!-- AGI: $0 + $45,000 = $45,000 -->
   <!-- Standard deduction: $30,000 (MFJ) -->
   <!-- Taxable: $15,000 -->
   <!-- Tax: $1,500 (10% bracket) -->
   <expected_agi>45000</expected_agi>
   <expected_foreign_earned_income>110000</expected_foreign_earned_income>
   <expected_foreign_earned_income_exclusion>110000</expected_foreign_earned_income_exclusion>
   <expected_days_outside_us>330</expected_days_outside_us>
   <expected_taxable_income>15000</expected_taxable_income>
   <expected_total_tax>1500</expected_total_tax>

   <!-- Taxpayers -->
   <taxpayers>
      <!-- Primary taxpayer working abroad -->
      <taxpayer id="1">
         <id>1</id>
         <name>Michael Anderson</name>
         <ssn>333-44-5555</ssn>
         <date_of_birth>9/5/1983</date_of_birth>
         <occupation>Oil & Gas Engineer</occupation>
         <is_us_citizen>true</is_us_citizen>
         <foreign_earned_income>110000</foreign_earned_income>
         <foreign_country>United Arab Emirates</foreign_country>
         <days_outside_us>330</days_outside_us>
         <foreign_residence_start>2/1/2025</foreign_residence_start>
         <foreign_residence_end>12/31/2025</foreign_residence_end>
         <physical_presence_test>true</physical_presence_test>
         <bona_fide_residence>false</bona_fide_residence>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>0</w2_wages>
         <w2_withholding>0</w2_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
      </taxpayer>

      <!-- Spouse working in US -->
      <taxpayer id="2">
         <id>2</id>
         <name>Sarah Anderson</name>
