   <!-- Foreign Test Case 4: Form 1116 - Foreign Tax Credit for Passive Income -->
   <!-- Tests: Calculate_Foreign_Tax_Credit -->
   <!-- Scenario: US resident with foreign passive income (interest/dividends) -->
   <!-- Foreign tax paid on dividends, claiming FTC instead of deduction -->
   <id>FOREIGN-04</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>NY</state>
   <city>New York</city>

   <!-- Expected values for validation -->
   <!-- US wages: $150,000 -->
   <!-- Foreign dividends: $25,000 (from UK stocks) -->
   <!-- Foreign tax paid: $3,750 (UK 15% withholding) -->
   <!-- AGI: $150,000 + $25,000 = $175,000 -->
   <!-- Standard deduction: $30,000 (MFJ) -->
   <!-- Taxable: $145,000 -->
   <!-- Tax before FTC: ~$22,400 -->
   <!-- FTC limitation: lesser of $3,750 paid OR US tax on foreign income -->
   <!-- US tax on foreign income: $25,000 @ ~22% = ~$5,500 -->
   <!-- FTC allowed: $3,750 (lesser amount) -->
   <!-- Final tax: $22,400 - $3,750 = $18,650 -->
   <expected_agi>175000</expected_agi>
   <expected_foreign_source_income>25000</expected_foreign_source_income>
   <expected_foreign_tax_paid>3750</expected_foreign_tax_paid>
   <expected_foreign_tax_credit>3750</expected_foreign_tax_credit>
   <expected_taxable_income>145000</expected_taxable_income>
   <expected_total_tax>18650</expected_total_tax>

   <!-- Taxpayers -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>David Williams</name>
         <ssn>666-77-8888</ssn>
