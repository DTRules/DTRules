   <!-- Foreign Test Case 8: Coordination - Combat Zone + Spouse FEIE -->
   <!-- Tests: Table 25400 - Coordinate_Military_And_Foreign_Income -->
   <!-- Scenario: Military member in combat zone + civilian spouse with FEIE -->
   <!-- No overlap of exclusions - combat zone exclusion and FEIE both apply -->
   <!-- References Military test case TestCase_Military_10 for coordination logic -->
   <id>FOREIGN-08</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>FL</state>
   <city>Jacksonville</city>

   <!-- Expected values for validation -->
   <!-- Service member W-2: $75,000 -->
   <!-- Combat zone pay: $55,000 (enlisted, fully excludable) -->
   <!-- IDP: $2,200 (also excludable) -->
   <!-- Taxable military wages: $75,000 - $55,000 - $2,200 = $17,800 -->
   <!-- Spouse foreign earned income: $102,000 -->
   <!-- FEIE max exclusion (2025): $126,500 -->
   <!-- Spouse FEIE exclusion: $102,000 (all excludable) -->
   <!-- Combined exclusions (no overlap): $57,200 (combat) + $102,000 (FEIE) = $159,200 -->
   <!-- AGI: $17,800 + $0 = $17,800 -->
   <!-- Standard deduction: $30,000 (MFJ) -->
   <!-- Taxable: $0 (negative becomes zero) -->
   <!-- Tax: $0 -->
   <!-- Child Tax Credit: $2,000 (non-refundable, no tax to offset) -->
   <expected_agi>17800</expected_agi>
   <expected_total_combat_zone_exclusion>57200</expected_total_combat_zone_exclusion>
   <expected_foreign_earned_income_exclusion>102000</expected_foreign_earned_income_exclusion>
   <expected_combined_military_foreign_exclusion>159200</expected_combined_military_foreign_exclusion>
   <expected_taxable_income>0</expected_taxable_income>
   <expected_total_tax>0</expected_total_tax>
   <expected_refund>2200</expected_refund>

