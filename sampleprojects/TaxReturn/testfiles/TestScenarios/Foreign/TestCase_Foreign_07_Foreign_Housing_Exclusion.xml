   <!-- Foreign Test Case 7: Form 2555 - Foreign Housing Exclusion/Deduction -->
   <!-- Tests: Process_Foreign_Earned_Income -->
   <!-- Scenario: US citizen abroad with employer-provided housing -->
   <!-- Housing costs exceed base amount, qualifies for housing exclusion -->
   <id>FOREIGN-07</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>TX</state>
   <city>Dallas</city>

   <!-- Expected values for validation -->
   <!-- Foreign earned income: $115,000 -->
   <!-- Days outside US: 365 (full year, bona fide residence) -->
   <!-- FEIE max exclusion (2025): $126,500 -->
   <!-- FEIE exclusion: $115,000 (full amount) -->
   <!-- Foreign housing costs: $65,000 (employer-provided) -->
   <!-- Foreign housing base (2025): $41,200 (16% of $126,500 + ($126,500 × 0.16)) -->
   <!-- Foreign housing amount: $65,000 - $41,200 = $23,800 -->
   <!-- Foreign housing exclusion: $23,800 (for employee) -->
   <!-- Combined exclusion: $115,000 + $23,800 = $138,800 -->
   <!-- Spouse US income: $52,000 -->
   <!-- AGI: $0 + $52,000 = $52,000 -->
   <!-- Standard deduction: $30,000 (MFJ) -->
   <!-- Taxable: $22,000 -->
   <!-- Tax: $2,200 (10% bracket) -->
   <expected_agi>52000</expected_agi>
   <expected_foreign_earned_income>115000</expected_foreign_earned_income>
   <expected_foreign_earned_income_exclusion>115000</expected_foreign_earned_income_exclusion>
   <expected_foreign_housing_expenses>65000</expected_foreign_housing_expenses>
   <expected_foreign_housing_base>41200</expected_foreign_housing_base>
   <expected_foreign_housing_exclusion>23800</expected_foreign_housing_exclusion>
   <expected_total_foreign_exclusion>138800</expected_total_foreign_exclusion>
   <expected_days_outside_us>365</expected_days_outside_us>
   <expected_taxable_income>22000</expected_taxable_income>
   <expected_total_tax>2200</expected_total_tax>

