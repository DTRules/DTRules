   <!-- Foreign Test Case 6: Form 1116 - FTC Limitation (Foreign Tax > US Tax on Foreign Income) -->
   <!-- Tests: Calculate_Foreign_Tax_Credit -->
   <!-- Scenario: Foreign tax paid exceeds US tax on same income -->
   <!-- FTC limited to lesser amount (US tax on foreign income) -->
   <!-- Excess can be carried forward -->
   <id>FOREIGN-06</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>FL</state>
   <city>Tampa</city>

   <!-- Expected values for validation -->
   <!-- US wages: $80,000 -->
   <!-- Foreign dividends: $20,000 (from France) -->
   <!-- Foreign tax paid: $6,000 (France 30% withholding) -->
   <!-- AGI: $80,000 + $20,000 = $100,000 -->
   <!-- Standard deduction: $30,000 (MFJ) -->
   <!-- Taxable: $70,000 -->
   <!-- Tax before FTC: $8,000 -->
   <!-- US tax on foreign income calculation: -->
   <!--   ($20,000 / $100,000) × $8,000 = $1,600 -->
   <!-- FTC limitation: lesser of $6,000 paid OR $1,600 US tax -->
   <!-- FTC allowed: $1,600 (limited by US tax) -->
   <!-- Excess FTC: $4,400 (can carry forward) -->
   <!-- Final tax: $8,000 - $1,600 = $6,400 -->
   <expected_agi>100000</expected_agi>
   <expected_foreign_source_income>20000</expected_foreign_source_income>
   <expected_foreign_tax_paid>6000</expected_foreign_tax_paid>
   <expected_foreign_tax_credit>1600</expected_foreign_tax_credit>
   <expected_foreign_tax_credit_carryforward>4400</expected_foreign_tax_credit_carryforward>
   <expected_taxable_income>68500</expected_taxable_income>
   <expected_total_tax>3343</expected_total_tax>

