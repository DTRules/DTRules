   <!-- Test Case: Form 2210 - Safe Harbor 100% Prior Year -->
   <!-- Scenario: Current year tax increased significantly, but paid 100% of prior year tax -->
   <!-- Should have NO PENALTY due to safe harbor exception -->
   <!-- Per IRC 6654(d)(1)(B)(i): Exception if paid 100% of prior year tax -->

   <id>EST-03</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>CO</state>

   <!-- Expected calculations: -->
   <!-- W-2 wages: $250,000 -->
   <!-- Bonus income (Q4): $80,000 -->
   <!-- AGI: $330,000 -->
   <!-- Standard Deduction: $30,000 -->
   <!-- Taxable: $300,000 -->
   <!-- Income Tax: ~$53,290 -->
   <!-- Total tax: $53,290 -->
   <!-- Prior year tax: $35,000 -->
   <!-- Required under 90% current: $53,290 x 0.90 = $47,961 -->
   <!-- Required under 100% prior: $35,000 -->
   <!-- Safe harbor amount: Lesser of $47,961 or $35,000 = $35,000 -->
   <!-- Estimated payments made: $36,000 (exceeds safe harbor) -->
   <!-- NO PENALTY - safe harbor met -->
   <expected_agi>330000</expected_agi>
   <expected_taxable_income>300000</expected_taxable_income>
   <expected_total_tax>53290</expected_total_tax>
   <expected_estimated_penalty>0</expected_estimated_penalty>
