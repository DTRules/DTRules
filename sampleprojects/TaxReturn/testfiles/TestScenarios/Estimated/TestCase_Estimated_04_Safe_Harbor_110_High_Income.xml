   <!-- Test Case: Form 2210 - Safe Harbor 110% High Income -->
   <!-- Scenario: AGI over $150,000 MFJ threshold, requires 110% of prior year tax -->
   <!-- Per IRC 6654(d)(1)(C): High income taxpayers need 110% of prior year -->
   <!-- Test case shows underpayment because only paid 100% instead of 110% -->

   <id>EST-04</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>NY</state>

   <!-- Expected calculations: -->
   <!-- W-2 wages: $400,000 -->
   <!-- Investment income: $50,000 -->
   <!-- AGI: $450,000 (exceeds $150,000 threshold) -->
   <!-- Standard Deduction: $30,000 -->
   <!-- Taxable: $420,000 -->
   <!-- Income Tax: ~$95,890 -->
   <!-- Additional Medicare Tax: $400,000 - $250,000 = $150,000 x 0.9% = $1,350 -->
   <!-- NIIT: $50,000 x 3.8% = $1,900 -->
   <!-- Total tax: $95,890 + $1,350 + $1,900 = $99,140 -->
   <!-- Prior year tax: $85,000 -->
   <!-- Prior year AGI: $380,000 (over $150,000) -->
   <!-- Safe harbor: 110% of $85,000 = $93,500 -->
   <!-- Required: Lesser of 90% current ($89,226) or 110% prior ($93,500) = $89,226 -->
   <!-- Actually 110% rule applies: $93,500 -->
   <!-- Estimated payments: $85,000 (only 100% of prior) -->
   <!-- Underpayment: $93,500 - $85,000 = $8,500 -->
   <!-- Quarterly underpayment: $8,500 / 4 = $2,125 -->
   <!-- Penalty rate: 8% -->
   <!-- Q1 penalty: $2,125 x 0.08 x (273/365) = $127 -->
   <!-- Q2 penalty: $2,125 x 0.08 x (182/365) = $85 -->
   <!-- Q3 penalty: $2,125 x 0.08 x (91/365) = $42 -->
   <!-- Q4 penalty: $0 -->
   <!-- Total penalty: $254 -->
   <expected_agi>450000</expected_agi>
   <expected_taxable_income>420000</expected_taxable_income>
   <expected_total_tax>99140</expected_total_tax>
   <expected_estimated_penalty>254</expected_estimated_penalty>

   <taxpayers>
