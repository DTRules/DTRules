   <!-- OR-03: High Income MFJ (Oregon Top Bracket) -->
   <!-- Test Case: MFJ filers hitting the top 9.9% bracket -->

   <!-- Tax Return Configuration -->
   <id>1003</id>
   <tax_year>2025</tax_year>
   <filing_status>Married_Filing_Jointly</filing_status>
   <state>OR</state>
   <city>Bend</city>

   <!-- Oregon Tax Calculation:
        Federal AGI: $300,000
        OR Standard Deduction (MFJ): $5,670
        OR Taxable Income: $294,330

        Bracket 1: $8,800 × 4.75% = $418.00
        Bracket 2: ($22,200 - $8,800) = $13,400 × 6.75% = $904.50
        Bracket 3: ($250,000 - $22,200) = $227,800 × 8.75% = $19,932.50
        Bracket 4: ($294,330 - $250,000) = $44,330 × 9.9% = $4,388.67
        Total Tax Before Credits: $25,643.67
        Personal Exemption Credits: 3 × $256 = $768
        Oregon Tax After Credits: $24,875.67
   -->

   <!-- Expected values for validation -->
   <expected_agi>300000</expected_agi>
   <expected_taxable_income>273200</expected_taxable_income>

