   <!-- Expected values for validation -->
   <!-- Federal AGI: $150,000 -->
   <!-- OH AGI: $150,000 -->
   <!-- OH Exemption: $1,850 per person (AGI > $80,000) -->
   <!-- Total Exemptions: 1 × $1,850 = $1,850 -->
   <!-- OH Taxable Income: $150,000 - $1,850 = $148,150 -->
   <!-- OH Tax: -->
   <!--   Bracket 1 (0% on $0-$26,050): $0 -->
   <!--   Bracket 2 (2.75% on $26,051-$100,000): $73,950 × 0.0275 = $2,033.625 -->
   <!--   Bracket 3 (3.125% above $100,000): $48,150 × 0.03125 = $1,504.6875 -->
   <!--   Total: $3,538.3125 -->
   <expected_agi>150000</expected_agi>
   <expected_oh_agi>150000</expected_oh_agi>
   <expected_oh_taxable_income>148150</expected_oh_taxable_income>
   <expected_oh_tax>3538.3125</expected_oh_tax>

