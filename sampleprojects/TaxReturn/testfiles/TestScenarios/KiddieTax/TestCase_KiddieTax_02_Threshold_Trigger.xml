   <!-- Test Case: Form 8615 - Kiddie Tax Threshold Trigger -->
   <!-- Scenario: 15-year-old with $2,700 unearned income (just over threshold) -->
   <!-- 2025 threshold: $2,500 triggers kiddie tax -->

   <!-- Kiddie Tax Calculation (2025): -->
   <!-- Unearned Income: $2,700 -->
   <!-- Standard Deduction for Dependent: $1,300 -->
   <!-- Remaining: $2,700 - $1,300 = $1,400 -->
   <!-- Next $1,300 taxed at child's rate (10%): $1,300 x 10% = $130 -->
   <!-- Remaining $100 taxed at parent's marginal rate (24%): $100 x 24% = $24 -->
   <!-- Total Kiddie Tax: $130 + $24 = $154 -->

   <!-- This tests the exact threshold where kiddie tax kicks in -->

   <id>KIDDIE-THRESHOLD-02</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>TX</state>

   <expected_agi>145000</expected_agi>
   <expected_total_kiddie_tax>154</expected_total_kiddie_tax>

