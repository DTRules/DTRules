   <!-- Test Case: Form 8814 - Parent Election to Report Child's Income -->
   <!-- Scenario: Parent elects to include child's unearned income on parent's return -->
   <!-- Child under 19 with unearned income under $12,500 -->

   <!-- Form 8814 Calculation (2025): -->
   <!-- Child's Unearned Income: $3,500 -->
   <!-- Parent can elect to report on their return if: -->
   <!-- - Child under 19 (or under 24 if full-time student) -->
   <!-- - Only unearned income -->
   <!-- - Unearned income < $12,500 -->
   <!-- - No estimated tax payments made -->

   <!-- Form 8814 Computation: -->
   <!-- Child's gross income: $3,500 -->
   <!-- Subtract: $1,300 (standard deduction amount) -->
   <!-- Remaining: $2,200 -->
   <!-- Parent adds to their AGI: $2,200 -->
   <!-- Additional tax on first $1,300: $130 (flat 10% on this portion) -->

   <id>KIDDIE-ELECTION-04</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>GA</state>

   <expected_agi>152200</expected_agi>
   <expected_additional_tax_form8814>130</expected_additional_tax_form8814>

