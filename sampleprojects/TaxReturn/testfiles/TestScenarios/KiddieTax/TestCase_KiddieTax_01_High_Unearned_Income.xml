   <!-- Test Case: Form 8615 - Kiddie Tax on High Unearned Income -->
   <!-- Scenario: 16-year-old with $5,000 trust fund dividends -->
   <!-- Child under 18 with unearned income triggers kiddie tax -->

   <!-- Kiddie Tax Calculation (2025): -->
   <!-- Unearned Income: $5,000 -->
   <!-- Standard Deduction for Dependent: $1,300 (kiddie tax standard deduction) -->
   <!-- Remaining: $5,000 - $1,300 = $3,700 -->
   <!-- Next $1,300 taxed at child's rate (10%): $1,300 x 10% = $130 -->
   <!-- Remaining $2,400 taxed at parent's marginal rate (32%): $2,400 x 32% = $768 -->
   <!-- Total Kiddie Tax: $130 + $768 = $898 -->

   <!-- Parent's Marginal Tax Rate: 32% (taxable income $180,000 MFJ) -->

   <id>KIDDIE-HIGH-01</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>CA</state>

   <expected_agi>180000</expected_agi>
   <expected_total_kiddie_tax>898</expected_total_kiddie_tax>

