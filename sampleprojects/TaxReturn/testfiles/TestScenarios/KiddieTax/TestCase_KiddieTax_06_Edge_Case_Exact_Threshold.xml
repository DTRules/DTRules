   <!-- Test Case: Kiddie Tax Edge Case - Exact Threshold -->
   <!-- Scenario: Child exactly at $2,500 unearned income threshold -->
   <!-- Tests boundary condition for kiddie tax application -->

   <!-- Boundary Testing: -->
   <!-- 2025 Kiddie Tax Threshold: $2,500 -->
   <!-- Child's Unearned Income: $2,500 (exactly at threshold) -->

   <!-- Kiddie Tax Calculation: -->
   <!-- Unearned Income: $2,500 -->
   <!-- Standard Deduction for Dependent: $1,300 -->
   <!-- Remaining: $2,500 - $1,300 = $1,200 -->
   <!-- All $1,200 taxed at child's rate (10%): $1,200 x 10% = $120 -->
   <!-- No parent's rate applied (under $2,600 net threshold) -->
   <!-- Total Tax: $120 -->

   <!-- Note: At exactly $2,500 gross, the NET unearned (after $1,300 deduction) -->
   <!-- is $1,200, which is below the $1,300 child's portion threshold. -->
   <!-- Only amounts over $2,600 gross trigger parent's rate. -->

