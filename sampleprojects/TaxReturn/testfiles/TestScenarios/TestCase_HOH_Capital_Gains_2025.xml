   <!-- Test: HOH Capital Gains Tax Brackets -->
   <!-- Income: $50,000 W2 wages + $20,000 long-term capital gains = $70,000 -->
   <!-- AGI: $70,000 -->
   <!-- Deduction: $22,500 standard (HOH) -->
   <!-- Taxable: $47,500 -->
   <!-- Regular income: $47,500 (fills 10% + 12% brackets) -->
   <!-- Capital gains: $20,000 -->
   <!--   - HOH 0% threshold: $63,000 -->
   <!--   - Since taxable income ($47,500) &lt; $63,000, all $20,000 gains at 0% -->
   <!--   - Remaining room in 0% bracket: $63,000 - $47,500 = $15,500 -->
   <!--   - First $15,500 of gains: 0% -->
   <!--   - Next $4,500 of gains: 15% = $675 -->
   <!-- Regular tax: ~$5,075 (10% on $16,550 + 12% on $30,950) -->
   <!-- Capital gains tax: $675 -->
   <!-- Total tax: $5,750 -->
   <!-- Child Tax Credit: $2,000 -->
   <!-- Net tax: $3,750 -->
   <!-- Withholding: $7,500 -->
   <!-- Refund: $3,750 -->
