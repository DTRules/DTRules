   <!-- Michigan Single Taxpayer Test Case -->
   <id>101</id>
   <tax_year>2025</tax_year>
   <filing_status>S</filing_status>
   <state>MI</state>
   <city>Detroit</city>

   <!-- Test Case 1: Single filer, W-2 income only -->
   <!-- Income: $60,000 W-2 wages -->
   <!-- Federal AGI: $60,000 -->
   <!-- MI Personal Exemption: $5,800 -->
   <!-- MI Taxable Income: $60,000 - $5,800 = $54,200 -->
   <!-- MI Tax: $54,200 * 0.0425 = $2,303.50 -->
   <expected_agi>60000</expected_agi>
   <expected_mi_state_tax>2303.50</expected_mi_state_tax>

   <!-- Taxpayer -->
   <taxpayers>
      <taxpayer id="1">
         <id>1</id>
         <name>John Smith</name>
         <ssn>111-22-3333</ssn>
         <date_of_birth>6/15/1985</date_of_birth>
         <age>40</age>
         <occupation>Software Developer</occupation>
         <is_self_employed>false</is_self_employed>
         <is_primary>true</is_primary>
         <w2_wages>60000</w2_wages>
         <w2_withholding>9000</w2_withholding>
         <se_gross_income>0</se_gross_income>
         <estimated_payments>0</estimated_payments>
         <retirement_income>0</retirement_income>
      </taxpayer>
   </taxpayers>

   <!-- No dependents -->
   <dependents>
   </dependents>

   <!-- No properties -->
   <properties>
   </properties>

   <!-- No schedule E income -->
   <schedule_e_income>
   </schedule_e_income>

   <!-- No itemized deductions -->
   <itemized_deductions>
   </itemized_deductions>
</job>
