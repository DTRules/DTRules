<!-- Test Case: Saver's Credit at 10% Rate with Phaseout -->
<!-- Scenario: Moderate income taxpayer qualifies for 10% Saver's Credit -->
<!-- Expected: 10% credit on $2,000 contribution = $200 -->
<job>
   <copyright>
