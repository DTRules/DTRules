   <!-- Required Minimum Distribution (RMD) - Age 73 (2025) -->
   <!-- SECURE 2.0 Act: RMD age is 73 for those born 1951-1959 -->
   <!-- IRS Uniform Lifetime Table (2024+): Age 73 = 26.5 divisor -->
   <!-- Taxpayer born in 1952, turns 73 in 2025 (first RMD year) -->
   <!-- IRA balance 12/31/2024: $500,000 -->
   <!-- RMD = $500,000 / 26.5 = $18,868 -->
   <!-- Failure to take RMD results in 25% excise tax (Form 5329) -->
   <!-- This test assumes RMD is properly taken -->

   <id>Retirement-10</id>
   <tax_year>2025</tax_year>
   <filing_status>MFJ</filing_status>
   <state>TX</state>

   <!-- Income: $45,000 pension + $18,868 RMD + $28,000 SS (50% taxable) -->
   <!-- Provisional Income: $45,000 + $18,868 + $14,000 = $77,868 (> $44k threshold) -->
   <!-- Taxable SS (85% tier): ~$23,800 (85% of $28,000) -->
   <!-- AGI: $45,000 + $18,868 + $23,800 = $87,668 -->
   <!-- Standard Deduction: $30,000 + $3,100 (both seniors) = $33,100 -->
   <!-- Taxable Income: $54,568 -->
   <expected_agi>87668</expected_agi>
   <expected_taxable_income>54568</expected_taxable_income>
   <expected_rmd>18868</expected_rmd>

