<?xml version="1.0" encoding="UTF-8"?>
<decision_tables>

<!-- TABLE 10200: Calculate_Overtime_Deduction -->
<decision_table>
<table_name>Calculate_Overtime_Deduction</table_name>
<xls_file>047_Calculate_Overtime_Deduction.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>No Tax on Overtime deduction per OBBBA 2025. Maximum $12,500 (Single/HOH) or $25,000 (MFJ). Phases out above $150,000 MAGI (Single) or $300,000 (MFJ).</COMMENTS>
<TABLE_NUMBER>10200</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions>
</initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has overtime income</condition_comment>
<condition_dsl>result.total_overtime_income &gt; 0</condition_dsl>
<condition_postfix>

</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value="Y"></condition_column>
<condition_column column_number="3" column_value="Y"></condition_column>
<condition_column column_number="4" column_value="Y"></condition_column>
<condition_column column_number="5" column_value="N"></condition_column>
</condition_details>
<condition_details>
<condition_number>2</condition_number>
<condition_comment>Married Filing Jointly</condition_comment>
<condition_dsl>job.filing_status is equal to &quot;MFJ&quot;</condition_dsl>
<condition_postfix>

</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value="Y"></condition_column>
<condition_column column_number="3" column_value="N"></condition_column>
<condition_column column_number="4" column_value="N"></condition_column>
<condition_column column_number="5" column_value="-"></condition_column>
</condition_details>
<condition_details>
<condition_number>3</condition_number>
<condition_comment>MFJ income below phase-out threshold ($300k)</condition_comment>
<condition_dsl>gross income below MFJ overtime phase-out threshold</condition_dsl>
<condition_postfix>

</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value="N"></condition_column>
<condition_column column_number="3" column_value="-"></condition_column>
<condition_column column_number="4" column_value="-"></condition_column>
<condition_column column_number="5" column_value="-"></condition_column>
</condition_details>
<condition_details>
<condition_number>4</condition_number>
<condition_comment>Single income below phase-out threshold ($150k)</condition_comment>
<condition_dsl>gross income below Single overtime phase-out threshold</condition_dsl>
<condition_postfix>

</condition_postfix>
<condition_column column_number="1" column_value="-"></condition_column>
<condition_column column_number="2" column_value="-"></condition_column>
<condition_column column_number="3" column_value="Y"></condition_column>
<condition_column column_number="4" column_value="N"></condition_column>
<condition_column column_number="5" column_value="-"></condition_column>
</condition_details>
</conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Full overtime deduction MFJ (below phase-out)</action_comment>
<action_dsl>set result.overtime_deduction = the minimum of result.total_overtime_income and constants.overtime_deduction_max_joint</action_dsl>
<action_postfix>

</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
</action_details>
<action_details>
<action_number>2</action_number>
<action_comment>Full overtime deduction Single (below phase-out)</action_comment>
<action_dsl>set result.overtime_deduction = the minimum of result.total_overtime_income and constants.overtime_deduction_max_single</action_dsl>
<action_postfix>

</action_postfix>
<action_column column_number="3" column_value="X"></action_column>
</action_details>
<action_details>
<action_number>3</action_number>
<action_comment>Overtime deduction phased out (high income)</action_comment>
<action_dsl>set result.overtime_deduction = 0</action_dsl>
<action_postfix>

</action_postfix>
<action_column column_number="2" column_value="X"></action_column>
<action_column column_number="4" column_value="X"></action_column>
</action_details>
<action_details>
<action_number>4</action_number>
<action_comment>No overtime income</action_comment>
<action_dsl>set result.overtime_deduction = 0</action_dsl>
<action_postfix>

</action_postfix>
<action_column column_number="5" column_value="X"></action_column>
</action_details>
</actions>
<policy_statements>
<policy_statement column="1">
<policy_description>Overtime deduction granted (MFJ below $300k) per OBBBA 2025</policy_description>
<policy_statement_postfix></policy_statement_postfix>
</policy_statement>
<policy_statement column="2">
<policy_description>Overtime deduction phased out (MFJ above $300k)</policy_description>
<policy_statement_postfix></policy_statement_postfix>
</policy_statement>
<policy_statement column="3">
<policy_description>Overtime deduction granted (Single below $150k) per OBBBA 2025</policy_description>
<policy_statement_postfix></policy_statement_postfix>
</policy_statement>
<policy_statement column="4">
<policy_description>Overtime deduction phased out (Single above $150k)</policy_description>
<policy_statement_postfix></policy_statement_postfix>
</policy_statement>
<policy_statement column="5">
<policy_description>No overtime deduction - no overtime income</policy_description>
<policy_statement_postfix></policy_statement_postfix>
</policy_statement>
</policy_statements>
</decision_table>
