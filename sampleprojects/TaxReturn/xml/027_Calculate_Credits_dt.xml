<decision_table>
<table_name>Calculate_Credits</table_name>
<xls_file>027_Calculate_Credits.xlsx</xls_file>
<attribute_fields>
<Type>ALL</Type>
<COMMENTS>Calculates tax credits including Child Tax Credit (CTC), Other Dependent Credit (ODC), and Additional Child Tax Credit (ACTC) per Form 1040 Lines 19-21, Schedule 8812, IRC Section 24.</COMMENTS>
<TABLE_NUMBER>6000</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions>
<initial_action>
<action_dsl>set result.total_ctc = 0, set result.total_odc = 0, set result.total_actc = 0, set result.total_credits = 0</action_dsl>
<action_postfix>
0.0 /result.total_ctc xdef
0.0 /result.total_odc xdef
0.0 /result.total_actc xdef
0.0 /result.total_credits xdef
&quot;CREDITS (Form 1040 Lines 19-21)&quot; job.audit_trail swap addto
</action_postfix>
</initial_action>
</initial_actions>
