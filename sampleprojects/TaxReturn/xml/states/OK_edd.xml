<?xml version="1.0" encoding="UTF-8"?>
<!--
  State-specific constants for Oklahoma

  Oklahoma has progressive tax brackets:
  - $0 to $1,000: 0.25%
  - $1,000 to $2,500: 0.75%
  - $2,500 to $3,750: 1.75%
  - $3,750 to $4,900: 2.75%
  - $4,900 to $7,200: 3.75%
  - Over $7,200: 4.75%

  Standard deductions (2025):
  - Single: $6,350
  - MFJ: $12,700
  - HOH: $9,350

  This file will be merged into TaxReturn_edd.xml by scripts/merge-states.sh
-->
