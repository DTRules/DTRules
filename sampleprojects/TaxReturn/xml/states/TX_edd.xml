<?xml version="1.0" encoding="UTF-8"?>
<!--
  State-specific constants for Texas (TX)

  Texas has NO state income tax. This is one of 9 states in the US without
  a state income tax (Alaska, Florida, Nevada, New Hampshire, South Dakota,
  Tennessee, Texas, Washington, Wyoming).

  This file documents this fact for consistency with the separate-files-per-state
  architecture, but no tax calculation is needed.

  This file will be merged into TaxReturn_edd.xml by scripts/merge-states.sh
-->
<entity_data_dictionary version="1.0">
  <file_metadata>
    <file_path>states/TX/44300_TX_constants</file_path>
  </file_metadata>
  <!-- Texas state tax constants (TX has no income tax) -->
  <entity name="result">
    <!-- No state income tax -->
    <field name="tx_has_income_tax" type="boolean" default_value="false"
           comment="TX has no state income tax (2025)"/>

    <field name="tx_tax_rate" type="double" default_value="0.0"
           comment="TX state income tax rate - 0.0 (no income tax)"/>

  </entity>
</entity_data_dictionary>
