<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Vermont military retirement exemption calculation (2025). AGI-based: Full exemption if AGI ≤ $125k, partial (phase-out) if $125k-$175k, no exemption if AGI &gt; $175k. Source: MOAA State Report Card, Vermont tax law changes effective 2025.</COMMENTS>
<TABLE_NUMBER>44790</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions>
</initial_actions>
<conditions>
<condition_details>
<condition_number>2</condition_number>
<condition_comment>AGI in phase-out range; $125,000 &lt; AGI &lt; $175,000 (partial exemption)</condition_comment>
<condition_dsl>result.agi > result.vt_military_agi_full_exemption_threshold and result.agi &lt; result.vt_military_agi_no_exemption_threshold</condition_dsl>
<condition_postfix>
AGI in phase-out range; $125,000 &lt; AGI &lt; $175,000 (partial exemption)
</condition_postfix>
</condition_details>
<condition_details>
<condition_number>3</condition_number>
<condition_comment>AGI ≥ $175,000; AGI ≥ $175,000 (no exemption)</condition_comment>
<condition_dsl>result.agi >= result.vt_military_agi_no_exemption_threshold</condition_dsl>
<condition_postfix>
AGI ≥ $175,000; AGI ≥ $175,000 (no exemption)
</condition_postfix>
</condition_details>
</conditions>
