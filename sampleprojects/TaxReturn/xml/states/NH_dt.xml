<?xml version="1.0" encoding="UTF-8"?>
<!--
  State-specific decision tables for New Hampshire (NH)

  New Hampshire has NO state income tax (as of 2025, repealed dividend/interest tax).
  This table simply sets the state tax liability to zero and documents this in the audit trail.

  Table Number: 42900 (NH is 29th alphabetically among states)

  Military Tax Provisions:
    - NH has no state income tax
    - All military income (retirement, combat pay, active duty, etc.) is automatically tax-free
    - MSRRA: N/A (no income tax)
    - SCRA: N/A (no income tax)
    - Military spouses and service members have no state income tax burden
    - NH repealed dividend/interest tax in 2025, becoming a no-income-tax state

  This file will be merged into TaxReturn_dt.xml by scripts/merge-states.sh
-->
<decision_tables>

<!-- ====================================================================== -->
<!-- TABLE 42900: Calculate_NH_Tax - New Hampshire State Income Tax (None) -->
<!-- ====================================================================== -->
<decision_table>
<table_name>Calculate_NH_Tax</table_name>
<xls_file>TaxReturn_dt.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>New Hampshire state income tax calculation. NH has no state income tax (2025) - this table simply sets state_tax_liability to 0.</COMMENTS>
<TABLE_NUMBER>42900</TABLE_NUMBER>
</attribute_fields>

<contexts></contexts>

<initial_actions>
<initial_action>
<action_description>Initialize NH tax calculation</action_description>
<action_postfix>
"New Hampshire Tax Calculation Started (NH has no income tax as of 2025)" job.audit_trail swap addto
</action_postfix>
</initial_action>
</initial_actions>

<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Always execute</condition_comment>
<condition_description>true</condition_description>
<condition_postfix>
true
</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
</condition_details>
</conditions>

<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Set NH state tax to zero (no income tax)</action_comment>
<action_postfix>
0.0 /result.state_tax_liability xdef

"New Hampshire has no state income tax - state tax liability: $0.00" job.audit_trail swap addto
</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
</action_details>
</actions>

</decision_table>

</decision_tables>
