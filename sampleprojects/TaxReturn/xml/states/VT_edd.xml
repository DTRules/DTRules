<?xml version="1.0" encoding="UTF-8"?>
<!--
  State-specific constants for Vermont

  VT has progressive tax brackets (5 brackets) ranging from 3.35% to 8.75%.

  2025 Tax Year
  Standard Deduction: $14,600 (single/married filing separately), $29,200 (married filing jointly/HOH)
  Personal Exemption: $5,250 per person

  Source: Vermont Department of Taxes
  https://tax.vermont.gov/individuals/personal-income-tax/rates
-->
<entity_data_dictionary version="1.0">
  <file_metadata>
    <file_path>states/VT/44800_VT_constants</file_path>
  </file_metadata>
  <entity name="result">

    <!-- Standard deductions -->
    <field name="vt_standard_deduction_single" type="double" default_value="14600.0"
           comment="VT standard deduction single (2025)"/>
    <field name="vt_standard_deduction_joint" type="double" default_value="29200.0"
           comment="VT standard deduction married filing jointly (2025)"/>
    <field name="vt_standard_deduction_hoh" type="double" default_value="29200.0"
           comment="VT standard deduction head of household (2025)"/>

    <!-- Personal exemption -->
    <field name="vt_personal_exemption" type="double" default_value="5250.0"
           comment="VT personal exemption per person (2025)"/>

    <!-- Progressive tax brackets - Single Filers -->
    <!-- Bracket 1: $0 to $47,600 @ 3.35% -->
    <field name="vt_bracket_1_limit" type="double" default_value="47600.0"
           comment="VT tax bracket 1 upper limit single (2025)"/>
    <field name="vt_bracket_1_rate" type="double" default_value="0.0335"
           comment="VT tax rate for bracket 1 - 3.35% (2025)"/>

    <!-- Bracket 2: $47,600 to $115,350 @ 5.4% -->
    <field name="vt_bracket_2_limit" type="double" default_value="115350.0"
           comment="VT tax bracket 2 upper limit single (2025)"/>
    <field name="vt_bracket_2_rate" type="double" default_value="0.054"
           comment="VT tax rate for bracket 2 - 5.4% (2025)"/>

    <!-- Bracket 3: $115,350 to $200,200 @ 6.6% -->
    <field name="vt_bracket_3_limit" type="double" default_value="200200.0"
           comment="VT tax bracket 3 upper limit single (2025)"/>
    <field name="vt_bracket_3_rate" type="double" default_value="0.066"
           comment="VT tax rate for bracket 3 - 6.6% (2025)"/>

    <!-- Bracket 4: $200,200 to $254,400 @ 7.6% -->
    <field name="vt_bracket_4_limit" type="double" default_value="254400.0"
           comment="VT tax bracket 4 upper limit single (2025)"/>
    <field name="vt_bracket_4_rate" type="double" default_value="0.076"
           comment="VT tax rate for bracket 4 - 7.6% (2025)"/>

    <!-- Bracket 5: Over $254,400 @ 8.75% -->
    <field name="vt_bracket_5_rate" type="double" default_value="0.0875"
           comment="VT tax rate for bracket 5 - 8.75% (2025)"/>

    <!-- State tax result field -->
    <field name="vt_state_tax" type="double" default_value="0.0"
           comment="VT state income tax liability (2025)"/>

  </entity>
</entity_data_dictionary>
