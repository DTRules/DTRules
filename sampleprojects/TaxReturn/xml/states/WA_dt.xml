<?xml version="1.0" encoding="UTF-8"?>
<!--
  State-specific decision tables for Washington (WA)

  Washington State has NO state income tax.

  This table is a passthrough that sets state_tax_liability to 0.0 and logs the result.

  Table Numbering: 44700 (WA is state #47 alphabetically)

  This file will be merged into TaxReturn_dt.xml by scripts/merge-states.sh
-->
<decision_tables>

<!-- ====================================================================== -->
<!-- TABLE 44700: Calculate_WA_Tax - Washington State Income Tax           -->
<!-- ====================================================================== -->
<decision_table>
<table_name>Calculate_WA_Tax</table_name>
<xls_file>TaxReturn_dt.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Washington state income tax calculation. WA has no state income tax - this is a passthrough that sets state_tax_liability to 0.0 (2025).</COMMENTS>
<TABLE_NUMBER>44700</TABLE_NUMBER>
</attribute_fields>

<contexts></contexts>

<initial_actions>
<initial_action>
<action_description>Initialize WA tax calculation (no income tax)</action_description>
<action_postfix>
"Washington Tax Calculation Started (WA has no income tax)" job.audit_trail swap addto
</action_postfix>
</initial_action>
</initial_actions>

<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Always execute (passthrough for no-tax state)</condition_comment>
<condition_description>true</condition_description>
<condition_postfix>
true
</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
</condition_details>
</conditions>

<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Set WA state tax to zero (no income tax)</action_comment>
<action_postfix>
0.0 /result.state_tax_liability xdef

"Washington state tax: $0.00 (WA has no state income tax)" job.audit_trail swap addto
</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
</action_details>
</actions>

</decision_table>

</decision_tables>
