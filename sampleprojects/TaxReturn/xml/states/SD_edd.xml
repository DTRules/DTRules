<?xml version="1.0" encoding="UTF-8"?>
<!--
  State-specific constants for South Dakota (SD)

  South Dakota has NO state income tax.

  This file documents that SD does not impose a state income tax.
  The decision table will simply pass through with zero tax liability.

  Military Tax Provisions:
    - SD has no state income tax
    - All military income (retirement, combat pay, active duty, etc.) is automatically tax-free
    - MSRRA: N/A (no income tax)
    - SCRA: N/A (no income tax)
    - Military spouses and service members have no state income tax burden

  This file will be merged into TaxReturn_edd.xml by scripts/merge-states.sh
-->
<entity_data_dictionary version="1.0">
  <file_metadata>
    <file_path>states/SD/44100_SD_constants</file_path>
  </file_metadata>
  <!-- South Dakota state constants -->
  <entity name="result">
    <!-- South Dakota has no state income tax -->
    <field name="sd_has_income_tax" type="boolean" default_value="false"
           comment="South Dakota does not impose state income tax (2025)"/>

    <field name="sd_tax_rate" type="double" default_value="0.0"
           comment="SD tax rate: 0% - no state income tax (2025)"/>

  </entity>
</entity_data_dictionary>
