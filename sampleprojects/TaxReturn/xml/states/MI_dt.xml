<decision_tables>

<!-- TABLE 42200: Calculate_MI_Tax -->
<decision_table>
<table_name>Calculate_MI_Tax</table_name>
<xls_file>MI.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Michigan state income tax calculation. Implements flat 4.25% tax rate with personal exemptions per MI tax code (2025).</COMMENTS>
<TABLE_NUMBER>42200</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions>
</initial_actions>
<conditions>
<condition_details>
<condition_number>2</condition_number>
<condition_comment>Filing status is Head of Household</condition_comment>
<condition_dsl>job.filing_status is equal to "HOH"</condition_dsl>
<condition_postfix>
Filing status is Head of Household
</condition_postfix>
<condition_column column_number="1" column_value="N"></condition_column>
<condition_column column_number="2" column_value="N"></condition_column>
<condition_column column_number="3" column_value="Y"></condition_column>
<condition_column column_number="4" column_value="N"></condition_column>
</condition_details>
<condition_details>
<condition_number>3</condition_number>
<condition_comment>Default case (Married Filing Separately, etc.)</condition_comment>
<condition_dsl>otherwise</condition_dsl>
<condition_postfix>
Default case (Married Filing Separately, etc.)
</condition_postfix>
<condition_column column_number="1" column_value="N"></condition_column>
<condition_column column_number="2" column_value="N"></condition_column>
<condition_column column_number="3" column_value="N"></condition_column>
<condition_column column_number="4" column_value="Y"></condition_column>
</condition_details>
</conditions>
<actions>
<action_details>
<action_number>4</action_number>
<action_comment>Calculate MI taxable income (AGI - exemptions, minimum 0)</action_comment>
<action_dsl>set result.mi_taxable_income = (result.agi - result.mi_total_exemption) max 0</action_dsl>
<action_postfix>
Calculate MI taxable income (AGI - exemptions, minimum 0)
</action_postfix>
</action_details>
<action_details>
<action_number>5</action_number>
<action_comment>Calculate MI tax: taxable income × 4.25%</action_comment>
<action_dsl>set result.state_tax_liability = result.mi_taxable_income * result.mi_tax_rate</action_dsl>
<action_postfix>
Calculate MI tax: taxable income × 4.25%
</action_postfix>
</action_details>
</actions>
<policy_statements>
</policy_statements>
</decision_table>

