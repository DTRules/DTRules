<?xml version="1.0" encoding="UTF-8"?>
<!--
  State-specific decision tables for Michigan

  Michigan Tax Structure (2025):
  - Flat tax rate: 4.25%
  - Personal exemptions: $5,800 per taxpayer, spouse, and dependent
  - Calculation: (AGI - Total Exemptions) × 4.25%

  Table Number: 42200 (MI is state #22 alphabetically)

  This file will be merged into TaxReturn_dt.xml by scripts/merge-states.sh
-->
<decision_tables>

<!-- ====================================================================== -->
<!-- TABLE 42200: Calculate_MI_Tax - Michigan State Income Tax            -->
<!-- ====================================================================== -->
<decision_table>
<table_name>Calculate_MI_Tax</table_name>
<xls_file>TaxReturn_dt.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Michigan state income tax calculation. Implements flat 4.25% tax rate with personal exemptions per MI tax code (2025).</COMMENTS>
<TABLE_NUMBER>42200</TABLE_NUMBER>
<FILE_PATH>states/MI/42200_Calculate_MI_Tax</FILE_PATH>
</attribute_fields>

<contexts></contexts>

<initial_actions>
<initial_action>
<action_description>Initialize Michigan tax calculation</action_description>
<action_postfix>
"Michigan Tax Calculation Started" job.audit_trail swap addto
</action_postfix>
</initial_action>
</initial_actions>

<conditions>
<!-- Condition 1: Filing status is Single -->
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Filing status is Single</condition_comment>
<condition_description>result.filing_status "single" ==</condition_description>
<condition_postfix>
result.filing_status "single" ==
</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value="N"></condition_column>
<condition_column column_number="3" column_value="N"></condition_column>
<condition_column column_number="4" column_value="N"></condition_column>
</condition_details>

<!-- Condition 2: Filing status is Married Filing Jointly -->
<condition_details>
<condition_number>2</condition_number>
<condition_comment>Filing status is Married Filing Jointly</condition_comment>
<condition_description>result.filing_status "married_filing_jointly" ==</condition_description>
<condition_postfix>
result.filing_status "married_filing_jointly" ==
</condition_postfix>
<condition_column column_number="1" column_value="N"></condition_column>
<condition_column column_number="2" column_value="Y"></condition_column>
<condition_column column_number="3" column_value="N"></condition_column>
<condition_column column_number="4" column_value="N"></condition_column>
</condition_details>

<!-- Condition 3: Filing status is Head of Household -->
<condition_details>
<condition_number>3</condition_number>
<condition_comment>Filing status is Head of Household</condition_comment>
<condition_description>result.filing_status "head_of_household" ==</condition_description>
<condition_postfix>
result.filing_status "head_of_household" ==
</condition_postfix>
<condition_column column_number="1" column_value="N"></condition_column>
<condition_column column_number="2" column_value="N"></condition_column>
<condition_column column_number="3" column_value="Y"></condition_column>
<condition_column column_number="4" column_value="N"></condition_column>
</condition_details>

<!-- Condition 4: Any other filing status -->
<condition_details>
<condition_number>4</condition_number>
<condition_comment>Default case (Married Filing Separately, etc.)</condition_comment>
<condition_description>true</condition_description>
<condition_postfix>
true
</condition_postfix>
<condition_column column_number="1" column_value="N"></condition_column>
<condition_column column_number="2" column_value="N"></condition_column>
<condition_column column_number="3" column_value="N"></condition_column>
<condition_column column_number="4" column_value="Y"></condition_column>
</condition_details>
</conditions>

<actions>
<!-- Action 1: Calculate exemption for Single filers -->
<action_details>
<action_number>1</action_number>
<action_comment>Single: base exemption + dependent exemptions</action_comment>
<action_postfix>
result.mi_exemption_single
result.number_of_dependents result.mi_exemption_dependent mul add
/result.mi_total_exemption xdef

"MI exemptions (Single): $" result.mi_total_exemption cvs strconcat job.audit_trail swap addto
</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
<action_column column_number="2" column_value=""></action_column>
<action_column column_number="3" column_value=""></action_column>
<action_column column_number="4" column_value=""></action_column>
</action_details>

<!-- Action 2: Calculate exemption for Married Filing Jointly -->
<action_details>
<action_number>2</action_number>
<action_comment>Married Filing Jointly: base exemption (2 x $5,800) + dependent exemptions</action_comment>
<action_postfix>
result.mi_exemption_married
result.number_of_dependents result.mi_exemption_dependent mul add
/result.mi_total_exemption xdef

"MI exemptions (MFJ): $" result.mi_total_exemption cvs strconcat job.audit_trail swap addto
</action_postfix>
<action_column column_number="1" column_value=""></action_column>
<action_column column_number="2" column_value="X"></action_column>
<action_column column_number="3" column_value=""></action_column>
<action_column column_number="4" column_value=""></action_column>
</action_details>

<!-- Action 3: Calculate exemption for Head of Household -->
<action_details>
<action_number>3</action_number>
<action_comment>Head of Household: base exemption + dependent exemptions</action_comment>
<action_postfix>
result.mi_exemption_single
result.number_of_dependents result.mi_exemption_dependent mul add
/result.mi_total_exemption xdef

"MI exemptions (HOH): $" result.mi_total_exemption cvs strconcat job.audit_trail swap addto
</action_postfix>
<action_column column_number="1" column_value=""></action_column>
<action_column column_number="2" column_value=""></action_column>
<action_column column_number="3" column_value="X"></action_column>
<action_column column_number="4" column_value=""></action_column>
</action_details>

<!-- Action 4: Calculate exemption for other filing statuses -->
<action_details>
<action_number>4</action_number>
<action_comment>Other statuses: base exemption + dependent exemptions</action_comment>
<action_postfix>
result.mi_exemption_single
result.number_of_dependents result.mi_exemption_dependent mul add
/result.mi_total_exemption xdef

"MI exemptions (Other): $" result.mi_total_exemption cvs strconcat job.audit_trail swap addto
</action_postfix>
<action_column column_number="1" column_value=""></action_column>
<action_column column_number="2" column_value=""></action_column>
<action_column column_number="3" column_value=""></action_column>
<action_column column_number="4" column_value="X"></action_column>
</action_details>

<!-- Action 5: Calculate MI taxable income (all columns) -->
<action_details>
<action_number>5</action_number>
<action_comment>Calculate MI taxable income (AGI - exemptions, minimum 0)</action_comment>
<action_postfix>
result.agi result.mi_total_exemption sub 0 max
/result.mi_taxable_income xdef

"MI taxable income: $" result.mi_taxable_income cvs strconcat job.audit_trail swap addto
</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
<action_column column_number="2" column_value="X"></action_column>
<action_column column_number="3" column_value="X"></action_column>
<action_column column_number="4" column_value="X"></action_column>
</action_details>

<!-- Action 6: Calculate MI tax liability (all columns) -->
<action_details>
<action_number>6</action_number>
<action_comment>Calculate MI tax: taxable income × 4.25%</action_comment>
<action_postfix>
result.mi_taxable_income result.mi_tax_rate mul
/result.mi_tax_liability xdef

"Michigan tax calculated: $" result.mi_tax_liability cvs strconcat job.audit_trail swap addto
</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
<action_column column_number="2" column_value="X"></action_column>
<action_column column_number="3" column_value="X"></action_column>
<action_column column_number="4" column_value="X"></action_column>
</action_details>
</actions>

</decision_table>

</decision_tables>
