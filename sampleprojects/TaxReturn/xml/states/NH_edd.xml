<?xml version="1.0" encoding="UTF-8"?>
<!--
  State-specific constants for New Hampshire (NH)

  New Hampshire has NO state income tax (as of 2025). This is one of 9 states
  in the US without a state income tax (Alaska, Florida, Nevada, New Hampshire,
  South Dakota, Tennessee, Texas, Washington, Wyoming).

  NH repealed its dividend/interest tax in 2025, becoming a no-income-tax state.

  This file documents this fact for consistency with the separate-files-per-state
  architecture, but no tax calculation is needed.

  Military Tax Provisions:
    - NH has no state income tax
    - All military income (retirement, combat pay, active duty, etc.) is automatically tax-free
    - MSRRA: N/A (no income tax)
    - SCRA: N/A (no income tax)
    - Military spouses and service members have no state income tax burden
    - NH repealed dividend/interest tax in 2025

  This file will be merged into TaxReturn_edd.xml by scripts/merge-states.sh
-->
<entity_data_dictionary version="1.0">
  <!-- New Hampshire state tax constants (NH has no income tax) -->
  <entity name="result">
    <!-- No state income tax -->
    <field name="nh_has_income_tax" type="boolean" default_value="false"
           comment="NH has no state income tax (2025 - repealed dividend/interest tax)"/>

    <field name="nh_tax_rate" type="double" default_value="0.0"
           comment="NH state income tax rate - 0.0 (no income tax)"/>

  </entity>
</entity_data_dictionary>
