<!-- TABLE 42301: UT_Military_Retirement_Exclusion -->
<decision_table>
<table_name>UT_Military_Retirement_Exclusion</table_name>
<xls_file>UT.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Utah military retirement exclusion calculation. UT allows up to $10,000 exemption on military retirement pay with income caps: Single $50k, Joint $65k AGI. Must choose between military retirement or Social Security exemption. Honors MSRRA and SCRA per federal law. Source: MOAA State Report Card.</COMMENTS>
<TABLE_NUMBER>42301</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions>
</initial_actions>
<conditions>
<condition_details>
<condition_number>2</condition_number>
<condition_comment>Joint filer within AGI cap</condition_comment>
<condition_dsl>job.filing_status is equal to "MFJ" and result.agi &lt;= result.ut_military_exemption_agi_cap_joint</condition_dsl>
<condition_postfix>
Joint filer within AGI cap
</condition_postfix>
<condition_column column_number="1" column_value="N"></condition_column>
<condition_column column_number="2" column_value="Y"></condition_column>
</condition_details>
