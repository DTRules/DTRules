<?xml version="1.0" encoding="UTF-8"?>
<!--
  State-specific constants for Rhode Island

  RI has progressive tax brackets (3 brackets) ranging from 3.75% to 5.99%.

  2025 Tax Year (filed in 2026)
  Standard Deduction: $10,900 (single), $21,800 (married filing jointly), $16,350 (HOH)
  Personal Exemption: $5,100 per person

  Source: Rhode Island Division of Taxation
  https://tax.ri.gov/sites/g/files/xkgbur541/files/2024-10/ADV_2024_26_Inflation_Adjustments.pdf
-->
<entity_data_dictionary version="1.0">
  <entity name="result">

    <!-- Standard deductions -->
    <field name="ri_standard_deduction_single" type="double" default_value="10900.0"
           comment="RI standard deduction single (2025)"/>
    <field name="ri_standard_deduction_joint" type="double" default_value="21800.0"
           comment="RI standard deduction married filing jointly (2025)"/>
    <field name="ri_standard_deduction_hoh" type="double" default_value="16350.0"
           comment="RI standard deduction head of household (2025)"/>

    <!-- Personal exemption -->
    <field name="ri_personal_exemption" type="double" default_value="5100.0"
           comment="RI personal exemption amount per person (2025)"/>

    <!-- Progressive tax brackets - Same for all filing statuses -->
    <!-- Bracket 1: $0 to $79,900 @ 3.75% -->
    <field name="ri_bracket_1_limit" type="double" default_value="79900.0"
           comment="RI tax bracket 1 upper limit (2025)"/>
    <field name="ri_bracket_1_rate" type="double" default_value="0.0375"
           comment="RI tax rate for bracket 1 - 3.75% (2025)"/>

    <!-- Bracket 2: $79,900 to $181,650 @ 4.75% -->
    <field name="ri_bracket_2_limit" type="double" default_value="181650.0"
           comment="RI tax bracket 2 upper limit (2025)"/>
    <field name="ri_bracket_2_rate" type="double" default_value="0.0475"
           comment="RI tax rate for bracket 2 - 4.75% (2025)"/>

    <!-- Bracket 3: $181,650+ @ 5.99% -->
    <field name="ri_bracket_3_rate" type="double" default_value="0.0599"
           comment="RI tax rate for bracket 3 - 5.99% (2025)"/>

    <!-- State tax result field -->
    <field name="ri_state_tax" type="double" default_value="0.0"
           comment="RI state income tax liability (2025)"/>

  </entity>
</entity_data_dictionary>
