<decision_table>
<table_name>Calculate_SS_Taxability</table_name>
<xls_file>049_Calculate_SS_Taxability.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Calculates taxable portion of Social Security benefits per Publication 915. Uses provisional income (AGI + 50% SS + tax-exempt interest) to determine if 0%, 50%, or 85% of SS is taxable.</COMMENTS>
<TABLE_NUMBER>11000</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions>
<initial_action>
<action_dsl>set result.provisional_income = result.agi + (result.total_social_security * 0.5)</action_dsl>
<action_postfix>
result.agi result.total_social_security 0.5 f* f+ /result.provisional_income xdef
&quot;SOCIAL SECURITY TAXABILITY (Publication 915)&quot; job.audit_trail swap addto
&quot;  Total SS Benefits: $&quot; result.total_social_security cvs strconcat job.audit_trail swap addto
&quot;  Provisional Income: $&quot; result.provisional_income cvs strconcat &quot; (AGI + 50% SS)&quot; strconcat job.audit_trail swap addto
</action_postfix>
</initial_action>
</initial_actions>
