<?xml version="1.0" encoding="UTF-8"?>
<decision_tables>

<!-- TABLE 10300: Calculate_Senior_Deduction -->
<decision_table>
<table_name>Calculate_Senior_Deduction</table_name>
<xls_file>048_Calculate_Senior_Deduction.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Senior Additional Deduction per OBBBA 2025. $6,000 per senior (age 65+). Phases out above $75,000 MAGI (Single) or $150,000 (MFJ).</COMMENTS>
<TABLE_NUMBER>10300</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions>
</initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has seniors</condition_comment>
<condition_dsl>result.senior_count &gt; 0</condition_dsl>
<condition_postfix>

</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value="Y"></condition_column>
<condition_column column_number="3" column_value="Y"></condition_column>
<condition_column column_number="4" column_value="Y"></condition_column>
<condition_column column_number="5" column_value="N"></condition_column>
</condition_details>
<condition_details>
<condition_number>2</condition_number>
<condition_comment>Married Filing Jointly</condition_comment>
<condition_dsl>job.filing_status is equal to &quot;MFJ&quot;</condition_dsl>
<condition_postfix>

</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value="Y"></condition_column>
<condition_column column_number="3" column_value="N"></condition_column>
<condition_column column_number="4" column_value="N"></condition_column>
<condition_column column_number="5" column_value="-"></condition_column>
</condition_details>
<condition_details>
<condition_number>3</condition_number>
<condition_comment>MFJ income below phase-out threshold ($150k)</condition_comment>
<condition_dsl>gross income below MFJ senior phase-out threshold</condition_dsl>
<condition_postfix>

</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value="N"></condition_column>
<condition_column column_number="3" column_value="-"></condition_column>
<condition_column column_number="4" column_value="-"></condition_column>
<condition_column column_number="5" column_value="-"></condition_column>
</condition_details>
<condition_details>
<condition_number>4</condition_number>
<condition_comment>Single income below phase-out threshold ($75k)</condition_comment>
<condition_dsl>gross income below Single senior phase-out threshold</condition_dsl>
<condition_postfix>

</condition_postfix>
<condition_column column_number="1" column_value="-"></condition_column>
<condition_column column_number="2" column_value="-"></condition_column>
<condition_column column_number="3" column_value="Y"></condition_column>
<condition_column column_number="4" column_value="N"></condition_column>
<condition_column column_number="5" column_value="-"></condition_column>
</condition_details>
</conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Full senior deduction (below phase-out)</action_comment>
<action_dsl>set result.senior_deduction = result.senior_count * constants.senior_deduction_amount</action_dsl>
<action_postfix>

</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
<action_column column_number="3" column_value="X"></action_column>
</action_details>
<action_details>
<action_number>2</action_number>
<action_comment>Senior deduction phased out (high income)</action_comment>
<action_dsl>set result.senior_deduction = 0</action_dsl>
<action_postfix>

</action_postfix>
<action_column column_number="2" column_value="X"></action_column>
<action_column column_number="4" column_value="X"></action_column>
</action_details>
<action_details>
<action_number>3</action_number>
<action_comment>No seniors</action_comment>
<action_dsl>set result.senior_deduction = 0</action_dsl>
<action_postfix>

</action_postfix>
<action_column column_number="5" column_value="X"></action_column>
</action_details>
</actions>
<policy_statements>
<policy_statement column="1">
<policy_description>Senior deduction granted (MFJ below $150k) per OBBBA 2025</policy_description>
<policy_statement_postfix></policy_statement_postfix>
</policy_statement>
<policy_statement column="2">
<policy_description>Senior deduction phased out (MFJ above $150k)</policy_description>
<policy_statement_postfix></policy_statement_postfix>
</policy_statement>
<policy_statement column="3">
<policy_description>Senior deduction granted (Single below $75k) per OBBBA 2025</policy_description>
<policy_statement_postfix></policy_statement_postfix>
</policy_statement>
<policy_statement column="4">
<policy_description>Senior deduction phased out (Single above $75k)</policy_description>
<policy_statement_postfix></policy_statement_postfix>
</policy_statement>
<policy_statement column="5">
<policy_description>No senior deduction - no qualifying seniors</policy_description>
<policy_statement_postfix></policy_statement_postfix>
</policy_statement>
</policy_statements>
</decision_table>
