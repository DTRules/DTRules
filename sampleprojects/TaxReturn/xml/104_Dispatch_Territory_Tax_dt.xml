<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Dispatches to US territory-specific tax calculation. Territories have special tax systems: PR (separate progressive), VI/GU (mirror code), AS (frozen IRC 2000 + SE tax), MP/CNMI (mirror + rebate). Bona fide residence test determines filing authority.</COMMENTS>
<TABLE_NUMBER>40100</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions>
<initial_action>
<action_dsl>Log territory tax calculation start</action_dsl>
<action_postfix>
job.territory isnull not if
  &quot;US Territory Tax Calculation for &quot; job.territory strconcat job.audit_trail swap addto
then
</action_postfix>
</initial_action>
