<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Calculates capital gains tax using preferential rates (0%/15%/20%) per Schedule D Tax Worksheet, IRC 1(h). Applies different brackets based on filing status.</COMMENTS>
<TABLE_NUMBER>13000</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions>
<initial_action>
<action_description>set result.preferential_rate_income = result.total_long_term_gains + result.qualified_dividends</action_description>
<action_postfix>
result.total_long_term_gains result.total_qualified_dividends f+ allocate
result.taxable_income 0 local@ f- /result.ordinary_income_for_cg xdef
&quot;CAPITAL GAINS TAX (Schedule D Tax Worksheet)&quot; job.audit_trail swap addto
&quot;  Preferential Income (LTCG + QD): $&quot; 0 local@ cvs strconcat job.audit_trail swap addto
&quot;  Ordinary Income for CG Brackets: $&quot; result.ordinary_income_for_cg cvs strconcat job.audit_trail swap addto
</action_postfix>
</initial_action>
</initial_actions>
