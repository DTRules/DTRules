<decision_table>
<table_name>Dispatch_State_Tax</table_name>
<xls_file>103_Dispatch_State_Tax.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Dispatches to state-specific tax calculation for each state_period or falls back to job.state for single-state returns. Supports multi-state allocation for taxpayers who moved between states.</COMMENTS>
<TABLE_NUMBER>40000</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions>
<initial_action>
<action_dsl>Log state tax dispatcher invocation</action_dsl>
<action_postfix>
job.state_periods length 0 eq
if
  &quot;State Tax Calculation for &quot; job.state strconcat job.audit_trail swap addto
else
  &quot;Multi-State Tax Calculation&quot; job.audit_trail swap addto
  Allocate_Income_By_State
then
</action_postfix>
</initial_action>
</initial_actions>
