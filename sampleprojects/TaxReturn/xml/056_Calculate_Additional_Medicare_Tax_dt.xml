<COMMENTS>Calculates Additional Medicare Tax (0.9%) per Form 8959, IRC 3101(b)(2). Applies to wages and SE income over threshold.</COMMENTS>
<TABLE_NUMBER>15000</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions>
<initial_action>
<action_description>set result.medicare_wages = sum of taxpayer wages</action_description>
<action_postfix>
result.total_w2_wages result.total_se_income f+ /result.wages_for_additional_medicare xdef
&quot;ADDITIONAL MEDICARE TAX (Form 8959, IRC 3101(b)(2))&quot; job.audit_trail swap addto
&quot;  Wages + SE Income: $&quot; result.wages_for_additional_medicare cvs strconcat job.audit_trail swap addto
</action_postfix>
</initial_action>
