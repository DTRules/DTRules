<?xml version="1.0" encoding="UTF-8"?>
<decision_tables>

<!-- TABLE 4100: Calculate_QBI_Deduction -->
<decision_table>
<table_name>Calculate_QBI_Deduction</table_name>
<xls_file>034_Calculate_QBI_Deduction.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Calculates Qualified Business Income deduction per Form 8995/8995-A, Publication 535, IRC 199A. The QBI deduction allows eligible self-employed and small business owners to deduct up to 20% of their qualified business income.</COMMENTS>
<TABLE_NUMBER>4100</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions>
</initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has qualified business income</condition_comment>
<condition_dsl>result.total_se_income &gt; 0</condition_dsl>
<condition_postfix>

</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value="N"></condition_column>
</condition_details>
<condition_details>
<condition_number>2</condition_number>
<condition_comment>Taxable income below threshold (simplified calculation)</condition_comment>
<condition_dsl>taxable_income before QBI below $394,600 MFJ threshold (2025)</condition_dsl>
<condition_postfix>

</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
</condition_details>
</conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Calculate QBI deduction at 20%</action_comment>
<action_dsl>set result.qbi_deduction = result.total_se_income * qbi_rate</action_dsl>
<action_postfix>

</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
</action_details>
<action_details>
<action_number>2</action_number>
<action_comment>No QBI - no qualified business income</action_comment>
<action_dsl>set result.qbi_deduction = 0</action_dsl>
<action_postfix>

</action_postfix>
<action_column column_number="2" column_value="X"></action_column>
</action_details>
</actions>
<policy_statements>
</policy_statements>
</decision_table>
</decision_tables>
