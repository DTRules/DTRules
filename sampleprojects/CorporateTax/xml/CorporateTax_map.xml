			<initialentity entity='corporation' epush='true'></initialentity>
			<initialentity entity='revenue' epush='true'></initialentity>
			<initialentity entity='expense' epush='true'></initialentity>
			<initialentity entity='result' epush='true'></initialentity>
			<initialentity entity='apportionment' epush='true'></initialentity>
		</initialization>
	</XMLtoEDD>

