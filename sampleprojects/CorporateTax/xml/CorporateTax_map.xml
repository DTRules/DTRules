			<setattribute tag='state_subtractions' RAttribute='state_subtractions' enclosure='apportionment' type='double'></setattribute>

			<!-- Every enclosure tag must be declared or the loader treats it as
			     an unknown wrapper and the values inside have nowhere to land —
			     the exact failure Poker and SinusitisTherapy had (#948). -->
			<createentity entity='job' tag='job' id='id'></createentity>
			<createentity entity='corporation' tag='corporation' id='id'></createentity>
			<createentity entity='apportionment' tag='apportionment' id='id'></createentity>
			<createentity entity='result' tag='result' id='id'></createentity>
			<createentity entity='revenue' tag='revenue' id='id'></createentity>
			<createentity entity='expense' tag='expense' id='id'></createentity>
		</map>

		<entities>
