			<!-- Audit Trail -->
			<setattribute tag='audit_trail' RAttribute='audit_trail' enclosure='result' type='string'></setattribute>

			<!-- State tier inputs (campaign #948 Phase 3). The map predated the
			     state tables entirely: it had no <apportionment> tags and no
			     <entities> block, so the singletons the tables read were never
			     created and no state input could load. Added by hand because the
			     mapping authoring API covers only setattribute entries. -->
			<setattribute tag='state_code' RAttribute='state_code' enclosure='apportionment' type='string'></setattribute>
			<setattribute tag='has_physical_presence' RAttribute='has_physical_presence' enclosure='apportionment' type='boolean'></setattribute>
			<setattribute tag='has_economic_nexus' RAttribute='has_economic_nexus' enclosure='apportionment' type='boolean'></setattribute>
			<setattribute tag='gross_receipts_in_state' RAttribute='gross_receipts_in_state' enclosure='apportionment' type='double'></setattribute>
			<setattribute tag='transactions_in_state' RAttribute='transactions_in_state' enclosure='apportionment' type='integer'></setattribute>
			<setattribute tag='state_taxable_income' RAttribute='state_taxable_income' enclosure='apportionment' type='double'></setattribute>
			<setattribute tag='state_tax_rate' RAttribute='state_tax_rate' enclosure='apportionment' type='double'></setattribute>
			<setattribute tag='state_payments' RAttribute='state_payments' enclosure='apportionment' type='double'></setattribute>
			<setattribute tag='state_credits' RAttribute='state_credits' enclosure='apportionment' type='double'></setattribute>
