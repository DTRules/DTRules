<?xml version="1.0" encoding="UTF-8"?>
<!--
  State-specific constants for Rhode Island

  Rhode Island General Laws Title 44 Chapter 11
  - Tax rate: 7.0% flat rate on net income
  - Apportionment: Single-sales factor
  - Economic nexus: $100,000 in gross receipts or 200 transactions
  - Form: RI Form RI-1120C (Corporate Income Tax Return)

  This file will be merged into CorporateTax_edd.xml by scripts/merge-states.sh
-->
<entity_data_dictionary version="1.0">
  <file_metadata>
    <file_path>states/RI/54300_RI_constants</file_path>
  </file_metadata>

  <!-- Rhode Island state-specific constants -->
  <entity name="apportionment">
    <!-- Economic Nexus Thresholds (Post-Wayfair) -->
    <field name="ri_economic_nexus_threshold" type="double" default_value="100000.0"
           comment="RI economic nexus gross receipts threshold - $100,000"/>

    <field name="ri_transaction_threshold" type="integer" default_value="200"
           comment="RI economic nexus transaction count threshold - 200"/>

    <!-- State Tax Rate -->
    <field name="ri_state_tax_rate" type="double" default_value="0.070"
           comment="RI corporate income tax rate - 7% flat rate (R.I. Gen. Laws § 44-11-2)"/>

  </entity>

</entity_data_dictionary>
