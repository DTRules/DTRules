<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mississippi Corporate Tax Decision Tables

  Mississippi has a graduated corporate income tax with rates from 3% to 5%.

  Table Allocation: 53400-53499
  - 53400: Determine_MS_Filing_Requirement
  - 53420: Calculate_MS_Income_Adjustments
  - 53480: Calculate_MS_State_Tax

  This file will be merged into CorporateTax_dt.xml by merge script
-->
<decision_tables>

<!-- ====================================================================== -->
<!-- TABLE 53400: Determine_MS_Filing_Requirement                           -->
<!-- ====================================================================== -->
<decision_table>
<table_name>Determine_MS_Filing_Requirement</table_name>
<xls_file>MS_Corp.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Determine if corporation must file Mississippi state corporate tax return. Checks for physical presence or economic nexus.</COMMENTS>
<TABLE_NUMBER>53400</TABLE_NUMBER>
<FILE_PATH>states/MS/53400_Determine_MS_Filing_Requirement</FILE_PATH>
</attribute_fields>

<contexts></contexts>

<initial_actions>
<initial_action>
<action_description>Initialize MS filing requirement check</action_description>
<action_postfix>
"MS Filing Requirement Check Started" job.audit_trail swap addto
</action_postfix>
</initial_action>
</initial_actions>

<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has physical presence in MS</condition_comment>
<condition_description>apportionment.has_physical_presence == true &amp;&amp; apportionment.state_code == "MS"</condition_description>
<condition_postfix>
apportionment.has_physical_presence true eq
apportionment.state_code "MS" eq
and
</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value=""></condition_column>
<condition_column column_number="3" column_value=""></condition_column>
</condition_details>

<condition_details>
<condition_number>2</condition_number>
<condition_comment>Has economic nexus in MS</condition_comment>
<condition_description>apportionment.has_economic_nexus == true &amp;&amp; apportionment.state_code == "MS"</condition_description>
<condition_postfix>
apportionment.has_economic_nexus true eq
apportionment.state_code "MS" eq
and
</condition_postfix>
<condition_column column_number="1" column_value=""></condition_column>
<condition_column column_number="2" column_value="Y"></condition_column>
<condition_column column_number="3" column_value=""></condition_column>
</condition_details>
</conditions>

<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Physical nexus - MS filing required</action_comment>
<action_postfix>
<!-- Physical nexus established - filing required -->
<!-- Apportionment will be calculated by tables 7000-7500 -->
"MS filing required due to physical presence (office, employees, or property in state)" job.audit_trail swap addto

<!-- Reference: Mississippi Code § 27-7-19 (Nexus and filing requirements) -->
<!-- Reference: Mississippi Department of Revenue Business Tax Guide -->
</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
<action_column column_number="2" column_value=""></action_column>
<action_column column_number="3" column_value=""></action_column>
</action_details>

<action_details>
<action_number>2</action_number>
<action_comment>Economic nexus - MS filing required</action_comment>
<action_postfix>
<!-- Economic nexus established per Wayfair - filing required -->
<!-- Economic nexus threshold: $250,000 gross receipts in MS -->
<!-- Apportionment will be calculated by tables 7000-7500 -->
"MS filing required due to economic nexus (post-Wayfair)" job.audit_trail swap addto

<!-- Reference: South Dakota v. Wayfair, Inc., 138 S. Ct. 2080 (2018) -->
<!-- Reference: Mississippi Department of Revenue Economic Nexus Guidance -->
<!-- Reference: Mississippi Code § 27-7-19 (Filing requirements) -->
</action_postfix>
<action_column column_number="1" column_value=""></action_column>
<action_column column_number="2" column_value="X"></action_column>
<action_column column_number="3" column_value=""></action_column>
</action_details>

<action_details>
<action_number>3</action_number>
<action_comment>No nexus - no filing required</action_comment>
<action_postfix>
<!-- No nexus - no filing required -->
0.0 /apportionment.state_tax xdef
apportionment.state_payments /apportionment.state_refund_or_owed xdef

"No MS nexus - no filing requirement. Any estimated payments refunded." job.audit_trail swap addto

<!-- Reference: Mississippi Code § 27-7-19 (Nexus requirements) -->
</action_postfix>
<action_column column_number="1" column_value=""></action_column>
<action_column column_number="2" column_value=""></action_column>
<action_column column_number="3" column_value="X"></action_column>
</action_details>
</actions>

</decision_table>

<!-- ====================================================================== -->
<!-- TABLE 53420: Calculate_MS_Income_Adjustments                          -->
<!-- ====================================================================== -->
<decision_table>
<table_name>Calculate_MS_Income_Adjustments</table_name>
<xls_file>MS_Corp.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Calculate MS state-specific additions and subtractions to federal taxable income.</COMMENTS>
<TABLE_NUMBER>53420</TABLE_NUMBER>
<FILE_PATH>states/MS/53420_Calculate_MS_Income_Adjustments</FILE_PATH>
</attribute_fields>

<contexts></contexts>

<initial_actions>
<initial_action>
<action_description>Initialize MS income adjustments</action_description>
<action_postfix>
"MS Income Adjustments Calculation Started" job.audit_trail swap addto
</action_postfix>
</initial_action>
</initial_actions>

<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has MS nexus</condition_comment>
<condition_description>apportionment.has_economic_nexus == true || apportionment.has_physical_presence == true</condition_description>
<condition_postfix>
apportionment.has_economic_nexus true eq
apportionment.has_physical_presence true eq
or
</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value=""></condition_column>
</condition_details>
</conditions>

<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Calculate MS state-specific additions and subtractions</action_comment>
<action_postfix>
<!-- Calculate MS state additions -->
0.0 /additions xdef

<!-- MS requires addback of: -->
<!-- - Federal interest income (taxable to MS) -->
<!-- - IRC 199A deduction (MS may not conform) -->
<!-- - State income taxes deducted federally -->
<!-- - Certain bonus depreciation amounts (depends on year) -->

<!-- Example additions (would be calculated from entity fields): -->
<!-- additions += revenue.federal_bond_interest; -->
<!-- additions += result.section_199a_deduction; -->
<!-- additions += result.state_taxes_deducted; -->

additions /apportionment.state_additions xdef

<!-- Calculate MS state subtractions -->
0.0 /subtractions xdef

<!-- MS allows subtraction of: -->
<!-- - MS municipal bond interest (exempt for MS purposes) -->
<!-- - MS net operating loss deduction (5-year carryforward) -->
<!-- - Certain dividend income (dividend received deduction) -->

<!-- Example subtractions (would be calculated from entity fields): -->
<!-- subtractions += revenue.ms_municipal_interest; -->
<!-- subtractions += result.ms_nol_deduction; -->

subtractions /apportionment.state_subtractions xdef

"MS state-specific income adjustments calculated" job.audit_trail swap addto

<!-- Reference: MS Form 83-100 Schedule A (Additions to Federal Taxable Income) -->
<!-- Reference: MS Form 83-100 Schedule B (Deductions from Federal Taxable Income) -->
<!-- Reference: Mississippi Code § 27-7-5 (Adjustments to federal taxable income) -->
</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
<action_column column_number="2" column_value=""></action_column>
</action_details>

<action_details>
<action_number>2</action_number>
<action_comment>No nexus - no adjustments</action_comment>
<action_postfix>
0.0 /apportionment.state_additions xdef
0.0 /apportionment.state_subtractions xdef

"No MS nexus - no state adjustments calculated" job.audit_trail swap addto
</action_postfix>
<action_column column_number="1" column_value=""></action_column>
<action_column column_number="2" column_value="X"></action_column>
</action_details>
</actions>

</decision_table>

<!-- ====================================================================== -->
<!-- TABLE 53480: Calculate_MS_State_Tax                                    -->
<!-- ====================================================================== -->
<decision_table>
<table_name>Calculate_MS_State_Tax</table_name>
<xls_file>MS_Corp.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Calculate MS state corporate income tax. Applies MS graduated rates (3%, 4%, 5%) to apportioned and adjusted taxable income.</COMMENTS>
<TABLE_NUMBER>53480</TABLE_NUMBER>
<FILE_PATH>states/MS/53480_Calculate_MS_State_Tax</FILE_PATH>
</attribute_fields>

<contexts></contexts>

<initial_actions>
<initial_action>
<action_description>Initialize MS state tax calculation</action_description>
<action_postfix>
"MS State Tax Calculation Started" job.audit_trail swap addto
</action_postfix>
</initial_action>
</initial_actions>

<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has MS nexus</condition_comment>
<condition_description>apportionment.has_economic_nexus == true || apportionment.has_physical_presence == true</condition_description>
<condition_postfix>
apportionment.has_economic_nexus true eq
apportionment.has_physical_presence true eq
or
</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value=""></condition_column>
<condition_column column_number="3" column_value=""></condition_column>
</condition_details>

<condition_details>
<condition_number>2</condition_number>
<condition_comment>Has positive state taxable income</condition_comment>
<condition_description>apportionment.state_taxable_income > 0</condition_description>
<condition_postfix>
apportionment.state_taxable_income 0 gt
</condition_postfix>
<condition_column column_number="1" column_value="Y"></column_column>
<condition_column column_number="2" column_value=""></condition_column>
<condition_column column_number="3" column_value=""></condition_column>
</condition_details>
</conditions>

<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Calculate MS tax using graduated rates (3%, 4%, 5%)</action_comment>
<action_postfix>
<!-- MS uses graduated rates: 3%, 4%, 5% -->
apportionment.state_taxable_income /taxable_income xdef
0.0 /tax xdef

<!-- Tier 1: 3% on first $5,000 -->
taxable_income 0 gt if
  taxable_income apportionment.ms_bracket_tier1 min /tier1_income xdef
  tier1_income apportionment.ms_tax_rate_tier1 mul /tier1_tax xdef
  tax tier1_tax add /tax xdef
then

<!-- Tier 2: 4% on next $5,000 ($5,001-$10,000) -->
taxable_income apportionment.ms_bracket_tier1 gt if
  taxable_income apportionment.ms_bracket_tier1 sub
  apportionment.ms_bracket_tier2 apportionment.ms_bracket_tier1 sub
  min /tier2_income xdef
  tier2_income apportionment.ms_tax_rate_tier2 mul /tier2_tax xdef
  tax tier2_tax add /tax xdef
then

<!-- Tier 3: 5% on income over $10,000 -->
taxable_income apportionment.ms_bracket_tier2 gt if
  taxable_income apportionment.ms_bracket_tier2 sub /tier3_income xdef
  tier3_income apportionment.ms_tax_rate_tier3 mul /tier3_tax xdef
  tax tier3_tax add /tax xdef
then

tax /apportionment.state_tax xdef

<!-- Subtract MS state credits -->
<!-- MS offers various credits: jobs creation, investment, R&D, film production, etc. -->
apportionment.state_tax apportionment.state_credits sub 0 max
/apportionment.state_tax xdef

<!-- Calculate refund or amount owed -->
apportionment.state_payments apportionment.state_tax sub
/apportionment.state_refund_or_owed xdef

"MS state tax calculated using graduated rates (3%, 4%, 5%)" job.audit_trail swap addto

<!-- Reference: MS Form 83-100 (Corporate Income and Franchise Tax Return) -->
<!-- Reference: Mississippi Code § 27-7-5 (Tax rates) -->
<!-- Reference: Mississippi Code § 27-7-19 (Apportionment) -->
</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
<action_column column_number="2" column_value=""></action_column>
<action_column column_number="3" column_value=""></action_column>
</action_details>

<action_details>
<action_number>2</action_number>
<action_comment>No MS nexus - no tax liability</action_comment>
<action_postfix>
0.0 /apportionment.state_tax xdef
apportionment.state_payments /apportionment.state_refund_or_owed xdef

"No MS nexus - no tax liability. Any estimated payments refunded." job.audit_trail swap addto

<!-- Reference: Mississippi Code § 27-7-19 (Nexus requirements) -->
</action_postfix>
<action_column column_number="1" column_value=""></action_column>
<action_column column_number="2" column_value="X"></action_column>
<action_column column_number="3" column_value=""></action_column>
</action_details>

<action_details>
<action_number>3</action_number>
<action_comment>Nexus but no taxable income</action_comment>
<action_postfix>
0.0 /apportionment.state_tax xdef
apportionment.state_payments /apportionment.state_refund_or_owed xdef

"No MS taxable income - no tax liability. MS NOL: 5-year carryforward, no carryback." job.audit_trail swap addto

<!-- Reference: MS Form 83-100 (Corporate Income and Franchise Tax Return) -->
<!-- Reference: Mississippi Code § 27-7-5 (Net operating loss provisions) -->
</action_postfix>
<action_column column_number="1" column_value=""></action_column>
<action_column column_number="2" column_value=""></action_column>
<action_column column_number="3" column_value="X"></action_column>
</action_details>
</actions>

</decision_table>

</decision_tables>
