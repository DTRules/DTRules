<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kentucky Corporate Tax Entity Data Dictionary

  KY corporate income tax rate: 4.5% flat rate (effective 2025)

  Key Features:
  - Flat 4.5% corporate income tax rate (KRS 141.040)
  - Single-sales apportionment formula
  - Economic nexus: $100,000 gross receipts threshold or 200 transactions
  - LLET (Limited Liability Entity Tax) applies separately to gross receipts
  - No alternative minimum tax

  References:
  - KRS 141.040 (Tax rate: 4.5%)
  - KRS 141.120 (Apportionment)
  - Kentucky Form 720 (Corporation Income Tax Return)
  - Kentucky Department of Revenue Corporation Income Tax Instructions
-->
<entity_dictionary name="CorporateTax_KY_Constants">

  <!--
    Apportionment Entity: Kentucky Configuration

    Used by decision tables 7000-7500 for multi-state tax apportionment
    and KY-specific tables 53000-53099.
  -->
  <entity name="apportionment">

    <!-- State Identification -->
    <field name='state_code' type='string' default_value='KY'
           comment='Kentucky state code'/>

    <!-- Economic Nexus Thresholds (Post-Wayfair) -->
    <field name='economic_nexus_threshold' type='double' default_value='100000.0'
           comment='KY economic nexus gross receipts threshold: $100,000'/>

    <field name='transaction_threshold' type='integer' default_value='200'
           comment='KY economic nexus transaction count threshold: 200 transactions'/>

    <!-- Apportionment Formula -->
    <field name='apportionment_formula' type='string' default_value='single_sales'
           comment='KY uses single-sales factor apportionment (100% sales factor)'/>

    <!-- State Tax Rate -->
    <field name='state_tax_rate' type='double' default_value='0.045'
           comment='KY corporate income tax rate: 4.5% flat rate (KRS 141.040, effective 2025)'/>

    <!-- State Additions to Federal Taxable Income -->
    <field name='state_additions' type='double' default_value='0.0'
           comment='KY additions: federal interest income, IRC 199A addback, state tax refunds, etc.'/>

    <!-- State Subtractions from Federal Taxable Income -->
    <field name='state_subtractions' type='double' default_value='0.0'
           comment='KY subtractions: KY municipal bond interest, dividends from KY corporations, etc.'/>

    <!-- State Tax Credits -->
    <field name='state_credits' type='double' default_value='0.0'
           comment='KY tax credits: industrial development, film industry, coal incentive, recycling, etc.'/>

  </entity>

  <!--
    Result Entity: KY does not require special state-specific fields

    Kentucky uses a straightforward flat-rate system without:
    - Alternative minimum tax
    - Special surcharges (except LLET which is separate)
    - Industry-specific tax rates
    - Complex combined reporting requirements
  -->
  <entity name="result">
    <!-- No KY-specific fields required -->
  </entity>

</entity_dictionary>
