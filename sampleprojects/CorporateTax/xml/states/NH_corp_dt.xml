<!-- TABLE 53800: Determine_NH_Filing_Requirement -->
<decision_table el_compiled="true">
<source>
<relative_path>NH_corp.xlsx</relative_path>
<file_name>NH_corp.xlsx</file_name>
<sheet_number>1</sheet_number>
</source>
<table_name>Determine_NH_Filing_Requirement</table_name>
<xls_file>NH_corp.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Determine if corporation must file New Hampshire Business Profits Tax (BPT) return. Checks for physical presence or economic nexus ($109,000 gross income threshold).</COMMENTS>
<TABLE_NUMBER>53800</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has physical presence in NH</condition_comment>
<condition_dsl>apportionment.has_physical_presence == true AND apportionment.state_code == "NH"</condition_dsl>
<condition_postfix>
apportionment.has_physical_presence true beq { pop apportionment.state_code "NH" streq } over if
</condition_postfix>
<columns>Y-N</columns>
</condition_details>
<condition_details>
<condition_number>2</condition_number>
<condition_comment>Has economic nexus in NH</condition_comment>
<condition_dsl>apportionment.has_economic_nexus == true AND apportionment.state_code == "NH"</condition_dsl>
<condition_postfix>
apportionment.has_economic_nexus true beq { pop apportionment.state_code "NH" streq } over if
</condition_postfix>
<columns>-YN</columns>
</condition_details>
</conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Physical nexus - BPT filing required</action_comment>
<action_dsl>// Physical nexus established - filing required</action_dsl>
<action_postfix></action_postfix>
<columns>X--</columns>
</action_details>
<action_details>
<action_number>2</action_number>
<action_comment>Economic nexus - BPT filing required</action_comment>
<action_dsl>// Economic nexus established per Wayfair - filing required</action_dsl>
<action_postfix></action_postfix>
<columns>-X-</columns>
</action_details>
<action_details>
<action_number>3</action_number>
<action_comment>No nexus - no filing required</action_comment>
<action_dsl>set apportionment.state_tax = 0.0; set apportionment.state_refund_or_owed = apportionment.state_payments;</action_dsl>
<action_postfix>
0.0 cvd /apportionment.state_tax xdef apportionment.state_payments cvd /apportionment.state_refund_or_owed xdef
</action_postfix>
<columns>--X</columns>
</action_details>
</actions>
<policy_statements></policy_statements>
</decision_table>

<!-- TABLE 53820: Calculate_NH_Income_Adjustments -->
<decision_table el_compiled="true">
<source>
<relative_path>NH_corp.xlsx</relative_path>
<file_name>NH_corp.xlsx</file_name>
<sheet_number>2</sheet_number>
</source>
<table_name>Calculate_NH_Income_Adjustments</table_name>
<xls_file>NH_corp.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Calculate NH state-specific additions and subtractions to federal taxable income. NH uses static conformity to IRC as of December 31, 2018, and has decoupled from Section 163(j) interest limitations.</COMMENTS>
<TABLE_NUMBER>53820</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has nexus with NH; apportionment.has_economic_nexus == true OR apportionment.has_physical_presence == true</condition_comment>
<condition_dsl>apportionment.has_economic_nexus == true or apportionment.has_physical_presence == true</condition_dsl>
<condition_postfix>
apportionment.has_economic_nexus true beq { pop apportionment.has_physical_presence true beq } over not if
</condition_postfix>
<columns>YN</columns>
</condition_details>
</conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Calculate NH state additions and subtractions</action_comment>
<action_dsl>set apportionment.state_additions = 0.0; set apportionment.state_subtractions = 0.0;</action_dsl>
<action_postfix>
0.0 cvd /apportionment.state_additions xdef 0.0 cvd /apportionment.state_subtractions xdef
</action_postfix>
<columns>X-</columns>
</action_details>
<action_details>
<action_number>2</action_number>
<action_comment>No nexus - no adjustments</action_comment>
<action_dsl>set apportionment.state_additions = 0.0; set apportionment.state_subtractions = 0.0;</action_dsl>
<action_postfix>
0.0 cvd /apportionment.state_additions xdef 0.0 cvd /apportionment.state_subtractions xdef
</action_postfix>
<columns>-X</columns>
</action_details>
</actions>
<policy_statements></policy_statements>
</decision_table>

<!-- TABLE 53880: Calculate_NH_State_Tax -->
<decision_table el_compiled="true">
<source>
<relative_path>NH_corp.xlsx</relative_path>
<file_name>NH_corp.xlsx</file_name>
<sheet_number>3</sheet_number>
</source>
<table_name>Calculate_NH_State_Tax</table_name>
<xls_file>NH_corp.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Calculate NH Business Profits Tax (BPT). Applies NH 7.5% flat rate to apportioned and adjusted business profits.</COMMENTS>
<TABLE_NUMBER>53880</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has nexus with NH; apportionment.has_economic_nexus == true OR apportionment.has_physical_presence == true</condition_comment>
<condition_dsl>apportionment.has_economic_nexus == true or apportionment.has_physical_presence == true</condition_dsl>
<condition_postfix>
apportionment.has_economic_nexus true beq { pop apportionment.has_physical_presence true beq } over not if
</condition_postfix>
<columns>YYN</columns>
</condition_details>
<condition_details>
<condition_number>2</condition_number>
<condition_comment>Has positive state taxable income</condition_comment>
<condition_dsl>apportionment.state_taxable_income &gt; 0</condition_dsl>
<condition_postfix>
apportionment.state_taxable_income 0 f&gt;
</condition_postfix>
<columns>YN-</columns>
</condition_details>
</conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Calculate NH BPT at 7.5% flat rate</action_comment>
<action_dsl>set apportionment.state_tax = the maximum of (apportionment.state_taxable_income * apportionment.state_tax_rate - apportionment.state_credits) and (0.0); set apportionment.state_refund_or_owed = apportionment.state_payments - apportionment.state_tax;</action_dsl>
<action_postfix>
apportionment.state_taxable_income apportionment.state_tax_rate fmul apportionment.state_credits f- 0.0 fmax cvd /apportionment.state_tax xdef apportionment.state_payments apportionment.state_tax f- cvd /apportionment.state_refund_or_owed xdef
</action_postfix>
<columns>X--</columns>
</action_details>
<action_details>
<action_number>2</action_number>
<action_comment>Nexus but no taxable income</action_comment>
<action_dsl>set apportionment.state_tax = 0.0; set apportionment.state_refund_or_owed = apportionment.state_payments;</action_dsl>
<action_postfix>
0.0 cvd /apportionment.state_tax xdef apportionment.state_payments cvd /apportionment.state_refund_or_owed xdef
</action_postfix>
<columns>-X-</columns>
</action_details>
<action_details>
<action_number>3</action_number>
<action_comment>No nexus - no BPT liability</action_comment>
<action_dsl>set apportionment.state_tax = 0.0; set apportionment.state_refund_or_owed = apportionment.state_payments;</action_dsl>
<action_postfix>
0.0 cvd /apportionment.state_tax xdef apportionment.state_payments cvd /apportionment.state_refund_or_owed xdef
</action_postfix>
<columns>--X</columns>
</action_details>
</actions>
<policy_statements></policy_statements>
</decision_table>
</decision_tables>
