<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  File: sampleprojects/CorporateTax/xml/states/GA_corp_edd.xml
  State: Georgia (GA)
  Type: Corporate Income Tax - Entity Data Dictionary
  Table Range: 51100-51199
  XLS File: GA_Corp.xls
  ============================================================================

  Georgia Corporate Tax Entity Data Dictionary

  GA corporate income tax: 5.75% flat rate (GA Code § 48-7-21)
  Apportionment: Single-sales factor (100% sales)
  Economic nexus: $100,000 gross receipts threshold
  Form: GA Form 600 (Corporation Tax Return)
-->
<entity_dictionary name="CorporateTax_GA_Constants">
  <entity name="apportionment">

    <!-- State Identification -->
    <field name='state_code' type='string' default_value='GA'
           comment='Georgia state code'/>

    <!-- Economic Nexus Thresholds (Post-Wayfair) -->
    <field name='economic_nexus_threshold' type='double' default_value='100000.0'
           comment='GA economic nexus gross receipts threshold: $100,000'/>

    <field name='transaction_threshold' type='integer' default_value='200'
           comment='GA economic nexus transaction count threshold: 200'/>

    <!-- Apportionment Formula -->
    <field name='apportionment_formula' type='string' default_value='single_sales'
           comment='GA uses single-sales factor apportionment (100% sales)'/>

    <!-- State Tax Rate -->
    <field name='state_tax_rate' type='double' default_value='0.0575'
           comment='GA corporate income tax rate: 5.75% (GA Code § 48-7-21)'/>

    <!-- State Additions to Federal Taxable Income -->
    <field name='state_additions' type='double' default_value='0.0'
           comment='GA-specific additions: federal interest, state addbacks'/>

    <!-- State Subtractions from Federal Taxable Income -->
    <field name='state_subtractions' type='double' default_value='0.0'
           comment='GA-specific subtractions: municipal interest, state deductions'/>

    <!-- State Tax Credits -->
    <field name='state_credits' type='double' default_value='0.0'
           comment='GA tax credits: jobs credits, R&D credits, film credits, etc.'/>

  </entity>

  <!--
    Result Entity: GA-Specific Extensions

    No special GA-specific fields needed for basic implementation.
    GA uses standard flat rate structure with single-sales apportionment.
  -->
  <entity name="result">
    <!-- No additional GA-specific fields required -->
  </entity>

</entity_dictionary>
