<action_number>1</action_number>
<action_comment>Calculate NE state-specific additions and subtractions</action_comment>
<action_dsl>set apportionment.state_additions = 0.0; set apportionment.state_subtractions = 0.0;</action_dsl>
<action_postfix>
0.0 cvd /apportionment.state_additions xdef 0.0 cvd /apportionment.state_subtractions xdef
</action_postfix>
<columns>X-</columns>
</action_details>
<action_details>
<action_number>2</action_number>
<action_comment>No nexus - no adjustments</action_comment>
<action_dsl>set apportionment.state_additions = 0.0; set apportionment.state_subtractions = 0.0;</action_dsl>
<action_postfix>
0.0 cvd /apportionment.state_additions xdef 0.0 cvd /apportionment.state_subtractions xdef
</action_postfix>
<columns>-X</columns>
</action_details>
</actions>
<policy_statements></policy_statements>
</decision_table>

<!-- TABLE 53780: Calculate_NE_State_Tax -->
<decision_table el_compiled="true">
<source>
<relative_path>NE_corp.xlsx</relative_path>
<file_name>NE_corp.xlsx</file_name>
<sheet_number>3</sheet_number>
<source_hash>sha256:b7f8e6e67adb8509176452cc2c909eb50ab40745b447d99da00b2748f93b46a0</source_hash>
</source>
<table_name>Calculate_NE_State_Tax</table_name>
<xls_file>NE_corp.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Calculate NE state corporate income tax. Applies NE 5.20% flat rate (2025) to apportioned and adjusted taxable income. Rate will decrease to 4.55% (2026) and 3.99% (2027) under LB 754.</COMMENTS>
<TABLE_NUMBER>53780</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has NE nexus</condition_comment>
<condition_dsl>apportionment.has_economic_nexus == true || apportionment.has_physical_presence == true</condition_dsl>
<condition_postfix>
apportionment.has_economic_nexus true beq { pop apportionment.has_physical_presence true beq } over not if
</condition_postfix>
<columns>Y--</columns>
</condition_details>
<condition_details>
<condition_number>2</condition_number>
<condition_comment>Has positive state taxable income</condition_comment>
<condition_dsl>apportionment.state_taxable_income &gt; 0</condition_dsl>
<condition_postfix>
apportionment.state_taxable_income 0 f&gt;
</condition_postfix>
<columns>Y--</columns>
</condition_details>
</conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Calculate NE tax at 5.20% flat rate (2025)</action_comment>
<action_dsl>set apportionment.state_tax = the maximum of (apportionment.state_taxable_income * ne_apportionment.state_tax_rate - apportionment.state_credits) and (0.0); set apportionment.state_refund_or_owed = apportionment.state_payments - apportionment.state_tax;</action_dsl>
<action_postfix>
apportionment.state_taxable_income ne_apportionment.state_tax_rate fmul apportionment.state_credits f- 0.0 fmax cvd /apportionment.state_tax xdef apportionment.state_payments apportionment.state_tax f- cvd /apportionment.state_refund_or_owed xdef
</action_postfix>
<columns>X--</columns>
</action_details>
<action_details>
<action_number>2</action_number>
<action_comment>No NE nexus - no tax liability</action_comment>
<action_dsl>set apportionment.state_tax = 0.0; set apportionment.state_refund_or_owed = apportionment.state_payments;</action_dsl>
<action_postfix>
0.0 cvd /apportionment.state_tax xdef apportionment.state_payments cvd /apportionment.state_refund_or_owed xdef
</action_postfix>
<columns>-X-</columns>
</action_details>
<action_details>
<action_number>3</action_number>
<action_comment>Nexus but no taxable income</action_comment>
<action_dsl>set apportionment.state_tax = 0.0; set apportionment.state_refund_or_owed = apportionment.state_payments;</action_dsl>
<action_postfix>
0.0 cvd /apportionment.state_tax xdef apportionment.state_payments cvd /apportionment.state_refund_or_owed xdef
</action_postfix>
<columns>--X</columns>
</action_details>
</actions>
<policy_statements></policy_statements>
</decision_table>
</decision_tables>
