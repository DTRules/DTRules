<table_name>Calculate_NE_Income_Adjustments</table_name>
<xls_file>NE_corp.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Calculate NE state-specific additions and subtractions to federal taxable income.</COMMENTS>
<TABLE_NUMBER>53720</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
