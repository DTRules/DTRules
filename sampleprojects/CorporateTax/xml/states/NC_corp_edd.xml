<?xml version="1.0" encoding="UTF-8"?>
<!--
  North Carolina Corporate Tax Entity Data Dictionary

  NC has the LOWEST state corporate income tax rate in the nation at 2.5%.

  Key Features:
  - Flat 2.5% corporate income tax rate (NC General Statute § 105-130.3)
  - Single-sales apportionment formula
  - Economic nexus: $100,000 gross receipts threshold
  - No alternative minimum tax
  - No special surcharges

  References:
  - NC General Statute § 105-130.3 (Tax rate)
  - NC Form CD-405 (Corporation Income Tax Return)
  - NC Department of Revenue Corporate Income Tax Bulletins
-->
<entity_dictionary name="CorporateTax_NC_Constants">

  <!--
    Apportionment Entity: North Carolina Configuration

    Used by decision tables 7000-7500 for multi-state tax apportionment
    and NC-specific tables 51200-51299.
  -->
  <entity name="apportionment">

    <!-- State Identification -->
    <field name='state_code' type='string' default_value='NC'
           comment='North Carolina state code'/>

    <!-- Economic Nexus Thresholds (Post-Wayfair) -->
    <field name='economic_nexus_threshold' type='double' default_value='100000.0'
           comment='NC economic nexus gross receipts threshold: $100,000'/>

    <field name='transaction_threshold' type='integer' default_value='200'
           comment='NC economic nexus transaction count threshold: 200 transactions'/>

    <!-- Apportionment Formula -->
    <field name='apportionment_formula' type='string' default_value='single_sales'
           comment='NC uses single-sales factor apportionment (100% sales factor)'/>

    <!-- State Tax Rate - LOWEST IN THE NATION -->
    <field name='state_tax_rate' type='double' default_value='0.025'
           comment='NC corporate income tax rate: 2.5% (LOWEST state rate in the nation) - NC Gen. Stat. § 105-130.3'/>

    <!-- State Additions to Federal Taxable Income -->
    <field name='state_additions' type='double' default_value='0.0'
           comment='NC additions: federal interest income, certain expenses, IRC 199A addback, etc.'/>

    <!-- State Subtractions from Federal Taxable Income -->
    <field name='state_subtractions' type='double' default_value='0.0'
           comment='NC subtractions: NC municipal bond interest, state income taxes, state NOL, etc.'/>

    <!-- State Tax Credits -->
    <field name='state_credits' type='double' default_value='0.0'
           comment='NC tax credits: jobs creation, film production, renewable energy, historic preservation, etc.'/>

  </entity>

  <!--
    Result Entity: NC does not require special state-specific fields

    North Carolina uses a straightforward flat-rate system without:
    - Alternative minimum tax
    - Special surcharges
    - Industry-specific tax rates
    - Combined reporting complexity (though unitary rules apply)
  -->
  <entity name="result">
    <!-- No NC-specific fields required -->
  </entity>

</entity_dictionary>
