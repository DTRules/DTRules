<table_name>Calculate_OK_State_Tax</table_name>
<xls_file>OK_corp.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Calculate Oklahoma state corporate income tax. Applies 4% flat rate to apportioned and adjusted taxable income.</COMMENTS>
<TABLE_NUMBER>54180</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has nexus with OK</condition_comment>
<condition_dsl>apportionment.has_economic_nexus == true || apportionment.has_physical_presence == true</condition_dsl>
<condition_postfix>
apportionment.has_economic_nexus true beq { pop apportionment.has_physical_presence true beq } over not if
</condition_postfix>
<columns>YYN</columns>
</condition_details>
<condition_details>
<condition_number>2</condition_number>
<condition_comment>Has positive state taxable income</condition_comment>
<condition_dsl>apportionment.state_taxable_income &gt; 0</condition_dsl>
<condition_postfix>
apportionment.state_taxable_income 0 f&gt;
</condition_postfix>
<columns>YN-</columns>
</condition_details>
</conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Calculate OK tax at 4% flat rate</action_comment>
<action_dsl>set apportionment.state_tax = apportionment.state_taxable_income * apportionment.state_tax_rate; set apportionment.state_tax = the maximum of (apportionment.state_tax - apportionment.state_credits) and (0.0); set apportionment.state_refund_or_owed = apportionment.state_payments - apportionment.state_tax;</action_dsl>
<action_postfix>
apportionment.state_taxable_income apportionment.state_tax_rate fmul cvd /apportionment.state_tax xdef apportionment.state_tax apportionment.state_credits f- 0.0 fmax cvd /apportionment.state_tax xdef apportionment.state_payments apportionment.state_tax f- cvd /apportionment.state_refund_or_owed xdef
</action_postfix>
<columns>X--</columns>
</action_details>
<action_details>
<action_number>2</action_number>
<action_comment>Nexus but no taxable income</action_comment>
<action_dsl>set apportionment.state_tax = 0.0; set apportionment.state_refund_or_owed = apportionment.state_payments;</action_dsl>
<action_postfix>
0.0 cvd /apportionment.state_tax xdef apportionment.state_payments cvd /apportionment.state_refund_or_owed xdef
</action_postfix>
<columns>-X-</columns>
</action_details>
<action_details>
<action_number>3</action_number>
<action_comment>No nexus - no tax liability</action_comment>
<action_dsl>set apportionment.state_tax = 0.0; set apportionment.state_refund_or_owed = apportionment.state_payments;</action_dsl>
<action_postfix>
0.0 cvd /apportionment.state_tax xdef apportionment.state_payments cvd /apportionment.state_refund_or_owed xdef
</action_postfix>
<columns>--X</columns>
</action_details>
</actions>
<policy_statements></policy_statements>
</decision_table>
</decision_tables>
