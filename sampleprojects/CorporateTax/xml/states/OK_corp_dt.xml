<table_name>Calculate_OK_Income_Adjustments</table_name>
<xls_file>OK_corp.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Calculate Oklahoma state-specific additions and subtractions to federal taxable income.</COMMENTS>
<TABLE_NUMBER>54120</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has nexus with OK</condition_comment>
<condition_dsl>apportionment.has_economic_nexus == true || apportionment.has_physical_presence == true</condition_dsl>
<condition_postfix>
apportionment.has_economic_nexus true beq { pop apportionment.has_physical_presence true beq } over not if
</condition_postfix>
<columns>YN</columns>
</condition_details>
</conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Calculate OK state additions and subtractions</action_comment>
<action_dsl>set apportionment.state_additions = 0.0; set apportionment.state_subtractions = 0.0;</action_dsl>
<action_postfix>
0.0 cvd /apportionment.state_additions xdef 0.0 cvd /apportionment.state_subtractions xdef
</action_postfix>
<columns>X-</columns>
</action_details>
<action_details>
<action_number>2</action_number>
<action_comment>No nexus - no adjustments</action_comment>
<action_dsl>set apportionment.state_additions = 0.0; set apportionment.state_subtractions = 0.0;</action_dsl>
<action_postfix>
0.0 cvd /apportionment.state_additions xdef 0.0 cvd /apportionment.state_subtractions xdef
</action_postfix>
<columns>-X</columns>
</action_details>
</actions>
<policy_statements></policy_statements>
</decision_table>

<!-- TABLE 54180: Calculate_OK_State_Tax -->
<decision_table el_compiled="true">
<source>
<relative_path>OK_corp.xlsx</relative_path>
<file_name>OK_corp.xlsx</file_name>
<sheet_number>3</sheet_number>
