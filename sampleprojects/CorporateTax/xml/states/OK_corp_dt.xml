<?xml version="1.0" encoding="UTF-8"?>
<!--
  State-specific decision tables for Oklahoma

  OK Corporate Income Tax Overview:
  - Tax rate: 4.0% flat rate
  - Apportionment: Single-sales factor
  - Economic nexus: $100,000 gross receipts threshold

  This file will be merged into CorporateTax_dt.xml by scripts/merge-states.sh
-->
<decision_tables>

<!-- ====================================================================== -->
<!-- TABLE 54100: Determine_OK_Filing_Requirement                          -->
<!-- ====================================================================== -->
<decision_table>
<table_name>Determine_OK_Filing_Requirement</table_name>
<xls_file>OK_Corp.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Determine if corporation must file Oklahoma state corporate tax return. Checks for physical presence or economic nexus.</COMMENTS>
<TABLE_NUMBER>54100</TABLE_NUMBER>
<FILE_PATH>states/OK/54100_Determine_OK_Filing_Requirement</FILE_PATH>
</attribute_fields>

<contexts></contexts>

<initial_actions>
</initial_actions>

<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has physical presence in OK</condition_comment>
<condition_description>apportionment.has_physical_presence == true &amp;&amp; apportionment.state_code == 'OK'</condition_description>
<condition_postfix>
apportionment.has_physical_presence true eq
apportionment.state_code "OK" streq
and
</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value=""></condition_column>
<condition_column column_number="3" column_value="N"></condition_column>
</condition_details>

<condition_details>
<condition_number>2</condition_number>
<condition_comment>Has economic nexus in OK</condition_comment>
<condition_description>apportionment.has_economic_nexus == true &amp;&amp; apportionment.state_code == 'OK'</condition_description>
<condition_postfix>
apportionment.has_economic_nexus true eq
apportionment.state_code "OK" streq
and
</condition_postfix>
<condition_column column_number="1" column_value=""></condition_column>
<condition_column column_number="2" column_value="Y"></condition_column>
<condition_column column_number="3" column_value="N"></condition_column>
</condition_details>
</conditions>

<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Physical nexus - filing required</action_comment>
<action_postfix>
// Physical nexus established - filing required
</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
</action_details>

<action_details>
<action_number>2</action_number>
<action_comment>Economic nexus - filing required</action_comment>
<action_postfix>
// Economic nexus established per Wayfair - filing required
</action_postfix>
<action_column column_number="2" column_value="X"></action_column>
</action_details>

<action_details>
<action_number>3</action_number>
<action_comment>No nexus - no filing required</action_comment>
<action_postfix>
// No nexus - no filing required
apportionment.state_tax 0.0 xdef
apportionment.state_refund_or_owed apportionment.state_payments xdef
</action_postfix>
<action_column column_number="3" column_value="X"></action_column>
</action_details>
</actions>

</decision_table>

<!-- ====================================================================== -->
<!-- TABLE 54120: Calculate_OK_Income_Adjustments                          -->
<!-- ====================================================================== -->
<decision_table>
<table_name>Calculate_OK_Income_Adjustments</table_name>
<xls_file>OK_Corp.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Calculate Oklahoma state-specific additions and subtractions to federal taxable income.</COMMENTS>
<TABLE_NUMBER>54120</TABLE_NUMBER>
<FILE_PATH>states/OK/54120_Calculate_OK_Income_Adjustments</FILE_PATH>
</attribute_fields>

<contexts></contexts>

<initial_actions>
</initial_actions>

<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has nexus with OK</condition_comment>
<condition_description>apportionment.has_economic_nexus == true || apportionment.has_physical_presence == true</condition_description>
<condition_postfix>
apportionment.has_economic_nexus true eq
apportionment.has_physical_presence true eq
or
</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value="N"></condition_column>
</condition_details>
</conditions>

<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Calculate OK state additions and subtractions</action_comment>
<action_postfix>
// Calculate OK state additions and subtractions
apportionment.state_additions 0.0 xdef
apportionment.state_subtractions 0.0 xdef
</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
</action_details>

<action_details>
<action_number>2</action_number>
<action_comment>No nexus - no adjustments</action_comment>
<action_postfix>
// No nexus - no state adjustments
apportionment.state_additions 0.0 xdef
apportionment.state_subtractions 0.0 xdef
</action_postfix>
<action_column column_number="2" column_value="X"></action_column>
</action_details>
</actions>

</decision_table>

<!-- ====================================================================== -->
<!-- TABLE 54180: Calculate_OK_State_Tax                                   -->
<!-- ====================================================================== -->
<decision_table>
<table_name>Calculate_OK_State_Tax</table_name>
<xls_file>OK_Corp.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Calculate Oklahoma state corporate income tax. Applies 4% flat rate to apportioned and adjusted taxable income.</COMMENTS>
<TABLE_NUMBER>54180</TABLE_NUMBER>
<FILE_PATH>states/OK/54180_Calculate_OK_State_Tax</FILE_PATH>
</attribute_fields>

<contexts></contexts>

<initial_actions>
</initial_actions>

<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has nexus with OK</condition_comment>
<condition_description>apportionment.has_economic_nexus == true || apportionment.has_physical_presence == true</condition_description>
<condition_postfix>
apportionment.has_economic_nexus true eq
apportionment.has_physical_presence true eq
or
</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value="Y"></condition_column>
<condition_column column_number="3" column_value="N"></condition_column>
</condition_details>

<condition_details>
<condition_number>2</condition_number>
<condition_comment>Has positive state taxable income</condition_comment>
<condition_description>apportionment.state_taxable_income > 0</condition_description>
<condition_postfix>
apportionment.state_taxable_income 0 gt
</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value="N"></condition_column>
<condition_column column_number="3" column_value=""></condition_column>
</condition_details>
</conditions>

<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Calculate OK tax at 4% flat rate</action_comment>
<action_postfix>
// OK uses 4.0% flat rate
apportionment.state_tax apportionment.state_taxable_income apportionment.state_tax_rate mul xdef
// Subtract state credits
apportionment.state_tax apportionment.state_tax apportionment.state_credits sub 0.0 max xdef
// Calculate refund or amount owed
apportionment.state_refund_or_owed apportionment.state_payments apportionment.state_tax sub xdef
</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
</action_details>

<action_details>
<action_number>2</action_number>
<action_comment>Nexus but no taxable income</action_comment>
<action_postfix>
// Nexus but no taxable income - no tax liability
apportionment.state_tax 0.0 xdef
apportionment.state_refund_or_owed apportionment.state_payments xdef
</action_postfix>
<action_column column_number="2" column_value="X"></action_column>
</action_details>

<action_details>
<action_number>3</action_number>
<action_comment>No nexus - no tax liability</action_comment>
<action_postfix>
// No nexus - no tax liability
apportionment.state_tax 0.0 xdef
apportionment.state_refund_or_owed apportionment.state_payments xdef
</action_postfix>
<action_column column_number="3" column_value="X"></action_column>
</action_details>
</actions>

</decision_table>

</decision_tables>
