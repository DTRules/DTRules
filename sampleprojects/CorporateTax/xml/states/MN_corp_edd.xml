<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minnesota Corporate Tax Entity Data Dictionary

  MN Corporate Tax Summary (2025):
  - Tax Rate: 9.5% flat rate (as of 2024 tax year)
  - Previously had progressive brackets, now simplified to single rate
  - Apportionment: Single-sales factor
  - Economic Nexus: $100,000 in gross receipts
  - Form: Form M4 (Corporation Franchise Tax Return)

  References:
  - MN Stat. § 290.06 (Tax rate)
  - MN Stat. § 290.191 (Apportionment)
  - MN Form M4 Instructions
-->
<entity_dictionary name="CorporateTax_MN_Constants">

  <!--
    Apportionment Entity: Minnesota-Specific Configuration

    Minnesota uses single-sales factor apportionment and has a flat 9.5% rate
    (changed from progressive brackets in 2024).
  -->
  <entity name="apportionment">

    <!-- State Identification -->
    <field name='state_code' type='string' default_value='MN'
           comment='Minnesota state code'/>

    <!-- Economic Nexus Thresholds (Post-Wayfair) -->
    <field name='economic_nexus_threshold' type='double' default_value='100000.0'
           comment='MN economic nexus: $100,000 in gross receipts'/>

    <field name='transaction_threshold' type='integer' default_value='200'
           comment='MN economic nexus: 200 transactions (standard threshold)'/>

    <!-- Apportionment Formula -->
    <field name='apportionment_formula' type='string' default_value='single_sales'
           comment='MN uses single-sales factor apportionment (100% sales factor)'/>

    <!-- State Tax Rate -->
    <field name='state_tax_rate' type='double' default_value='0.095'
           comment='MN flat corporate tax rate: 9.5% (as of 2024)'/>

    <!-- State Additions to Federal Taxable Income -->
    <field name='state_additions' type='double' default_value='0.0'
           comment='MN additions: federal interest, IRC 199A addback, foreign dividend deduction, etc.'/>

    <!-- State Subtractions from Federal Taxable Income -->
    <field name='state_subtractions' type='double' default_value='0.0'
           comment='MN subtractions: state municipal interest, state NOL, business income deduction, etc.'/>

    <!-- State Tax Credits -->
    <field name='state_credits' type='double' default_value='0.0'
           comment='MN credits: R&D, jobs, Angel investment, renewable energy, etc.'/>

  </entity>

  <!--
    Result Entity: Minnesota-Specific Extensions

    MN-specific fields for the flat 9.5% rate structure.
    These fields document the transition from progressive to flat rate.
  -->
  <entity name="result">

    <!-- Minnesota Flat Rate Fields -->
    <field name='mn_flat_rate' type='double' default_value='0.095'
           comment='MN flat corporate tax rate: 9.5% (effective 2024)'/>

    <!-- Historical note: MN previously had progressive brackets -->
    <field name='mn_rate_notes' type='string' default_value='Flat 9.5% rate as of 2024'
           comment='MN simplified from progressive brackets to flat rate in 2024'/>

    <!-- Minnesota-Specific Deductions -->
    <field name='mn_small_business_deduction' type='double' default_value='0.0'
           comment='MN small business income deduction (if applicable)'/>

    <!-- Minnesota NOL (may differ from federal) -->
    <field name='mn_nol_carryforward' type='double' default_value='0.0'
           comment='MN NOL carryforward (80% of income limitation)'/>

  </entity>

</entity_dictionary>
