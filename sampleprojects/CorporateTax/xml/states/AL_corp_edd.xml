<?xml version="1.0" encoding="UTF-8"?>
<!--
  Alabama Corporate Tax Entity Data Dictionary

  Tax Rate: 6.5% flat rate (AL Code § 40-18-31)
  Apportionment: Single-sales factor
  Economic Nexus: $250,000 gross receipts

  Reference: AL Form 20C (Corporation Income Tax Return)
  Reference: AL Code § 40-18-31 (Tax rate)
  Reference: AL Department of Revenue - Corporate Income Tax Guide
-->
<entity_dictionary name="CorporateTax_AL_Constants">

  <!--
    Apportionment Entity: Alabama Configuration

    This entity is used by decision tables 7000-7500 to calculate
    multi-state tax apportionment.
  -->
  <entity name="apportionment">

    <!-- State Identification -->
    <field name='state_code' type='string' default_value='AL'
           comment='Alabama state code'/>

    <!-- Economic Nexus Thresholds (Post-Wayfair) -->
    <field name='economic_nexus_threshold' type='double' default_value='250000.0'
           comment='Alabama economic nexus gross receipts threshold - $250,000'/>

    <field name='transaction_threshold' type='integer' default_value='200'
           comment='Economic nexus transaction count threshold - 200 transactions'/>

    <!-- Apportionment Formula -->
    <field name='apportionment_formula' type='string' default_value='single_sales'
           comment='Alabama uses single-sales factor apportionment'/>

    <!-- Alabama Tax Rate -->
    <field name='state_tax_rate' type='double' default_value='0.065'
           comment='Alabama corporate income tax rate - 6.5% flat rate (AL Code § 40-18-31)'/>

    <!-- State Additions to Federal Taxable Income -->
    <field name='state_additions' type='double' default_value='0.0'
           comment='Alabama additions: interest on federal bonds, IRC 199A addback, etc.'/>

    <!-- State Subtractions from Federal Taxable Income -->
    <field name='state_subtractions' type='double' default_value='0.0'
           comment='Alabama subtractions: municipal interest, state taxes, Alabama NOL, etc.'/>

    <!-- State Tax Credits -->
    <field name='state_credits' type='double' default_value='0.0'
           comment='Alabama tax credits: jobs credit, R&D credit, historic preservation, etc.'/>

  </entity>

  <!--
    Result Entity: Alabama-Specific Extensions

    No special Alabama-specific fields needed beyond standard apportionment.
    Alabama uses a straightforward flat 6.5% rate with single-sales apportionment.
  -->
  <entity name="result">
    <!-- No Alabama-specific result fields required -->
  </entity>

</entity_dictionary>
