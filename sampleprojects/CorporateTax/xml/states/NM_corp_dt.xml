<?xml version="1.0" encoding="UTF-8"?>
<!--
  State-specific decision tables for New Mexico

  NM Corporate Income Tax Overview:
  - Tax rate: 5.9% flat rate (effective 2025)
  - Apportionment: Single-sales factor
  - Economic nexus: $100,000 gross receipts threshold

  This file will be merged into CorporateTax_dt.xml by scripts/merge-states.sh
-->
<decision_tables>

<!-- ====================================================================== -->
<!-- TABLE 53900: Determine_NM_Filing_Requirement                          -->
<!-- ====================================================================== -->
<decision_table>
<table_name>Determine_NM_Filing_Requirement</table_name>
<xls_file>NM_Corp.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Determine if corporation must file New Mexico state corporate tax return. Checks for physical presence or economic nexus.</COMMENTS>
<TABLE_NUMBER>53900</TABLE_NUMBER>
<FILE_PATH>states/NM/53900_Determine_NM_Filing_Requirement</FILE_PATH>
</attribute_fields>

<contexts></contexts>

<initial_actions>
</initial_actions>

<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has physical presence in NM</condition_comment>
<condition_description>apportionment.has_physical_presence == true AND apportionment.state_code == "NM"</condition_description>
<condition_postfix>
apportionment.has_physical_presence true eq
apportionment.state_code "NM" streq
and
</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value=""></condition_column>
<condition_column column_number="3" column_value="N"></condition_column>
</condition_details>

<condition_details>
<condition_number>2</condition_number>
<condition_comment>Has economic nexus in NM</condition_comment>
<condition_description>apportionment.has_economic_nexus == true AND apportionment.state_code == "NM"</condition_description>
<condition_postfix>
apportionment.has_economic_nexus true eq
apportionment.state_code "NM" streq
and
</condition_postfix>
<condition_column column_number="1" column_value=""></condition_column>
<condition_column column_number="2" column_value="Y"></condition_column>
<condition_column column_number="3" column_value="N"></condition_column>
</condition_details>
</conditions>

<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Physical nexus - filing required</action_comment>
<action_postfix>
// Physical nexus established - filing required
// Apportionment will be calculated by tables 7000-7500
</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
</action_details>

<action_details>
<action_number>2</action_number>
<action_comment>Economic nexus - filing required</action_comment>
<action_postfix>
// Economic nexus established per Wayfair - filing required
// Apportionment will be calculated by tables 7000-7500
</action_postfix>
<action_column column_number="2" column_value="X"></action_column>
</action_details>

<action_details>
<action_number>3</action_number>
<action_comment>No nexus - no filing required</action_comment>
<action_postfix>
// No nexus - no filing required
apportionment.state_tax 0.0 xdef
apportionment.state_refund_or_owed apportionment.state_payments xdef
</action_postfix>
<action_column column_number="3" column_value="X"></action_column>
</action_details>
</actions>

</decision_table>

<!-- ====================================================================== -->
<!-- TABLE 53920: Calculate_NM_Income_Adjustments                          -->
<!-- ====================================================================== -->
<decision_table>
<table_name>Calculate_NM_Income_Adjustments</table_name>
<xls_file>NM_Corp.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Calculate NM state-specific additions and subtractions to federal taxable income. Includes adjustments for NM's decoupling from federal bonus depreciation, IRC 168(n), and IRC 163(j) provisions.</COMMENTS>
<TABLE_NUMBER>53920</TABLE_NUMBER>
<FILE_PATH>states/NM/53920_Calculate_NM_Income_Adjustments</FILE_PATH>
</attribute_fields>

<contexts></contexts>

<initial_actions>
</initial_actions>

<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has nexus with NM</condition_comment>
<condition_description>apportionment.has_economic_nexus == true OR apportionment.has_physical_presence == true</condition_description>
<condition_postfix>
apportionment.has_economic_nexus true eq
apportionment.has_physical_presence true eq
or
</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value="N"></condition_column>
</condition_details>
</conditions>

<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Calculate NM state additions and subtractions</action_comment>
<action_postfix>
// Calculate NM state additions and subtractions
0.0 /additions xdef
0.0 /subtractions xdef
apportionment.state_additions additions xdef
apportionment.state_subtractions subtractions xdef
</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
</action_details>

<action_details>
<action_number>2</action_number>
<action_comment>No nexus - no adjustments</action_comment>
<action_postfix>
// No nexus - no state adjustments
apportionment.state_additions 0.0 xdef
apportionment.state_subtractions 0.0 xdef
</action_postfix>
<action_column column_number="2" column_value="X"></action_column>
</action_details>
</actions>

</decision_table>

<!-- ====================================================================== -->
<!-- TABLE 53980: Calculate_NM_State_Tax                                   -->
<!-- ====================================================================== -->
<decision_table>
<table_name>Calculate_NM_State_Tax</table_name>
<xls_file>NM_Corp.xls</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Calculate NM state corporate income tax. Applies NM 5.9% flat rate to apportioned and adjusted taxable income. NM changed to flat rate system in 2025 (previously had graduated rates).</COMMENTS>
<TABLE_NUMBER>53980</TABLE_NUMBER>
<FILE_PATH>states/NM/53980_Calculate_NM_State_Tax</FILE_PATH>
</attribute_fields>

<contexts></contexts>

<initial_actions>
</initial_actions>

<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has nexus with NM</condition_comment>
<condition_description>apportionment.has_economic_nexus == true OR apportionment.has_physical_presence == true</condition_description>
<condition_postfix>
apportionment.has_economic_nexus true eq
apportionment.has_physical_presence true eq
or
</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value="Y"></condition_column>
<condition_column column_number="3" column_value="N"></condition_column>
</condition_details>

<condition_details>
<condition_number>2</condition_number>
<condition_comment>Has positive state taxable income</condition_comment>
<condition_description>apportionment.state_taxable_income > 0</condition_description>
<condition_postfix>
apportionment.state_taxable_income 0 gt
</condition_postfix>
<condition_column column_number="1" column_value="Y"></condition_column>
<condition_column column_number="2" column_value="N"></condition_column>
<condition_column column_number="3" column_value=""></condition_column>
</condition_details>
</conditions>

<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Calculate NM tax at 5.9% flat rate</action_comment>
<action_postfix>
// NM uses 5.9% flat rate (effective 2025)
apportionment.state_taxable_income apportionment.state_tax_rate mul
/state_tax_before_credits xdef

// Subtract state credits
state_tax_before_credits apportionment.state_credits sub
0.0 max
/apportionment.state_tax xdef

// Calculate refund or amount owed
apportionment.state_payments apportionment.state_tax sub
/apportionment.state_refund_or_owed xdef
</action_postfix>
<action_column column_number="1" column_value="X"></action_column>
</action_details>

<action_details>
<action_number>2</action_number>
<action_comment>Nexus but no taxable income</action_comment>
<action_postfix>
// Nexus but no taxable income - no tax liability
apportionment.state_tax 0.0 xdef
apportionment.state_refund_or_owed apportionment.state_payments xdef
</action_postfix>
<action_column column_number="2" column_value="X"></action_column>
</action_details>

<action_details>
<action_number>3</action_number>
<action_comment>No nexus - no tax liability</action_comment>
<action_postfix>
// No nexus - no tax liability
apportionment.state_tax 0.0 xdef
apportionment.state_refund_or_owed apportionment.state_payments xdef
</action_postfix>
<action_column column_number="3" column_value="X"></action_column>
</action_details>
</actions>

</decision_table>

</decision_tables>
