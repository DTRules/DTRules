<?xml version="1.0" encoding="UTF-8"?>
<!--
  Massachusetts (MA) Corporate Tax Entity Data Dictionary

  Massachusetts General Laws Chapter 63 § 39
  - Tax rate: 8% flat rate on net income
  - Apportionment: Single-sales factor
  - Economic nexus: $500,000 in gross receipts
  - Form: MA Form 355 (Corporate Excise Tax Return)
-->
<entity_dictionary name="CorporateTax_MA_Constants">

  <!--
    Apportionment Entity: Massachusetts-Specific Configuration

    This entity is used by decision tables 7000-7500 to calculate
    multi-state tax apportionment.
  -->
  <entity name="apportionment">

    <!-- State Identification -->
    <field name='state_code' type='string' default_value='MA'
           comment='Massachusetts state code'/>

    <!-- Economic Nexus Thresholds (Post-Wayfair) -->
    <field name='economic_nexus_threshold' type='double' default_value='500000.0'
           comment='MA economic nexus gross receipts threshold - $500,000'/>

    <field name='transaction_threshold' type='integer' default_value='200'
           comment='MA economic nexus transaction count threshold - 200'/>

    <!-- Apportionment Formula -->
    <field name='apportionment_formula' type='string' default_value='single_sales'
           comment='MA uses single-sales factor apportionment'/>

    <!-- State Tax Rate -->
    <field name='state_tax_rate' type='double' default_value='0.080'
           comment='MA corporate excise tax rate - 8% flat rate (M.G.L. c. 63 § 39)'/>

    <!-- State Additions to Federal Taxable Income -->
    <field name='state_additions' type='double' default_value='0.0'
           comment='MA-specific additions: federal interest, IRC 199A addback, bonus depreciation, etc.'/>

    <!-- State Subtractions from Federal Taxable Income -->
    <field name='state_subtractions' type='double' default_value='0.0'
           comment='MA-specific subtractions: municipal interest, state taxes, state NOL, etc.'/>

    <!-- State Tax Credits -->
    <field name='state_credits' type='double' default_value='0.0'
           comment='MA tax credits: Economic Development Incentive Program (EDIP), R&D, film, etc.'/>

  </entity>

  <!--
    Result Entity: Massachusetts-Specific Extensions

    No special state-specific fields are required for Massachusetts.
    The standard apportionment fields are sufficient for MA's 8% flat rate.
  -->
  <entity name="result">
    <!-- No MA-specific fields needed -->
  </entity>

</entity_dictionary>
