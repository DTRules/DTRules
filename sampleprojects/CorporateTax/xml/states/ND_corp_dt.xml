<!-- TABLE 53600: Determine_ND_Filing_Requirement -->
<decision_table el_compiled="true">
<source>
<relative_path>ND_corp.xlsx</relative_path>
<file_name>ND_corp.xlsx</file_name>
<sheet_number>1</sheet_number>
</source>
<table_name>Determine_ND_Filing_Requirement</table_name>
<xls_file>ND_corp.xlsx</xls_file>
<attribute_fields>
<Type>FIRST</Type>
<COMMENTS>Determine if corporation must file North Dakota state corporate tax return. Checks for physical presence or economic nexus.</COMMENTS>
<TABLE_NUMBER>53600</TABLE_NUMBER>
</attribute_fields>
<contexts></contexts>
<initial_actions></initial_actions>
<conditions>
<condition_details>
<condition_number>1</condition_number>
<condition_comment>Has physical presence in ND</condition_comment>
<condition_dsl>apportionment.has_physical_presence == true AND apportionment.state_code == "ND"</condition_dsl>
<condition_postfix>
apportionment.has_physical_presence true beq { pop apportionment.state_code "ND" streq } over if
</condition_postfix>
<columns>Y--</columns>
</condition_details>
<condition_details>
<condition_number>2</condition_number>
<condition_comment>Has economic nexus in ND</condition_comment>
<condition_dsl>apportionment.has_economic_nexus == true AND apportionment.state_code == "ND"</condition_dsl>
<condition_postfix>
apportionment.has_economic_nexus true beq { pop apportionment.state_code "ND" streq } over if
</condition_postfix>
<columns>-Y-</columns>
</condition_details>
</conditions>
<actions>
<action_details>
<action_number>1</action_number>
<action_comment>Physical nexus - ND filing required</action_comment>
<action_dsl>// Physical nexus established - filing required</action_dsl>
<action_postfix></action_postfix>
<columns>X--</columns>
</action_details>
<action_details>
<action_number>2</action_number>
<action_comment>Economic nexus - ND filing required</action_comment>
<action_dsl>// Economic nexus established per Wayfair - filing required</action_dsl>
<action_postfix></action_postfix>
<columns>-X-</columns>
</action_details>
<action_details>
<action_number>3</action_number>
<action_comment>No nexus - no filing required</action_comment>
<action_dsl>set apportionment.state_tax = 0.0; set apportionment.state_refund_or_owed = apportionment.state_payments;</action_dsl>
<action_postfix>
0.0 cvi /apportionment.state_tax xdef apportionment.state_payments cvi /apportionment.state_refund_or_owed xdef
</action_postfix>
<columns>--X</columns>
</action_details>
</actions>
<policy_statements></policy_statements>
</decision_table>

