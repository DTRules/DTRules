        <action_postfix>apportionment.sales_in_state apportionment.sales_total fdiv cvd /apportionment.sales_factor xdef</action_postfix>
      </action_details>
      <action_details>
        <action_number>2</action_number>
        <action_dsl>set apportionment.sales_factor = 0.0</action_dsl>
