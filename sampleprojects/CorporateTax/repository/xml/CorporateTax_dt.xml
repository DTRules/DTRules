  <decision_table>
    <table_name>Determine_State_Nexus</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>apportionment.has_physical_presence == true</condition_dsl>
        <condition_postfix>apportionment.has_physical_presence true beq</condition_postfix>
      </condition_details>
      <condition_details>
        <condition_number>2</condition_number>
        <condition_dsl />
        <condition_postfix>
apportionment.gross_receipts_in_state apportionment.economic_nexus_threshold &gt;= { pop apportionment.transactions_in_state apportionment.transaction_threshold &gt;= } over not if
</condition_postfix>
      <condition_comment>apportionment.gross_receipts_in_state &gt;= apportionment.economic_nexus_threshold or apportionment.transactions_in_state &gt;= apportionment.transaction_threshold</condition_comment></condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set apportionment.has_economic_nexus = true</action_dsl>
        <action_postfix>true cvb /apportionment.has_economic_nexus xdef</action_postfix>
      </action_details>
      <action_details>
        <action_number>2</action_number>
        <action_dsl>set apportionment.has_economic_nexus = false; set apportionment.apportionment_percentage = 0.0; set apportionment.state_tax = 0.0</action_dsl>
        <action_postfix>false cvb /apportionment.has_economic_nexus xdef 0.0 cvd /apportionment.apportionment_percentage xdef 0.0 cvd /apportionment.state_tax xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Calculate_Property_Factor</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl />
        <condition_postfix>
apportionment.has_economic_nexus true beq { pop apportionment.has_physical_presence true beq } over not if
</condition_postfix>
      <condition_comment>apportionment.has_economic_nexus == true or apportionment.has_physical_presence == true</condition_comment></condition_details>
      <condition_details>
        <condition_number>2</condition_number>
        <condition_dsl>apportionment.property_total_average &gt; 0</condition_dsl>
        <condition_postfix>apportionment.property_total_average 0 f&gt;</condition_postfix>
      </condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set apportionment.property_average = (apportionment.property_beginning_balance + apportionment.property_ending_balance) / 2.0; set apportionment.property_factor = apportionment.property_average / apportionment.property_total_average</action_dsl>
        <action_postfix>apportionment.property_beginning_balance apportionment.property_ending_balance f+ 2.0 fdiv cvd /apportionment.property_average xdef apportionment.property_average apportionment.property_total_average fdiv cvd /apportionment.property_factor xdef</action_postfix>
      </action_details>
      <action_details>
        <action_number>2</action_number>
        <action_dsl>set apportionment.property_factor = 0.0</action_dsl>
        <action_postfix>0.0 cvd /apportionment.property_factor xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Calculate_Payroll_Factor</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl />
        <condition_postfix>
apportionment.has_economic_nexus true beq { pop apportionment.has_physical_presence true beq } over not if
</condition_postfix>
      <condition_comment>apportionment.has_economic_nexus == true or apportionment.has_physical_presence == true</condition_comment></condition_details>
      <condition_details>
        <condition_number>2</condition_number>
        <condition_dsl>apportionment.payroll_total &gt; 0</condition_dsl>
        <condition_postfix>apportionment.payroll_total 0 f&gt;</condition_postfix>
      </condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set apportionment.payroll_factor = apportionment.payroll_in_state / apportionment.payroll_total</action_dsl>
        <action_postfix>apportionment.payroll_in_state apportionment.payroll_total fdiv cvd /apportionment.payroll_factor xdef</action_postfix>
      </action_details>
      <action_details>
        <action_number>2</action_number>
        <action_dsl>set apportionment.payroll_factor = 0.0</action_dsl>
        <action_postfix>0.0 cvd /apportionment.payroll_factor xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
