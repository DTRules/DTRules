<?xml version='1.0' encoding='UTF-8'?>
<decision_tables>
  <decision_table>
    <table_name>Calculate_Net_Receipts</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>revenue.gross_receipts &gt; 0</condition_dsl>
        <condition_postfix>revenue.gross_receipts 0 f&gt;</condition_postfix>
      </condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set revenue.net_receipts = revenue.gross_receipts - revenue.returns_and_allowances</action_dsl>
        <action_postfix>revenue.gross_receipts revenue.returns_and_allowances f- cvd /revenue.net_receipts xdef</action_postfix>
      </action_details>
      <action_details>
        <action_number>2</action_number>
        <action_dsl>set revenue.net_receipts = 0.0</action_dsl>
        <action_postfix>0.0 cvd /revenue.net_receipts xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Calculate_Gross_Profit</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>revenue.net_receipts &gt; 0</condition_dsl>
        <condition_postfix>revenue.net_receipts 0 f&gt;</condition_postfix>
      </condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set revenue.gross_profit = revenue.net_receipts - revenue.cost_of_goods_sold</action_dsl>
        <action_postfix>revenue.net_receipts revenue.cost_of_goods_sold f- cvd /revenue.gross_profit xdef</action_postfix>
      </action_details>
      <action_details>
        <action_number>2</action_number>
        <action_dsl>set revenue.gross_profit = 0.0 - revenue.cost_of_goods_sold</action_dsl>
        <action_postfix>0.0 revenue.cost_of_goods_sold - cvd /revenue.gross_profit xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Calculate_Total_Income</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>true</condition_dsl>
        <condition_postfix>true</condition_postfix>
      </condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set revenue.total_income = revenue.gross_profit + revenue.dividends_received + revenue.interest_income + revenue.gross_rents + revenue.gross_royalties + revenue.capital_gain_net_income + revenue.net_gain_loss_4797 + revenue.other_income; set result.total_income = revenue.total_income</action_dsl>
        <action_postfix>revenue.gross_profit revenue.dividends_received f+ revenue.interest_income f+ revenue.gross_rents f+ revenue.gross_royalties f+ revenue.capital_gain_net_income f+ revenue.net_gain_loss_4797 f+ revenue.other_income f+ cvd /revenue.total_income xdef revenue.total_income cvd /result.total_income xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Calculate_Compensation_Deduction</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>result.compensation &gt; 0</condition_dsl>
        <condition_postfix>result.compensation 0 f&gt;</condition_postfix>
      </condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set result.compensation = 0.0</action_dsl>
        <action_postfix>0.0 cvd /result.compensation xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Calculate_Interest_Deduction</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>result.interest_expense &gt; 0</condition_dsl>
        <condition_postfix>result.interest_expense 0 f&gt;</condition_postfix>
      </condition_details>
      <condition_details>
        <condition_number>2</condition_number>
        <condition_dsl />
        <condition_postfix>
result.interest_expense 0.30 result.taxable_income fmul f&gt;
</condition_postfix>
      <condition_comment>result.interest_expense &gt; (0.30 * result.taxable_income)</condition_comment></condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set result.interest_expense = 0.30 * result.taxable_income</action_dsl>
        <action_postfix>0.30 result.taxable_income fmul cvd /result.interest_expense xdef</action_postfix>
      </action_details>
      <action_details>
        <action_number>2</action_number>
        <action_dsl>set result.interest_expense = 0.0</action_dsl>
        <action_postfix>0.0 cvd /result.interest_expense xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Calculate_Charitable_Contributions</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>result.charitable_contributions &gt; 0</condition_dsl>
        <condition_postfix>result.charitable_contributions 0 f&gt;</condition_postfix>
      </condition_details>
      <condition_details>
        <condition_number>2</condition_number>
        <condition_dsl />
        <condition_postfix>
result.charitable_contributions 0.10 result.taxable_income fmul f&gt;
</condition_postfix>
      <condition_comment>result.charitable_contributions &gt; (0.10 * result.taxable_income)</condition_comment></condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set result.charitable_contributions = 0.10 * result.taxable_income</action_dsl>
        <action_postfix>0.10 result.taxable_income fmul cvd /result.charitable_contributions xdef</action_postfix>
      </action_details>
      <action_details>
        <action_number>2</action_number>
        <action_dsl>set result.charitable_contributions = 0.0</action_dsl>
        <action_postfix>0.0 cvd /result.charitable_contributions xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Calculate_Total_Deductions</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>true</condition_dsl>
        <condition_postfix>true</condition_postfix>
      </condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set result.total_deductions = result.compensation + result.salaries_and_wages + result.repairs_and_maintenance + result.bad_debts + result.rents + result.taxes_and_licenses + result.interest_expense + result.charitable_contributions + result.depreciation + result.depletion + result.advertising + result.pension_profit_sharing + result.employee_benefit_programs + result.other_deductions</action_dsl>
        <action_postfix>result.compensation result.salaries_and_wages f+ result.repairs_and_maintenance f+ result.bad_debts f+ result.rents f+ result.taxes_and_licenses f+ result.interest_expense f+ result.charitable_contributions f+ result.depreciation f+ result.depletion f+ result.advertising f+ result.pension_profit_sharing f+ result.employee_benefit_programs f+ result.other_deductions f+ cvd /result.total_deductions xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Calculate_Taxable_Income</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>result.total_income &gt; result.total_deductions</condition_dsl>
        <condition_postfix>result.total_income result.total_deductions f&gt;</condition_postfix>
      </condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set result.taxable_income = result.total_income - result.total_deductions</action_dsl>
        <action_postfix>result.total_income result.total_deductions f- cvd /result.taxable_income xdef</action_postfix>
      </action_details>
      <action_details>
        <action_number>2</action_number>
        <action_dsl>set result.taxable_income = 0.0</action_dsl>
        <action_postfix>0.0 cvd /result.taxable_income xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Apply_Corporate_Tax_Rate</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>result.taxable_income &gt; 0</condition_dsl>
        <condition_postfix>result.taxable_income 0 f&gt;</condition_postfix>
      </condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set result.federal_tax = result.taxable_income * result.federal_tax_rate</action_dsl>
        <action_postfix>result.taxable_income result.federal_tax_rate fmul cvd /result.federal_tax xdef</action_postfix>
      </action_details>
      <action_details>
        <action_number>2</action_number>
        <action_dsl>set result.federal_tax = 0.0</action_dsl>
        <action_postfix>0.0 cvd /result.federal_tax xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Calculate_Refund_Or_Owed</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>true</condition_dsl>
        <condition_postfix>true</condition_postfix>
      </condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set result.total_payments = result.estimated_tax_payments + result.total_credits; set result.refund_or_owed = result.total_payments - result.federal_tax</action_dsl>
        <action_postfix>result.estimated_tax_payments result.total_credits f+ cvd /result.total_payments xdef result.total_payments result.federal_tax f- cvd /result.refund_or_owed xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Calculate_RD_Credit</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>result.research_development_credit &gt; 0</condition_dsl>
        <condition_postfix>result.research_development_credit 0 f&gt;</condition_postfix>
      </condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set result.research_development_credit = 0.0</action_dsl>
        <action_postfix>0.0 cvd /result.research_development_credit xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Calculate_General_Business_Credit</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl />
        <condition_postfix>
result.research_development_credit 0 &gt; { pop result.work_opportunity_credit 0 &gt; } over not if
</condition_postfix>
      <condition_comment>result.research_development_credit &gt; 0 or result.work_opportunity_credit &gt; 0</condition_comment></condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set result.general_business_credit = result.research_development_credit + result.work_opportunity_credit; set result.total_credits = result.general_business_credit</action_dsl>
        <action_postfix>result.research_development_credit result.work_opportunity_credit f+ cvd /result.general_business_credit xdef result.general_business_credit cvd /result.total_credits xdef</action_postfix>
      </action_details>
      <action_details>
        <action_number>2</action_number>
        <action_dsl>set result.general_business_credit = 0.0; set result.total_credits = 0.0</action_dsl>
        <action_postfix>0.0 cvd /result.general_business_credit xdef 0.0 cvd /result.total_credits xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Determine_Asset_Class</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>asset.asset_class is not null and asset.asset_class is not null</condition_dsl>
        <condition_postfix>asset.asset_class isnull not { pop asset.asset_class } over if isnull not</condition_postfix>
      </condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>Perform Lookup_MACRS_Recovery_Period</action_dsl>
        <action_postfix>/Lookup_MACRS_Recovery_Period performtable</action_postfix>
      </action_details>
      <action_details>
        <action_number>2</action_number>
        <action_dsl>set asset.asset_class = "7-year"; set asset.recovery_period = 7; set asset.depreciation_method = "MACRS-200DB"</action_dsl>
        <action_postfix>&quot;7-year&quot; cvs /asset.asset_class xdef 7 cvi /asset.recovery_period xdef &quot;MACRS-200DB&quot; cvs /asset.depreciation_method xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Calculate_Section_179</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>asset.eligible_for_section_179 == true</condition_dsl>
        <condition_postfix>asset.eligible_for_section_179 true beq</condition_postfix>
      </condition_details>
      <condition_details>
        <condition_number>2</condition_number>
        <condition_dsl>result.section_179_total &lt; result.section_179_limit</condition_dsl>
        <condition_postfix>result.section_179_total result.section_179_limit f&lt;</condition_postfix>
      </condition_details>
      <condition_details>
        <condition_number>3</condition_number>
        <condition_dsl>asset.cost_basis &gt; 0</condition_dsl>
        <condition_postfix>asset.cost_basis 0 f&gt;</condition_postfix>
      </condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set asset.section_179_deduction = asset.cost_basis; add asset.cost_basis to result.section_179_total; set asset.cost_basis = 0.0</action_dsl>
        <action_postfix>asset.cost_basis cvd /asset.section_179_deduction xdef asset.cost_basis cvd result.section_179_total f+ /result.section_179_total xdef 0.0 cvd /asset.cost_basis xdef</action_postfix>
      </action_details>
      <action_details>
        <action_number>2</action_number>
        <action_dsl>set asset.section_179_deduction = 0.0</action_dsl>
        <action_postfix>0.0 cvd /asset.section_179_deduction xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Calculate_Bonus_Depreciation</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>asset.eligible_for_bonus == true</condition_dsl>
        <condition_postfix>asset.eligible_for_bonus true beq</condition_postfix>
      </condition_details>
      <condition_details>
        <condition_number>2</condition_number>
        <condition_dsl>result.bonus_depreciation_rate &gt; 0</condition_dsl>
        <condition_postfix>result.bonus_depreciation_rate 0 f&gt;</condition_postfix>
      </condition_details>
      <condition_details>
        <condition_number>3</condition_number>
        <condition_dsl>asset.cost_basis &gt; 0</condition_dsl>
        <condition_postfix>asset.cost_basis 0 f&gt;</condition_postfix>
      </condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set asset.bonus_depreciation = asset.cost_basis * result.bonus_depreciation_rate; set asset.cost_basis = asset.cost_basis - asset.bonus_depreciation</action_dsl>
        <action_postfix>asset.cost_basis result.bonus_depreciation_rate fmul cvd /asset.bonus_depreciation xdef asset.cost_basis asset.bonus_depreciation f- cvd /asset.cost_basis xdef</action_postfix>
      </action_details>
      <action_details>
        <action_number>2</action_number>
        <action_dsl>set asset.bonus_depreciation = 0.0</action_dsl>
        <action_postfix>0.0 cvd /asset.bonus_depreciation xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Calculate_MACRS_Depreciation</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>asset.cost_basis &gt; 0</condition_dsl>
        <condition_postfix>asset.cost_basis 0 f&gt;</condition_postfix>
      </condition_details>
      <condition_details>
        <condition_number>2</condition_number>
        <condition_dsl>asset.accumulated_depreciation == 0</condition_dsl>
        <condition_postfix>asset.accumulated_depreciation 0 f==</condition_postfix>
      </condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set asset.current_year_depreciation = asset.cost_basis * 0.1429; add asset.current_year_depreciation to asset.accumulated_depreciation; add asset.current_year_depreciation to result.macrs_depreciation_total</action_dsl>
        <action_postfix>asset.cost_basis 0.1429 fmul cvd /asset.current_year_depreciation xdef asset.current_year_depreciation cvd asset.accumulated_depreciation f+ /asset.accumulated_depreciation xdef asset.current_year_depreciation cvd result.macrs_depreciation_total f+ /result.macrs_depreciation_total xdef</action_postfix>
      </action_details>
      <action_details>
        <action_number>2</action_number>
        <action_dsl>set asset.current_year_depreciation = 0.0</action_dsl>
        <action_postfix>0.0 cvd /asset.current_year_depreciation xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
  <decision_table>
    <table_name>Aggregate_Depreciation</table_name>
    <contexts />
    <conditions>
      <condition_details>
        <condition_number>1</condition_number>
        <condition_dsl>true</condition_dsl>
        <condition_postfix>true</condition_postfix>
      </condition_details>
    </conditions>
    <actions>
      <action_details>
        <action_number>1</action_number>
        <action_dsl>set result.depreciation = result.section_179_total + result.bonus_depreciation_total + result.macrs_depreciation_total</action_dsl>
        <action_postfix>result.section_179_total result.bonus_depreciation_total f+ result.macrs_depreciation_total f+ cvd /result.depreciation xdef</action_postfix>
      </action_details>
    </actions>
  </decision_table>
