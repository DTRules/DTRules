---
// CompactPokerTable.astro - Minimal poker table display
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div
  id="compact-poker-table"
  class:list={[
    'glass rounded-xl md:rounded-2xl p-3 md:p-4 flex-1',
    className
  ]}
>
  {/* Game info bar */}
  <div class="flex justify-between items-center mb-3 px-1">
    <div class="flex items-center gap-2">
      <div class="px-2 py-1 md:px-3 md:py-1.5 bg-black/60 rounded-lg text-white text-xs md:text-sm font-semibold">
        Hand #<span id="hand-number">1</span>
      </div>
    </div>
    <div class="px-2 py-1 md:px-3 md:py-1.5 bg-black/60 rounded-lg text-white text-xs md:text-sm font-semibold">
      $<span id="small-blind">10</span>/<span id="big-blind">20</span>
    </div>
  </div>

  {/* Mobile Layout */}
  <div id="mobile-layout" class="flex flex-col gap-3 md:hidden">
    {/* Community Cards & Pot */}
    <div class="bg-gradient-to-b from-green-800/80 to-green-900/80 rounded-xl p-3 border border-green-700/50">
      <div id="community-cards-mobile" class="flex gap-1.5 justify-center mb-2">
        {[...Array(5)].map(() => (
          <div class="w-9 h-13 rounded border-2 border-dashed border-green-600/50 bg-green-950/50"></div>
        ))}
      </div>
      <div id="pot-display-mobile" class="text-center bg-black/40 rounded-lg py-1.5 px-3">
        <span class="text-gray-300 text-xs">Pot:</span>
        <span class="text-yellow-400 font-bold text-lg ml-1">$0</span>
      </div>
    </div>

    {/* Opponents Grid */}
    <div id="opponents-grid" class="grid grid-cols-2 gap-2">
      {[...Array(3)].map(() => (
        <div class="bg-gray-800/80 rounded-lg p-2 flex items-center gap-2 border border-gray-700">
          <span class="bg-gray-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded">AI</span>
          <div class="flex-1 min-w-0">
            <div class="text-gray-400 text-xs">Waiting...</div>
          </div>
        </div>
      ))}
    </div>

    {/* Your Section */}
    <div id="your-section" class="bg-gradient-to-t from-blue-900/80 to-blue-800/60 rounded-xl p-3 border-2 border-blue-600/50">
      <div class="text-center text-blue-300 text-[10px] font-semibold uppercase tracking-wide mb-1.5">Your Hand</div>
      <div id="your-cards-mobile" class="flex justify-center gap-3 mb-2">
        <div class="w-14 h-20 rounded border-2 border-dashed border-blue-500/50 bg-blue-950/50"></div>
        <div class="w-14 h-20 rounded border-2 border-dashed border-blue-500/50 bg-blue-950/50"></div>
      </div>
      <div class="flex justify-between items-center bg-black/30 rounded-lg px-2 py-1.5">
        <span id="your-name-mobile" class="text-white font-semibold text-sm">You</span>
        <span id="your-chips-mobile" class="text-yellow-400 font-bold">$1,000</span>
      </div>
      <div id="your-bet-mobile" class="text-green-400 text-xs text-center mt-1 hidden"></div>
      <div id="your-hand-mobile" class="text-purple-300 text-xs text-center mt-0.5 hidden"></div>
    </div>

    {/* Round Banner (Mobile) */}
    <div id="round-banner-mobile" class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 transition-opacity duration-200 z-10">
      <div class="px-5 py-2 bg-black/90 rounded-xl border-2 border-yellow-400 shadow-2xl">
        <span id="round-banner-text-mobile" class="text-lg font-bold text-yellow-400 uppercase tracking-wider"></span>
      </div>
    </div>
  </div>

  {/* Desktop Layout - Full poker table */}
  <div
    id="desktop-layout"
    class="hidden md:flex md:flex-col relative rounded-2xl overflow-visible h-[580px] lg:h-[700px]"
    style="border: 16px solid #5c4033; box-shadow: 0 15px 40px rgba(0,0,0,0.5), inset 0 0 0 4px #3d2817; background: radial-gradient(ellipse at center, #1a6b35 0%, #145228 40%, #0d3320 100%);"
  >
    {/* Table felt texture */}
    <div class="absolute inset-0 rounded opacity-15" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.4'/%3E%3C/svg%3E&quot;);"></div>

    {/* Inner shadow */}
    <div class="absolute inset-0 rounded" style="box-shadow: inset 0 0 40px rgba(0,0,0,0.4);"></div>

    {/* Center - Community cards and pot */}
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-center">
      <div id="community-cards" class="flex gap-3 lg:gap-4 justify-center mb-5">
        {[...Array(5)].map(() => (
          <div class="w-14 h-20 lg:w-16 lg:h-24 rounded-lg border-2 border-dashed border-green-600/40 bg-green-950/40 shadow-inner"></div>
        ))}
      </div>
      <div id="pot-display" class="px-6 py-3 md:px-10 md:py-4 bg-black/60 rounded-full inline-block border border-yellow-600/30 shadow-lg">
        <span class="text-gray-300 text-base md:text-lg">Pot:</span>
        <span class="text-yellow-400 font-bold text-3xl lg:text-4xl ml-2">$0</span>
      </div>
    </div>

    {/* Players container - positioned dynamically */}
    <div id="players-container"></div>

    {/* Round Banner (Desktop) */}
    <div id="round-banner" class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 transition-opacity duration-200">
      <div class="px-6 py-3 bg-black/90 rounded-xl border-2 border-yellow-500 shadow-2xl backdrop-blur-sm">
        <span id="round-banner-text" class="text-xl md:text-2xl font-bold text-yellow-400 uppercase tracking-wider"></span>
      </div>
    </div>
  </div>
</div>

{/* Showdown Modal */}
<div id="showdown-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-2 md:p-4">
  <div class="glass rounded-xl md:rounded-2xl p-4 md:p-6 max-w-2xl w-full mx-2 md:mx-4 max-h-[85vh] overflow-y-auto">
    <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4 text-center">Showdown Results</h2>
    <div id="showdown-results" class="space-y-3 md:space-y-4">
      {/* Results populated dynamically */}
    </div>
    <button id="btn-close-showdown" class="mt-4 md:mt-6 w-full px-4 py-3 gradient-button text-white font-semibold rounded-lg touch-manipulation">
      Next Hand
    </button>
  </div>
</div>

<style>
  /* Active player pulse */
  .player-active {
    animation: playerPulse 1.5s ease-in-out infinite;
  }

  @keyframes playerPulse {
    0%, 100% { box-shadow: 0 0 0 2px rgba(250, 204, 21, 0.5); }
    50% { box-shadow: 0 0 0 4px rgba(250, 204, 21, 0.8); }
  }

  /* Card animations - faster */
  .card-reveal {
    animation: flipIn 0.25s ease-out forwards;
    opacity: 0;
  }

  @keyframes flipIn {
    0% { transform: rotateY(90deg) scale(0.8); opacity: 0; }
    100% { transform: rotateY(0deg) scale(1); opacity: 1; }
  }

  .card-delayed-1 { animation-delay: 0.1s; }
  .card-delayed-2 { animation-delay: 0.2s; }

  /* Winner highlight */
  .winner-highlight {
    animation: winnerPulse 1.5s ease-in-out infinite;
  }

  @keyframes winnerPulse {
    0%, 100% { box-shadow: 0 0 10px 2px rgba(34, 197, 94, 0.5); }
    50% { box-shadow: 0 0 20px 5px rgba(34, 197, 94, 0.8); }
  }

  /* Best hand card */
  .best-hand-card {
    box-shadow: 0 0 8px 2px rgba(168, 85, 247, 0.6);
    border: 2px solid rgb(168, 85, 247);
  }

  /* Round banner */
  .round-banner-show {
    opacity: 1 !important;
  }

  .round-banner-animate {
    animation: bannerBounce 0.3s ease-out;
  }

  @keyframes bannerBounce {
    0% { transform: scale(0.5); opacity: 0; }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); opacity: 1; }
  }
</style>
