  <style>
    /* Disable smooth scrolling on this page to prevent unwanted scroll behavior */
    html {
      scroll-behavior: auto !important;
    }

    /* Safe area for iOS bottom bar */
    .safe-area-bottom {
      padding-bottom: env(safe-area-inset-bottom, 0);
    }

    /* Better touch targets */
    .touch-manipulation {
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }

    /* Active player pulse animation */
    .player-active {
      animation: playerPulse 1.5s ease-in-out infinite;
    }

    @keyframes playerPulse {
      0%, 100% { box-shadow: 0 0 0 2px rgba(250, 204, 21, 0.5); }
      50% { box-shadow: 0 0 0 4px rgba(250, 204, 21, 0.8); }
    }

    /* Mobile body padding for fixed bottom bar */
    @media (max-width: 767px) {
      #poker-game {
        position: relative;
      }
    }

    /* Card reveal animations */
    .card-reveal {
      animation: flipIn 0.5s ease-out forwards;
      opacity: 0;
    }

    @keyframes flipIn {
      0% {
        transform: rotateY(90deg) scale(0.8);
        opacity: 0;
      }
      100% {
        transform: rotateY(0deg) scale(1);
        opacity: 1;
      }
    }

    .card-delayed-1 { animation-delay: 0.15s; }
    .card-delayed-2 { animation-delay: 0.3s; }

    /* Winner highlight animation */
    .winner-highlight {
      animation: winnerPulse 1.5s ease-in-out infinite;
    }

    @keyframes winnerPulse {
      0%, 100% { box-shadow: 0 0 10px 2px rgba(34, 197, 94, 0.5); }
      50% { box-shadow: 0 0 20px 5px rgba(34, 197, 94, 0.8); }
    }

    /* Best hand card highlight */
    .best-hand-card {
      box-shadow: 0 0 8px 2px rgba(168, 85, 247, 0.6);
      border: 2px solid rgb(168, 85, 247);
    }

    /* Round banner animation */
    .round-banner-show {
      opacity: 1 !important;
    }

    .round-banner-animate {
      animation: bannerBounce 0.5s ease-out;
    }

    @keyframes bannerBounce {
      0% { transform: scale(0.5); opacity: 0; }
      50% { transform: scale(1.1); }
      100% { transform: scale(1); opacity: 1; }
    }

    /* Decision table highlighting */
    .dt-active {
      box-shadow: 0 0 20px rgba(168, 85, 247, 0.5);
      border: 2px solid rgb(168, 85, 247);
    }

    .dt-column-highlight {
      background-color: rgba(168, 85, 247, 0.3) !important;
    }

    .dt-row-highlight td {
      background-color: rgba(34, 197, 94, 0.2) !important;
    }

    /* Details marker styling */
    details summary::-webkit-details-marker {
      display: none;
    }

    details summary::after {
      content: '+';
      float: right;
      font-weight: bold;
      transition: transform 0.2s;
    }

    details[open] summary::after {
      transform: rotate(45deg);
    }
  </style>

