    let isRevealingCards = false;
    let lastKnownRound = null;
    let showdownModalShown = false;
    let savedChips = null; // Track chips across hands
    let currentBreakpoint = 'desktop';

    // Breakpoint detection
    function getBreakpoint() {
      const w = window.innerWidth;
      if (w < 768) return 'mobile';
      if (w < 1024) return 'tablet';
      return 'desktop';
    }

    // Debounce utility
    function debounce(fn, delay) {
      let timeoutId;
      return (...args) => {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => fn(...args), delay);
      };
    }

    // Handle breakpoint changes
    function handleBreakpointChange() {
      const newBreakpoint = getBreakpoint();
      if (newBreakpoint !== currentBreakpoint) {
        currentBreakpoint = newBreakpoint;
        if (gameState) {
          renderPlayers();
          updateCommunityCards();
        }
      }
    }

    // Create a card element with responsive sizing
    // size: 'small' (opponent on mobile), 'medium' (community), 'large' (your cards on mobile), 'default' (desktop)
    function createCardElement(card, faceDown = false, size = 'default') {
      const cardEl = document.createElement('div');

      // Size classes based on context
      const sizeClasses = {
        small: 'w-6 h-8 text-[10px]',
        medium: 'w-12 h-[4.5rem] md:w-14 md:h-20 lg:w-16 lg:h-24 text-sm md:text-base lg:text-lg',
        large: 'w-16 h-24 text-lg',
        default: 'w-14 h-20 md:w-16 md:h-24 text-base md:text-lg'
      };

      cardEl.className = `${sizeClasses[size] || sizeClasses.default} rounded-md flex items-center justify-center font-bold shadow-md`;

      if (faceDown || !card) {
        cardEl.className += ' bg-gradient-to-br from-blue-800 to-blue-900 border-2 border-blue-700';
        const questionSize = size === 'small' ? 'text-sm' : size === 'large' ? 'text-3xl' : 'text-xl';
        cardEl.innerHTML = `<span class="text-blue-400 ${questionSize}">?</span>`;
      } else {
        cardEl.style.backgroundColor = 'white';
        cardEl.style.color = SUIT_COLORS[card.suit];
        cardEl.innerHTML = `<span class="flex flex-col items-center leading-tight"><span>${RANK_DISPLAY[card.rank] || card.rankName}</span><span>${SUIT_SYMBOLS[card.suit]}</span></span>`;
      }

      return cardEl;
    }

    // Show round transition banner
    function showRoundTransition(roundName) {
      const isMobile = getBreakpoint() === 'mobile';

      // Show desktop banner
      const banner = document.getElementById('round-banner');
      const bannerText = document.getElementById('round-banner-text');
      if (banner && bannerText && !isMobile) {
        bannerText.textContent = roundName.toUpperCase();
        banner.classList.add('round-banner-show');
        banner.querySelector('div')?.classList.add('round-banner-animate');

        setTimeout(() => {
          banner.classList.remove('round-banner-show');
          banner.querySelector('div')?.classList.remove('round-banner-animate');
        }, 1500);
      }

      // Show mobile banner
      const bannerMobile = document.getElementById('round-banner-mobile');
      const bannerTextMobile = document.getElementById('round-banner-text-mobile');
      if (bannerMobile && bannerTextMobile && isMobile) {
        bannerTextMobile.textContent = roundName.toUpperCase();
        bannerMobile.classList.add('round-banner-show');
        bannerMobile.querySelector('div')?.classList.add('round-banner-animate');

        setTimeout(() => {
          bannerMobile.classList.remove('round-banner-show');
          bannerMobile.querySelector('div')?.classList.remove('round-banner-animate');
        }, 1500);
      }
    }

    // Create a card element for showdown display (larger size)
    function createShowdownCardElement(card, isInBestHand = false) {
      const cardEl = document.createElement('div');
      cardEl.className = 'w-12 h-16 rounded-md flex items-center justify-center text-sm font-bold shadow-md';

      if (isInBestHand) {
        cardEl.className += ' best-hand-card';
      }

      cardEl.style.backgroundColor = 'white';
      cardEl.style.color = SUIT_COLORS[card.suit];
      cardEl.innerHTML = `<span class="flex flex-col items-center"><span>${RANK_DISPLAY[card.rank] || card.rankName}</span><span>${SUIT_SYMBOLS[card.suit]}</span></span>`;

      return cardEl;
    }

    // Check if a card is in the best hand
    function isCardInBestHand(card, bestHand) {
      if (!bestHand || !card) return false;
      return bestHand.some(bc => bc.rank === card.rank && bc.suit === card.suit);
    }

    // Show showdown results modal
    function showShowdownResults(game) {
      if (!game.showdownResults || game.showdownResults.length === 0) return;
      if (showdownModalShown) return;

      showdownModalShown = true;

      const modal = document.getElementById('showdown-modal');
      const resultsContainer = document.getElementById('showdown-results');
      if (!modal || !resultsContainer) return;

      resultsContainer.innerHTML = '';

      // Sort by rank (1st place first)
      const sortedResults = [...game.showdownResults].sort((a, b) => a.rank - b.rank);

      sortedResults.forEach((result, index) => {
        const playerDiv = document.createElement('div');
        playerDiv.className = `p-4 rounded-xl ${result.won ? 'bg-green-900/50 border border-green-500 winner-highlight' : 'bg-gray-800/50'}`;

        // Rank badge
        const rankBadge = result.rank <= 3 ?
          `<span class="px-2 py-1 rounded-full text-xs font-bold ${
            result.rank === 1 ? 'bg-yellow-500 text-black' :
            result.rank === 2 ? 'bg-gray-300 text-black' :
            'bg-orange-600 text-white'
          }">${result.rank === 1 ? '1st' : result.rank === 2 ? '2nd' : '3rd'}</span>` :
          `<span class="px-2 py-1 rounded-full text-xs bg-gray-600 text-white">${result.rank}th</span>`;

        playerDiv.innerHTML = `
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              ${rankBadge}
              <span class="font-semibold text-white text-lg">${result.playerName}</span>
            </div>
            ${result.won ? `<span class="text-green-400 font-bold">Won $${result.wonAmount}</span>` : ''}
          </div>
          <div class="mb-2">
            <span class="text-purple-400 font-semibold">${result.handName}</span>
          </div>
          <div class="flex gap-1 flex-wrap items-center">
            <span class="text-gray-400 text-xs mr-2">Hole Cards:</span>
            <div id="showdown-hole-${index}" class="flex gap-1"></div>
          </div>
          <div class="flex gap-1 flex-wrap items-center mt-2">
            <span class="text-gray-400 text-xs mr-2">Best 5:</span>
            <div id="showdown-best-${index}" class="flex gap-1"></div>
          </div>
        `;

        resultsContainer.appendChild(playerDiv);

        // Add hole cards
        const holeContainer = document.getElementById(`showdown-hole-${index}`);
        if (holeContainer && result.holeCards) {
          result.holeCards.forEach(card => {
            holeContainer.appendChild(createShowdownCardElement(card, isCardInBestHand(card, result.bestHand)));
          });
        }

        // Add best hand cards
        const bestContainer = document.getElementById(`showdown-best-${index}`);
        if (bestContainer && result.bestHand) {
          result.bestHand.forEach(card => {
            bestContainer.appendChild(createShowdownCardElement(card, true));
          });
        }
      });

      // Check if game is over (one player has all chips)
      const playersWithChips = game.players.filter(p => p.chips > 0);
      const closeBtn = document.getElementById('btn-close-showdown');
      if (closeBtn) {
        if (playersWithChips.length === 1) {
          const winner = playersWithChips[0];
          // Add game winner banner
          const winnerBanner = document.createElement('div');
          winnerBanner.className = 'mt-4 p-4 bg-yellow-500/20 border-2 border-yellow-500 rounded-xl text-center';
          winnerBanner.innerHTML = `
            <div class="text-2xl font-bold text-yellow-400 mb-2">GAME OVER</div>
            <div class="text-white text-lg">${winner.name} wins with $${winner.chips}!</div>
          `;
          resultsContainer.appendChild(winnerBanner);
          closeBtn.textContent = 'New Game';
        } else {
          closeBtn.textContent = 'Next Hand';
        }
      }

      modal.classList.remove('hidden');
    }

    // Hide showdown modal
    function hideShowdownModal() {
      const modal = document.getElementById('showdown-modal');
      if (modal) {
        modal.classList.add('hidden');
      }
    }

    // Handle pending reveal with animation
    async function handlePendingReveal(game) {
      if (!game.pendingReveal || isRevealingCards) return;

      isRevealingCards = true;

      // Update gameState and render players/pot first (without new community cards)
      gameState = game;
      renderPlayers();

      // Update pot display (both desktop and mobile)
      const potDisplay = document.querySelector('#pot-display span:last-child');
      if (potDisplay) potDisplay.textContent = `$${game.pot}`;
      const potDisplayMobile = document.querySelector('#pot-display-mobile span:last-child');
      if (potDisplayMobile) potDisplayMobile.textContent = `$${game.pot}`;

      // Show round transition banner
      showRoundTransition(game.pendingReveal);
      addToLog(`--- ${game.pendingReveal.toUpperCase()} ---`);

      // Wait for banner animation
      await new Promise(resolve => setTimeout(resolve, 1000));

      // Update community cards with animation
      updateCommunityCardsWithAnimation(game);

      // Wait for card animations to complete
      const numNewCards = game.newCommunityCards?.length || 0;
      const animationTime = 500 + (numNewCards * 150) + 200;

      await new Promise(resolve => setTimeout(resolve, animationTime));

      // Clear pending reveal
      clearPendingReveal(game);
      isRevealingCards = false;

      // If it's showdown, award pot (if not already done) and show results
      if (game.round === 'showdown') {
        game.runningOutBoard = false; // Clean up run-out flag
        if (!game.handComplete) {
          awardPot(game);
        }
        showShowdownResults(game);
        return;
      }

      // If running out the board (all-in scenario), continue dealing next street
      if (game.runningOutBoard) {
        // Small delay before next street
        await new Promise(resolve => setTimeout(resolve, 500));
        continueRunOut(game);
        // Handle the next reveal (if any)
        if (game.pendingReveal) {
          await handlePendingReveal(game);
        } else if (game.handComplete) {
          showShowdownResults(game);
        }
        return;
      }

      // Continue AI turns after reveal
      await runAITurns();
    }

    // Run AI turns with callbacks
    async function runAITurns() {
      if (!gameState || gameState.handComplete) return;

      await processAllAITurns(gameState, (result) => {
        // Log the action
        addToLog(result.actionMessage);

        // Update AI decision display
        const archetypeReasons = {
          'TAG': 'Tight-Aggressive: Plays premium hands, bets/raises with strength',
          'LAG': 'Loose-Aggressive: Plays many hands, applies pressure with bets',
          'Rock': 'Tight-Passive: Only plays very strong hands, rarely raises',
          'Calling': 'Calling Station: Calls frequently, rarely folds or raises'
        };
        const reasoning = archetypeReasons[result.player.archetype] || 'Standard play based on hand strength';
        updateAIDecisionDisplay(result.player.name, result.action.actionType, reasoning, result.player.archetype);

        // Update display after each action
        updateGameDisplay();
      });

      // Check for pending reveal after AI actions
      if (gameState.pendingReveal) {
        await handlePendingReveal(gameState);
      } else if (gameState.handComplete) {
        // Hand ended without showdown (everyone folded)
        if (gameState.winners) {
          const winnerNames = gameState.winners.map(id => {
            const winner = gameState.players.find(p => p.id === id);
            return winner?.name || id;
          }).join(', ');
          addToLog(`Winner: ${winnerNames} with ${gameState.winningHand || 'best hand'}`);

          if (gameState.showdownResults && gameState.showdownResults.length > 1) {
            showShowdownResults(gameState);
          }
        }
        updateGameDisplay();
      } else {
        updateGameDisplay();
      }
    }

    // Handle player action
    async function handleAction(actionType, amount = 0) {
      if (!gameState) {
        alert('No active game. Deal a new hand first.');
        return;
      }

      const humanPlayer = gameState.players.find(p => p.isHuman);
      if (!humanPlayer) return;

      // Adjust amount for raise based on slider (check both desktop and mobile)
      if (actionType === 'raise') {
        const isMobile = getBreakpoint() === 'mobile';
        const slider = isMobile
          ? document.getElementById('raise-slider-m')
          : document.getElementById('raise-slider');
        amount = parseInt(slider?.value || '0');
      }

      // Process action locally
      const result = processPokerAction(gameState, {
        playerId: humanPlayer.id,
        actionType: actionType,
        amount: amount
      });

      if (result.success && result.valid) {
        // Log the action
        if (result.message) {
          addToLog(result.message);
        }

        // Check for pending reveal (street transition)
        if (gameState.pendingReveal) {
          await handlePendingReveal(gameState);
        } else if (gameState.handComplete) {
          // Hand ended
          if (gameState.winners) {
            const winnerNames = gameState.winners.map(id => {
              const winner = gameState.players.find(p => p.id === id);
              return winner?.name || id;
            }).join(', ');
            addToLog(`Winner: ${winnerNames} with ${gameState.winningHand || 'best hand'}`);

            if (gameState.showdownResults && gameState.showdownResults.length > 1) {
              showShowdownResults(gameState);
            }
          }
          updateGameDisplay();
        } else {
          updateGameDisplay();
          // Run AI turns
          await runAITurns();
        }
      } else {
        addToLog(`Error: ${result.error || 'Action failed'}`);
      }
    }

    // Deal new hand
    async function dealNewHand() {
      console.log('dealNewHand called');
      try {
        const playerCount = 4;
        const startingChips = 1000;

        // Clear previous game state
        hideShowdownModal();
        showdownModalShown = false;
        isRevealingCards = false;
        lastKnownRound = null;
        savedChips = null;

        console.log('Calling dealNewPokerHand...');
        // Deal new hand locally
        gameState = dealNewPokerHand({
          playerCount,
          humanPosition: 0,
          smallBlind: 10,
          bigBlind: 20,
          startingChips,
          dealerPosition: secureRandom(playerCount)
        });
        console.log('Game state created:', gameState);

      // Log blinds
      const sbPlayer = gameState.players.find(p => p.isSmallBlind);
      const bbPlayer = gameState.players.find(p => p.isBigBlind);
      if (sbPlayer) addToLog(`${sbPlayer.name} posts small blind $${gameState.smallBlind}`);
      if (bbPlayer) addToLog(`${bbPlayer.name} posts big blind $${gameState.bigBlind}`);

      // Track action count before AI processing
      const actionCountBefore = gameState.actionHistory.length;

      // Process initial AI actions (sync - no delays for pre-human actions)
      processAITurnsSync(gameState);

      // Log any AI actions that happened
      for (let i = actionCountBefore; i < gameState.actionHistory.length; i++) {
        const action = gameState.actionHistory[i];
        if (action.action !== 'posts small blind' && action.action !== 'posts big blind') {
          const player = gameState.players.find(p => p.id === action.playerId);
          const actionMsg = `${action.playerName} ${action.action}${action.amount ? ` $${action.amount}` : ''}`;
          addToLog(actionMsg);

          // Update AI decision display for the last AI action
          if (player && player.archetype) {
            const archetypeReasons = {
              'TAG': 'Tight-Aggressive: Plays premium hands',
              'LAG': 'Loose-Aggressive: Applies pressure',
              'Rock': 'Tight-Passive: Only premium hands',
              'Calling': 'Calling Station: Calls frequently'
            };
            updateAIDecisionDisplay(player.name, action.action, archetypeReasons[player.archetype] || '', player.archetype);
          }
        }
      }

      // Check for pending reveal
      if (gameState.pendingReveal) {
        updateGameDisplay();
        renderPlayers();
        await handlePendingReveal(gameState);
      } else {
        updateGameDisplay();
        renderPlayers();
      }
      } catch (error) {
        console.error('Error in dealNewHand:', error);
      }
    }

    // Check if game is over
    function checkGameOver() {
      if (!gameState) return false;

      const playersWithChips = gameState.players.filter(p => p.chips > 0);
      if (playersWithChips.length === 1) {
        const winner = playersWithChips[0];
        addToLog(`${winner.name} WINS THE GAME with $${winner.chips}!`);
        return true;
      }
      return false;
    }

    // Auto-deal next hand
    async function autoDealNextHand() {
      if (checkGameOver()) {
        savedChips = null;
        return;
      }

      addToLog('Next hand starting...');
      await new Promise(resolve => setTimeout(resolve, 2000));

      await dealContinueHand();
    }

    // Deal continuation hand (keeps chip counts)
    async function dealContinueHand() {
      if (!gameState) {
        dealNewHand();
        return;
      }

      // Save chip counts and game settings before new deal
      const currentChips = gameState.players.map(p => p.chips);
      const playerCount = gameState.players.length;
      const handNumber = (gameState.handNumber || 1) + 1;
      const smallBlind = gameState.smallBlind;
      const bigBlind = gameState.bigBlind;

      // Clear state
      hideShowdownModal();
      showdownModalShown = false;
      isRevealingCards = false;
      lastKnownRound = null;

      // Rotate dealer position
      const newDealerPos = (gameState.dealerPosition + 1) % playerCount;

      // Deal new hand with a dummy starting chips value (we'll restore real chips)
      gameState = dealNewPokerHand({
        playerCount,
        humanPosition: 0,
        smallBlind,
        bigBlind,
        startingChips: 10000, // Dummy value, will be overwritten
        dealerPosition: newDealerPos
      });

      // Restore chip counts (adjusting for blinds posted in the new hand)
      gameState.players.forEach((p, i) => {
        if (currentChips[i] !== undefined) {
          // Calculate blind deduction for this player in the new hand
          let blindDeduction = 0;
          if (p.isSmallBlind) blindDeduction = smallBlind;
          if (p.isBigBlind) blindDeduction = bigBlind;
          p.chips = currentChips[i] - blindDeduction;
        }
      });

      // Recalculate pot based on actual blinds
      gameState.pot = smallBlind + bigBlind;

      gameState.handNumber = handNumber;
      addToLog(`--- Hand #${handNumber} ---`);

      // Log blinds
      const sbPlayer = gameState.players.find(p => p.isSmallBlind);
      const bbPlayer = gameState.players.find(p => p.isBigBlind);
      if (sbPlayer) addToLog(`${sbPlayer.name} posts small blind $${smallBlind}`);
      if (bbPlayer) addToLog(`${bbPlayer.name} posts big blind $${bigBlind}`);

      // Track action count before AI processing
      const actionCountBefore = gameState.actionHistory.length;

      // Process initial AI actions
      processAITurnsSync(gameState);

      // Log any AI actions that happened
      for (let i = actionCountBefore; i < gameState.actionHistory.length; i++) {
        const action = gameState.actionHistory[i];
        if (action.action !== 'posts small blind' && action.action !== 'posts big blind') {
          const player = gameState.players.find(p => p.id === action.playerId);
          const actionMsg = `${action.playerName} ${action.action}${action.amount ? ` $${action.amount}` : ''}`;
          addToLog(actionMsg);

          if (player && player.archetype) {
            const archetypeReasons = {
              'TAG': 'Tight-Aggressive: Plays premium hands',
              'LAG': 'Loose-Aggressive: Applies pressure',
              'Rock': 'Tight-Passive: Only premium hands',
              'Calling': 'Calling Station: Calls frequently'
            };
            updateAIDecisionDisplay(player.name, action.action, archetypeReasons[player.archetype] || '', player.archetype);
          }
        }
      }

      if (gameState.pendingReveal) {
        updateGameDisplay();
        renderPlayers();
        await handlePendingReveal(gameState);
      } else {
        updateGameDisplay();
        renderPlayers();
      }
    }

    // Render player positions - dispatch to correct layout based on breakpoint
    function renderPlayers() {
      if (!gameState) return;

      const bp = getBreakpoint();
      if (bp === 'mobile') {
        renderMobilePlayers();
      } else {
        renderDesktopPlayers();
      }
    }

    // Render mobile layout - grid for opponents, prominent section for player
    function renderMobilePlayers() {
      if (!gameState) return;

      const opponentsGrid = document.getElementById('opponents-grid');
      const yourCardsContainer = document.getElementById('your-cards-mobile');
      const yourNameEl = document.getElementById('your-name-mobile');
      const yourChipsEl = document.getElementById('your-chips-mobile');
      const yourBetEl = document.getElementById('your-bet-mobile');
      const yourHandEl = document.getElementById('your-hand-mobile');
      const yourSection = document.getElementById('your-section');

      if (!opponentsGrid) return;

      opponentsGrid.innerHTML = '';

      const humanPlayer = gameState.players.find(p => p.isHuman);
      const humanIndex = gameState.players.findIndex(p => p.isHuman);
      const opponents = gameState.players.filter(p => !p.isHuman);

      // Render opponents in grid
      opponents.forEach((player, index) => {
        const playerIndex = gameState.players.findIndex(p => p.id === player.id);
        const isActive = playerIndex === gameState.currentPlayerIndex && !gameState.handComplete;

        const archetypeColors = {
          'TAG': 'bg-blue-600',
          'LAG': 'bg-orange-600',
          'Rock': 'bg-gray-600',
          'Calling': 'bg-green-600'
        };

        const playerCard = document.createElement('div');
        playerCard.className = `bg-gray-800/90 rounded-lg p-2 flex items-center gap-2
                    border border-gray-700 ${player.folded ? 'opacity-50' : ''}
                    ${isActive ? 'ring-2 ring-yellow-400 player-active' : ''}`;

        let statusHtml = '';
        if (player.folded) {
          statusHtml = '<span class="text-red-400 text-[10px] font-semibold">FOLD</span>';
        } else if (player.allIn) {
          statusHtml = '<span class="text-purple-400 text-[10px] font-semibold">ALL-IN</span>';
        }

        playerCard.innerHTML = `
          <span class="${archetypeColors[player.archetype] || 'bg-gray-600'} text-white text-[10px] font-bold px-1.5 py-0.5 rounded">${player.archetype}</span>
          <div class="flex-1 min-w-0">
            <div class="text-white text-sm font-medium truncate flex items-center gap-1">
              ${player.isDealer ? '<span class="bg-yellow-500 text-black px-1 rounded text-[10px]">D</span>' : ''}
              ${player.name}
            </div>
            <div class="text-yellow-400 text-xs">$${player.chips}</div>
            ${player.currentBet > 0 ? `<div class="text-green-400 text-[10px]">Bet: $${player.currentBet}</div>` : ''}
            ${statusHtml}
          </div>
          <div id="opponent-cards-${index}" class="flex gap-0.5"></div>
        `;

        opponentsGrid.appendChild(playerCard);

        // Add cards
        const cardsContainer = document.getElementById(`opponent-cards-${index}`);
        if (cardsContainer && !player.folded) {
          if (player.holeCards && player.holeCards.length > 0) {
            const showCards = gameState.handComplete;
            player.holeCards.forEach(card => {
              cardsContainer.appendChild(createCardElement(card, !showCards, 'small'));
            });
          } else {
            cardsContainer.appendChild(createCardElement(null, true, 'small'));
            cardsContainer.appendChild(createCardElement(null, true, 'small'));
          }
        }
      });

      // Render human player section
      if (humanPlayer && yourCardsContainer) {
        yourCardsContainer.innerHTML = '';

        if (!humanPlayer.folded && humanPlayer.holeCards && humanPlayer.holeCards.length > 0) {
          humanPlayer.holeCards.forEach(card => {
            yourCardsContainer.appendChild(createCardElement(card, false, 'large'));
          });
        } else if (!humanPlayer.folded) {
          yourCardsContainer.appendChild(createCardElement(null, true, 'large'));
          yourCardsContainer.appendChild(createCardElement(null, true, 'large'));
        }

        if (yourNameEl) {
          yourNameEl.innerHTML = `${humanPlayer.isDealer ? '<span class="bg-yellow-500 text-black px-1.5 py-0.5 rounded text-xs mr-1">D</span>' : ''}You`;
        }
        if (yourChipsEl) yourChipsEl.textContent = `$${humanPlayer.chips}`;

        if (yourBetEl) {
          if (humanPlayer.currentBet > 0) {
            yourBetEl.textContent = `Bet: $${humanPlayer.currentBet}`;
            yourBetEl.classList.remove('hidden');
          } else {
            yourBetEl.classList.add('hidden');
          }
        }

        if (yourHandEl) {
          if (gameState.handComplete && humanPlayer.handName && !humanPlayer.folded) {
            yourHandEl.textContent = humanPlayer.handName;
            yourHandEl.classList.remove('hidden');
          } else {
            yourHandEl.classList.add('hidden');
          }
        }

        // Highlight if it's player's turn
        if (yourSection) {
          const isHumanTurn = humanIndex === gameState.currentPlayerIndex && !gameState.handComplete;
          if (isHumanTurn) {
            yourSection.classList.add('ring-2', 'ring-yellow-400', 'player-active');
          } else {
            yourSection.classList.remove('ring-2', 'ring-yellow-400', 'player-active');
          }

          if (humanPlayer.folded) {
            yourSection.classList.add('opacity-50');
          } else {
            yourSection.classList.remove('opacity-50');
          }
        }
      }
    }

    // Render desktop/tablet layout - square table with positioned players
    function renderDesktopPlayers() {
      const container = document.getElementById('players-container');
      if (!container || !gameState) return;

      container.innerHTML = '';
      const numPlayers = gameState.players.length;

      // Use square positions if available, otherwise fall back to calculated positions
      const squarePositions = PLAYER_POSITIONS_SQUARE[numPlayers];

      gameState.players.forEach((player, index) => {
        let x, y;

        if (squarePositions) {
          // Use predefined square table positions
          x = squarePositions[index].x;
          y = squarePositions[index].y;
        } else {
          // Fallback to angle-based for larger player counts
          const angles = PLAYER_POSITIONS[numPlayers] || PLAYER_POSITIONS[4];
          const angle = angles[index];
          const radian = (angle - 90) * (Math.PI / 180);
          x = 50 + 42 * Math.cos(radian);
          y = 50 + 40 * Math.sin(radian);
        }

        const playerEl = document.createElement('div');
        playerEl.className = 'absolute transform -translate-x-1/2 -translate-y-1/2 text-center z-10';
        playerEl.style.left = `${x}%`;
        playerEl.style.top = `${y}%`;

        const isActive = index === gameState.currentPlayerIndex && !gameState.handComplete;

        const infoBox = document.createElement('div');
        infoBox.className = `p-2 md:p-3 rounded-lg ${player.isHuman ? 'bg-blue-900/80' : 'bg-gray-800/80'} ${player.folded ? 'opacity-50' : ''}`;
        if (isActive) {
          infoBox.className += ' ring-2 ring-yellow-400 player-active';
        }

        if (player.archetype && !player.isHuman) {
          const archetypeColors = {
            'TAG': 'bg-blue-600',
            'LAG': 'bg-orange-600',
            'Rock': 'bg-gray-600',
            'Calling': 'bg-green-600'
          };
          const archetypeEl = document.createElement('div');
          archetypeEl.className = `${archetypeColors[player.archetype] || 'bg-gray-600'} text-white text-xs md:text-sm font-bold px-1.5 md:px-2 py-0.5 md:py-1 rounded mb-1`;
          archetypeEl.textContent = player.archetype;
          infoBox.appendChild(archetypeEl);
        }

        const nameEl = document.createElement('div');
        nameEl.className = 'text-white text-sm md:text-base font-semibold flex items-center justify-center gap-1';
        nameEl.innerHTML = `${player.isDealer ? '<span class="bg-yellow-500 text-black px-1 md:px-1.5 py-0.5 rounded text-xs md:text-sm">D</span>' : ''}${player.name}`;

        const chipsEl = document.createElement('div');
        chipsEl.className = 'text-yellow-400 text-sm md:text-base font-medium';
        chipsEl.textContent = `$${player.chips}`;

        if (player.currentBet > 0) {
          const betEl = document.createElement('div');
          betEl.className = 'text-green-400 text-xs md:text-sm';
          betEl.textContent = `Bet: $${player.currentBet}`;
          infoBox.appendChild(betEl);
        }

        if (player.folded) {
          const foldedEl = document.createElement('div');
          foldedEl.className = 'text-red-400 text-xs md:text-sm font-semibold';
          foldedEl.textContent = 'FOLDED';
          infoBox.appendChild(foldedEl);
        } else if (player.allIn) {
          const allInEl = document.createElement('div');
          allInEl.className = 'text-purple-400 text-xs md:text-sm font-semibold';
          allInEl.textContent = 'ALL-IN';
          infoBox.appendChild(allInEl);
        }

        infoBox.appendChild(nameEl);
        infoBox.appendChild(chipsEl);

        const cardsEl = document.createElement('div');
        cardsEl.className = 'flex gap-1 mt-1 justify-center';

        if (!player.folded) {
          if (player.holeCards && player.holeCards.length > 0) {
            const showCards = player.isHuman || gameState.handComplete;
            player.holeCards.forEach(card => {
              cardsEl.appendChild(createCardElement(card, !showCards, 'default'));
            });
          } else {
            cardsEl.appendChild(createCardElement(null, true, 'default'));
            cardsEl.appendChild(createCardElement(null, true, 'default'));
          }
        }

        if (gameState.handComplete && player.handName && !player.folded) {
          const handEl = document.createElement('div');
          handEl.className = 'text-purple-300 text-xs md:text-sm mt-1';
          handEl.textContent = player.handName;
          infoBox.appendChild(handEl);
        }

        playerEl.appendChild(infoBox);
        playerEl.appendChild(cardsEl);
        container.appendChild(playerEl);
      });
    }

    // Update community cards (no animation)
    function updateCommunityCards() {
      const isMobile = getBreakpoint() === 'mobile';

      // Update desktop container
      const container = document.getElementById('community-cards');
      if (container && !isMobile) {
        container.innerHTML = '';

        for (let i = 0; i < 5; i++) {
          if (gameState && gameState.communityCards && gameState.communityCards[i]) {
            container.appendChild(createCardElement(gameState.communityCards[i], false, 'medium'));
          } else {
            const emptyCard = document.createElement('div');
            emptyCard.className = 'w-12 h-[4.5rem] md:w-14 md:h-20 lg:w-16 lg:h-24 rounded-lg border-2 border-dashed border-green-600/40 bg-green-950/40 shadow-inner';
            container.appendChild(emptyCard);
          }
        }
      }

      // Update mobile container
      const mobileContainer = document.getElementById('community-cards-mobile');
      if (mobileContainer && isMobile) {
        mobileContainer.innerHTML = '';

        for (let i = 0; i < 5; i++) {
          if (gameState && gameState.communityCards && gameState.communityCards[i]) {
            mobileContainer.appendChild(createCardElement(gameState.communityCards[i], false, 'medium'));
          } else {
            const emptyCard = document.createElement('div');
            emptyCard.className = 'w-10 h-14 rounded-md border-2 border-dashed border-gray-500/50 bg-black/20';
            mobileContainer.appendChild(emptyCard);
          }
        }
      }

      // Update pot display for mobile
      const potDisplayMobile = document.querySelector('#pot-display-mobile span:last-child');
      if (potDisplayMobile && gameState) {
        potDisplayMobile.textContent = `$${gameState.pot}`;
      }
    }

    // Update community cards with animation
    function updateCommunityCardsWithAnimation(game) {
      const isMobile = getBreakpoint() === 'mobile';
      const newCards = game.newCommunityCards || [];
      const allCards = game.communityCards || [];
      const numNewCards = newCards.length;
      const firstNewCardIndex = allCards.length - numNewCards;

      // Update desktop container
      const container = document.getElementById('community-cards');
      if (container && !isMobile) {
        container.innerHTML = '';

        for (let i = 0; i < 5; i++) {
          if (allCards[i]) {
            const cardEl = createCardElement(allCards[i], false, 'medium');

            if (i >= firstNewCardIndex) {
              const animationDelay = i - firstNewCardIndex;
              cardEl.classList.add('card-reveal');
              if (animationDelay === 1) cardEl.classList.add('card-delayed-1');
              if (animationDelay === 2) cardEl.classList.add('card-delayed-2');
            }

            container.appendChild(cardEl);
          } else {
            const emptyCard = document.createElement('div');
            emptyCard.className = 'w-12 h-[4.5rem] md:w-14 md:h-20 lg:w-16 lg:h-24 rounded-lg border-2 border-dashed border-green-600/40 bg-green-950/40 shadow-inner';
            container.appendChild(emptyCard);
          }
        }
      }

      // Update mobile container
      const mobileContainer = document.getElementById('community-cards-mobile');
      if (mobileContainer && isMobile) {
        mobileContainer.innerHTML = '';

        for (let i = 0; i < 5; i++) {
          if (allCards[i]) {
            const cardEl = createCardElement(allCards[i], false, 'medium');

            if (i >= firstNewCardIndex) {
              const animationDelay = i - firstNewCardIndex;
              cardEl.classList.add('card-reveal');
              if (animationDelay === 1) cardEl.classList.add('card-delayed-1');
              if (animationDelay === 2) cardEl.classList.add('card-delayed-2');
            }

            mobileContainer.appendChild(cardEl);
          } else {
            const emptyCard = document.createElement('div');
            emptyCard.className = 'w-10 h-14 rounded-md border-2 border-dashed border-gray-500/50 bg-black/20';
            mobileContainer.appendChild(emptyCard);
          }
        }
      }

      // Update pot display for mobile
      const potDisplayMobile = document.querySelector('#pot-display-mobile span:last-child');
      if (potDisplayMobile) {
        potDisplayMobile.textContent = `$${game.pot}`;
      }
    }

    // Update game display
    function updateGameDisplay() {
      if (!gameState) return;

      // Update pot display (both desktop and mobile)
      const potDisplay = document.querySelector('#pot-display span:last-child');
      if (potDisplay) potDisplay.textContent = `$${gameState.pot}`;
      const potDisplayMobile = document.querySelector('#pot-display-mobile span:last-child');
      if (potDisplayMobile) potDisplayMobile.textContent = `$${gameState.pot}`;

      const handNum = document.getElementById('hand-number');
      if (handNum) handNum.textContent = (gameState.handNumber || 1).toString();

      const smallBlind = document.getElementById('small-blind');
      const bigBlind = document.getElementById('big-blind');
      if (smallBlind) smallBlind.textContent = gameState.smallBlind.toString();
      if (bigBlind) bigBlind.textContent = gameState.bigBlind.toString();

      updateCommunityCards();
      renderPlayers();

      const humanPlayer = gameState.players.find(p => p.isHuman);
      const toCall = gameState.currentBet - (humanPlayer?.currentBet || 0);

      const callAmount = document.getElementById('call-amount');
      if (callAmount) callAmount.textContent = toCall.toString();

      // Desktop slider
      const slider = document.getElementById('raise-slider');
      const minRaiseEl = document.getElementById('min-raise');
      const maxRaiseEl = document.getElementById('max-raise');
      const raiseAmountEl = document.getElementById('raise-amount');
      const raiseAmountMobileEl = document.getElementById('raise-amount-mobile');

      // Mobile slider
      const sliderM = document.getElementById('raise-slider-m');

      if (humanPlayer) {
        const minRaise = gameState.currentBet + (gameState.minRaise || gameState.bigBlind);
        const maxRaise = humanPlayer.chips + humanPlayer.currentBet;
        const defaultValue = Math.min(minRaise * 2, maxRaise).toString();

        // Update desktop slider
        if (slider) {
          slider.min = minRaise.toString();
          slider.max = maxRaise.toString();
          slider.value = defaultValue;
        }

        // Update mobile slider
        if (sliderM) {
          sliderM.min = minRaise.toString();
          sliderM.max = maxRaise.toString();
          sliderM.value = defaultValue;
        }

        if (minRaiseEl) minRaiseEl.textContent = minRaise.toString();
        if (maxRaiseEl) maxRaiseEl.textContent = maxRaise.toString();
        if (raiseAmountEl) raiseAmountEl.textContent = defaultValue;
        if (raiseAmountMobileEl) raiseAmountMobileEl.textContent = defaultValue;
      }

      updateBettingControls();
      updateDecisionTables();
    }

    function updateBettingControls() {
      if (!gameState) return;

      const humanPlayer = gameState.players.find(p => p.isHuman);
      const humanIndex = gameState.players.findIndex(p => p.isHuman);
      const isHumanTurn = gameState.currentPlayerIndex === humanIndex && !gameState.handComplete;
      const canCheck = gameState.currentBet === (humanPlayer?.currentBet || 0);
      const isHandComplete = gameState.handComplete;
      const hasPendingReveal = gameState.pendingReveal && gameState.pendingReveal !== '';

      const disableAll = !isHumanTurn || isHandComplete || humanPlayer?.folded || humanPlayer?.allIn || isRevealingCards || hasPendingReveal;

      // Desktop buttons
      const btnFold = document.getElementById('btn-fold');
      const btnCheck = document.getElementById('btn-check');
      const btnCall = document.getElementById('btn-call');
      const btnRaise = document.getElementById('btn-raise');
      const btnAllin = document.getElementById('btn-allin');

      if (btnFold) btnFold.disabled = disableAll;
      if (btnCheck) {
        btnCheck.disabled = disableAll || !canCheck;
        btnCheck.style.display = canCheck ? 'inline-block' : 'none';
      }
      if (btnCall) {
        btnCall.disabled = disableAll || canCheck;
        btnCall.style.display = !canCheck ? 'inline-block' : 'none';
      }
      if (btnRaise) btnRaise.disabled = disableAll;
      if (btnAllin) btnAllin.disabled = disableAll;

      // Mobile buttons
      const btnFoldM = document.getElementById('btn-fold-m');
      const btnCheckM = document.getElementById('btn-check-m');
      const btnCallM = document.getElementById('btn-call-m');
      const btnRaiseM = document.getElementById('btn-raise-m');
      const btnAllinM = document.getElementById('btn-allin-m');

      if (btnFoldM) btnFoldM.disabled = disableAll;
      if (btnCheckM) {
        btnCheckM.disabled = disableAll || !canCheck;
        btnCheckM.style.display = canCheck ? 'block' : 'none';
      }
      if (btnCallM) {
        btnCallM.disabled = disableAll || canCheck;
        btnCallM.style.display = !canCheck ? 'block' : 'none';
      }
      if (btnRaiseM) btnRaiseM.disabled = disableAll;
      if (btnAllinM) btnAllinM.disabled = disableAll;
    }

    function updateDecisionTables() {
      if (!gameState) return;

      updateHandEvalDisplay();
      updateBettingRulesDisplay();
      updateGameStateDisplay();
    }

    function updateHandEvalDisplay() {
      if (!gameState) return;

      const humanPlayer = gameState.players.find(p => p.isHuman);
      const defaultHtml = '<div class="text-gray-500">Deal cards to see evaluation...</div>';

      // Desktop version
      const container = document.getElementById('dt-hand-eval');
      // Mobile version
      const mobileContainer = document.getElementById('dt-hand-eval-mobile');

      if (!humanPlayer || !humanPlayer.holeCards || humanPlayer.holeCards.length < 2) {
        if (container) container.innerHTML = defaultHtml;
        if (mobileContainer) mobileContainer.innerHTML = defaultHtml;
        return;
      }

      const holeCardsStr = humanPlayer.holeCards.map(c =>
        `${RANK_DISPLAY[c.rank]}${SUIT_SYMBOLS[c.suit]}`
      ).join(' ');

      let html = `<div class="text-white mb-1">Hole: <span class="text-green-300">${holeCardsStr}</span></div>`;

      if (gameState.communityCards && gameState.communityCards.length > 0) {
        const communityStr = gameState.communityCards.map(c =>
          `${RANK_DISPLAY[c.rank]}${SUIT_SYMBOLS[c.suit]}`
        ).join(' ');
        html += `<div class="text-white mb-1">Board: <span class="text-blue-300">${communityStr}</span></div>`;
      }

      if (humanPlayer.handName) {
        html += `<div class="text-yellow-300 mt-1 font-bold">${humanPlayer.handName}</div>`;
      } else if (gameState.communityCards && gameState.communityCards.length >= 3) {
        html += `<div class="text-gray-400 mt-1">Evaluating...</div>`;
      }

      if (container) container.innerHTML = html;
      if (mobileContainer) mobileContainer.innerHTML = html;
    }

    function updateBettingRulesDisplay() {
      const container = document.getElementById('dt-betting-rules');
      if (!container || !gameState) return;

      const humanPlayer = gameState.players.find(p => p.isHuman);
      const humanIndex = gameState.players.findIndex(p => p.isHuman);
      const isHumanTurn = gameState.currentPlayerIndex === humanIndex && !gameState.handComplete;
      const toCall = gameState.currentBet - (humanPlayer?.currentBet || 0);

      if (gameState.handComplete) {
        container.innerHTML = '<div class="text-gray-400">Hand complete</div>';
        return;
      }

      if (!isHumanTurn) {
        const currentPlayer = gameState.players[gameState.currentPlayerIndex];
        container.innerHTML = `<div class="text-gray-400">Waiting for ${currentPlayer?.name || 'opponent'}...</div>`;
        return;
      }

      let html = '<table class="w-full text-left">';
      html += '<tr class="border-b border-gray-700"><th class="py-1">Action</th><th class="py-1">Rule</th></tr>';

      html += '<tr><td class="text-red-400 py-1">Fold</td><td class="text-gray-400">Always valid</td></tr>';

      if (toCall === 0) {
        html += '<tr><td class="text-blue-400 py-1">Check</td><td class="text-gray-400">No bet to call</td></tr>';
      } else {
        html += `<tr><td class="text-green-400 py-1">Call $${toCall}</td><td class="text-gray-400">Match current bet</td></tr>`;
      }

      const minRaise = gameState.currentBet + (gameState.minRaise || gameState.bigBlind);
      html += `<tr><td class="text-yellow-400 py-1">Raise</td><td class="text-gray-400">Min: $${minRaise}</td></tr>`;

      if (humanPlayer) {
        html += `<tr><td class="text-purple-400 py-1">All-In</td><td class="text-gray-400">$${humanPlayer.chips}</td></tr>`;
      }

      html += '</table>';
      container.innerHTML = html;
    }

    function updateAIDecisionDisplay(playerName, action, reasoning, archetype) {
      const container = document.getElementById('dt-ai-decision');
      if (!container) return;

      let html = `<div class="text-white mb-1">${playerName}:</div>`;
      html += `<div class="text-yellow-300 font-bold">${action.toUpperCase()}</div>`;
      html += `<div class="text-gray-400 text-[10px] mt-1">${reasoning}</div>`;
      container.innerHTML = html;

      highlightDecisionTable(archetype, action);
    }

    function highlightDecisionTable(archetype, action) {
      document.querySelectorAll('.dt-active').forEach(el => el.classList.remove('dt-active'));
      document.querySelectorAll('.dt-column-highlight').forEach(el => el.classList.remove('dt-column-highlight'));

      const archetypeMap = {
        'TAG': 'dt-tag-container',
        'LAG': 'dt-lag-container',
        'Rock': 'dt-rock-container',
        'Calling': 'dt-calling-container'
      };

      const containerId = archetypeMap[archetype];
      if (!containerId) return;

      const container = document.getElementById(containerId);
      if (!container) return;

      container.classList.add('dt-active');

      const actionLower = action.toLowerCase();
      let columnIndex = -1;

      if (actionLower.includes('raise') || actionLower.includes('bet')) {
        columnIndex = 1;
      } else if (actionLower.includes('call')) {
        columnIndex = 2;
      } else if (actionLower.includes('check')) {
        columnIndex = 3;
      } else if (actionLower.includes('fold')) {
        columnIndex = 5;
      }

      if (columnIndex > 0) {
        const table = container.querySelector('table');
        if (table) {
          const rows = table.querySelectorAll('tr');
          rows.forEach(row => {
            const cells = row.querySelectorAll('td, th');
            if (cells[columnIndex]) {
              cells[columnIndex].classList.add('dt-column-highlight');
            }
          });
        }
      }

      setTimeout(() => {
        container.classList.remove('dt-active');
        document.querySelectorAll('.dt-column-highlight').forEach(el => el.classList.remove('dt-column-highlight'));
      }, 3000);
    }

    function updateGameStateDisplay() {
      const roundNames = {
        'preflop': 'Pre-Flop',
        'flop': 'Flop',
        'turn': 'Turn',
        'river': 'River',
        'showdown': 'Showdown'
      };

      // Desktop version
      const container = document.getElementById('dt-game-state');
      if (container && gameState) {
        let html = '<table class="w-full text-left">';
        html += `<tr><td class="text-gray-400">Round:</td><td class="text-purple-300">${roundNames[gameState.round] || gameState.round}</td></tr>`;
        html += `<tr><td class="text-gray-400">Pot:</td><td class="text-yellow-300">$${gameState.pot}</td></tr>`;
        html += `<tr><td class="text-gray-400">To Act:</td><td class="text-white">${gameState.players[gameState.currentPlayerIndex]?.name || '-'}</td></tr>`;
        html += `<tr><td class="text-gray-400">Active:</td><td class="text-green-300">${gameState.activePlayerCount} players</td></tr>`;
        html += '</table>';
        container.innerHTML = html;
      }

      // Mobile version
      const mobileContainer = document.getElementById('dt-game-state-mobile');
      if (mobileContainer && gameState) {
        let mobileHtml = `<div class="text-purple-300">${roundNames[gameState.round] || gameState.round}</div>`;
        mobileHtml += `<div class="text-yellow-300">Pot: $${gameState.pot}</div>`;
        mobileHtml += `<div class="text-white">Turn: ${gameState.players[gameState.currentPlayerIndex]?.name || '-'}</div>`;
        mobileContainer.innerHTML = mobileHtml;
      }
    }

    // Add entry to action log (console only, no UI element)
    function addToLog(message) {
      console.log(`[Poker] ${message}`);
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', () => {
      // Initialize breakpoint detection
      currentBreakpoint = getBreakpoint();

      // Add resize listener for responsive layout
      window.addEventListener('resize', debounce(handleBreakpointChange, 150));

      document.getElementById('btn-play')?.addEventListener('click', dealNewHand);

      // Desktop buttons
      document.getElementById('btn-fold')?.addEventListener('click', () => handleAction('fold'));
      document.getElementById('btn-check')?.addEventListener('click', () => handleAction('check'));
      document.getElementById('btn-call')?.addEventListener('click', () => handleAction('call'));
      document.getElementById('btn-raise')?.addEventListener('click', () => handleAction('raise'));
      document.getElementById('btn-allin')?.addEventListener('click', () => handleAction('allin'));

      // Mobile buttons (with -m suffix)
      document.getElementById('btn-fold-m')?.addEventListener('click', () => handleAction('fold'));
      document.getElementById('btn-check-m')?.addEventListener('click', () => handleAction('check'));
      document.getElementById('btn-call-m')?.addEventListener('click', () => handleAction('call'));
      document.getElementById('btn-raise-m')?.addEventListener('click', () => handleAction('raise'));
      document.getElementById('btn-allin-m')?.addEventListener('click', () => handleAction('allin'));

      document.getElementById('btn-close-showdown')?.addEventListener('click', () => {
        hideShowdownModal();
        autoDealNextHand();
      });

      // Desktop slider
      const slider = document.getElementById('raise-slider');
      const raiseAmount = document.getElementById('raise-amount');
      const raiseAmountMobile = document.getElementById('raise-amount-mobile');

      if (slider) {
        slider.addEventListener('input', () => {
          if (raiseAmount) raiseAmount.textContent = slider.value;
          if (raiseAmountMobile) raiseAmountMobile.textContent = slider.value;
          // Sync mobile slider
          const sliderM = document.getElementById('raise-slider-m');
          if (sliderM) sliderM.value = slider.value;
        });
      }

      // Mobile slider
      const sliderM = document.getElementById('raise-slider-m');
      if (sliderM) {
        sliderM.addEventListener('input', () => {
          if (raiseAmountMobile) raiseAmountMobile.textContent = sliderM.value;
          if (raiseAmount) raiseAmount.textContent = sliderM.value;
          // Sync desktop slider
          if (slider) slider.value = sliderM.value;
        });
      }
    });
  </script>
</BaseLayout>
