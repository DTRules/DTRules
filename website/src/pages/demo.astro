---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Interactive Demo - DTRules" description="Interactive Texas Hold'em poker game showcasing DTRules decision tables for hand evaluation, betting validation, and game flow.">
  <section class="py-8 lg:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold mb-4">
          Interactive <span class="gradient-text">Demo</span>
        </h1>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          A Texas Hold'em poker game powered by DTRules decision tables.
          Watch how complex game logic is handled through declarative rules.
        </p>
      </div>

      <!-- Main Game Area -->
      <div class="flex flex-col lg:flex-row gap-6">
        <!-- Poker Table -->
        <div class="flex-1">
          <div id="poker-game" class="glass rounded-2xl p-4 min-h-[500px]">
            <!-- Table will be rendered here -->
            <div class="relative w-full aspect-[16/10] rounded-[40%] overflow-hidden" style="background: linear-gradient(145deg, #1e5631 0%, #0d3320 50%, #1e5631 100%); box-shadow: inset 0 0 50px rgba(0,0,0,0.5), 0 10px 30px rgba(0,0,0,0.3); border: 15px solid #5c3d2e;">
              <!-- Table felt texture -->
              <div class="absolute inset-0 opacity-30" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.5'/%3E%3C/svg%3E&quot;);"></div>

              <!-- Inner border -->
              <div class="absolute inset-4 rounded-[35%] border-2 border-white/20"></div>

              <!-- Center content -->
              <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-center">
                <div id="community-cards" class="flex gap-2 justify-center mb-4">
                  <!-- Community cards will be shown here -->
                  <div class="w-14 h-20 rounded-lg border-2 border-dashed border-gray-500/50 bg-black/20"></div>
                  <div class="w-14 h-20 rounded-lg border-2 border-dashed border-gray-500/50 bg-black/20"></div>
                  <div class="w-14 h-20 rounded-lg border-2 border-dashed border-gray-500/50 bg-black/20"></div>
                  <div class="w-14 h-20 rounded-lg border-2 border-dashed border-gray-500/50 bg-black/20"></div>
                  <div class="w-14 h-20 rounded-lg border-2 border-dashed border-gray-500/50 bg-black/20"></div>
                </div>
                <div id="pot-display" class="px-4 py-2 bg-black/50 rounded-lg inline-block">
                  <span class="text-gray-300 text-xs">Pot</span>
                  <span class="text-yellow-400 font-bold text-xl ml-2">$0</span>
                </div>
              </div>

              <!-- Player positions will be added dynamically -->
              <div id="players-container"></div>

              <!-- Game info badges -->
              <div class="absolute top-2 left-2 px-2 py-1 bg-black/50 rounded text-white text-xs">
                Hand #<span id="hand-number">1</span>
              </div>
              <div class="absolute top-2 right-2 px-2 py-1 bg-black/50 rounded text-white text-xs">
                Blinds: $<span id="small-blind">10</span>/$<span id="big-blind">20</span>
              </div>

              <!-- Round Transition Banner -->
              <div id="round-banner" class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 transition-opacity duration-300">
                <div class="px-8 py-4 bg-black/80 rounded-xl border-2 border-yellow-400 shadow-2xl">
                  <span id="round-banner-text" class="text-3xl font-bold text-yellow-400 uppercase tracking-wider"></span>
                </div>
              </div>
            </div>
          </div>

          <!-- Showdown Results Modal -->
          <div id="showdown-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70">
            <div class="glass rounded-2xl p-6 max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
              <h2 class="text-2xl font-bold text-white mb-4 text-center">Showdown Results</h2>
              <div id="showdown-results" class="space-y-4">
                <!-- Results will be populated dynamically -->
              </div>
              <button id="btn-close-showdown" class="mt-6 w-full px-4 py-3 gradient-button text-white font-semibold rounded-lg">
                Next Hand
              </button>
            </div>
          </div>

          <!-- Betting Controls -->
          <div id="betting-controls" class="glass rounded-xl p-4 mt-4">
            <div class="flex flex-wrap gap-2 justify-center">
              <button id="btn-fold" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                Fold
              </button>
              <button id="btn-check" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                Check
              </button>
              <button id="btn-call" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                Call $<span id="call-amount">0</span>
              </button>
              <button id="btn-raise" class="px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white font-semibold rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                Raise to $<span id="raise-amount">0</span>
              </button>
              <button id="btn-allin" class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                All-In
              </button>
            </div>
            <div class="mt-3 flex items-center gap-3 justify-center">
              <span class="text-gray-400 text-sm">$<span id="min-raise">20</span></span>
              <input type="range" id="raise-slider" min="20" max="1000" value="40" class="w-48 h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer" />
              <span class="text-gray-400 text-sm">$<span id="max-raise">1000</span></span>
            </div>
          </div>
        </div>

        <!-- Side Panel -->
        <div class="w-full lg:w-80 flex flex-col gap-4">
          <!-- Game Controls -->
          <div class="glass rounded-xl p-4">
            <h3 class="font-semibold text-white mb-3">Game Controls</h3>
            <button id="btn-play" class="w-full px-4 py-3 gradient-button text-white font-bold text-lg rounded-lg">
              Play Game
            </button>
            <p class="text-gray-500 text-xs mt-2 text-center">4 players, $1,000 starting chips</p>
          </div>

          <!-- Action Log -->
          <div class="glass rounded-xl p-4 flex-1">
            <h3 class="font-semibold text-white mb-3">Action Log</h3>
            <div id="action-log" class="space-y-1 max-h-48 overflow-y-auto text-sm">
              <div class="text-gray-500 text-center py-4">Start a game to see actions</div>
            </div>
          </div>

          <!-- Decision Tables Display -->
          <div class="glass rounded-xl p-4">
            <h3 class="font-semibold text-white mb-3 flex items-center gap-2">
              <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"></path>
              </svg>
              Decision Tables
            </h3>

            <!-- Hand Evaluation Table -->
            <div class="mb-4">
              <div class="text-xs font-semibold text-green-400 mb-2 flex items-center gap-1">
                <span class="w-2 h-2 bg-green-400 rounded-full"></span>
                Hand Evaluation
              </div>
              <div id="dt-hand-eval" class="bg-gray-900/50 rounded p-2 text-xs font-mono">
                <div class="text-gray-500">Deal cards to see evaluation...</div>
              </div>
            </div>

            <!-- Betting Rules Table -->
            <div class="mb-4">
              <div class="text-xs font-semibold text-blue-400 mb-2 flex items-center gap-1">
                <span class="w-2 h-2 bg-blue-400 rounded-full"></span>
                Valid Actions
              </div>
              <div id="dt-betting-rules" class="bg-gray-900/50 rounded p-2 text-xs font-mono">
                <div class="text-gray-500">Waiting for game...</div>
              </div>
            </div>

            <!-- AI Decision Table -->
            <div class="mb-4">
              <div class="text-xs font-semibold text-yellow-400 mb-2 flex items-center gap-1">
                <span class="w-2 h-2 bg-yellow-400 rounded-full"></span>
                Last AI Decision
              </div>
              <div id="dt-ai-decision" class="bg-gray-900/50 rounded p-2 text-xs font-mono">
                <div class="text-gray-500">No AI actions yet...</div>
              </div>
            </div>

            <!-- Round State -->
            <div>
              <div class="text-xs font-semibold text-purple-400 mb-2 flex items-center gap-1">
                <span class="w-2 h-2 bg-purple-400 rounded-full"></span>
                Game State
              </div>
              <div id="dt-game-state" class="bg-gray-900/50 rounded p-2 text-xs font-mono">
                <div class="text-gray-500">No active game...</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Decision Tables Section -->
      <div class="mt-6">
        <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-3">
          <svg class="w-7 h-7 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"></path>
          </svg>
          AI Decision Tables
        </h2>
        <p class="text-gray-400 mb-6">Each AI opponent uses a different decision table based on their playing style. Watch the tables highlight as decisions are made.</p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- TAG Decision Table -->
          <div class="glass rounded-xl p-4" id="dt-tag-container">
            <div class="flex items-center gap-2 mb-4">
              <span class="px-2 py-1 bg-blue-600 text-white text-xs font-bold rounded">TAG</span>
              <h3 class="font-semibold text-white">Tight-Aggressive</h3>
              <span class="text-gray-400 text-xs ml-auto">~18% VPIP</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-xs" id="dt-tag-table">
                <thead>
                  <tr class="border-b border-gray-600">
                    <th class="text-left py-2 px-2 text-gray-400">Condition</th>
                    <th class="text-center py-2 px-1 text-gray-400">1</th>
                    <th class="text-center py-2 px-1 text-gray-400">2</th>
                    <th class="text-center py-2 px-1 text-gray-400">3</th>
                    <th class="text-center py-2 px-1 text-gray-400">4</th>
                    <th class="text-center py-2 px-1 text-gray-400">5</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="border-b border-gray-700">
                    <td class="py-2 px-2 text-gray-300">Hand Strength >= 70%</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                  </tr>
                  <tr class="border-b border-gray-700">
                    <td class="py-2 px-2 text-gray-300">Hand Strength >= 50%</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                  </tr>
                  <tr class="border-b border-gray-700">
                    <td class="py-2 px-2 text-gray-300">Pot Odds Favorable</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-gray-500">-</td>
                  </tr>
                  <tr class="border-b border-gray-700">
                    <td class="py-2 px-2 text-gray-300">Can Check</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-red-400">N</td>
                  </tr>
                  <tr class="bg-gray-800/50">
                    <td class="py-2 px-2 text-purple-300 font-semibold">-> Action</td>
                    <td class="text-center text-yellow-400 font-bold">RAISE</td>
                    <td class="text-center text-blue-400 font-bold">CALL</td>
                    <td class="text-center text-gray-400 font-bold">CHECK</td>
                    <td class="text-center text-gray-400 font-bold">CHECK</td>
                    <td class="text-center text-red-400 font-bold">FOLD</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- LAG Decision Table -->
          <div class="glass rounded-xl p-4" id="dt-lag-container">
            <div class="flex items-center gap-2 mb-4">
              <span class="px-2 py-1 bg-orange-600 text-white text-xs font-bold rounded">LAG</span>
              <h3 class="font-semibold text-white">Loose-Aggressive</h3>
              <span class="text-gray-400 text-xs ml-auto">~35% VPIP</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-xs" id="dt-lag-table">
                <thead>
                  <tr class="border-b border-gray-600">
                    <th class="text-left py-2 px-2 text-gray-400">Condition</th>
                    <th class="text-center py-2 px-1 text-gray-400">1</th>
                    <th class="text-center py-2 px-1 text-gray-400">2</th>
                    <th class="text-center py-2 px-1 text-gray-400">3</th>
                    <th class="text-center py-2 px-1 text-gray-400">4</th>
                    <th class="text-center py-2 px-1 text-gray-400">5</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="border-b border-gray-700">
                    <td class="py-2 px-2 text-gray-300">Hand Strength >= 50%</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                  </tr>
                  <tr class="border-b border-gray-700">
                    <td class="py-2 px-2 text-gray-300">Position = Late/Button</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                  </tr>
                  <tr class="border-b border-gray-700">
                    <td class="py-2 px-2 text-gray-300">Hand Strength >= 25%</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-red-400">N</td>
                  </tr>
                  <tr class="border-b border-gray-700">
                    <td class="py-2 px-2 text-gray-300">Can Check</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-gray-500">-</td>
                  </tr>
                  <tr class="bg-gray-800/50">
                    <td class="py-2 px-2 text-purple-300 font-semibold">-> Action</td>
                    <td class="text-center text-yellow-400 font-bold">RAISE</td>
                    <td class="text-center text-yellow-400 font-bold">RAISE</td>
                    <td class="text-center text-gray-400 font-bold">CHECK</td>
                    <td class="text-center text-blue-400 font-bold">CALL</td>
                    <td class="text-center text-red-400 font-bold">FOLD</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Rock Decision Table -->
          <div class="glass rounded-xl p-4" id="dt-rock-container">
            <div class="flex items-center gap-2 mb-4">
              <span class="px-2 py-1 bg-gray-600 text-white text-xs font-bold rounded">Rock</span>
              <h3 class="font-semibold text-white">Tight-Passive</h3>
              <span class="text-gray-400 text-xs ml-auto">~12% VPIP</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-xs" id="dt-rock-table">
                <thead>
                  <tr class="border-b border-gray-600">
                    <th class="text-left py-2 px-2 text-gray-400">Condition</th>
                    <th class="text-center py-2 px-1 text-gray-400">1</th>
                    <th class="text-center py-2 px-1 text-gray-400">2</th>
                    <th class="text-center py-2 px-1 text-gray-400">3</th>
                    <th class="text-center py-2 px-1 text-gray-400">4</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="border-b border-gray-700">
                    <td class="py-2 px-2 text-gray-300">Hand Strength >= 85%</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                  </tr>
                  <tr class="border-b border-gray-700">
                    <td class="py-2 px-2 text-gray-300">Hand Strength >= 60%</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                  </tr>
                  <tr class="border-b border-gray-700">
                    <td class="py-2 px-2 text-gray-300">Can Check</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-red-400">N</td>
                  </tr>
                  <tr class="bg-gray-800/50">
                    <td class="py-2 px-2 text-purple-300 font-semibold">-> Action</td>
                    <td class="text-center text-yellow-400 font-bold">RAISE</td>
                    <td class="text-center text-blue-400 font-bold">CALL</td>
                    <td class="text-center text-gray-400 font-bold">CHECK</td>
                    <td class="text-center text-red-400 font-bold">FOLD</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Calling Station Decision Table -->
          <div class="glass rounded-xl p-4" id="dt-calling-container">
            <div class="flex items-center gap-2 mb-4">
              <span class="px-2 py-1 bg-green-600 text-white text-xs font-bold rounded">Calling</span>
              <h3 class="font-semibold text-white">Calling Station</h3>
              <span class="text-gray-400 text-xs ml-auto">~40% VPIP</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-xs" id="dt-calling-table">
                <thead>
                  <tr class="border-b border-gray-600">
                    <th class="text-left py-2 px-2 text-gray-400">Condition</th>
                    <th class="text-center py-2 px-1 text-gray-400">1</th>
                    <th class="text-center py-2 px-1 text-gray-400">2</th>
                    <th class="text-center py-2 px-1 text-gray-400">3</th>
                    <th class="text-center py-2 px-1 text-gray-400">4</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="border-b border-gray-700">
                    <td class="py-2 px-2 text-gray-300">Hand Strength >= 20%</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                  </tr>
                  <tr class="border-b border-gray-700">
                    <td class="py-2 px-2 text-gray-300">Bet <= 2x Big Blind</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                  </tr>
                  <tr class="border-b border-gray-700">
                    <td class="py-2 px-2 text-gray-300">Can Check</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-gray-500">-</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-red-400">N</td>
                  </tr>
                  <tr class="bg-gray-800/50">
                    <td class="py-2 px-2 text-purple-300 font-semibold">-> Action</td>
                    <td class="text-center text-blue-400 font-bold">CALL</td>
                    <td class="text-center text-blue-400 font-bold">CALL</td>
                    <td class="text-center text-gray-400 font-bold">CHECK</td>
                    <td class="text-center text-red-400 font-bold">FOLD</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Hand Evaluation Decision Table -->
        <div class="mt-6">
          <h3 class="text-xl font-bold text-white mb-4">Hand Evaluation Table</h3>
          <div class="glass rounded-xl p-4 overflow-x-auto">
            <table class="w-full text-xs" id="dt-hand-eval-table">
              <thead>
                <tr class="border-b border-gray-600">
                  <th class="text-left py-2 px-2 text-gray-400">Condition</th>
                  <th class="text-center py-2 px-1 text-gray-400">1</th>
                  <th class="text-center py-2 px-1 text-gray-400">2</th>
                  <th class="text-center py-2 px-1 text-gray-400">3</th>
                  <th class="text-center py-2 px-1 text-gray-400">4</th>
                  <th class="text-center py-2 px-1 text-gray-400">5</th>
                  <th class="text-center py-2 px-1 text-gray-400">6</th>
                  <th class="text-center py-2 px-1 text-gray-400">7</th>
                  <th class="text-center py-2 px-1 text-gray-400">8</th>
