---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Interactive Demo - DTRules" description="Interactive Texas Hold'em poker game showcasing DTRules decision tables for hand evaluation, betting validation, and game flow.">
  <section class="py-8 lg:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-6 md:mb-8">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-2 md:mb-4">
          Interactive <span class="gradient-text">Demo</span>
        </h1>
        <p class="text-sm md:text-lg text-muted-foreground max-w-2xl mx-auto px-2">
          Texas Hold'em poker powered by DTRules decision tables.
        </p>
      </div>

      <!-- Main Game Area -->
      <div class="flex flex-col lg:flex-row gap-6">
        <!-- Poker Table -->
        <div class="flex-1">
          <div id="poker-game" class="glass rounded-xl md:rounded-2xl p-3 md:p-4 lg:p-6
                            min-h-[500px] md:min-h-[650px] lg:min-h-[750px]
                            flex flex-col">
            <!-- Game info bar - always visible at top -->
            <div class="flex justify-between items-center mb-3 px-2">
              <div class="flex items-center gap-2">
                <div class="px-3 py-1.5 md:px-4 md:py-2 bg-black/60 rounded-lg text-white text-sm md:text-base font-semibold">
                  Hand #<span id="hand-number">1</span>
                </div>
                <!-- Mobile indicator (only visible on mobile) -->
                <span class="md:hidden px-2 py-1 bg-purple-600/80 rounded text-[10px] text-white font-bold">MOBILE</span>
              </div>
              <div class="px-3 py-1.5 md:px-4 md:py-2 bg-black/60 rounded-lg text-white text-sm md:text-base font-semibold">
                $<span id="small-blind">10</span>/<span id="big-blind">20</span>
              </div>
            </div>

            <!-- Mobile Layout (< 768px) - Vertical Stack Design -->
            <div id="mobile-layout" class="flex-1 flex flex-col md:hidden">
              <!-- Community Cards & Pot - Green felt area -->
              <div class="bg-gradient-to-b from-green-800/80 to-green-900/80 rounded-xl p-4 mb-3 border border-green-700/50 shadow-lg">
                <div id="community-cards-mobile" class="flex gap-2 justify-center mb-3">
                  <!-- Community cards placeholder -->
                  <div class="w-11 h-16 rounded-lg border-2 border-dashed border-green-600/50 bg-green-950/50"></div>
                  <div class="w-11 h-16 rounded-lg border-2 border-dashed border-green-600/50 bg-green-950/50"></div>
                  <div class="w-11 h-16 rounded-lg border-2 border-dashed border-green-600/50 bg-green-950/50"></div>
                  <div class="w-11 h-16 rounded-lg border-2 border-dashed border-green-600/50 bg-green-950/50"></div>
                  <div class="w-11 h-16 rounded-lg border-2 border-dashed border-green-600/50 bg-green-950/50"></div>
                </div>
                <div id="pot-display-mobile" class="text-center bg-black/40 rounded-lg py-2 px-4 inline-block mx-auto w-full">
                  <span class="text-gray-300 text-sm">Pot:</span>
                  <span class="text-yellow-400 font-bold text-xl ml-2">$0</span>
                </div>
              </div>

              <!-- Opponents Grid - 2 column layout -->
              <div id="opponents-grid" class="grid grid-cols-2 gap-2 mb-3 flex-1">
                <!-- Placeholder cards shown before game starts -->
                <div class="bg-gray-800/80 rounded-lg p-2.5 flex items-center gap-2 border border-gray-700">
                  <span class="bg-gray-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded">AI</span>
                  <div class="flex-1 min-w-0">
                    <div class="text-gray-400 text-sm">Waiting...</div>
                  </div>
                </div>
                <div class="bg-gray-800/80 rounded-lg p-2.5 flex items-center gap-2 border border-gray-700">
                  <span class="bg-gray-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded">AI</span>
                  <div class="flex-1 min-w-0">
                    <div class="text-gray-400 text-sm">Waiting...</div>
                  </div>
                </div>
                <div class="bg-gray-800/80 rounded-lg p-2.5 flex items-center gap-2 border border-gray-700">
                  <span class="bg-gray-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded">AI</span>
                  <div class="flex-1 min-w-0">
                    <div class="text-gray-400 text-sm">Waiting...</div>
                  </div>
                </div>
              </div>

              <!-- Your Section - Prominent at bottom -->
              <div id="your-section" class="bg-gradient-to-t from-blue-900/80 to-blue-800/60 rounded-xl p-4 border-2 border-blue-600/50 shadow-lg">
                <div class="text-center text-blue-300 text-xs font-semibold uppercase tracking-wide mb-2">Your Hand</div>
                <div id="your-cards-mobile" class="flex justify-center gap-4 mb-3">
                  <!-- Large cards for easy viewing -->
                  <div class="w-16 h-24 rounded-lg border-2 border-dashed border-blue-500/50 bg-blue-950/50"></div>
                  <div class="w-16 h-24 rounded-lg border-2 border-dashed border-blue-500/50 bg-blue-950/50"></div>
                </div>
                <div class="flex justify-between items-center bg-black/30 rounded-lg px-3 py-2">
                  <span id="your-name-mobile" class="text-white font-semibold">You</span>
                  <span id="your-chips-mobile" class="text-yellow-400 font-bold text-lg">$1,000</span>
                </div>
                <div id="your-bet-mobile" class="text-green-400 text-sm text-center mt-2 hidden"></div>
                <div id="your-hand-mobile" class="text-purple-300 text-sm text-center mt-1 hidden"></div>
              </div>

              <!-- Round Transition Banner (Mobile) -->
              <div id="round-banner-mobile" class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 transition-opacity duration-300 z-10">
                <div class="px-6 py-3 bg-black/90 rounded-xl border-2 border-yellow-400 shadow-2xl">
                  <span id="round-banner-text-mobile" class="text-xl font-bold text-yellow-400 uppercase tracking-wider"></span>
                </div>
              </div>
            </div>

            <!-- Tablet/Desktop Layout (>= 768px) - Square Table with Brown Border -->
            <div id="desktop-layout" class="hidden md:block relative flex-1 rounded-2xl overflow-visible min-h-[450px] lg:min-h-[550px]" style="border: 16px solid #5c4033; box-shadow: 0 15px 40px rgba(0,0,0,0.5), inset 0 0 0 4px #3d2817; background: radial-gradient(ellipse at center, #1a6b35 0%, #145228 40%, #0d3320 100%);">
              <!-- Table felt texture -->
              <div class="absolute inset-0 rounded-lg opacity-20" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.4'/%3E%3C/svg%3E&quot;);"></div>

              <!-- Inner shadow for depth -->
              <div class="absolute inset-0 rounded-lg" style="box-shadow: inset 0 0 60px rgba(0,0,0,0.5);"></div>

              <!-- Center content -->
              <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-center">
                <!-- DTRules logo watermark -->
                <div class="absolute -top-8 left-1/2 -translate-x-1/2 text-white/10 text-xs font-bold tracking-widest">DTRULES POKER</div>

                <div id="community-cards" class="flex gap-2 lg:gap-4 justify-center mb-5">
                  <!-- Community cards placeholder -->
                  <div class="w-12 h-[4.5rem] md:w-14 md:h-20 lg:w-16 lg:h-24 rounded-lg border-2 border-dashed border-green-600/40 bg-green-950/40 shadow-inner"></div>
                  <div class="w-12 h-[4.5rem] md:w-14 md:h-20 lg:w-16 lg:h-24 rounded-lg border-2 border-dashed border-green-600/40 bg-green-950/40 shadow-inner"></div>
                  <div class="w-12 h-[4.5rem] md:w-14 md:h-20 lg:w-16 lg:h-24 rounded-lg border-2 border-dashed border-green-600/40 bg-green-950/40 shadow-inner"></div>
                  <div class="w-12 h-[4.5rem] md:w-14 md:h-20 lg:w-16 lg:h-24 rounded-lg border-2 border-dashed border-green-600/40 bg-green-950/40 shadow-inner"></div>
                  <div class="w-12 h-[4.5rem] md:w-14 md:h-20 lg:w-16 lg:h-24 rounded-lg border-2 border-dashed border-green-600/40 bg-green-950/40 shadow-inner"></div>
                </div>
                <div id="pot-display" class="px-6 py-3 md:px-10 md:py-4 bg-black/60 rounded-full inline-block border border-yellow-600/30 shadow-lg">
                  <span class="text-gray-300 text-base md:text-lg">Pot:</span>
                  <span class="text-yellow-400 font-bold text-2xl md:text-3xl lg:text-4xl ml-2">$0</span>
                </div>
              </div>

              <!-- Player positions will be added dynamically -->
              <div id="players-container"></div>

              <!-- Round Transition Banner -->
              <div id="round-banner" class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 transition-opacity duration-300">
                <div class="px-8 py-4 bg-black/90 rounded-2xl border-2 border-yellow-500 shadow-2xl backdrop-blur-sm">
                  <span id="round-banner-text" class="text-2xl md:text-3xl font-bold text-yellow-400 uppercase tracking-wider"></span>
                </div>
              </div>
            </div>
          </div>

          <!-- Showdown Results Modal -->
          <div id="showdown-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-2 md:p-4">
            <div class="glass rounded-xl md:rounded-2xl p-4 md:p-6 max-w-2xl w-full mx-2 md:mx-4 max-h-[85vh] overflow-y-auto">
              <h2 class="text-xl md:text-2xl font-bold text-white mb-3 md:mb-4 text-center">Showdown Results</h2>
              <div id="showdown-results" class="space-y-3 md:space-y-4">
                <!-- Results will be populated dynamically -->
              </div>
              <button id="btn-close-showdown" class="mt-4 md:mt-6 w-full px-4 py-3 gradient-button text-white font-semibold rounded-lg touch-manipulation">
                Next Hand
              </button>
            </div>
          </div>

          <!-- Betting Controls -->
          <div id="betting-controls" class="
              fixed bottom-0 left-0 right-0 z-40 md:relative md:bottom-auto
              bg-gray-900/95 md:bg-transparent backdrop-blur-md md:backdrop-blur-none
              rounded-t-2xl md:rounded-xl p-4 md:p-5 mt-0 md:mt-4
              border-t-2 border-gray-600/50 md:border md:border-gray-700/50
              safe-area-bottom md:glass shadow-[0_-10px_40px_rgba(0,0,0,0.5)] md:shadow-none">

            <!-- Mobile: Compact 2-row layout -->
            <div class="md:hidden">
              <div class="grid grid-cols-4 gap-2 mb-3">
                <button id="btn-fold-m" class="py-3 bg-gradient-to-b from-red-500 to-red-700 hover:from-red-400 hover:to-red-600 active:from-red-600 active:to-red-800 text-white text-sm font-bold rounded-xl shadow-lg transition-all disabled:opacity-40 disabled:cursor-not-allowed touch-manipulation">
                  Fold
                </button>
                <button id="btn-check-m" class="py-3 bg-gradient-to-b from-blue-500 to-blue-700 hover:from-blue-400 hover:to-blue-600 active:from-blue-600 active:to-blue-800 text-white text-sm font-bold rounded-xl shadow-lg transition-all disabled:opacity-40 disabled:cursor-not-allowed touch-manipulation">
                  Check
                </button>
                <button id="btn-call-m" class="py-3 bg-gradient-to-b from-green-500 to-green-700 hover:from-green-400 hover:to-green-600 active:from-green-600 active:to-green-800 text-white text-sm font-bold rounded-xl shadow-lg transition-all disabled:opacity-40 disabled:cursor-not-allowed touch-manipulation">
                  Call
                </button>
                <button id="btn-raise-m" class="py-3 bg-gradient-to-b from-yellow-500 to-yellow-700 hover:from-yellow-400 hover:to-yellow-600 active:from-yellow-600 active:to-yellow-800 text-white text-sm font-bold rounded-xl shadow-lg transition-all disabled:opacity-40 disabled:cursor-not-allowed touch-manipulation">
                  Raise
                </button>
              </div>
              <div class="flex items-center gap-3">
                <input type="range" id="raise-slider-m" min="20" max="1000" value="40"
                       class="flex-1 h-3 bg-gray-700 rounded-full appearance-none cursor-pointer touch-manipulation accent-yellow-500" />
                <span class="text-yellow-400 font-bold text-base min-w-[60px] text-right">$<span id="raise-amount-mobile">40</span></span>
                <button id="btn-allin-m" class="px-4 py-2 bg-gradient-to-b from-purple-500 to-purple-700 hover:from-purple-400 hover:to-purple-600 text-white text-xs font-bold rounded-lg shadow-lg transition-all disabled:opacity-40 touch-manipulation">
                  ALL IN
                </button>
              </div>
            </div>

            <!-- Desktop: Original layout -->
            <div class="hidden md:block">
              <div class="flex gap-3 justify-center mb-3">
                <button id="btn-fold" class="px-6 py-3 bg-gradient-to-b from-red-500 to-red-700 hover:from-red-400 hover:to-red-600 text-white text-lg font-semibold rounded-xl shadow-lg transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                  Fold
                </button>
                <button id="btn-check" class="px-6 py-3 bg-gradient-to-b from-blue-500 to-blue-700 hover:from-blue-400 hover:to-blue-600 text-white text-lg font-semibold rounded-xl shadow-lg transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                  Check
                </button>
                <button id="btn-call" class="px-6 py-3 bg-gradient-to-b from-green-500 to-green-700 hover:from-green-400 hover:to-green-600 text-white text-lg font-semibold rounded-xl shadow-lg transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                  Call $<span id="call-amount">0</span>
                </button>
                <button id="btn-raise" class="px-6 py-3 bg-gradient-to-b from-yellow-500 to-yellow-700 hover:from-yellow-400 hover:to-yellow-600 text-white text-lg font-semibold rounded-xl shadow-lg transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                  Raise to $<span id="raise-amount">0</span>
                </button>
                <button id="btn-allin" class="px-6 py-3 bg-gradient-to-b from-purple-500 to-purple-700 hover:from-purple-400 hover:to-purple-600 text-white text-lg font-semibold rounded-xl shadow-lg transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                  All-In
                </button>
              </div>
              <div class="flex items-center gap-3 justify-center">
                <span class="text-gray-400 text-sm">$<span id="min-raise">20</span></span>
                <input type="range" id="raise-slider" min="20" max="1000" value="40"
                       class="w-48 h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer accent-yellow-500" />
                <span class="text-gray-400 text-sm">$<span id="max-raise">1000</span></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Side Panel -->
        <div class="w-full lg:w-96 flex flex-col gap-4 mb-32 md:mb-0">
          <!-- Game Controls -->
          <div class="glass rounded-xl p-4 md:p-5">
            <h3 class="font-semibold text-white text-base md:text-lg mb-3 md:mb-4">Game Controls</h3>
            <button id="btn-play" class="w-full px-4 md:px-6 py-3 md:py-4 gradient-button text-white font-bold text-lg md:text-xl rounded-lg touch-manipulation">
              Play Game
            </button>
            <p class="text-gray-400 text-xs md:text-sm mt-2 md:mt-3 text-center">4 players, $1,000 starting chips</p>
          </div>

          <!-- Mobile: Collapsible Decision Tables -->
          <details class="md:hidden glass rounded-xl">
            <summary class="p-4 font-semibold text-white cursor-pointer flex items-center gap-2">
              <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"></path>
              </svg>
              Decision Tables
            </summary>
            <div class="p-4 pt-0 text-xs">
              <!-- Hand Evaluation Table -->
              <div class="mb-3">
                <div class="text-xs font-semibold text-green-400 mb-1 flex items-center gap-1">
                  <span class="w-2 h-2 bg-green-400 rounded-full"></span>
                  Hand Evaluation
                </div>
                <div id="dt-hand-eval-mobile" class="bg-gray-900/50 rounded p-2 text-xs font-mono">
                  <div class="text-gray-500">Deal cards to see evaluation...</div>
                </div>
              </div>

              <!-- Game State -->
              <div>
                <div class="text-xs font-semibold text-purple-400 mb-1 flex items-center gap-1">
                  <span class="w-2 h-2 bg-purple-400 rounded-full"></span>
                  Game State
                </div>
                <div id="dt-game-state-mobile" class="bg-gray-900/50 rounded p-2 text-xs font-mono">
                  <div class="text-gray-500">No active game...</div>
                </div>
              </div>
            </div>
          </details>

          <!-- Tablet/Desktop: Full Decision Tables Display -->
          <div class="hidden md:block glass rounded-xl p-5">
            <h3 class="font-semibold text-white text-lg mb-4 flex items-center gap-2">
              <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"></path>
              </svg>
              Decision Tables
            </h3>

            <!-- Hand Evaluation Table -->
            <div class="mb-4">
              <div class="text-sm font-semibold text-green-400 mb-2 flex items-center gap-2">
                <span class="w-2.5 h-2.5 bg-green-400 rounded-full"></span>
                Hand Evaluation
              </div>
              <div id="dt-hand-eval" class="bg-gray-900/50 rounded p-3 text-sm font-mono">
                <div class="text-gray-500">Deal cards to see evaluation...</div>
              </div>
            </div>

            <!-- Betting Rules Table -->
            <div class="mb-4">
              <div class="text-sm font-semibold text-blue-400 mb-2 flex items-center gap-2">
                <span class="w-2.5 h-2.5 bg-blue-400 rounded-full"></span>
                Valid Actions
              </div>
              <div id="dt-betting-rules" class="bg-gray-900/50 rounded p-3 text-sm font-mono">
                <div class="text-gray-500">Waiting for game...</div>
              </div>
            </div>

            <!-- AI Decision Table -->
            <div class="mb-4">
              <div class="text-sm font-semibold text-yellow-400 mb-2 flex items-center gap-2">
                <span class="w-2.5 h-2.5 bg-yellow-400 rounded-full"></span>
                Last AI Decision
              </div>
              <div id="dt-ai-decision" class="bg-gray-900/50 rounded p-3 text-sm font-mono">
                <div class="text-gray-500">No AI actions yet...</div>
              </div>
            </div>

            <!-- Round State -->
            <div>
              <div class="text-sm font-semibold text-purple-400 mb-2 flex items-center gap-2">
                <span class="w-2.5 h-2.5 bg-purple-400 rounded-full"></span>
                Game State
              </div>
              <div id="dt-game-state" class="bg-gray-900/50 rounded p-3 text-sm font-mono">
                <div class="text-gray-500">No active game...</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Decision Tables Section - Hidden on mobile, collapsible -->
      <div class="mt-6 mb-32 md:mb-0">
        <!-- Mobile: Collapsible -->
        <details class="md:hidden glass rounded-xl mb-4">
          <summary class="p-4 font-semibold text-white cursor-pointer flex items-center gap-2">
            <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"></path>
            </svg>
            AI Decision Tables
          </summary>
          <div class="p-4 pt-0">
            <p class="text-gray-400 text-xs mb-4">Each AI uses a different strategy. Expand on desktop for full tables.</p>
          </div>
        </details>

        <!-- Desktop: Full section -->
        <div class="hidden md:block">
          <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-3">
            <svg class="w-7 h-7 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"></path>
            </svg>
            AI Decision Tables
          </h2>
          <p class="text-gray-400 mb-6">Each AI opponent uses a different decision table based on their playing style. Watch the tables highlight as decisions are made.</p>
        </div>

        <div class="hidden md:grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- TAG Decision Table -->
          <div class="glass rounded-xl p-4" id="dt-tag-container">
            <div class="flex items-center gap-2 mb-4">
              <span class="px-2 py-1 bg-blue-600 text-white text-xs font-bold rounded">TAG</span>
              <h3 class="font-semibold text-white">Tight-Aggressive</h3>
              <span class="text-gray-400 text-xs ml-auto">~18% VPIP</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-xs" id="dt-tag-table">
                <thead>
                  <tr class="border-b border-gray-600">
                    <th class="text-left py-2 px-2 text-gray-400">Condition</th>
                    <th class="text-center py-2 px-1 text-gray-400">1</th>
                    <th class="text-center py-2 px-1 text-gray-400">2</th>
                    <th class="text-center py-2 px-1 text-gray-400">3</th>
                    <th class="text-center py-2 px-1 text-gray-400">4</th>
                    <th class="text-center py-2 px-1 text-gray-400">5</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="border-b border-gray-700">
                    <td class="py-2 px-2 text-gray-300">Hand Strength >= 70%</td>
                    <td class="text-center text-green-400">Y</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                    <td class="text-center text-red-400">N</td>
                  </tr>
                  <tr class="border-b border-gray-700">
                    <td class="py-2 px-2 text-gray-300">Hand Strength >= 50%</td>
