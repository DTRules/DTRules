<script>
  // Tax Calculator Logic
  const TAX_RATES_2025 = {
    single: {
      brackets: [
        { min: 0, max: 11925, rate: 0.10, base: 0 },
        { min: 11925, max: 48475, rate: 0.12, base: 1192.50 },
        { min: 48475, max: 103350, rate: 0.22, base: 5578.50 },
        { min: 103350, max: 197300, rate: 0.24, base: 17651 },
        { min: 197300, max: 250525, rate: 0.32, base: 40199 },
        { min: 250525, max: 626350, rate: 0.35, base: 57231 },
        { min: 626350, max: Infinity, rate: 0.37, base: 188769.75 }
      ],
      standardDeduction: 15000
    },
    mfj: {
      brackets: [
        { min: 0, max: 23850, rate: 0.10, base: 0 },
        { min: 23850, max: 96950, rate: 0.12, base: 2385 },
        { min: 96950, max: 206700, rate: 0.22, base: 11157 },
        { min: 206700, max: 394600, rate: 0.24, base: 35302 },
        { min: 394600, max: 501050, rate: 0.32, base: 80398 },
        { min: 501050, max: 751600, rate: 0.35, base: 114462 },
        { min: 751600, max: Infinity, rate: 0.37, base: 202154.50 }
      ],
      standardDeduction: 30000
    },
    hoh: {
      brackets: [
        { min: 0, max: 17000, rate: 0.10, base: 0 },
        { min: 17000, max: 64850, rate: 0.12, base: 1700 },
        { min: 64850, max: 103350, rate: 0.22, base: 7442 },
        { min: 103350, max: 197300, rate: 0.24, base: 15912 },
        { min: 197300, max: 250500, rate: 0.32, base: 38460 },
        { min: 250500, max: 626350, rate: 0.35, base: 55484 },
        { min: 626350, max: Infinity, rate: 0.37, base: 187031.50 }
      ],
      standardDeduction: 22500
    }
  };

  function calculateTax() {
    const filingStatus = (document.getElementById('filing-status') as HTMLSelectElement).value as 'single' | 'mfj' | 'hoh';
    const wages = parseFloat((document.getElementById('wages') as HTMLInputElement).value) || 0;
    const dependents = parseInt((document.getElementById('dependents') as HTMLInputElement).value) || 0;

    const rates = TAX_RATES_2025[filingStatus];

    // Calculate AGI (simplified - just wages for this demo)
    const agi = wages;

    // Calculate taxable income
    const taxableIncome = Math.max(0, agi - rates.standardDeduction);

    // Calculate tax using brackets
    let tax = 0;
    let marginalRate = 0;
    for (const bracket of rates.brackets) {
      if (taxableIncome > bracket.min) {
        if (taxableIncome <= bracket.max) {
          tax = bracket.base + (taxableIncome - bracket.min) * bracket.rate;
          marginalRate = bracket.rate * 100;
          break;
        }
      }
    }

    // Calculate Child Tax Credit (simplified)
    const ctc = dependents * 2000;

    // Total tax
    const totalTax = Math.max(0, tax - ctc);

    // Effective rate
    const effectiveRate = agi > 0 ? (totalTax / agi) * 100 : 0;

    // Update display
    document.getElementById('result-agi')!.textContent = formatCurrency(agi);
    document.getElementById('result-deduction')!.textContent = formatCurrency(rates.standardDeduction);
    document.getElementById('result-taxable')!.textContent = formatCurrency(taxableIncome);
    document.getElementById('result-tax')!.textContent = formatCurrency(tax);

    const ctcRow = document.getElementById('ctc-row');
    if (ctc > 0) {
      ctcRow?.classList.remove('hidden');
      document.getElementById('result-ctc')!.textContent = '-' + formatCurrency(ctc);
    } else {
      ctcRow?.classList.add('hidden');
    }

    document.getElementById('result-total')!.textContent = formatCurrency(totalTax);

    const ratesDiv = document.getElementById('rates');
    ratesDiv?.classList.remove('hidden');
    document.getElementById('effective-rate')!.textContent = effectiveRate.toFixed(1) + '%';
    document.getElementById('marginal-rate')!.textContent = marginalRate + '%';
  }

  function formatCurrency(amount: number): string {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0
    }).format(amount);
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('calculate-btn')?.addEventListener('click', calculateTax);

    // Calculate on input change
    ['filing-status', 'wages', 'dependents'].forEach(id => {
      document.getElementById(id)?.addEventListener('change', calculateTax);
    });

    // Initial calculation
    calculateTax();
  });
</script>
