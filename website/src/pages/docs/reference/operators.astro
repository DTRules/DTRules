  </table>

  <h3>Boolean Examples</h3>
  <pre><code>// Input: is_member = true, is_active = true, is_suspended = false
is_member and is_active          // Result: true
is_member or is_suspended        // Result: true
not is_suspended                 // Result: true
is_member and not is_suspended   // Result: true
is_member xor is_active          // Result: false (both true)</code></pre>

