      </tr>
      <tr>
        <td><code>set</code></td>
        <td>Assignment</td>
        <td><code>set total = subtotal * tax</code></td>
      </tr>
    </tbody>
  </table>

  <h3>Control Flow Examples</h3>
  <pre><code>// Conditional assignment
if age >= 18 then set category = "adult" else set category = "minor"

// Iterating over arrays
for each item in cart do
  set item.total = item.price * item.quantity
done

// Calling another decision table
perform Calculate_Shipping
perform Apply_Discounts</code></pre>

