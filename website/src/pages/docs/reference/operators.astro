  <h2>Control Flow Operators</h2>

  <table>
    <thead>
      <tr>
        <th>Operator</th>
        <th>Description</th>
        <th>Example</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>if...then</code></td>
        <td>Conditional</td>
        <td><code>if age >= 18 then set adult = true</code></td>
      </tr>
      <tr>
        <td><code>if...then...else</code></td>
