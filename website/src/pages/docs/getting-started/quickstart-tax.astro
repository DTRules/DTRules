<DocsLayout
  title="Quick Start (Tax Return)"
  description="Get started with the TaxReturn sample project - a comprehensive tax calculation demonstration."
  prev={{ title: "Quick Start (Go)", href: "/docs/getting-started/quickstart-go" }}
