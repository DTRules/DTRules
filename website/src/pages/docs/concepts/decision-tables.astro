        <td>N</td>
        <td>N</td>
      </tr>
      <tr>
        <td>income &lt; threshold</td>
        <td>Y</td>
        <td>N</td>
        <td>Y</td>
        <td>N</td>
      </tr>
      <tr>
        <td><strong>Actions</strong></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>set eligible = true</td>
        <td>X</td>
        <td>-</td>
        <td>X</td>
        <td>-</td>
      </tr>
      <tr>
        <td>set reason = "income"</td>
        <td>-</td>
        <td>X</td>
        <td>-</td>
        <td>-</td>
      </tr>
