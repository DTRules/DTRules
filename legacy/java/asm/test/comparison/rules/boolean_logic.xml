<?xml version="1.0" encoding="UTF-8"?>
<!--
  Boolean Logic Test
  Tests boolean operators (and, or, not, xor)
-->
<ruleset name="boolean_logic">
    <decision_tables>
        <decision_table name="boolean_test">
            <actions>
                <action name="test_and">
                    <!-- Test and: true and true -> true -->
                    true true and print
                    <!-- Test and: true and false -> false -->
                    true false and print
                </action>
                <action name="test_or">
                    <!-- Test or: false or true -> true -->
                    false true or print
                    <!-- Test or: false or false -> false -->
                    false false or print
                </action>
                <action name="test_not">
                    <!-- Test not: not false -> true -->
                    false not print
                    <!-- Test not: not true -> false -->
                    true not print
                </action>
                <action name="test_xor">
                    <!-- Test xor: true xor false -> true -->
                    true false xor print
                    <!-- Test xor: true xor true -> false -->
                    true true xor print
                </action>
            </actions>
            <columns>
                <column number="1">
                    <action name="test_and"/>
                    <action name="test_or"/>
                    <action name="test_not"/>
                    <action name="test_xor"/>
                </column>
            </columns>
        </decision_table>
    </decision_tables>
</ruleset>
