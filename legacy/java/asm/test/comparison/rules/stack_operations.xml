<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stack Operations Test
  Tests data stack manipulation operations
-->
<ruleset name="stack_operations">
    <decision_tables>
        <decision_table name="stack_test">
            <actions>
                <action name="test_dup">
                    <!-- Test dup: 5 dup -> [5, 5] -->
                    5 dup print print
                </action>
                <action name="test_swap">
                    <!-- Test swap: 1 2 swap -> [2, 1] -->
                    1 2 swap print print
                </action>
                <action name="test_rot">
                    <!-- Test rot: 1 2 3 rot -> [2, 3, 1] -->
                    1 2 3 rot print print print
                </action>
                <action name="test_over">
                    <!-- Test over: 1 2 over -> [1, 2, 1] -->
                    1 2 over print print print
                </action>
            </actions>
            <columns>
                <column number="1">
                    <action name="test_dup"/>
                    <action name="test_swap"/>
                    <action name="test_rot"/>
                    <action name="test_over"/>
                </column>
            </columns>
        </decision_table>
    </decision_tables>
</ruleset>
