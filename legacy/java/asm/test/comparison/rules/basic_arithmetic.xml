<?xml version="1.0" encoding="UTF-8"?>
<!--
  Basic Arithmetic Test
  Tests simple math operations
-->
<ruleset name="basic_arithmetic">
    <decision_tables>
        <decision_table name="arithmetic_test">
            <actions>
                <action name="compute">
                    <!-- Push 3 and 4, add them -->
                    3 4 add print

                    <!-- Push 10 and 3, subtract -->
                    10 3 sub print

                    <!-- Push 5 and 6, multiply -->
                    5 6 mul print

                    <!-- Push 20 and 4, divide -->
                    20 4 div print
                </action>
            </actions>
            <columns>
                <column number="1">
                    <action name="compute"/>
                </column>
            </columns>
        </decision_table>
    </decision_tables>
</ruleset>
