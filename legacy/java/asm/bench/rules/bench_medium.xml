<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="bench_medium">
    <decision_tables>
        <decision_table name="stack_ops">
            <actions>
                <action name="stack_test">
                    1 2 3 4 5
                    dup swap rot over
                    10 20 lt
                    5 5 eq
                    true false and
                    false true or
                </action>
                <action name="math_test">
                    100 50 add
                    200 30 sub
                    7 8 mul
                    100 10 div
                    17 5 mod
                    42 neg
                    -100 abs
                </action>
            </actions>
            <columns>
                <column number="1">
                    <action name="stack_test"/>
                    <action name="math_test"/>
                </column>
            </columns>
        </decision_table>
    </decision_tables>
</ruleset>
